---
/**
 * MatrixAddDiagram — shows matrix addition with color-coded entries
 * A = [[1,2],[3,4]], B = [[5,6],[7,8]], A+B = [[6,8],[10,12]]
 */
---
<div class="diagram-container">
<svg viewBox="-10 -10 460 180" width="100%" style="max-width:480px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Matrix addition: A plus B equals A+B with color-coded entries">

  {/* Matrix A */}
  <text x="55" y="14" fill="#888" font-size="13" font-family="serif" text-anchor="middle">A</text>
  <rect x="10" y="24" width="90" height="80" rx="5" fill="none" stroke="#58a6ff" stroke-width="1.8" class="ma-blue-stroke" />
  <text x="30" y="58" fill="#58a6ff" font-size="20" font-family="serif" font-weight="bold" class="ma-blue">1</text>
  <text x="72" y="58" fill="#7ee787" font-size="20" font-family="serif" font-weight="bold" class="ma-green">2</text>
  <text x="30" y="92" fill="#d2a8ff" font-size="20" font-family="serif" font-weight="bold" class="ma-purple">3</text>
  <text x="72" y="92" fill="#f0883e" font-size="20" font-family="serif" font-weight="bold" class="ma-orange">4</text>

  {/* Plus */}
  <text x="118" y="72" fill="#888" font-size="22" font-family="serif">+</text>

  {/* Matrix B */}
  <text x="185" y="14" fill="#888" font-size="13" font-family="serif" text-anchor="middle">B</text>
  <rect x="140" y="24" width="90" height="80" rx="5" fill="none" stroke="#58a6ff" stroke-width="1.8" class="ma-blue-stroke" />
  <text x="160" y="58" fill="#58a6ff" font-size="20" font-family="serif" font-weight="bold" class="ma-blue">5</text>
  <text x="202" y="58" fill="#7ee787" font-size="20" font-family="serif" font-weight="bold" class="ma-green">6</text>
  <text x="160" y="92" fill="#d2a8ff" font-size="20" font-family="serif" font-weight="bold" class="ma-purple">7</text>
  <text x="202" y="92" fill="#f0883e" font-size="20" font-family="serif" font-weight="bold" class="ma-orange">8</text>

  {/* Equals */}
  <text x="248" y="72" fill="#888" font-size="22" font-family="serif">=</text>

  {/* Result A+B */}
  <text x="325" y="14" fill="#888" font-size="13" font-family="serif" text-anchor="middle">A + B</text>
  <rect x="275" y="24" width="100" height="80" rx="5" fill="none" stroke="#888" stroke-width="1.8" />
  <text x="296" y="58" fill="#58a6ff" font-size="20" font-family="serif" font-weight="bold" class="ma-blue">6</text>
  <text x="344" y="58" fill="#7ee787" font-size="20" font-family="serif" font-weight="bold" class="ma-green">8</text>
  <text x="290" y="92" fill="#d2a8ff" font-size="20" font-family="serif" font-weight="bold" class="ma-purple">10</text>
  <text x="338" y="92" fill="#f0883e" font-size="20" font-family="serif" font-weight="bold" class="ma-orange">12</text>

  {/* Legend */}
  <g transform="translate(10, 120)">
    <rect x="0" y="0" width="14" height="14" rx="3" fill="#58a6ff" class="ma-blue-fill" />
    <text x="20" y="11" fill="#888" font-size="11" font-family="serif">row 1, col 1</text>
    <rect x="120" y="0" width="14" height="14" rx="3" fill="#7ee787" class="ma-green-fill" />
    <text x="140" y="11" fill="#888" font-size="11" font-family="serif">row 1, col 2</text>
    <rect x="240" y="0" width="14" height="14" rx="3" fill="#d2a8ff" class="ma-purple-fill" />
    <text x="260" y="11" fill="#888" font-size="11" font-family="serif">row 2, col 1</text>
    <rect x="360" y="0" width="14" height="14" rx="3" fill="#f0883e" class="ma-orange-fill" />
    <text x="380" y="11" fill="#888" font-size="11" font-family="serif">row 2, col 2</text>
  </g>
</svg>
</div>

<style>
  .ma-blue { fill: #58a6ff; }
  .ma-green { fill: #7ee787; }
  .ma-purple { fill: #d2a8ff; }
  .ma-orange { fill: #f0883e; }
  .ma-blue-stroke { stroke: #58a6ff; }
  .ma-blue-fill { fill: #58a6ff; }
  .ma-green-fill { fill: #7ee787; }
  .ma-purple-fill { fill: #d2a8ff; }
  .ma-orange-fill { fill: #f0883e; }

  :global([data-theme="light"]) .ma-blue { fill: #0550ae; }
  :global([data-theme="light"]) .ma-green { fill: #1a7f2e; }
  :global([data-theme="light"]) .ma-purple { fill: #6b3fa0; }
  :global([data-theme="light"]) .ma-orange { fill: #c05010; }
  :global([data-theme="light"]) .ma-blue-stroke { stroke: #0550ae; }
  :global([data-theme="light"]) .ma-blue-fill { fill: #0550ae; }
  :global([data-theme="light"]) .ma-green-fill { fill: #1a7f2e; }
  :global([data-theme="light"]) .ma-purple-fill { fill: #6b3fa0; }
  :global([data-theme="light"]) .ma-orange-fill { fill: #c05010; }
  :global([data-theme="light"]) svg text[fill="#888"] { fill: #555; }
  :global([data-theme="light"]) svg rect[stroke="#888"] { stroke: #999; }
</style>
