---
/**
 * LimitEx3 - graph of f(x) = |x-2|/(x-2), step function.
 * Left side = -1, right side = 1, limit DNE at x=2.
 */
const w = 280;
const h = 220;
const pad = 40;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 4, yMin = -2, yMax = 2;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;
---

<figure class="le3" role="img" aria-label="Step function: y=-1 for x less than 2, y=1 for x greater than 2, limit DNE">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[0,1,2,3,4].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="le3-grid" stroke-width="0.5" />
    ))}
    {[-1,0,1].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="le3-grid" stroke-width="0.5" />
    ))}
    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="le3-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="le3-axis" stroke-width="1" />
    {/* Tick labels */}
    <text class="le3-tick" x={sx(2)} y={sy(0) + 14} font-size="9" text-anchor="middle">2</text>
    <text class="le3-tick" x={sx(0) - 6} y={sy(1) + 3} font-size="9" text-anchor="end">1</text>
    <text class="le3-tick" x={sx(0) - 6} y={sy(-1) + 3} font-size="9" text-anchor="end">-1</text>
    {/* Left segment: y = -1 */}
    <line x1={sx(0)} y1={sy(-1)} x2={sx(1.95)} y2={sy(-1)} class="le3-left" stroke-width="2.5" />
    {/* Right segment: y = 1 */}
    <line x1={sx(2.05)} y1={sy(1)} x2={sx(4)} y2={sy(1)} class="le3-right" stroke-width="2.5" />
    {/* Open circles at the jump */}
    <circle cx={sx(2)} cy={sy(-1)} r="5" fill="none" class="le3-hole" stroke-width="2" />
    <circle cx={sx(2)} cy={sy(1)} r="5" fill="none" class="le3-hole" stroke-width="2" />
    {/* Dashed vertical at x=2 */}
    <line x1={sx(2)} y1={sy(-1)} x2={sx(2)} y2={sy(1)} class="le3-jump" stroke-width="1" stroke-dasharray="4,3" />
    {/* Labels */}
    <text class="le3-lbl-l" x={sx(0.2)} y={sy(-1.5)} font-size="9">from left: -1</text>
    <text class="le3-lbl-r" x={sx(2.8)} y={sy(1.6)} font-size="9">from right: 1</text>
    <text class="le3-lbl-dne" x={sx(2.5)} y={sy(-0.2)} font-size="10">limit DNE</text>
  </svg>
</figure>

<style>
  .le3 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .le3 svg { max-width:100%; height:auto; }
  .le3-grid { stroke:#333; }
  .le3-axis { stroke:#666; }
  .le3-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .le3-left { stroke:#58a6ff; }
  .le3-right { stroke:#f0883e; }
  .le3-hole { stroke:#f0883e; }
  .le3-jump { stroke:#666; }
  .le3-lbl-l { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .le3-lbl-r { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .le3-lbl-dne { fill:#f47067; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  :global([data-theme="light"]) .le3-grid { stroke:#ddd; }
  :global([data-theme="light"]) .le3-axis { stroke:#999; }
  :global([data-theme="light"]) .le3-tick { fill:#666; }
  :global([data-theme="light"]) .le3-left { stroke:#0550ae; }
  :global([data-theme="light"]) .le3-right { stroke:#b35900; }
  :global([data-theme="light"]) .le3-hole { stroke:#b35900; }
  :global([data-theme="light"]) .le3-jump { stroke:#999; }
  :global([data-theme="light"]) .le3-lbl-l { fill:#0550ae; }
  :global([data-theme="light"]) .le3-lbl-r { fill:#b35900; }
  :global([data-theme="light"]) .le3-lbl-dne { fill:#cf222e; }
</style>
