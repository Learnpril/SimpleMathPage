---
/**
 * ExpSelfDerivative - shows e^x with a tangent line at x=1,
 * demonstrating that the slope of the tangent equals the y-value.
 * At x=1: y = e ≈ 2.718, slope = e ≈ 2.718. They're the same.
 * Dashed guides show the y-value matching the slope value.
 */
const w = 460;
const h = 320;
const pad = 55;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -1.5, xMax = 3, yMin = 0, yMax = 8;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const E = Math.E;
const a = 1; // tangent point
const fa = Math.exp(a); // e^1 ≈ 2.718
const slope = fa; // derivative = e^1 = same value

// Curve points for e^x
const pts: string[] = [];
for (let i = 0; i <= 80; i++) {
  const x = xMin + i * (xMax - xMin) / 80;
  const y = Math.exp(x);
  if (y >= yMin && y <= yMax) pts.push(`${sx(x)},${sy(y)}`);
}

// Tangent line at x=1: y = fa + slope*(x - a) = e + e*(x-1) = e*x
const tanX1 = -0.5;
const tanX2 = 2.5;
const tanY1 = fa + slope * (tanX1 - a);
const tanY2 = fa + slope * (tanX2 - a);
---

<figure class="esd" role="img" aria-label="Graph of e to the x showing that the slope at any point equals the y-value">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[-1,0,1,2].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="esd-grid" stroke-width="0.5" />
    ))}
    {[2,4,6].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="esd-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="esd-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="esd-axis" stroke-width="1.2" />

    {/* Dashed guide: horizontal from y-axis to point */}
    <line x1={sx(0)} y1={sy(fa)} x2={sx(a)} y2={sy(fa)}
          class="esd-guide" stroke-width="1.2" stroke-dasharray="5,4" />
    {/* Dashed guide: vertical from x-axis to point */}
    <line x1={sx(a)} y1={sy(0)} x2={sx(a)} y2={sy(fa)}
          class="esd-guide" stroke-width="1.2" stroke-dasharray="5,4" />

    {/* e^x curve */}
    <polyline points={pts.join(' ')} fill="none" class="esd-curve" stroke-width="3" />

    {/* Tangent line */}
    <line x1={sx(tanX1)} y1={sy(tanY1)} x2={sx(tanX2)} y2={sy(tanY2)}
          class="esd-tangent" stroke-width="2.5" />

    {/* Point */}
    <circle cx={sx(a)} cy={sy(fa)} r="7" class="esd-dot" />

    {/* Tick labels */}
    <text class="esd-tick" x={sx(a)} y={sy(0) + 18} font-size="11" text-anchor="middle">1</text>
    <text class="esd-tick" x={sx(0) - 8} y={sy(fa) + 4} font-size="11" text-anchor="end">e</text>
  </svg>
  <div class="esd-legend">
    <span class="esd-leg-item"><span class="esd-swatch esd-sw-curve"></span> f(x) = eˣ</span>
    <span class="esd-leg-item"><span class="esd-swatch esd-sw-tan"></span> tangent at x = 1 (slope = e)</span>
    <span class="esd-leg-item esd-leg-note">y-value = slope = e ≈ 2.718</span>
  </div>
</figure>

<style>
  .esd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .esd svg { max-width:100%; height:auto; }
  .esd-grid { stroke:#333; }
  .esd-axis { stroke:#666; }
  .esd-curve { stroke:#58a6ff; }
  .esd-tangent { stroke:#7ee787; }
  .esd-guide { stroke:#d2a8ff; }
  .esd-dot { fill:#f0883e; }
  .esd-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .esd-legend {
    display:flex; gap:1.2rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.85rem;
  }
  .esd-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .esd-swatch { display:inline-block; width:18px; height:4px; border-radius:2px; }
  .esd-sw-curve { background:#58a6ff; }
  .esd-sw-tan { background:#7ee787; }
  .esd-leg-note { color:#d2a8ff; font-style:italic; }

  :global([data-theme="light"]) .esd-grid { stroke:#ddd; }
  :global([data-theme="light"]) .esd-axis { stroke:#999; }
  :global([data-theme="light"]) .esd-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .esd-tangent { stroke:#116329; }
  :global([data-theme="light"]) .esd-guide { stroke:#6639ba; }
  :global([data-theme="light"]) .esd-dot { fill:#b35900; }
  :global([data-theme="light"]) .esd-tick { fill:#666; }
  :global([data-theme="light"]) .esd-sw-curve { background:#0550ae; }
  :global([data-theme="light"]) .esd-sw-tan { background:#116329; }
  :global([data-theme="light"]) .esd-leg-note { color:#6639ba; }
</style>
