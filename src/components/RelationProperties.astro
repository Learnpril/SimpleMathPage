---
/**
 * RelationProperties - reflexive, symmetric, and transitive drawn as small
 * directed graphs, which is the fastest way to check each property by eye.
 */
const w = 540;
const h = 220;
const panels = [72, 270, 462];
const cy = 108;
---

<figure
  class="rlp"
  role="img"
  aria-label="Three small directed graphs illustrating reflexive with self loops at every vertex, symmetric with arrows in both directions, and transitive where a two step path always has a shortcut"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* ============ Reflexive ============ */}
    <text x={panels[0]} y="30" class="rlp-title rlp-t-green" font-size="12.5" font-weight="bold" text-anchor="middle">Reflexive</text>
    <text x={panels[0]} y="46" class="rlp-sub" font-size="9.5" text-anchor="middle">every vertex loops to itself</text>
    {[-52, 0, 52].map((dx) => (
      <g>
        <circle cx={panels[0] + dx} cy={cy + 20} r="13" class="rlp-node rlp-green" />
        {/* self loop */}
        <path d={`M ${panels[0] + dx - 7} ${cy + 9} A 11 11 0 1 1 ${panels[0] + dx + 7} ${cy + 9}`}
          class="rlp-arrow-g" fill="none" marker-end="url(#rlp-hg)" />
      </g>
    ))}
    <text x={panels[0]} y="188" class="rlp-eg" font-size="9.5" text-anchor="middle">“equals”, “divides”</text>

    {/* ============ Symmetric ============ */}
    <text x={panels[1]} y="30" class="rlp-title rlp-t-blue" font-size="12.5" font-weight="bold" text-anchor="middle">Symmetric</text>
    <text x={panels[1]} y="46" class="rlp-sub" font-size="9.5" text-anchor="middle">every arrow has a twin going back</text>
    <circle cx={panels[1] - 46} cy={cy + 20} r="13" class="rlp-node rlp-blue" />
    <text x={panels[1] - 46} y={cy + 25} class="rlp-vl" font-size="10" text-anchor="middle">a</text>
    <circle cx={panels[1] + 46} cy={cy + 20} r="13" class="rlp-node rlp-blue" />
    <text x={panels[1] + 46} y={cy + 25} class="rlp-vl" font-size="10" text-anchor="middle">b</text>
    <path d={`M ${panels[1] - 34} ${cy + 12} Q ${panels[1]} ${cy - 6} ${panels[1] + 34} ${cy + 12}`}
      class="rlp-arrow-b" fill="none" marker-end="url(#rlp-hb)" />
    <path d={`M ${panels[1] + 34} ${cy + 30} Q ${panels[1]} ${cy + 48} ${panels[1] - 34} ${cy + 30}`}
      class="rlp-arrow-b" fill="none" marker-end="url(#rlp-hb)" />
    <text x={panels[1]} y="188" class="rlp-eg" font-size="9.5" text-anchor="middle">“is a sibling of”</text>

    {/* ============ Transitive ============ */}
    <text x={panels[2]} y="30" class="rlp-title rlp-t-purple" font-size="12.5" font-weight="bold" text-anchor="middle">Transitive</text>
    <text x={panels[2]} y="46" class="rlp-sub" font-size="9.5" text-anchor="middle">two steps imply a shortcut</text>
    <circle cx={panels[2] - 44} cy={cy + 34} r="13" class="rlp-node rlp-purple" />
    <text x={panels[2] - 44} y={cy + 39} class="rlp-vl" font-size="10" text-anchor="middle">a</text>
    <circle cx={panels[2]} cy={cy - 12} r="13" class="rlp-node rlp-purple" />
    <text x={panels[2]} y={cy - 7} class="rlp-vl" font-size="10" text-anchor="middle">b</text>
    <circle cx={panels[2] + 44} cy={cy + 34} r="13" class="rlp-node rlp-purple" />
    <text x={panels[2] + 44} y={cy + 39} class="rlp-vl" font-size="10" text-anchor="middle">c</text>
    <line x1={panels[2] - 34} y1={cy + 26} x2={panels[2] - 10} y2={cy - 3} class="rlp-arrow-p" marker-end="url(#rlp-hp)" />
    <line x1={panels[2] + 10} y1={cy - 3} x2={panels[2] + 34} y2={cy + 26} class="rlp-arrow-p" marker-end="url(#rlp-hp)" />
    <line x1={panels[2] - 30} y1={cy + 40} x2={panels[2] + 28} y2={cy + 40} class="rlp-arrow-req" marker-end="url(#rlp-hp)" />
    <text x={panels[2]} y={cy + 58} class="rlp-req" font-size="9" text-anchor="middle">this must exist</text>
    <text x={panels[2]} y="188" class="rlp-eg" font-size="9.5" text-anchor="middle">“is less than”</text>

    {/* Footer */}
    <text x={w / 2} y="210" class="rlp-foot" font-size="10.5" text-anchor="middle">
      All three together make an equivalence relation, which partitions the set into classes
    </text>

    <defs>
      <marker id="rlp-hg" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" class="rlp-fg" />
      </marker>
      <marker id="rlp-hb" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" class="rlp-fb" />
      </marker>
      <marker id="rlp-hp" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" class="rlp-fp" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .rlp { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .rlp svg { max-width:100%; height:auto; }
  .rlp-node { fill:#121212; stroke-width:2.2; }
  .rlp-green { stroke:#7ee787; }
  .rlp-blue { stroke:#58a6ff; }
  .rlp-purple { stroke:#d2a8ff; }
  .rlp-vl { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .rlp-title { font-family:'Libre Baskerville',Georgia,serif; }
  .rlp-t-green { fill:#7ee787; }
  .rlp-t-blue { fill:#58a6ff; }
  .rlp-t-purple { fill:#d2a8ff; }
  .rlp-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .rlp-eg { fill:#666; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .rlp-arrow-g { stroke:#7ee787; stroke-width:1.5; }
  .rlp-arrow-b { stroke:#58a6ff; stroke-width:1.5; }
  .rlp-arrow-p { stroke:#d2a8ff; stroke-width:1.5; }
  .rlp-arrow-req { stroke:#f0883e; stroke-width:1.5; stroke-dasharray:4,3; }
  .rlp-req { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .rlp-fg { fill:#7ee787; }
  .rlp-fb { fill:#58a6ff; }
  .rlp-fp { fill:#d2a8ff; }
  .rlp-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .rlp-node { fill:#ffffff; }
  :global([data-theme="light"]) .rlp-green { stroke:#116329; }
  :global([data-theme="light"]) .rlp-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .rlp-purple { stroke:#6639ba; }
  :global([data-theme="light"]) .rlp-vl { fill:#555; }
  :global([data-theme="light"]) .rlp-t-green { fill:#116329; }
  :global([data-theme="light"]) .rlp-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .rlp-t-purple { fill:#6639ba; }
  :global([data-theme="light"]) .rlp-arrow-g { stroke:#116329; }
  :global([data-theme="light"]) .rlp-arrow-b { stroke:#0550ae; }
  :global([data-theme="light"]) .rlp-arrow-p { stroke:#6639ba; }
  :global([data-theme="light"]) .rlp-arrow-req { stroke:#b35900; }
  :global([data-theme="light"]) .rlp-req { fill:#b35900; }
  :global([data-theme="light"]) .rlp-fg { fill:#116329; }
  :global([data-theme="light"]) .rlp-fb { fill:#0550ae; }
  :global([data-theme="light"]) .rlp-fp { fill:#6639ba; }
  :global([data-theme="light"]) .rlp-foot { fill:#b35900; }
</style>
