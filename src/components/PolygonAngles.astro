---
// PolygonAngles.astro - 2×2 grid of regular polygons with interior angle sums
// Row 1: Triangle (left x=125), Square (right x=375). Shapes y=48–138.
// Row 2: Pentagon (left x=125), Hexagon (right x=375). Shapes y=240–330.
// Titles at y=20 (row1) and y=215 (row2). Formulas at y=170 (row1) and y=365 (row2).
// All vertices computed with trig. Radius ~55 for bigger shapes.
---

<div class="diagram-container" style="text-align:center; margin: 1.5rem 0;">
  <svg viewBox="0 0 500 385" width="500" height="385" role="img" aria-label="Four polygons showing interior angle sums: triangle 180°, square 360°, pentagon 540°, hexagon 720°" style="max-width:100%; height:auto;">

    <!-- ROW 1 -->

    <!-- TRIANGLE n=3, center (125,93), radius 55 -->
    <!-- k=0: (125, 38), k=1: (172.6, 120.5), k=2: (77.4, 120.5) -->
    <text x="125" y="20" font-size="15" font-weight="bold" fill="var(--pa-label, currentColor)" text-anchor="middle">Triangle</text>
    <polygon points="125,38 172.6,120.5 77.4,120.5" fill="none" stroke="var(--pa1, #61afef)" stroke-width="2" stroke-linejoin="round" />
    <text x="125" y="95" font-size="16" font-weight="bold" fill="var(--pa-sum, #e5c07b)" text-anchor="middle">180°</text>
    <text x="125" y="170" font-size="15" font-weight="bold" fill="var(--pa-sub, #888)" text-anchor="middle">(3−2) × 180°</text>

    <!-- SQUARE n=4, center (375,93), side 110 -->
    <text x="375" y="20" font-size="15" font-weight="bold" fill="var(--pa-label, currentColor)" text-anchor="middle">Square</text>
    <rect x="320" y="38" width="110" height="110" fill="none" stroke="var(--pa2, #98c379)" stroke-width="2" />
    <text x="375" y="100" font-size="16" font-weight="bold" fill="var(--pa-sum, #e5c07b)" text-anchor="middle">360°</text>
    <text x="375" y="170" font-size="15" font-weight="bold" fill="var(--pa-sub, #888)" text-anchor="middle">(4−2) × 180°</text>

    <!-- ROW 2 -->

    <!-- PENTAGON n=5, center (125,285), radius 55 -->
    <!-- x = cx + r*sin(k*72°), y = cy - r*cos(k*72°) -->
    <!-- k=0: (125, 230) -->
    <!-- k=1: (125+55*sin72, 285-55*cos72) = (177.3, 268.0) -->
    <!-- k=2: (125+55*sin144, 285-55*cos144) = (157.3, 329.5) -->
    <!-- k=3: (125-32.3, 329.5) = (92.7, 329.5) -->
    <!-- k=4: (125-52.3, 268.0) = (72.7, 268.0) -->
    <text x="125" y="215" font-size="15" font-weight="bold" fill="var(--pa-label, currentColor)" text-anchor="middle">Pentagon</text>
    <polygon points="125,230 177.3,268 157.3,329.5 92.7,329.5 72.7,268" fill="none" stroke="var(--pa3, #e06c75)" stroke-width="2" stroke-linejoin="round" />
    <text x="125" y="292" font-size="16" font-weight="bold" fill="var(--pa-sum, #e5c07b)" text-anchor="middle">540°</text>
    <text x="125" y="365" font-size="15" font-weight="bold" fill="var(--pa-sub, #888)" text-anchor="middle">(5−2) × 180°</text>

    <!-- HEXAGON n=6, center (375,285), radius 55 -->
    <!-- x = cx + r*sin(k*60°), y = cy - r*cos(k*60°) -->
    <!-- k=0: (375, 230) -->
    <!-- k=1: (375+47.6, 257.5) = (422.6, 257.5) -->
    <!-- k=2: (422.6, 312.5) -->
    <!-- k=3: (375, 340) -->
    <!-- k=4: (327.4, 312.5) -->
    <!-- k=5: (327.4, 257.5) -->
    <text x="375" y="215" font-size="15" font-weight="bold" fill="var(--pa-label, currentColor)" text-anchor="middle">Hexagon</text>
    <polygon points="375,230 422.6,257.5 422.6,312.5 375,340 327.4,312.5 327.4,257.5" fill="none" stroke="var(--pa4, #c678dd)" stroke-width="2" stroke-linejoin="round" />
    <text x="375" y="292" font-size="16" font-weight="bold" fill="var(--pa-sum, #e5c07b)" text-anchor="middle">720°</text>
    <text x="375" y="365" font-size="15" font-weight="bold" fill="var(--pa-sub, #888)" text-anchor="middle">(6−2) × 180°</text>

  </svg>
</div>

<style>
  :root {
    --pa1: #61afef;
    --pa2: #98c379;
    --pa3: #e06c75;
    --pa4: #c678dd;
    --pa-sum: #e5c07b;
    --pa-label: var(--sl-color-white, #e0e0e0);
    --pa-sub: #888;
  }
  :root[data-theme="light"] {
    --pa1: #2980b9;
    --pa2: #27ae60;
    --pa3: #c0392b;
    --pa4: #8e44ad;
    --pa-sum: #d4a017;
    --pa-label: #1a1a1a;
    --pa-sub: #666;
  }
</style>
