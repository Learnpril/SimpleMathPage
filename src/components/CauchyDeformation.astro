---
/**
 * CauchyDeformation — two closed contours enclosing the same region. When the
 * integrand is analytic inside, both integrals vanish; when a pole is enclosed,
 * both give the same nonzero value, so the contour can be deformed freely as
 * long as it does not cross a singularity. All four integrals are computed
 * numerically along the contours actually drawn.
 */
const w = 540;
const h = 306;

const cy = 150;
const unit = 52;
const lcx = 128;
const rcx = 398;

type C = { re: number; im: number };
const mul = (a: C, b: C): C => ({ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re });
const inv = (a: C): C => {
  const d = a.re * a.re + a.im * a.im;
  return { re: a.re / d, im: -a.im / d };
};

function loop(f: (z: C) => C, path: (t: number) => C, n = 40000): C {
  let sre = 0;
  let sim = 0;
  for (let i = 0; i < n; i++) {
    const a = path(i / n);
    const b = path((i + 1) / n);
    const mid: C = { re: (a.re + b.re) / 2, im: (a.im + b.im) / 2 };
    const dz: C = { re: b.re - a.re, im: b.im - a.im };
    const term = mul(f(mid), dz);
    sre += term.re;
    sim += term.im;
  }
  return { re: sre, im: sim };
}

const circle = (t: number): C => ({ re: Math.cos(2 * Math.PI * t), im: Math.sin(2 * Math.PI * t) });
const ellipse = (t: number): C => ({
  re: 1.32 * Math.cos(2 * Math.PI * t),
  im: 0.62 * Math.sin(2 * Math.PI * t),
});

const sqFn = (z: C) => mul(z, z);
const invFn = (z: C) => inv(z);

const analytic = { circle: loop(sqFn, circle), ellipse: loop(sqFn, ellipse) };
const pole = { circle: loop(invFn, circle), ellipse: loop(invFn, ellipse) };

const fmt = (v: C) => {
  const rr = Math.abs(v.re) < 1e-6 ? 0 : v.re;
  const ii = Math.abs(v.im) < 1e-6 ? 0 : v.im;
  if (rr === 0 && ii === 0) return "0";
  const rs = rr === 0 ? "" : rr.toFixed(3);
  const is = ii === 0 ? "" : `${ii.toFixed(3)}i`;
  return [rs, is].filter(Boolean).join(" + ");
};
const twoPi = (2 * Math.PI).toFixed(3);

const trace = (path: (t: number) => C, cx: number) =>
  Array.from({ length: 121 }, (_, i) => {
    const p = path(i / 120);
    return `${(cx + p.re * unit).toFixed(1)},${(cy - p.im * unit).toFixed(1)}`;
  }).join(" ");
---

<figure
  class="cdf"
  role="img"
  aria-label={`Two closed contours, a circle and a flattened ellipse, drawn twice. With the analytic integrand z squared both give ${fmt(analytic.circle)}. With the integrand one over z, which has a pole at the enclosed origin, both give ${twoPi}i, so deforming the contour does not change the value.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="cdf-head" font-size="12.5" font-weight="bold">The contour can be reshaped, not moved past a pole</text>
    <text x="16" y="38" class="cdf-sub" font-size="10.5">The same two contours, integrated against an analytic and a singular integrand</text>

    <line x1="262" y1="52" x2="262" y2="262" class="cdf-divide" />

    {/* ---------- left: nothing singular inside ---------- */}
    <text x={lcx} y="56" class="cdf-panel" font-size="10" text-anchor="middle">f(z) = z², analytic inside</text>
    <line x1={lcx - 1.25 * unit} y1={cy} x2={lcx + 1.25 * unit} y2={cy} class="cdf-axis" />
    <line x1={lcx} y1={cy - 1.25 * unit} x2={lcx} y2={cy + 1.25 * unit} class="cdf-axis" />
    <polyline points={trace(ellipse, lcx)} class="cdf-c2" fill="none" />
    <polyline points={trace(circle, lcx)} class="cdf-c1" fill="none" />

    {/* ---------- right: a pole inside ---------- */}
    <text x={rcx} y="56" class="cdf-panel" font-size="10" text-anchor="middle">f(z) = 1⁄z, pole at the centre</text>
    <line x1={rcx - 1.25 * unit} y1={cy} x2={rcx + 1.25 * unit} y2={cy} class="cdf-axis" />
    <line x1={rcx} y1={cy - 1.25 * unit} x2={rcx} y2={cy + 1.25 * unit} class="cdf-axis" />
    <polyline points={trace(ellipse, rcx)} class="cdf-c2" fill="none" />
    <polyline points={trace(circle, rcx)} class="cdf-c1" fill="none" />
    <line x1={rcx - 6} y1={cy - 6} x2={rcx + 6} y2={cy + 6} class="cdf-pole" />
    <line x1={rcx - 6} y1={cy + 6} x2={rcx + 6} y2={cy - 6} class="cdf-pole" />

    <text x={lcx} y="234" class="cdf-c1-lbl" font-size="9.5" text-anchor="middle">{`circle:  ${fmt(analytic.circle)}`}</text>
    <text x={lcx} y="250" class="cdf-c2-lbl" font-size="9.5" text-anchor="middle">{`ellipse:  ${fmt(analytic.ellipse)}`}</text>
    <text x={rcx} y="234" class="cdf-c1-lbl" font-size="9.5" text-anchor="middle">{`circle:  ${fmt(pole.circle)}`}</text>
    <text x={rcx} y="250" class="cdf-c2-lbl" font-size="9.5" text-anchor="middle">{`ellipse:  ${fmt(pole.ellipse)}`}</text>

    <text x={w / 2} y="278" class="cdf-foot" font-size="10.5" text-anchor="middle">
      {`Analytic inside gives 0; one enclosed pole gives ${twoPi}i = 2πi, whatever the shape`}
    </text>
    <text x={w / 2} y="296" class="cdf-sub2" font-size="9.5" text-anchor="middle">
      Only which singularities you enclose matters, and how many times you wind around them
    </text>
  </svg>
</figure>

<style>
  .cdf { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cdf svg { width:100%; max-width:100%; height:auto; }
  .cdf-axis { stroke:#888; stroke-width:1.3; }
  .cdf-divide { stroke:#3a3a3a; stroke-width:1; }
  .cdf-c1 { stroke:#58a6ff; stroke-width:2.4; }
  .cdf-c2 { stroke:#f0883e; stroke-width:2.4; stroke-dasharray:7,4; }
  .cdf-c1-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .cdf-c2-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .cdf-pole { stroke:#ff7b72; stroke-width:2.4; }
  .cdf-panel, .cdf-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .cdf-sub, .cdf-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cdf-foot { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .cdf-axis { stroke:#666; }
  :global([data-theme="light"]) .cdf-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .cdf-c1 { stroke:#0550ae; }
  :global([data-theme="light"]) .cdf-c1-lbl { fill:#0550ae; }
  :global([data-theme="light"]) .cdf-c2 { stroke:#b35900; }
  :global([data-theme="light"]) .cdf-c2-lbl { fill:#b35900; }
  :global([data-theme="light"]) .cdf-pole { stroke:#a40e26; }
  :global([data-theme="light"]) .cdf-foot { fill:#116329; }
  :global([data-theme="light"]) .cdf-panel, :global([data-theme="light"]) .cdf-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.cdf-sub, .cdf-sub2) { fill:#57606a; }
</style>
