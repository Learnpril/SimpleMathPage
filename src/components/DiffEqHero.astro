---
/**
 * DiffEqHero — SVG direction field with mathematically accurate solution curves.
 * Equation: dy/dx = x - y.  Exact solutions: y = x - 1 + C e^{-x}.
 * All solutions converge to the line y = x - 1 (shown dashed).
 */

const ox = 196, oy = 150, s = 52; // origin pixel + scale (px per unit)
const toPx = (x: number) => ox + x * s;
const toPy = (y: number) => oy - y * s;

// Clip bounds (plot area)
const X0 = 38, X1 = 384, Y0 = 16, Y1 = 284;

function curve(f: (x: number) => number, xmin: number, xmax: number, step = 0.04) {
  const pts: [number, number][] = [];
  for (let x = xmin; x <= xmax + 1e-9; x += step) {
    const px = toPx(x), py = toPy(f(x));
    if (px >= X0 && px <= X1 && py >= Y0 && py <= Y1) pts.push([px, py]);
    else if (pts.length) break;
  }
  return pts;
}
const ptsStr = (pts: [number, number][]) => pts.map(p => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");
function arrowPts(pts: [number, number][], size = 8) {
  if (pts.length < 2) return "";
  const [x2, y2] = pts[pts.length - 1];
  const [x1, y1] = pts[pts.length - 2];
  const a = Math.atan2(y2 - y1, x2 - x1);
  const a1 = a + Math.PI * 0.82, a2 = a - Math.PI * 0.82;
  return `${x2.toFixed(1)},${y2.toFixed(1)} ${(x2 + size * Math.cos(a1)).toFixed(1)},${(y2 + size * Math.sin(a1)).toFixed(1)} ${(x2 + size * Math.cos(a2)).toFixed(1)},${(y2 + size * Math.sin(a2)).toFixed(1)}`;
}

// Solution curves
const cAbove = curve(x => x - 1 + 2.2 * Math.exp(-x), -1.05, 3.0);
const cBelow = curve(x => x - 1 - 1.6 * Math.exp(-x), -0.1, 3.0);
const asymptote = curve(x => x - 1, -1.85, 3.0);

// Slope field segments
const field: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let xi = -3; xi <= 3.001; xi += 0.6) {
  for (let yi = -2.2; yi <= 2.2001; yi += 0.55) {
    const ang = Math.atan(xi - yi);
    const L = 9;
    field.push({
      x1: toPx(xi) - L * Math.cos(ang), y1: toPy(yi) + L * Math.sin(ang),
      x2: toPx(xi) + L * Math.cos(ang), y2: toPy(yi) - L * Math.sin(ang),
    });
  }
}
---

<figure class="deqh" role="img" aria-label="Direction field for dy/dx = x minus y with solution curves converging to the line y = x minus 1">
  <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="deqh-svg">
    {/* Grid */}
    <g class="deqh-grid">
      {[-3,-2,-1,0,1,2,3].map(x => <line x1={toPx(x)} y1={Y0} x2={toPx(x)} y2={Y1} />)}
      {[-2,-1,0,1,2].map(y => <line x1={X0} y1={toPy(y)} x2={X1} y2={toPy(y)} />)}
    </g>

    {/* Axes */}
    <line x1={X0} y1={toPy(0)} x2={X1} y2={toPy(0)} class="deqh-axis" />
    <line x1={toPx(0)} y1={Y0} x2={toPx(0)} y2={Y1} class="deqh-axis" />
    <text x={X1 + 4} y={toPy(0) + 4} class="deqh-lbl axis">x</text>
    <text x={toPx(0) + 6} y={Y0 + 4} class="deqh-lbl axis">y</text>

    {/* Slope field */}
    {field.map(f => <line x1={f.x1} y1={f.y1} x2={f.x2} y2={f.y2} class="deqh-slope" />)}

    {/* Asymptote line y = x - 1 */}
    <polyline points={ptsStr(asymptote)} class="deqh-asymp" fill="none" />

    {/* Solution curves */}
    <polyline points={ptsStr(cAbove)} class="deqh-curve c-blue" fill="none" />
    <polygon points={arrowPts(cAbove)} class="deqh-arrow a-blue" />
    <polyline points={ptsStr(cBelow)} class="deqh-curve c-green" fill="none" />
    <polygon points={arrowPts(cBelow)} class="deqh-arrow a-green" />

    {/* Labels in clear zones */}
    <text x={X0 + 4} y={Y0 + 16} class="deqh-lbl eq">dy/dx = x − y</text>
    <text x={toPx(1.7)} y={toPy(-1.35)} class="deqh-lbl asymp-lbl">y = x − 1</text>
  </svg>
</figure>

<style>
  .deqh { display: flex; justify-content: center; margin: 1.5rem 0; }
  .deqh-svg { width: 100%; max-width: 500px; height: auto; }
  .deqh-grid line { stroke: #262626; stroke-width: 0.5; }
  .deqh-axis { stroke: #555; stroke-width: 1.2; }
  .deqh-slope { stroke: #5a5a5a; stroke-width: 1; stroke-linecap: round; }
  .deqh-asymp { stroke: #777; stroke-width: 1.5; stroke-dasharray: 6 4; }
  .deqh-curve { stroke-width: 2.6; stroke-linecap: round; }
  .c-blue { stroke: #58a6ff; }
  .c-green { stroke: #7ee787; }
  .a-blue { fill: #58a6ff; }
  .a-green { fill: #7ee787; }
  .deqh-lbl { font-family: "Libre Baskerville", Georgia, serif; fill: #aaa; }
  .axis { font-size: 14px; font-weight: bold; fill: #888; }
  .eq { font-size: 14px; font-style: italic; fill: #f0883e; }
  .asymp-lbl { font-size: 12px; fill: #9a9a9a; font-style: italic; }

  :root[data-theme="light"] .deqh-grid line { stroke: #e8e8e8; }
  :root[data-theme="light"] .deqh-axis { stroke: #999; }
  :root[data-theme="light"] .deqh-slope { stroke: #bbb; }
  :root[data-theme="light"] .deqh-asymp { stroke: #888; }
  :root[data-theme="light"] .c-blue { stroke: #0550ae; }
  :root[data-theme="light"] .c-green { stroke: #1a7f2e; }
  :root[data-theme="light"] .a-blue { fill: #0550ae; }
  :root[data-theme="light"] .a-green { fill: #1a7f2e; }
  :root[data-theme="light"] .deqh-lbl { fill: #555; }
  :root[data-theme="light"] .axis { fill: #666; }
  :root[data-theme="light"] .eq { fill: #c05010; }
  :root[data-theme="light"] .asymp-lbl { fill: #666; }
</style>
