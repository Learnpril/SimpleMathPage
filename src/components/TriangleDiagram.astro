---
interface Props {
  title?: string;
}
const { title = "Triangle — A = ½bh" } = Astro.props;
---

<figure class="tri-diagram" role="img" aria-label={title}>
  {title && <figcaption class="tri-title">{title}</figcaption>}
  <svg viewBox="0 0 240 180" width="240" height="180" xmlns="http://www.w3.org/2000/svg">

    {/* Triangle outline */}
    <polygon class="tri-outline" points="30,150 210,150 130,30" />

    {/* Base label line + label */}
    <line class="tri-dim" x1="30" y1="160" x2="210" y2="160" />
    <line class="tri-dim" x1="30" y1="156" x2="30" y2="164" />
    <line class="tri-dim" x1="210" y1="156" x2="210" y2="164" />
    <text class="tri-label" x="120" y="176" text-anchor="middle">b</text>

    {/* Height dashed line (apex down to base, perpendicular) */}
    <line class="tri-dim-h" x1="130" y1="30" x2="130" y2="150" stroke-dasharray="5,4" />

    {/* Small right-angle square */}
    <polyline class="tri-right-angle" points="130,140 140,140 140,150" fill="none" />

    {/* Height label */}
    <text class="tri-label-h" x="142" y="92" text-anchor="start">h</text>

    {/* Dots at key points */}
    <circle class="tri-dot" cx="130" cy="30" r="3" />
    <circle class="tri-dot" cx="130" cy="150" r="3" />

  </svg>
</figure>

<style>
  .tri-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1.5rem 0;
  }
  .tri-title {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
    font-style: italic;
  }
  .tri-diagram svg {
    max-width: 100%;
    height: auto;
  }

  /* Dark mode (default) */
  .tri-outline { fill: none; stroke: #999; stroke-width: 2; stroke-linejoin: round; }
  .tri-dim { stroke: #f0c674; stroke-width: 1.5; }
  .tri-dim-h { stroke: #58a6ff; stroke-width: 1.5; }
  .tri-right-angle { stroke: #58a6ff; stroke-width: 1.2; }
  .tri-label { fill: #f0c674; font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; font-style: italic; font-weight: bold; }
  .tri-label-h { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; font-style: italic; font-weight: bold; }
  .tri-dot { fill: #58a6ff; }

  /* Light mode */
  :global([data-theme="light"]) .tri-outline { stroke: #444; }
  :global([data-theme="light"]) .tri-dim { stroke: #b45309; }
  :global([data-theme="light"]) .tri-dim-h { stroke: #0550ae; }
  :global([data-theme="light"]) .tri-right-angle { stroke: #0550ae; }
  :global([data-theme="light"]) .tri-label { fill: #b45309; }
  :global([data-theme="light"]) .tri-label-h { fill: #0550ae; }
  :global([data-theme="light"]) .tri-dot { fill: #0550ae; }
</style>
