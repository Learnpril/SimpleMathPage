---
/**
 * KonigsbergBridges - the seven bridges reduced to a multigraph.
 * All four vertices have odd degree (5, 3, 3, 3), so no Euler path exists.
 * This is the argument that started graph theory in 1736.
 */
const w = 460;
const h = 272;
const N = { x: 166, y: 48 };
const S = { x: 166, y: 196 };
const A = { x: 166, y: 122 };
const B = { x: 316, y: 122 };
---

<figure
  class="kbg"
  role="img"
  aria-label="The seven bridges of Konigsberg as a graph with four vertices of degree 5, 3, 3 and 3. Because all four degrees are odd, no route crosses every bridge exactly once."
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="14" y="22" class="kbg-head" font-size="12.5" font-weight="bold">Königsberg, 1736 - 7 bridges</text>

    {/* North bank to island A: two bridges, drawn as arcs on each side */}
    <path d={`M ${N.x} ${N.y} Q ${N.x - 46} ${(N.y + A.y) / 2} ${A.x} ${A.y}`} class="kbg-edge" fill="none" />
    <path d={`M ${N.x} ${N.y} Q ${N.x + 46} ${(N.y + A.y) / 2} ${A.x} ${A.y}`} class="kbg-edge" fill="none" />

    {/* South bank to island A: two bridges */}
    <path d={`M ${A.x} ${A.y} Q ${S.x - 46} ${(S.y + A.y) / 2} ${S.x} ${S.y}`} class="kbg-edge" fill="none" />
    <path d={`M ${A.x} ${A.y} Q ${S.x + 46} ${(S.y + A.y) / 2} ${S.x} ${S.y}`} class="kbg-edge" fill="none" />

    {/* Island A to island B: one bridge */}
    <line x1={A.x} y1={A.y} x2={B.x} y2={B.y} class="kbg-edge" />

    {/* North bank to island B, and south bank to island B */}
    <path d={`M ${N.x} ${N.y} Q ${B.x + 20} ${N.y + 6} ${B.x} ${B.y}`} class="kbg-edge" fill="none" />
    <path d={`M ${S.x} ${S.y} Q ${B.x + 20} ${S.y - 6} ${B.x} ${B.y}`} class="kbg-edge" fill="none" />

    {/* Vertices - all odd degree, so all flagged */}
    <circle cx={N.x} cy={N.y} r="19" class="kbg-node" />
    <text x={N.x} y={N.y + 5} class="kbg-vl" font-size="13" font-weight="bold" text-anchor="middle">N</text>
    <text x={N.x - 36} y={N.y + 5} class="kbg-deg" font-size="10" text-anchor="middle">deg 3</text>

    <circle cx={S.x} cy={S.y} r="19" class="kbg-node" />
    <text x={S.x} y={S.y + 5} class="kbg-vl" font-size="13" font-weight="bold" text-anchor="middle">S</text>
    <text x={S.x - 36} y={S.y + 5} class="kbg-deg" font-size="10" text-anchor="middle">deg 3</text>

    <circle cx={A.x} cy={A.y} r="19" class="kbg-node" />
    <text x={A.x} y={A.y + 5} class="kbg-vl" font-size="13" font-weight="bold" text-anchor="middle">A</text>
    <text x={A.x - 36} y={A.y + 5} class="kbg-deg" font-size="10" text-anchor="middle">deg 5</text>

    <circle cx={B.x} cy={B.y} r="19" class="kbg-node" />
    <text x={B.x} y={B.y + 5} class="kbg-vl" font-size="13" font-weight="bold" text-anchor="middle">B</text>
    <text x={B.x + 36} y={B.y + 5} class="kbg-deg" font-size="10" text-anchor="middle">deg 3</text>

    {/* Legend for the geography */}
    <text x="380" y="196" class="kbg-note" font-size="9.5">N = north bank</text>
    <text x="380" y="210" class="kbg-note" font-size="9.5">S = south bank</text>
    <text x="380" y="224" class="kbg-note" font-size="9.5">A, B = islands</text>

    {/* Verdict */}
    <text x={w / 2} y="248" class="kbg-verdict" font-size="11.5" text-anchor="middle">
      All four degrees are odd - an Euler path allows at most two
    </text>
    <text x={w / 2} y="265" class="kbg-sub" font-size="10" text-anchor="middle">
      So the walk is impossible, and no amount of clever routing helps
    </text>
  </svg>
</figure>

<style>
  .kbg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .kbg svg { max-width:100%; height:auto; }
  .kbg-edge { stroke:#58a6ff; stroke-width:2; }
  .kbg-node { fill:#121212; stroke:#f0883e; stroke-width:2.5; }
  .kbg-vl { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .kbg-deg { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .kbg-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .kbg-head { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .kbg-verdict { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .kbg-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .kbg-edge { stroke:#0550ae; }
  :global([data-theme="light"]) .kbg-node { fill:#ffffff; stroke:#b35900; }
  :global([data-theme="light"]) .kbg-vl { fill:#24292f; }
  :global([data-theme="light"]) .kbg-deg { fill:#b35900; }
  :global([data-theme="light"]) .kbg-head { fill:#0550ae; }
  :global([data-theme="light"]) .kbg-verdict { fill:#b35900; }
</style>
