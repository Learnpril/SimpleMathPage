---
/**
 * DiskMethodGraph — y = sqrt(x) from 0 to 4, shaded region under curve.
 * Shows a sample disk radius line at x = 2 to illustrate R(x).
 */
const w = 400;
const h = 260;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -0.5, xMax = 5, yMin = -0.3, yMax = 2.5;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// y = sqrt(x) curve
const curvePts: string[] = [];
for (let i = 0; i <= 100; i++) {
  const x = i * 4.5 / 100;
  curvePts.push(`${sx(x)},${sy(Math.sqrt(x))}`);
}

// Shaded region under sqrt(x) from 0 to 4
const shadePts: string[] = [`${sx(0)},${sy(0)}`];
for (let i = 0; i <= 80; i++) {
  const x = i * 4 / 80;
  shadePts.push(`${sx(x)},${sy(Math.sqrt(x))}`);
}
shadePts.push(`${sx(4)},${sy(0)}`);

// Sample radius at x = 2
const rx = 2;
const ry = Math.sqrt(rx);
---

<figure class="dkg" role="img" aria-label="Disk method: y equals square root of x from 0 to 4, with shaded region and a sample radius line at x equals 2">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[1, 2, 3, 4].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="dkg-grid" stroke-width="0.5" />
    ))}
    {[1, 2].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="dkg-grid" stroke-width="0.5" />
    ))}

    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="dkg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="dkg-axis" stroke-width="1.2" />

    {/* Shaded region */}
    <polygon points={shadePts.join(' ')} class="dkg-shade" />

    {/* Curve */}
    <polyline points={curvePts.join(' ')} fill="none" class="dkg-curve" stroke-width="2.5" />

    {/* Sample radius line */}
    <line x1={sx(rx)} y1={sy(0)} x2={sx(rx)} y2={sy(ry)} class="dkg-radius" stroke-width="2" stroke-dasharray="6,3" />
    <circle cx={sx(rx)} cy={sy(ry)} r="3.5" class="dkg-dot" />

    {/* Tick labels */}
    <text class="dkg-tick" x={sx(1)} y={sy(0)+16} font-size="10" text-anchor="middle">1</text>
    <text class="dkg-tick" x={sx(2)} y={sy(0)+16} font-size="10" text-anchor="middle">2</text>
    <text class="dkg-tick" x={sx(4)} y={sy(0)+16} font-size="10" text-anchor="middle">4</text>
    <text class="dkg-tick" x={sx(0)-6} y={sy(1)+4} font-size="10" text-anchor="end">1</text>
    <text class="dkg-tick" x={sx(0)-6} y={sy(2)+4} font-size="10" text-anchor="end">2</text>
  </svg>
  <div class="dkg-legend">
    <span class="dkg-leg"><span class="dkg-sw dkg-sw-curve"></span> y = sqrt(x)</span>
    <span class="dkg-leg"><span class="dkg-sw dkg-sw-shade"></span> region rotated</span>
    <span class="dkg-leg"><span class="dkg-sw dkg-sw-radius"></span> R(x) = disk radius</span>
  </div>
</figure>

<style>
  .dkg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .dkg svg { max-width:100%; height:auto; }
  .dkg-grid { stroke:#333; }
  .dkg-axis { stroke:#666; }
  .dkg-curve { stroke:#58a6ff; }
  .dkg-shade { fill:rgba(88,166,255,0.18); stroke:none; }
  .dkg-radius { stroke:#f0883e; }
  .dkg-dot { fill:#f0883e; }
  .dkg-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .dkg-legend { display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem; }
  .dkg-leg { display:flex; align-items:center; gap:0.35rem; }
  .dkg-sw { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .dkg-sw-curve { background:#58a6ff; height:4px; }
  .dkg-sw-shade { background:rgba(88,166,255,0.35); }
  .dkg-sw-radius { background:#f0883e; height:4px; }
  :global([data-theme="light"]) .dkg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .dkg-axis { stroke:#999; }
  :global([data-theme="light"]) .dkg-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .dkg-shade { fill:rgba(5,80,174,0.12); }
  :global([data-theme="light"]) .dkg-radius { stroke:#b35900; }
  :global([data-theme="light"]) .dkg-dot { fill:#b35900; }
  :global([data-theme="light"]) .dkg-tick { fill:#666; }
  :global([data-theme="light"]) .dkg-sw-curve { background:#0550ae; }
  :global([data-theme="light"]) .dkg-sw-shade { background:rgba(5,80,174,0.2); }
  :global([data-theme="light"]) .dkg-sw-radius { background:#b35900; }
</style>
