---
/**
 * PerpFieldDiagram — SVG showing the upper semicircle path from (1,0)
 * to (-1,0) with the radial field F=<x,y> arrows along the path,
 * illustrating that F is always perpendicular to the circle (work = 0).
 */
---

<figure class="diagram-container" role="img" aria-label="Work integral along the upper semicircle with the radial field F equals x comma y shown as perpendicular outward arrows, giving zero work">
  <svg viewBox="-175 -185 350 260" width="350" height="260" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="pfd-ah" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto">
        <path d="M0,0 L6,2 L0,4 Z" class="pfd-arrow" />
      </marker>
      <marker id="pfd-ah-ax" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto">
        <path d="M0,0 L6,2 L0,4 Z" class="pfd-ax-arrow" />
      </marker>
    </defs>
    <!-- Axes -->
    <line x1="-150" y1="0" x2="150" y2="0" class="pfd-axis" marker-end="url(#pfd-ah-ax)" />
    <line x1="0" y1="30" x2="0" y2="-165" class="pfd-axis" marker-end="url(#pfd-ah-ax)" />
    <text x="155" y="5" class="pfd-label">x</text>
    <text x="5" y="-168" class="pfd-label">y</text>
    <!-- Unit circle upper half -->
    <path d="M 120 0 A 120 120 0 0 0 -120 0" class="pfd-circle" fill="none" />
    <!-- Radial arrows along the semicircle (F=<x,y> points outward, perpendicular to circle) -->
    <!-- At t=0 (1,0): F=<1,0> pointing right (outward) -->
    <line x1="120" y1="0" x2="148" y2="0" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=pi/6: F=<cos30, sin30> pointing outward -->
    <line x1="104" y1="-60" x2="128" y2="-74" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=pi/4: F=<cos45, sin45> -->
    <line x1="85" y1="-85" x2="105" y2="-105" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=pi/3: -->
    <line x1="60" y1="-104" x2="74" y2="-128" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=pi/2 (0,1): F=<0,1> pointing up (outward) -->
    <line x1="0" y1="-120" x2="0" y2="-148" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=2pi/3: -->
    <line x1="-60" y1="-104" x2="-74" y2="-128" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=3pi/4: -->
    <line x1="-85" y1="-85" x2="-105" y2="-105" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=5pi/6: -->
    <line x1="-104" y1="-60" x2="-128" y2="-74" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- At t=pi (-1,0): F=<-1,0> pointing left (outward) -->
    <line x1="-120" y1="0" x2="-148" y2="0" class="pfd-vec" marker-end="url(#pfd-ah)" />
    <!-- Endpoint dots -->
    <circle cx="120" cy="0" r="4" class="pfd-start" />
    <circle cx="-120" cy="0" r="4" class="pfd-end" />
    <!-- Endpoint labels -->
    <text x="125" y="18" class="pfd-pt">(1, 0)</text>
    <text x="-160" y="18" class="pfd-pt">(-1, 0)</text>
    <!-- Path label -->
    <text x="5" y="-130" class="pfd-dir">C</text>
    <!-- Legend at bottom -->
    <text x="0" y="55" text-anchor="middle" class="pfd-legend-text">
      <tspan class="pfd-legend-path-t">&#9644;</tspan> Semicircle C
      <tspan dx="10" class="pfd-legend-vec-t">&#9644;</tspan> F perpendicular to C (work = 0)
    </text>
  </svg>
</figure>

<style>
  .pfd-axis { stroke: #666; stroke-width: 1; fill: none; }
  .pfd-ax-arrow { fill: #666; }
  .pfd-label { font: bold 14px sans-serif; fill: #888; }
  .pfd-pt { font: 11px sans-serif; fill: #888; }
  .pfd-circle { stroke: #58a6ff; stroke-width: 2.5; }
  .pfd-vec { stroke: #f47067; stroke-width: 2; }
  .pfd-arrow { fill: #f47067; }
  .pfd-start { fill: #f0883e; }
  .pfd-end { fill: #d2a8ff; }
  .pfd-dir { font: italic 14px 'Libre Baskerville', Georgia, serif; fill: #58a6ff; }
  .pfd-legend-text { font: 11px 'Libre Baskerville', Georgia, serif; fill: #888; }
  .pfd-legend-path-t { fill: #58a6ff; }
  .pfd-legend-vec-t { fill: #f47067; }
  [data-theme="light"] .pfd-axis { stroke: #999; }
  [data-theme="light"] .pfd-ax-arrow { fill: #999; }
  [data-theme="light"] .pfd-label { fill: #666; }
  [data-theme="light"] .pfd-pt { fill: #666; }
  [data-theme="light"] .pfd-circle { stroke: #0550ae; }
  [data-theme="light"] .pfd-vec { stroke: #cf222e; }
  [data-theme="light"] .pfd-arrow { fill: #cf222e; }
  [data-theme="light"] .pfd-start { fill: #b35900; }
  [data-theme="light"] .pfd-end { fill: #6639ba; }
  [data-theme="light"] .pfd-dir { fill: #0550ae; }
  [data-theme="light"] .pfd-legend-text { fill: #666; }
  [data-theme="light"] .pfd-legend-path-t { fill: #0550ae; }
  [data-theme="light"] .pfd-legend-vec-t { fill: #cf222e; }
</style>
