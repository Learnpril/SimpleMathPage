---
// ParallelTransversal.astro - Two parallel lines cut by a transversal, showing all 8 angles
// Parallel lines at y=70 and y=170. Transversal crosses at x=160 (top) and x=200 (bottom).
// Angle with horizontal ≈ 65°. All 8 angles labeled with colors.
---

<div class="diagram-container" style="text-align:center; margin: 1.5rem 0;">
  <svg viewBox="0 0 480 300" width="480" height="300" role="img" aria-label="Two parallel lines cut by a transversal showing corresponding, alternate interior, and consecutive interior angles" style="max-width:100%; height:auto;">

    <!-- Parallel line 1 -->
    <line x1="30" y1="80" x2="390" y2="80" stroke="var(--line-color, #888)" stroke-width="2" />
    <!-- Parallel line 2 -->
    <line x1="30" y1="180" x2="390" y2="180" stroke="var(--line-color, #888)" stroke-width="2" />

    <!-- Parallel arrows on right side -->
    <text x="396" y="76" font-size="11" fill="var(--sublabel-color, #888)">ℓ₁</text>
    <text x="396" y="176" font-size="11" fill="var(--sublabel-color, #888)">ℓ₂</text>

    <!-- Transversal line -->
    <line x1="140" y1="15" x2="260" y2="245" stroke="var(--trans-color, #c678dd)" stroke-width="2" />
    <text x="265" y="248" font-size="11" fill="var(--sublabel-color, #888)">t</text>

    <!-- Intersection points -->
    <!-- Top intersection: transversal hits line1 at (174, 80) -->
    <circle cx="174" cy="80" r="3.5" fill="var(--point-color, #e5c07b)" />
    <!-- Bottom intersection: transversal hits line2 at (226, 180) -->
    <circle cx="226" cy="180" r="3.5" fill="var(--point-color, #e5c07b)" />

    <!-- ANGLE LABELS at top intersection (172, 80) -->
    <!-- Angles 1-4 clockwise from upper-left -->
    <!-- Angle 1: upper-left (exterior) = 115° -->
    <text x="120" y="72" font-size="14" font-weight="bold" fill="var(--angle-b-color, #e06c75)">115°</text>
    <!-- Angle 2: upper-right (exterior) = 65° -->
    <text x="188" y="72" font-size="14" font-weight="bold" fill="var(--angle-a-color, #61afef)">65°</text>
    <!-- Angle 3: lower-right (interior) = 115° -->
    <text x="188" y="100" font-size="14" font-weight="bold" fill="var(--angle-b-color, #e06c75)">115°</text>
    <!-- Angle 4: lower-left (interior) = 65° -->
    <text x="120" y="100" font-size="14" font-weight="bold" fill="var(--angle-a-color, #61afef)">65°</text>

    <!-- ANGLE LABELS at bottom intersection (220, 180) -->
    <!-- Angle 5: upper-left (interior) = 115° -->
    <text x="168" y="172" font-size="14" font-weight="bold" fill="var(--angle-b-color, #e06c75)">115°</text>
    <!-- Angle 6: upper-right (interior) = 65° -->
    <text x="236" y="172" font-size="14" font-weight="bold" fill="var(--angle-a-color, #61afef)">65°</text>
    <!-- Angle 7: lower-right (exterior) = 115° -->
    <text x="236" y="200" font-size="14" font-weight="bold" fill="var(--angle-b-color, #e06c75)">115°</text>
    <!-- Angle 8: lower-left (exterior) = 65° -->
    <text x="168" y="200" font-size="14" font-weight="bold" fill="var(--angle-a-color, #61afef)">65°</text>

    <!-- Legend -->
    <rect x="30" y="265" width="12" height="12" rx="2" fill="var(--angle-a-color, #61afef)" />
    <text x="48" y="276" font-size="11" fill="var(--label-color, currentColor)">Corresponding / Alternate (equal)</text>
    <rect x="250" y="265" width="12" height="12" rx="2" fill="var(--angle-b-color, #e06c75)" />
    <text x="268" y="276" font-size="11" fill="var(--label-color, currentColor)">Consecutive interior (add to 180°)</text>

  </svg>
</div>

<style>
  :root {
    --line-color: #888;
    --trans-color: #c678dd;
    --point-color: #e5c07b;
    --angle-a-color: #61afef;
    --angle-b-color: #e06c75;
    --label-color: var(--sl-color-white, #e0e0e0);
    --sublabel-color: #888;
  }
  :root[data-theme="light"] {
    --line-color: #555;
    --trans-color: #8e44ad;
    --point-color: #d4a017;
    --angle-a-color: #2980b9;
    --angle-b-color: #c0392b;
    --label-color: #1a1a1a;
    --sublabel-color: #666;
  }
</style>
