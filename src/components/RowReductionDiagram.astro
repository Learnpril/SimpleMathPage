---
/**
 * RowReductionDiagram — step-by-step Gaussian elimination
 * System: 2x + 4y = 8, 3x + 5y = 11
 * Shows augmented matrix → REF → RREF with row operations labeled.
 */
---
<div class="diagram-container">
<svg viewBox="0 0 310 460" width="100%" style="max-width:340px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Gaussian elimination: step-by-step row reduction to RREF">

  {/* Step 1: Original */}
  <text x="10" y="16" fill="#888" font-size="13" font-family="serif" font-weight="bold" class="rrd-label">Start</text>
  <rect x="10" y="24" width="148" height="56" rx="5" fill="#58a6ff" fill-opacity="0.06" stroke="#555" stroke-width="1" class="rrd-box" />
  <text x="22" y="50" fill="#ccc" font-size="18" font-family="monospace" class="rrd-r1">2  4  |  8</text>
  <text x="22" y="72" fill="#f0883e" font-size="18" font-family="monospace" class="rrd-r2">3  5  | 11</text>

  {/* Arrow 1 */}
  <line x1="84" y1="84" x2="84" y2="112" stroke="#d2a8ff" stroke-width="1.5" class="rrd-arrow" />
  <polygon points="79,108 84,118 89,108" fill="#d2a8ff" class="rrd-arrow-head" />
  <text x="98" y="105" fill="#d2a8ff" font-size="12" font-family="serif" class="rrd-op">R1 ÷ 2</text>

  {/* Step 2: After R1 ÷ 2 */}
  <text x="10" y="132" fill="#888" font-size="13" font-family="serif" font-weight="bold" class="rrd-label">Scale R1</text>
  <rect x="10" y="140" width="148" height="56" rx="5" fill="#58a6ff" fill-opacity="0.06" stroke="#555" stroke-width="1" class="rrd-box" />
  <text x="22" y="166" fill="#ccc" font-size="18" font-family="monospace" class="rrd-r1">1  2  |  4</text>
  <text x="22" y="188" fill="#f0883e" font-size="18" font-family="monospace" class="rrd-r2">3  5  | 11</text>

  {/* Arrow 2 */}
  <line x1="84" y1="200" x2="84" y2="228" stroke="#d2a8ff" stroke-width="1.5" class="rrd-arrow" />
  <polygon points="79,224 84,234 89,224" fill="#d2a8ff" class="rrd-arrow-head" />
  <text x="98" y="221" fill="#d2a8ff" font-size="12" font-family="serif" class="rrd-op">R2 - 3·R1</text>

  {/* Step 3: After elimination */}
  <text x="10" y="248" fill="#888" font-size="13" font-family="serif" font-weight="bold" class="rrd-label">Eliminate</text>
  <rect x="10" y="256" width="160" height="56" rx="5" fill="#58a6ff" fill-opacity="0.06" stroke="#555" stroke-width="1" class="rrd-box" />
  <text x="22" y="282" fill="#ccc" font-size="18" font-family="monospace" class="rrd-r1">1  2  |  4</text>
  <text x="22" y="304" fill="#7ee787" font-size="18" font-family="monospace" class="rrd-r3">0 -1  | -1</text>
  {/* Zero highlight */}
  <rect x="18" y="290" width="16" height="18" rx="3" fill="#7ee787" fill-opacity="0.15" />

  {/* Arrow 3 */}
  <line x1="84" y1="316" x2="84" y2="344" stroke="#d2a8ff" stroke-width="1.5" class="rrd-arrow" />
  <polygon points="79,340 84,350 89,340" fill="#d2a8ff" class="rrd-arrow-head" />
  <text x="98" y="337" fill="#d2a8ff" font-size="12" font-family="serif" class="rrd-op">-R2, then R1 - 2·R2</text>

  {/* Step 4: RREF */}
  <text x="10" y="364" fill="#888" font-size="13" font-family="serif" font-weight="bold" class="rrd-label">RREF</text>
  <rect x="10" y="372" width="148" height="56" rx="5" fill="#7ee787" fill-opacity="0.08" stroke="#555" stroke-width="1" class="rrd-box" />
  <text x="22" y="398" fill="#7ee787" font-size="18" font-family="monospace" class="rrd-r3">1  0  |  2</text>
  <text x="22" y="420" fill="#7ee787" font-size="18" font-family="monospace" class="rrd-r3">0  1  |  1</text>

  {/* Solution readout */}
  <text x="175" y="398" fill="#58a6ff" font-size="15" font-family="serif" font-weight="bold" class="rrd-sol">x = 2</text>
  <text x="175" y="420" fill="#58a6ff" font-size="15" font-family="serif" font-weight="bold" class="rrd-sol">y = 1</text>
</svg>
</div>

<style>
  .rrd-label { fill: #888; }
  .rrd-box { stroke: #555; }
  .rrd-r1 { fill: #ccc; }
  .rrd-r2 { fill: #f0883e; }
  .rrd-r3 { fill: #7ee787; }
  .rrd-arrow { stroke: #d2a8ff; }
  .rrd-arrow-head { fill: #d2a8ff; }
  .rrd-op { fill: #d2a8ff; }
  .rrd-sol { fill: #58a6ff; }

  :global([data-theme="light"]) .rrd-label { fill: #555; }
  :global([data-theme="light"]) .rrd-box { stroke: #ccc; }
  :global([data-theme="light"]) .rrd-r1 { fill: #444; }
  :global([data-theme="light"]) .rrd-r2 { fill: #c05010; }
  :global([data-theme="light"]) .rrd-r3 { fill: #1a7f2e; }
  :global([data-theme="light"]) .rrd-arrow { stroke: #6b3fa0; }
  :global([data-theme="light"]) .rrd-arrow-head { fill: #6b3fa0; }
  :global([data-theme="light"]) .rrd-op { fill: #6b3fa0; }
  :global([data-theme="light"]) .rrd-sol { fill: #0550ae; }
</style>
