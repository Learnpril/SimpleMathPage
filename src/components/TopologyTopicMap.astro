---
/**
 * TopologyTopicMap — the five areas of the section and how they depend on each
 * other. Everything is built from one primitive: a chosen collection of open sets.
 */
const bw = 152;
const bh = 54;
const gap = 22;
const margin = 14;
const w = margin * 2 + 3 * bw + 2 * gap;
const h = 254;
const row1Y = 34;
const row2Y = 148;
const colX = (i: number) => margin + i * (bw + gap);

const areas = [
  { x: colX(0), y: row1Y, label: "Open sets", sub: "the only primitive", cls: "green" },
  { x: colX(1), y: row1Y, label: "Continuity", sub: "preimages stay open", cls: "blue" },
  { x: colX(2), y: row1Y, label: "Invariants", sub: "connected, compact", cls: "purple" },
  { x: colX(1), y: row2Y, label: "Surfaces", sub: "gluing and genus", cls: "orange" },
  { x: colX(2), y: row2Y, label: "Algebraic topology", sub: "loops become groups", cls: "pink" },
];
---

<figure
  class="tptm"
  role="img"
  aria-label="Topic map of Topology: a chosen family of open sets defines continuity, which produces invariants such as connectedness and compactness, and both feed into the study of surfaces and into algebraic topology where loops are turned into groups"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <line x1={colX(0) + bw} y1={row1Y + bh / 2} x2={colX(1) - 3} y2={row1Y + bh / 2} class="tptm-link" marker-end="url(#tptm-head)" />
    <line x1={colX(1) + bw} y1={row1Y + bh / 2} x2={colX(2) - 3} y2={row1Y + bh / 2} class="tptm-link" marker-end="url(#tptm-head)" />
    <line x1={colX(1) + bw / 2} y1={row1Y + bh} x2={colX(1) + bw / 2} y2={row2Y - 3} class="tptm-link" marker-end="url(#tptm-head)" />
    <line x1={colX(2) + bw / 2} y1={row1Y + bh} x2={colX(2) + bw / 2} y2={row2Y - 3} class="tptm-link" marker-end="url(#tptm-head)" />
    <line x1={colX(1) + bw} y1={row2Y + bh / 2} x2={colX(2) - 3} y2={row2Y + bh / 2} class="tptm-link" marker-end="url(#tptm-head)" />

    {areas.map((a) => (
      <g>
        <rect x={a.x} y={a.y} width={bw} height={bh} rx="8" class={`tptm-box tptm-${a.cls}`} />
        <text x={a.x + bw / 2} y={a.y + 23} class={`tptm-label tptm-t-${a.cls}`} font-size="12.5" text-anchor="middle" font-weight="bold">{a.label}</text>
        <text x={a.x + bw / 2} y={a.y + 41} class="tptm-sub" font-size="10" text-anchor="middle">{a.sub}</text>
      </g>
    ))}

    <text x={w / 2} y="228" class="tptm-foot" font-size="10.5" text-anchor="middle">
      No distances, no angles, no coordinates — only which sets count as open
    </text>
    <text x={w / 2} y="245" class="tptm-sub" font-size="9.5" text-anchor="middle">
      Strip geometry down that far and what survives is the shape itself
    </text>

    <defs>
      <marker id="tptm-head" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="tptm-head-fill" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .tptm { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .tptm svg { width:100%; max-width:100%; height:auto; }
  .tptm-box { fill:none; stroke-width:2; }
  .tptm-green { stroke:#7ee787; }
  .tptm-blue { stroke:#58a6ff; }
  .tptm-purple { stroke:#d2a8ff; }
  .tptm-orange { stroke:#f0883e; }
  .tptm-pink { stroke:#ff7b72; }
  .tptm-label { font-family:'Libre Baskerville',Georgia,serif; }
  .tptm-t-green { fill:#7ee787; }
  .tptm-t-blue { fill:#58a6ff; }
  .tptm-t-purple { fill:#d2a8ff; }
  .tptm-t-orange { fill:#f0883e; }
  .tptm-t-pink { fill:#ff7b72; }
  .tptm-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .tptm-link { stroke:#888; stroke-width:1.5; }
  .tptm-head-fill { fill:#888; }
  .tptm-foot { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .tptm-green { stroke:#116329; }
  :global([data-theme="light"]) .tptm-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .tptm-purple { stroke:#6639ba; }
  :global([data-theme="light"]) .tptm-orange { stroke:#b35900; }
  :global([data-theme="light"]) .tptm-pink { stroke:#a40e26; }
  :global([data-theme="light"]) .tptm-t-green { fill:#116329; }
  :global([data-theme="light"]) .tptm-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .tptm-t-purple { fill:#6639ba; }
  :global([data-theme="light"]) .tptm-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .tptm-t-pink { fill:#a40e26; }
  :global([data-theme="light"]) :is(.tptm-sub, .tptm-foot) { fill:#57606a; }
  :global([data-theme="light"]) .tptm-link { stroke:#555; }
  :global([data-theme="light"]) .tptm-head-fill { fill:#555; }
</style>
