---
/**
 * ContourPathCompare — two different paths from 0 to 1+i. The integral of z is
 * the same along both; the integral of conj(z) is not. Both integrals are
 * evaluated numerically along the drawn paths by summing f(z) dz, so the numbers
 * printed are the ones the picture actually produces.
 */
const w = 540;
const h = 316;

const ox = 118; // origin of the plane
const oy = 196;
const unit = 96;
const px = (re: number) => ox + re * unit;
const py = (im: number) => oy - im * unit;

type C = { re: number; im: number };
const mul = (a: C, b: C): C => ({ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re });
const conj = (a: C): C => ({ re: a.re, im: -a.im });

/** Numerically integrate f along a parametrised path, using the midpoint rule. */
function integrate(f: (z: C) => C, path: (t: number) => C, n = 20000): C {
  let sre = 0;
  let sim = 0;
  for (let i = 0; i < n; i++) {
    const t0 = i / n;
    const t1 = (i + 1) / n;
    const a = path(t0);
    const b = path(t1);
    const mid: C = { re: (a.re + b.re) / 2, im: (a.im + b.im) / 2 };
    const dz: C = { re: b.re - a.re, im: b.im - a.im };
    const term = mul(f(mid), dz);
    sre += term.re;
    sim += term.im;
  }
  return { re: sre, im: sim };
}

// Path 1: straight line 0 → 1+i
const straight = (t: number): C => ({ re: t, im: t });
// Path 2: along the real axis to 1, then up to 1+i
const dogleg = (t: number): C =>
  t < 0.5 ? { re: 2 * t, im: 0 } : { re: 1, im: 2 * t - 1 };

const idFn = (z: C) => z;
const conjFn = (z: C) => conj(z);

const results = [
  { label: "∫ z dz", fn: idFn, cls: "ok" },
  { label: "∫ z̄ dz", fn: conjFn, cls: "bad" },
].map((r) => {
  const a = integrate(r.fn, straight);
  const b = integrate(r.fn, dogleg);
  const same = Math.hypot(a.re - b.re, a.im - b.im) < 1e-6;
  return { ...r, a, b, same };
});

const fmt = (v: C) => {
  const rr = Math.abs(v.re) < 1e-7 ? 0 : v.re;
  const ii = Math.abs(v.im) < 1e-7 ? 0 : v.im;
  const rs = Math.abs(rr - Math.round(rr)) < 1e-5 ? String(Math.round(rr)) : rr.toFixed(3);
  const is = Math.abs(ii - Math.round(ii)) < 1e-5 ? String(Math.round(ii)) : ii.toFixed(3);
  if (ii === 0) return rs.replace("-", "−");
  if (rr === 0) return `${ii < 0 ? "−" : ""}${Math.abs(Number(is)) === 1 ? "" : is.replace("-", "")}i`;
  return `${rs.replace("-", "−")} ${ii < 0 ? "−" : "+"} ${Math.abs(Number(is)) === 1 ? "" : is.replace("-", "")}i`;
};

// Sample points for drawing the two paths
const drawStraight = Array.from({ length: 21 }, (_, i) => {
  const p = straight(i / 20);
  return `${px(p.re).toFixed(1)},${py(p.im).toFixed(1)}`;
}).join(" ");
const drawDogleg = Array.from({ length: 41 }, (_, i) => {
  const p = dogleg(i / 40);
  return `${px(p.re).toFixed(1)},${py(p.im).toFixed(1)}`;
}).join(" ");
---

<figure
  class="cpc"
  role="img"
  aria-label={`Two paths from the origin to 1 plus i: a straight diagonal and an L-shaped route along the real axis then upward. Integrating z gives ${fmt(results[0].a)} along both. Integrating the conjugate of z gives ${fmt(results[1].a)} along the diagonal and ${fmt(results[1].b)} along the L, so it is path dependent.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="cpc-head" font-size="12.5" font-weight="bold">Some integrands care about the path, some do not</text>
    <text x="16" y="38" class="cpc-sub" font-size="10.5">Two routes from 0 to 1 + i, integrated numerically along each</text>

    <line x1="252" y1="52" x2="252" y2="272" class="cpc-divide" />

    {/* ---------- the two paths ---------- */}
    <line x1={px(-0.18)} y1={oy} x2={px(1.42)} y2={oy} class="cpc-axis" />
    <line x1={ox} y1={py(1.42)} x2={ox} y2={py(-0.18)} class="cpc-axis" />

    <polyline points={drawDogleg} class="cpc-p2" fill="none" />
    <polyline points={drawStraight} class="cpc-p1" fill="none" />

    <circle cx={px(0)} cy={py(0)} r="4.2" class="cpc-node" />
    <circle cx={px(1)} cy={py(1)} r="4.2" class="cpc-node" />
    <text x={px(0) - 8} y={py(0) + 16} class="cpc-node-lbl" font-size="9.5" text-anchor="middle">0</text>
    <text x={px(1) + 10} y={py(1) - 6} class="cpc-node-lbl" font-size="9.5" text-anchor="start">1 + i</text>

    <text x={px(0.62)} y={py(0.34)} class="cpc-lbl-1" font-size="9.5" text-anchor="start">path A</text>
    <text x={px(0.42)} y={oy + 16} class="cpc-lbl-2" font-size="9.5" text-anchor="middle">path B</text>

    {/* ---------- the measured integrals ---------- */}
    {results.map((r, k) => (
      <g>
        <text x="288" y={78 + k * 92} class={`cpc-fn cpc-${r.cls}`} font-size="11.5" text-anchor="start" font-weight="bold">{r.label}</text>
        <text x="288" y={100 + k * 92} class="cpc-row" font-size="10" text-anchor="start">{`path A:  ${fmt(r.a)}`}</text>
        <text x="288" y={120 + k * 92} class="cpc-row" font-size="10" text-anchor="start">{`path B:  ${fmt(r.b)}`}</text>
        <text x="288" y={142 + k * 92} class={`cpc-verdict cpc-${r.cls}`} font-size="10" text-anchor="start">
          {r.same ? "equal — path independent" : "different — path dependent"}
        </text>
      </g>
    ))}

    <text x={w / 2} y="290" class="cpc-foot" font-size="10.5" text-anchor="middle">
      An analytic integrand has an antiderivative, so only the endpoints matter
    </text>
    <text x={w / 2} y="308" class="cpc-sub2" font-size="9.5" text-anchor="middle">
      z̄ is not analytic anywhere, and its integral records which way you went
    </text>
  </svg>
</figure>

<style>
  .cpc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cpc svg { width:100%; max-width:100%; height:auto; }
  .cpc-axis { stroke:#888; stroke-width:1.3; }
  .cpc-divide { stroke:#3a3a3a; stroke-width:1; }
  .cpc-p1 { stroke:#58a6ff; stroke-width:2.6; }
  .cpc-p2 { stroke:#f0883e; stroke-width:2.6; }
  .cpc-lbl-1 { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .cpc-lbl-2 { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .cpc-node { fill:#d2a8ff; stroke:#eee; stroke-width:1.2; }
  .cpc-node-lbl, .cpc-row { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .cpc-fn, .cpc-verdict { font-family:'Libre Baskerville',Georgia,serif; }
  .cpc-ok { fill:#7ee787; }
  .cpc-bad { fill:#ff7b72; }
  .cpc-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .cpc-sub, .cpc-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cpc-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .cpc-axis { stroke:#666; }
  :global([data-theme="light"]) .cpc-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .cpc-p1 { stroke:#0550ae; }
  :global([data-theme="light"]) .cpc-lbl-1, :global([data-theme="light"]) .cpc-foot { fill:#0550ae; }
  :global([data-theme="light"]) .cpc-p2 { stroke:#b35900; }
  :global([data-theme="light"]) .cpc-lbl-2 { fill:#b35900; }
  :global([data-theme="light"]) .cpc-node { fill:#6639ba; stroke:#fff; }
  :global([data-theme="light"]) .cpc-ok { fill:#116329; }
  :global([data-theme="light"]) .cpc-bad { fill:#a40e26; }
  :global([data-theme="light"]) .cpc-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.cpc-node-lbl, .cpc-row, .cpc-sub, .cpc-sub2) { fill:#57606a; }
</style>
