---
/**
 * CauchyWindows - the Cauchy condition without mentioning a limit. For a chosen
 * threshold N, every term past N fits inside a window; push N out and the window
 * shrinks.
 *
 * The window heights are computed as the actual min and max of each tail, so the
 * widths quoted in the labels are measurements rather than claims.
 */
const w = 540;
const h = 314;
const left = 70;
const right = 450;
const axisY = 250;
const top = 64;
const nMax = 22;

const seq = (n: number) => 1.5 + (0.6 * Math.sin(2 * n)) / n;
const terms = Array.from({ length: nMax }, (_, i) => ({ n: i + 1, v: seq(i + 1) }));

function tailWindow(from: number) {
  const tail = terms.filter((t) => t.n >= from).map((t) => t.v);
  return { from, lo: Math.min(...tail), hi: Math.max(...tail) };
}
const windows = [
  { ...tailWindow(6), cls: "orange" },
  { ...tailWindow(13), cls: "purple" },
];

const vMax = 2.4;
const px = (n: number) => left + ((n - 1) / (nMax - 1)) * (right - left);
const py = (v: number) => axisY - (v / vMax) * (axisY - top);
const ticks = [1, 5, 10, 15, 20];
---

<figure
  class="cwn"
  role="img"
  aria-label={`A sequence plotted with two nested windows. Every term from index ${windows[0].from} onward fits in a window of height ${(windows[0].hi - windows[0].lo).toFixed(3)}, and every term from index ${windows[1].from} onward fits in a smaller window of height ${(windows[1].hi - windows[1].lo).toFixed(3)}. No limit is referred to.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="cwn-head" font-size="12.5" font-weight="bold">Cauchy: the terms bunch up, with no limit named</text>
    <text x="16" y="40" class="cwn-sub" font-size="10.5">Push the threshold out and the window containing the tail shrinks</text>

    {windows.map((win, i) => (
      <text x={right} y={76 + i * 16} class={`cwn-wlbl cwn-t-${win.cls}`} font-size="9.5" text-anchor="end">
        {`after N = ${win.from}: window height ${(win.hi - win.lo).toFixed(3)}`}
      </text>
    ))}

    {windows.map((win) => (
      <rect
        x={px(win.from)}
        y={py(win.hi)}
        width={right - px(win.from)}
        height={py(win.lo) - py(win.hi)}
        class={`cwn-win cwn-w-${win.cls}`}
      />
    ))}

    <line x1={left - 12} y1={axisY} x2={right + 4} y2={axisY} class="cwn-axis" />
    <line x1={left} y1={top} x2={left} y2={axisY} class="cwn-axis" />
    {ticks.map((t) => (
      <text x={px(t)} y="266" class="cwn-tick" font-size="9.5" text-anchor="middle">{t}</text>
    ))}

    {terms.map((t) => (
      <circle cx={px(t.n)} cy={py(t.v)} r="3.4" class="cwn-dot" />
    ))}

    <text x={w / 2} y="286" class="cwn-foot" font-size="10.5" text-anchor="middle">
      Cauchy: for every ε there is N with |aₘ − aₙ| &lt; ε for all m, n &gt; N
    </text>
    <text x={w / 2} y="304" class="cwn-sub2" font-size="9.5" text-anchor="middle">
      In ℝ every Cauchy sequence converges. In ℚ one can bunch up around a number that is not there.
    </text>
  </svg>
</figure>

<style>
  .cwn { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cwn svg { width:100%; max-width:100%; height:auto; }
  .cwn-win { fill-opacity:0.12; stroke-width:1.4; stroke-dasharray:5,4; }
  .cwn-w-orange { fill:#f0883e; stroke:#f0883e; }
  .cwn-w-purple { fill:#d2a8ff; stroke:#d2a8ff; }
  .cwn-t-orange { fill:#f0883e; }
  .cwn-t-purple { fill:#d2a8ff; }
  .cwn-wlbl { font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cwn-dot { fill:#7ee787; stroke:#7ee787; stroke-width:1.2; }
  .cwn-axis { stroke:#888; stroke-width:1.3; }
  .cwn-tick { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .cwn-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .cwn-sub, .cwn-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cwn-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .cwn-w-orange, :global([data-theme="light"]) .cwn-t-orange { fill:#b35900; stroke:#b35900; }
  :global([data-theme="light"]) .cwn-w-purple, :global([data-theme="light"]) .cwn-t-purple { fill:#6639ba; stroke:#6639ba; }
  :global([data-theme="light"]) .cwn-dot { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .cwn-axis { stroke:#666; }
  :global([data-theme="light"]) :is(.cwn-tick, .cwn-sub, .cwn-sub2) { fill:#57606a; }
  :global([data-theme="light"]) .cwn-head { fill:#24292f; }
  :global([data-theme="light"]) .cwn-foot { fill:#0550ae; }
</style>
