---
/**
 * WasherSolid3D — 3D washer solid: region between y=x and y=x² rotated around x-axis.
 * Shows outer surface (from y=x), inner surface (from y=x²), and the hollow gap.
 */
---

<figure class="rev3d" role="img" aria-label="Interactive 3D washer solid: region between y equals x and y equals x squared rotated around the x-axis">
  <div class="rev3d-canvas" data-washer3d></div>
  <div class="rev3d-hint">Drag to rotate · Scroll to zoom</div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initWasher(container: HTMLElement) {
    const width = Math.min(container.clientWidth, 500);
    const height = 320;
    const isDark = document.documentElement.dataset.theme !== "light";

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(isDark ? 0x121212 : 0xf8f9fa);

    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    camera.position.set(1.5, 1.2, 1.8);
    camera.lookAt(0.5, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.enableZoom = true;
    controls.minDistance = 3;
    controls.maxDistance = 20;
    controls.target.set(0.5, 0, 0);
    controls.update();

    const seg = 60;
    const radSeg = 48;

    // Outer surface: y = x rotated (radius = x at position x)
    const outerProfile: THREE.Vector2[] = [];
    for (let i = 0; i <= seg; i++) {
      const t = i / seg;
      outerProfile.push(new THREE.Vector2(t, t)); // radius = x, height = x
    }
    const outerGeo = new THREE.LatheGeometry(outerProfile, radSeg);
    const outerMat = new THREE.MeshPhongMaterial({
      color: isDark ? 0x58a6ff : 0x0550ae,
      transparent: true, opacity: 0.3, side: THREE.DoubleSide,
    });
    const outerMesh = new THREE.Mesh(outerGeo, outerMat);
    outerMesh.rotation.z = -Math.PI / 2;
    scene.add(outerMesh);

    // Inner surface: y = x² rotated (radius = x² at position x)
    const innerProfile: THREE.Vector2[] = [];
    for (let i = 0; i <= seg; i++) {
      const t = i / seg;
      innerProfile.push(new THREE.Vector2(t * t, t)); // radius = x², height = x
    }
    const innerGeo = new THREE.LatheGeometry(innerProfile, radSeg);
    const innerMat = new THREE.MeshPhongMaterial({
      color: isDark ? 0xf0883e : 0xb35900,
      transparent: true, opacity: 0.3, side: THREE.DoubleSide,
    });
    const innerMesh = new THREE.Mesh(innerGeo, innerMat);
    innerMesh.rotation.z = -Math.PI / 2;
    scene.add(innerMesh);

    // Wireframes
    const outerWire = new THREE.Mesh(outerGeo, new THREE.MeshBasicMaterial({
      color: isDark ? 0x58a6ff : 0x0550ae, wireframe: true, transparent: true, opacity: 0.1,
    }));
    outerWire.rotation.z = -Math.PI / 2;
    scene.add(outerWire);

    const innerWire = new THREE.Mesh(innerGeo, new THREE.MeshBasicMaterial({
      color: isDark ? 0xf0883e : 0xb35900, wireframe: true, transparent: true, opacity: 0.1,
    }));
    innerWire.rotation.z = -Math.PI / 2;
    scene.add(innerWire);

    // Axis
    const axisGeo = new THREE.BufferGeometry().setFromPoints([
      new THREE.Vector3(-0.2, 0, 0), new THREE.Vector3(1.3, 0, 0),
    ]);
    scene.add(new THREE.Line(axisGeo, new THREE.LineBasicMaterial({ color: isDark ? 0x666666 : 0x999999 })));

    // Profile curve: y = x (outer) in the xz=0 plane
    const outerCurve: THREE.Vector3[] = [];
    for (let i = 0; i <= 60; i++) {
      const x = i / 60;
      outerCurve.push(new THREE.Vector3(x, x, 0));
    }
    scene.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(outerCurve),
      new THREE.LineBasicMaterial({ color: isDark ? 0x58a6ff : 0x0550ae })
    ));
    // Bottom reflection of y = x
    const outerCurveBot: THREE.Vector3[] = [];
    for (let i = 0; i <= 60; i++) {
      const x = i / 60;
      outerCurveBot.push(new THREE.Vector3(x, -x, 0));
    }
    scene.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(outerCurveBot),
      new THREE.LineBasicMaterial({ color: isDark ? 0x58a6ff : 0x0550ae })
    ));

    // Profile curve: y = x² (inner) in the xz=0 plane
    const innerCurve: THREE.Vector3[] = [];
    for (let i = 0; i <= 60; i++) {
      const x = i / 60;
      innerCurve.push(new THREE.Vector3(x, x * x, 0));
    }
    scene.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(innerCurve),
      new THREE.LineBasicMaterial({ color: isDark ? 0xf0883e : 0xb35900 })
    ));
    // Bottom reflection of y = x²
    const innerCurveBot: THREE.Vector3[] = [];
    for (let i = 0; i <= 60; i++) {
      const x = i / 60;
      innerCurveBot.push(new THREE.Vector3(x, -(x * x), 0));
    }
    scene.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(innerCurveBot),
      new THREE.LineBasicMaterial({ color: isDark ? 0xf0883e : 0xb35900 })
    ));

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const d1 = new THREE.DirectionalLight(0xffffff, 0.8);
    d1.position.set(3, 3, 3);
    scene.add(d1);
    scene.add(new THREE.DirectionalLight(0xffffff, 0.3).translateX(-2));

    // Axis label
    function makeLabel(text: string, pos: number[], color: string, size = 0.5) {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      canvas.width = 128;
      canvas.height = 64;
      ctx.font = "bold 36px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(text, 64, 32);
      const tex = new THREE.CanvasTexture(canvas);
      const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
      const sprite = new THREE.Sprite(mat);
      sprite.position.set(pos[0], pos[1], pos[2]);
      sprite.scale.set(size * 2, size, 1);
      scene.add(sprite);
    }

    const labelColor = isDark ? "#888" : "#666";
    makeLabel("x", [1.5, -0.2, 0], labelColor);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    const ro = new ResizeObserver(() => {
      const w = Math.min(container.clientWidth, 500);
      camera.aspect = w / height;
      camera.updateProjectionMatrix();
      renderer.setSize(w, height);
    });
    ro.observe(container);
  }

  document.querySelectorAll<HTMLElement>("[data-washer3d]").forEach((el) => {
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { io.disconnect(); initWasher(el); }
    }, { threshold: 0.1 });
    io.observe(el);
  });
</script>

<style>
  .rev3d { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .rev3d-canvas { width:100%; max-width:500px; border-radius:0.5rem; overflow:hidden; }
  .rev3d-canvas canvas { display:block; border-radius:0.5rem; }
  .rev3d-hint { margin-top:0.4rem; font-size:0.78rem; color:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
</style>
