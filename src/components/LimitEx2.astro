---
/**
 * LimitEx2 - graph of f(x) = (x²-9)/(x-3) = x+3 with hole at (3,6).
 * Shows removable discontinuity: limit = 6 even though f(3) is undefined.
 */
const w = 280;
const h = 220;
const pad = 40;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 6, yMin = 0, yMax = 10;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;
---

<figure class="le2" role="img" aria-label="f(x) = (x²-9)/(x-3) with hole at (3,6), limit = 6">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[0,1,2,3,4,5,6].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="le2-grid" stroke-width="0.5" />
    ))}
    {[0,2,4,6,8].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="le2-grid" stroke-width="0.5" />
    ))}
    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="le2-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="le2-axis" stroke-width="1" />
    {/* Tick labels */}
    <text class="le2-tick" x={sx(3)} y={sy(0) + 14} font-size="9" text-anchor="middle">3</text>
    <text class="le2-tick" x={sx(0) - 6} y={sy(6) + 3} font-size="9" text-anchor="end">6</text>
    {/* Line y = x + 3 with gap at x=3 */}
    <line x1={sx(0)} y1={sy(3)} x2={sx(2.9)} y2={sy(5.9)} class="le2-curve" stroke-width="2.5" />
    <line x1={sx(3.1)} y1={sy(6.1)} x2={sx(6)} y2={sy(9)} class="le2-curve" stroke-width="2.5" />
    {/* Hole at (3, 6) */}
    <circle cx={sx(3)} cy={sy(6)} r="6" fill="none" class="le2-hole" stroke-width="2.5" />
    {/* Dashed guides */}
    <line x1={sx(3)} y1={sy(0)} x2={sx(3)} y2={sy(6)} class="le2-guide" stroke-width="1" stroke-dasharray="4,3" />
    <line x1={sx(0)} y1={sy(6)} x2={sx(3)} y2={sy(6)} class="le2-guide" stroke-width="1" stroke-dasharray="4,3" />
    {/* Labels - positioned in clear space below the line */}
    <text class="le2-lbl" x={sx(0.3)} y={sy(9)} font-size="10">limit = 6</text>
    <text class="le2-lbl-hole" x={sx(4.2)} y={sy(4.2)} font-size="9">hole</text>
    <text class="le2-lbl-func" x={sx(0.5)} y={sy(1.5)} font-size="9">y = x + 3</text>
  </svg>
</figure>

<style>
  .le2 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .le2 svg { max-width:100%; height:auto; }
  .le2-grid { stroke:#333; }
  .le2-axis { stroke:#666; }
  .le2-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .le2-curve { stroke:#58a6ff; }
  .le2-hole { stroke:#f0883e; }
  .le2-guide { stroke:#7ee787; }
  .le2-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .le2-lbl-hole { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .le2-grid { stroke:#ddd; }
  :global([data-theme="light"]) .le2-axis { stroke:#999; }
  :global([data-theme="light"]) .le2-tick { fill:#666; }
  :global([data-theme="light"]) .le2-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .le2-hole { stroke:#b35900; }
  :global([data-theme="light"]) .le2-guide { stroke:#116329; }
  :global([data-theme="light"]) .le2-lbl { fill:#116329; }
  :global([data-theme="light"]) .le2-lbl-hole { fill:#b35900; }
</style>
