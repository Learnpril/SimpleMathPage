---
// ArcCentralAngle.astro — Circle with a 60° central angle, minor arc, and major arc labeled
// Center (180, 150), radius 90. Central angle from 0° to 60°.
// Point A at (270, 150) = 0°. Point B at (180+90*cos60, 150-90*sin60) = (225, 72.1).
// Minor arc: A to B (60°, short way). Major arc: B to A (300°, long way).
---

<div class="diagram-container" style="text-align:center; margin: 1.5rem 0;">
  <svg viewBox="0 0 440 330" width="440" height="330" role="img" aria-label="Circle with 60° central angle showing minor arc of 60° and major arc of 300°" style="max-width:100%; height:auto;">

    <!-- Major arc highlight (the long way, 300°) — drawn first so it's behind -->
    <path d="M 225,72.1 A 90,90 0 1,0 270,150" fill="none" stroke="var(--aca-major, #e06c75)" stroke-width="5" opacity="0.5" />

    <!-- Circle -->
    <circle cx="180" cy="150" r="90" fill="none" stroke="var(--aca-circle, #61afef)" stroke-width="2" />

    <!-- Minor arc highlight (the short way, 60°) -->
    <path d="M 270,150 A 90,90 0 0,0 225,72.1" fill="none" stroke="var(--aca-minor, #98c379)" stroke-width="5" />

    <!-- Central angle lines (radii) -->
    <line x1="180" y1="150" x2="270" y2="150" stroke="var(--aca-line, #888)" stroke-width="2" />
    <line x1="180" y1="150" x2="225" y2="72.1" stroke="var(--aca-line, #888)" stroke-width="2" />

    <!-- Central angle arc (small, inside) R=25 -->
    <!-- From 0° to 60°: start (205,150), end (180+25*cos60, 150-25*sin60) = (192.5, 128.4) -->
    <path d="M 205,150 A 25,25 0 0,0 192.5,128.4" fill="none" stroke="var(--aca-angle, #e5c07b)" stroke-width="2" />

    <!-- Center dot -->
    <circle cx="180" cy="150" r="4" fill="var(--aca-center, #e5c07b)" />
    <text x="168" y="148" font-size="13" font-weight="bold" fill="var(--aca-center, #e5c07b)" text-anchor="end">O</text>

    <!-- Point labels -->
    <text x="278" y="148" font-size="13" font-weight="bold" fill="var(--aca-label, currentColor)">A</text>
    <text x="230" y="65" font-size="13" font-weight="bold" fill="var(--aca-label, currentColor)">B</text>

    <!-- Central angle label -->
    <text x="212" y="140" font-size="14" font-weight="bold" fill="var(--aca-angle, #e5c07b)">60°</text>

    <!-- Minor arc label (outside, near the green arc) -->
    <text x="272" y="95" font-size="14" font-weight="bold" fill="var(--aca-minor, #98c379)">Minor arc</text>
    <text x="272" y="111" font-size="13" fill="var(--aca-minor, #98c379)">= 60°</text>

    <!-- Major arc label — far left, clear of circle (circle left edge is at x=90) -->
    <text x="18" y="200" font-size="14" font-weight="bold" fill="var(--aca-major, #e06c75)">Major arc</text>
    <text x="18" y="216" font-size="13" fill="var(--aca-major, #e06c75)">= 300°</text>

    <!-- Summary below -->
    <text x="220" y="280" font-size="14" fill="var(--aca-sub, #888)" text-anchor="middle">Minor arc = central angle</text>
    <text x="220" y="300" font-size="14" fill="var(--aca-sub, #888)" text-anchor="middle">Major arc = 360° − central angle</text>

  </svg>
</div>

<style>
  :root {
    --aca-circle: #61afef;
    --aca-minor: #98c379;
    --aca-major: #e06c75;
    --aca-angle: #e5c07b;
    --aca-line: #888;
    --aca-center: #e5c07b;
    --aca-label: var(--sl-color-white, #e0e0e0);
    --aca-sub: #888;
  }
  :root[data-theme="light"] {
    --aca-circle: #2980b9;
    --aca-minor: #27ae60;
    --aca-major: #c0392b;
    --aca-angle: #d4a017;
    --aca-line: #555;
    --aca-center: #d4a017;
    --aca-label: #1a1a1a;
    --aca-sub: #666;
  }
</style>
