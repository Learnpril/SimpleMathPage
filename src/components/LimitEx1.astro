---
/**
 * LimitEx1 - graph of f(x) = 3x²-5x+1 with solid dot at (2,3).
 * Shows direct substitution: the function is smooth, limit = f(2) = 3.
 */
const w = 280;
const h = 220;
const pad = 40;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
// x: -1 to 4, y: -2 to 6 (dot at y=3 is centered vertically)
const xMin = -1, xMax = 4, yMin = -2, yMax = 6;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;
const pts: string[] = [];
for (let i = 0; i <= 80; i++) {
  const x = xMin + i * (xMax - xMin) / 80;
  const y = 3*x*x - 5*x + 1;
  if (y >= yMin && y <= yMax) pts.push(`${sx(x)},${sy(y)}`);
}
---

<figure class="le1" role="img" aria-label="f(x) = 3x²-5x+1 with limit = 3 at x = 2">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[0,1,2,3,4].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="le1-grid" stroke-width="0.5" />
    ))}
    {[-1,0,1,2,3,4,5].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="le1-grid" stroke-width="0.5" />
    ))}
    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="le1-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="le1-axis" stroke-width="1" />
    {/* Tick labels on x-axis */}
    <text class="le1-tick" x={sx(1)} y={sy(0) + 14} font-size="9" text-anchor="middle">1</text>
    <text class="le1-tick" x={sx(2)} y={sy(0) + 14} font-size="9" text-anchor="middle">2</text>
    <text class="le1-tick" x={sx(3)} y={sy(0) + 14} font-size="9" text-anchor="middle">3</text>
    {/* Tick labels on y-axis */}
    <text class="le1-tick" x={sx(0) - 6} y={sy(1) + 3} font-size="9" text-anchor="end">1</text>
    <text class="le1-tick" x={sx(0) - 6} y={sy(2) + 3} font-size="9" text-anchor="end">2</text>
    <text class="le1-tick" x={sx(0) - 6} y={sy(3) + 3} font-size="9" text-anchor="end">3</text>
    <text class="le1-tick" x={sx(0) - 6} y={sy(4) + 3} font-size="9" text-anchor="end">4</text>
    <text class="le1-tick" x={sx(0) - 6} y={sy(5) + 3} font-size="9" text-anchor="end">5</text>
    {/* Curve */}
    <polyline points={pts.join(' ')} fill="none" class="le1-curve" stroke-width="2.5" />
    {/* Dashed guides to (2, 3) */}
    <line x1={sx(2)} y1={sy(0)} x2={sx(2)} y2={sy(3)} class="le1-guide" stroke-width="1" stroke-dasharray="4,3" />
    <line x1={sx(0)} y1={sy(3)} x2={sx(2)} y2={sy(3)} class="le1-guide" stroke-width="1" stroke-dasharray="4,3" />
    {/* Solid dot at (2, 3) */}
    <circle cx={sx(2)} cy={sy(3)} r="6" class="le1-dot" />
    {/* Labels */}
    <text class="le1-lbl" x={sx(2.6)} y={sy(3.8)} font-size="10">limit = 3</text>
    <text class="le1-lbl-pt" x={sx(2.6)} y={sy(2.8)} font-size="8">(2, 3)</text>
  </svg>
</figure>

<style>
  .le1 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .le1 svg { max-width:100%; height:auto; }
  .le1-grid { stroke:#333; }
  .le1-axis { stroke:#666; }
  .le1-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .le1-curve { stroke:#58a6ff; }
  .le1-guide { stroke:#7ee787; }
  .le1-dot { fill:#7ee787; }
  .le1-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .le1-lbl-pt { fill:#aaa; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .le1-grid { stroke:#ddd; }
  :global([data-theme="light"]) .le1-axis { stroke:#999; }
  :global([data-theme="light"]) .le1-tick { fill:#666; }
  :global([data-theme="light"]) .le1-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .le1-guide { stroke:#116329; }
  :global([data-theme="light"]) .le1-dot { fill:#116329; }
  :global([data-theme="light"]) .le1-lbl { fill:#116329; }
  :global([data-theme="light"]) .le1-lbl-pt { fill:#666; }
</style>
