---
/**
 * ConeSliceDiagram — four double cones showing how different plane angles
 * produce circle, ellipse, parabola, and hyperbola.
 * Each cone is drawn as two triangles (side view) with a colored cutting line.
 */
const pw = 90;
const gap = 16;
const totalW = pw * 4 + gap * 3 + 20;
const totalH = 195;

function px(i: number) { return 10 + i * (pw + gap); }
function cx(i: number) { return px(i) + pw / 2; }

// Double cone: apex at center, top cone above, bottom cone below
// Side view: two triangles sharing a point
const apexY = 100;
const coneH = 60; // half-height
const coneW = 30; // half-width at base

function cone(i: number) {
  const c = cx(i);
  // Top cone: apex → top-left → top-right
  const topL = `${c - coneW},${apexY - coneH}`;
  const topR = `${c + coneW},${apexY - coneH}`;
  // Bottom cone: apex → bot-left → bot-right
  const botL = `${c - coneW},${apexY + coneH}`;
  const botR = `${c + coneW},${apexY + coneH}`;
  return {
    top: `M${c},${apexY} L${topL} L${topR} Z`,
    bot: `M${c},${apexY} L${botL} L${botR} Z`,
  };
}

const labels = ["Circle", "Ellipse", "Parabola", "Hyperbola"];
const subs = ["horizontal cut", "angled cut", "parallel to side", "cuts both halves"];
---

<figure class="csl-diagram" role="img" aria-label="Four double cones sliced at different angles to produce conic sections">
  <figcaption class="csl-title">Slicing a double cone at different angles</figcaption>
  <svg viewBox={`0 0 ${totalW} ${totalH}`} width={totalW} height={totalH} xmlns="http://www.w3.org/2000/svg">

    <rect class="csl-bg" x="0" y="0" width={totalW} height={totalH} rx="8" />

    {/* Labels */}
    {labels.map((label, i) => (
      <text class={`csl-label csl-label-${i}`} x={cx(i)} y={16} font-size="11" text-anchor="middle" font-weight="bold">{label}</text>
    ))}
    {subs.map((sub, i) => (
      <text class="csl-sub" x={cx(i)} y={28} font-size="8" text-anchor="middle">{sub}</text>
    ))}

    {/* Cones and cutting planes */}
    {[0, 1, 2, 3].map(i => {
      const c = cone(i);
      return (
        <g>
          <path class="csl-cone" d={c.top} fill="none" stroke-width="1.5" />
          <path class="csl-cone" d={c.bot} fill="none" stroke-width="1.5" />
        </g>
      );
    })}

    {/* Circle: horizontal line through upper cone */}
    <line class="csl-cut csl-cut-0" x1={cx(0) - 35} y1={apexY - 30} x2={cx(0) + 35} y2={apexY - 30} stroke-width="2.5" />

    {/* Ellipse: angled line through upper cone */}
    <line class="csl-cut csl-cut-1" x1={cx(1) - 32} y1={apexY - 42} x2={cx(1) + 32} y2={apexY - 18} stroke-width="2.5" />

    {/* Parabola: line parallel to cone side (steeper angle) */}
    <line class="csl-cut csl-cut-2" x1={cx(2) - 20} y1={apexY - 55} x2={cx(2) + 32} y2={apexY + 10} stroke-width="2.5" />

    {/* Hyperbola: vertical-ish line cutting both cones */}
    <line class="csl-cut csl-cut-3" x1={cx(3) + 10} y1={apexY - 55} x2={cx(3) + 10} y2={apexY + 55} stroke-width="2.5" />

  </svg>
</figure>

<style>
  .csl-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .csl-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .csl-diagram svg { max-width: 100%; height: auto; }
  .csl-bg { fill: var(--sl-color-bg, #121212); }
  .csl-cone { stroke: #666; }
  .csl-sub { fill: #888; font-family: 'Libre Baskerville', Georgia, serif; }

  .csl-label-0 { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .csl-label-1 { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }
  .csl-label-2 { fill: #f78166; font-family: 'Libre Baskerville', Georgia, serif; }
  .csl-label-3 { fill: #d2a8ff; font-family: 'Libre Baskerville', Georgia, serif; }

  .csl-cut-0 { stroke: #58a6ff; }
  .csl-cut-1 { stroke: #7ee787; }
  .csl-cut-2 { stroke: #f78166; }
  .csl-cut-3 { stroke: #d2a8ff; }

  :global([data-theme="light"]) .csl-bg { fill: #f8f9fa; }
  :global([data-theme="light"]) .csl-cone { stroke: #aaa; }
  :global([data-theme="light"]) .csl-sub { fill: #666; }
  :global([data-theme="light"]) .csl-label-0 { fill: #0550ae; }
  :global([data-theme="light"]) .csl-label-1 { fill: #116329; }
  :global([data-theme="light"]) .csl-label-2 { fill: #cf222e; }
  :global([data-theme="light"]) .csl-label-3 { fill: #6639ba; }
  :global([data-theme="light"]) .csl-cut-0 { stroke: #0550ae; }
  :global([data-theme="light"]) .csl-cut-1 { stroke: #116329; }
  :global([data-theme="light"]) .csl-cut-2 { stroke: #cf222e; }
  :global([data-theme="light"]) .csl-cut-3 { stroke: #6639ba; }
</style>
