  .hmd-divide { stroke:#3a3a3a; stroke-width:1; }
  .hmd-loop { stroke-width:2.2; }
  .hmd-l0 { stroke:#58a6ff; }
  .hmd-l1 { stroke:#7ee787; }
  .hmd-l2 { stroke:#f0883e; }
  .hmd-l3 { stroke:#d2a8ff; }
  .hmd-dot { fill:#d2a8ff; stroke:none; }
  .hmd-hole { stroke:#ff7b72; stroke-width:2.6; }
  .hmd-panel, .hmd-val { font-family:'Libre Baskerville',Georgia,serif; }
  .hmd-ok { fill:#7ee787; }
  .hmd-bad { fill:#ff7b72; }
  .hmd-note { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .hmd-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .hmd-sub, .hmd-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .hmd-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .hmd-axis { stroke:#8c959f; }
  :global([data-theme="light"]) .hmd-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .hmd-l0 { stroke:#0550ae; }
  :global([data-theme="light"]) .hmd-l1 { stroke:#116329; }
  :global([data-theme="light"]) .hmd-l2 { stroke:#b35900; }
  :global([data-theme="light"]) .hmd-l3 { stroke:#6639ba; }
  :global([data-theme="light"]) .hmd-dot { fill:#6639ba; }
  :global([data-theme="light"]) .hmd-hole { stroke:#a40e26; }
  :global([data-theme="light"]) .hmd-ok { fill:#116329; }
  :global([data-theme="light"]) .hmd-bad { fill:#a40e26; }
  :global([data-theme="light"]) .hmd-head { fill:#24292f; }
  :global([data-theme="light"]) .hmd-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.hmd-note, .hmd-sub, .hmd-sub2) { fill:#57606a; }
</style>
