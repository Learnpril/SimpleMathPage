---
/**
 * BarVsHistogram - side by side comparison. Bar chart bars are separated
 * because categories are distinct; histogram bars touch because the bins
 * tile a continuous number line.
 */
const w = 540;
const h = 250;
const baseY = 180;
const maxBar = 120;

// Bar chart: categories with gaps
const cats = [
  { label: "Bus", v: 0.55 },
  { label: "Car", v: 0.85 },
  { label: "Bike", v: 0.35 },
  { label: "Walk", v: 0.6 },
];
const barW = 34;
const barGap = 18;
const barStart = 34;

// Histogram: adjacent bins
const bins = [0.2, 0.45, 0.8, 1.0, 0.62, 0.3, 0.12];
const binW = 27;
const histStart = 320;
---

<figure
  class="bvh"
  role="img"
  aria-label="A bar chart with separated bars for transport categories beside a histogram with touching bars for a continuous measurement"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* ---------- Bar chart ---------- */}
    <text x="130" y="24" class="bvh-title bvh-t-blue" font-size="13" font-weight="bold" text-anchor="middle">Bar chart</text>
    <text x="130" y="40" class="bvh-sub" font-size="10" text-anchor="middle">categorical data</text>

    <line x1="24" y1={baseY} x2="248" y2={baseY} class="bvh-axis" />
    {cats.map((c, i) => {
      const x = barStart + i * (barW + barGap);
      const bh = c.v * maxBar;
      return (
        <g>
          <rect x={x} y={baseY - bh} width={barW} height={bh} class="bvh-bar" />
          <text x={x + barW / 2} y={baseY + 14} class="bvh-cat" font-size="9.5" text-anchor="middle">{c.label}</text>
        </g>
      );
    })}
    <text x="130" y={baseY + 34} class="bvh-note bvh-t-blue" font-size="10" text-anchor="middle">bars have GAPS</text>
    <text x="130" y={baseY + 48} class="bvh-sub" font-size="9.5" text-anchor="middle">nothing exists between categories</text>
    <text x="130" y={baseY + 62} class="bvh-sub" font-size="9.5" text-anchor="middle">order is arbitrary; sorting is fine</text>

    {/* Divider */}
    <line x1="280" y1="30" x2="280" y2={baseY + 40} class="bvh-divide" stroke-dasharray="4,4" />

    {/* ---------- Histogram ---------- */}
    <text x="415" y="24" class="bvh-title bvh-t-green" font-size="13" font-weight="bold" text-anchor="middle">Histogram</text>
    <text x="415" y="40" class="bvh-sub" font-size="10" text-anchor="middle">quantitative data</text>

    <line x1={histStart - 10} y1={baseY} x2={histStart + bins.length * binW + 10} y2={baseY} class="bvh-axis" />
    {bins.map((v, i) => {
      const x = histStart + i * binW;
      const bh = v * maxBar;
      return <rect x={x} y={baseY - bh} width={binW} height={bh} class="bvh-hbar" />;
    })}
    {/* Bin edge ticks */}
    {Array.from({ length: bins.length + 1 }).map((_, i) => (
      <line x1={histStart + i * binW} y1={baseY} x2={histStart + i * binW} y2={baseY + 5} class="bvh-axis" />
    ))}
    <text x={histStart} y={baseY + 15} class="bvh-cat" font-size="9.5" text-anchor="middle">0</text>
    <text x={histStart + bins.length * binW} y={baseY + 15} class="bvh-cat" font-size="9.5" text-anchor="middle">70</text>

    <text x="415" y={baseY + 34} class="bvh-note bvh-t-green" font-size="10" text-anchor="middle">bars TOUCH</text>
    <text x="415" y={baseY + 48} class="bvh-sub" font-size="9.5" text-anchor="middle">bins tile a continuous scale</text>
    <text x="415" y={baseY + 62} class="bvh-sub" font-size="9.5" text-anchor="middle">order is fixed by the numbers</text>
  </svg>
</figure>

<style>
  .bvh { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .bvh svg { width:100%; max-width:100%; height:auto; }
  .bvh-axis { stroke:#888; stroke-width:1.5; }
  .bvh-bar { fill:#58a6ff; fill-opacity:0.45; stroke:#58a6ff; stroke-width:1.5; }
  .bvh-hbar { fill:#7ee787; fill-opacity:0.35; stroke:#7ee787; stroke-width:1.5; }
  .bvh-title { font-family:'Libre Baskerville',Georgia,serif; }
  .bvh-t-blue { fill:#58a6ff; }
  .bvh-t-green { fill:#7ee787; }
  .bvh-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .bvh-cat { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .bvh-note { font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .bvh-divide { stroke:#555; }
  :global([data-theme="light"]) .bvh-axis { stroke:#666; }
  :global([data-theme="light"]) .bvh-bar { fill:#0550ae; fill-opacity:0.30; stroke:#0550ae; }
  :global([data-theme="light"]) .bvh-hbar { fill:#116329; fill-opacity:0.25; stroke:#116329; }
  :global([data-theme="light"]) .bvh-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .bvh-t-green { fill:#116329; }
  :global([data-theme="light"]) .bvh-divide { stroke:#ccc; }
</style>
