---
/**
 * RationalFuncGraph — plots f(x) = (x²-4)/(x²-3x-4)
 * = (x-2)(x+2)/((x-4)(x+1))
 * VA at x=-1, x=4; HA at y=1
 */
const w = 340;
const h = 280;
const pad = 35;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -4, xMax = 8, yMin = -6, yMax = 6;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const f = (x: number) => (x * x - 4) / (x * x - 3 * x - 4);

// Generate curve segments (skip near asymptotes at x=-1 and x=4)
const segs: string[][] = [[], [], []];
for (let x = xMin; x <= xMax; x += 0.06) {
  const y = f(x);
  let seg = -1;
  if (x < -1.15) seg = 0;
  else if (x > -0.85 && x < 3.85) seg = 1;
  else if (x > 4.15) seg = 2;
  if (seg >= 0 && y > yMin && y < yMax) {
    segs[seg].push(`${sx(x).toFixed(1)},${sy(y).toFixed(1)}`);
  }
}
---

<figure class="rfg" role="img" aria-label="Graph of rational function with vertical asymptotes at x=-1 and x=4, horizontal asymptote at y=1">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[-4,-2,0,2,4,6,8].map(v => (
      <g>
        {v >= xMin && v <= xMax && <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="rfg-grid" stroke-width="0.5" />}
        {v >= yMin && v <= yMax && <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="rfg-grid" stroke-width="0.5" />}
      </g>
    ))}
    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="rfg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="rfg-axis" stroke-width="1.5" />

    {/* Vertical asymptotes */}
    <line x1={sx(-1)} y1={sy(yMin)} x2={sx(-1)} y2={sy(yMax)} class="rfg-va" stroke-width="1.5" stroke-dasharray="6,4" />
    <line x1={sx(4)} y1={sy(yMin)} x2={sx(4)} y2={sy(yMax)} class="rfg-va" stroke-width="1.5" stroke-dasharray="6,4" />

    {/* Horizontal asymptote */}
    <line x1={sx(xMin)} y1={sy(1)} x2={sx(xMax)} y2={sy(1)} class="rfg-ha" stroke-width="1.5" stroke-dasharray="6,4" />

    {/* Curve segments */}
    {segs.map(s => s.length > 1 && (
      <polyline points={s.join(' ')} fill="none" class="rfg-curve" stroke-width="2.5" />
    ))}

    {/* x-intercept dots at x=-2 and x=2 */}
    <circle cx={sx(-2)} cy={sy(0)} r="4" class="rfg-zero" />
    <circle cx={sx(2)} cy={sy(0)} r="4" class="rfg-zero" />

    {/* Labels */}
    <text class="rfg-va-lbl" x={sx(-1) + 4} y={sy(yMax) + 12} font-size="10">x = -1</text>
    <text class="rfg-va-lbl" x={sx(4) + 4} y={sy(yMax) + 12} font-size="10">x = 4</text>
    <text class="rfg-ha-lbl" x={sx(xMax) - 36} y={sy(1) - 6} font-size="10">y = 1</text>
  </svg>
</figure>

<style>
  .rfg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .rfg svg { max-width:100%; height:auto; }
  .rfg-grid { stroke:#333; }
  .rfg-axis { stroke:#666; }
  .rfg-va { stroke:#f47067; }
  .rfg-ha { stroke:#7ee787; }
  .rfg-curve { stroke:#58a6ff; }
  .rfg-zero { fill:#f0883e; }
  .rfg-va-lbl { fill:#f47067; font-family:'Libre Baskerville',Georgia,serif; }
  .rfg-ha-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .rfg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .rfg-axis { stroke:#999; }
  :global([data-theme="light"]) .rfg-va { stroke:#cf222e; }
  :global([data-theme="light"]) .rfg-ha { stroke:#116329; }
  :global([data-theme="light"]) .rfg-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .rfg-zero { fill:#b35900; }
  :global([data-theme="light"]) .rfg-va-lbl { fill:#cf222e; }
  :global([data-theme="light"]) .rfg-ha-lbl { fill:#116329; }
</style>
