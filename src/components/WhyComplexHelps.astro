---
/**
 * WhyComplexHelps — the radius of convergence of the Taylor series for
 * 1/(1+x²) about 0 is 1, and nothing on the real line explains why. The poles
 * at ±i do. Both the real graph and the pole positions are computed here, and
 * the radius is read off as the distance from the centre to the nearest pole.
 */
const w = 540;
const h = 300;

// ---- left panel: the real graph, smooth everywhere ----
const lL = 34;
const lR = 246;
const axisY = 150;
const topY = 66;

const f = (x: number) => 1 / (1 + x * x);
const xLo = -4;
const xHi = 4;
const lpx = (x: number) => lL + ((x - xLo) / (xHi - xLo)) * (lR - lL);
const lpy = (y: number) => axisY - y * (axisY - topY);

const curve = Array.from({ length: 201 }, (_, i) => {
  const x = xLo + (i / 200) * (xHi - xLo);
  return `${lpx(x).toFixed(1)},${lpy(f(x)).toFixed(1)}`;
}).join(" ");

// ---- right panel: the plane, with the poles of 1/(1+z²) ----
const cx = 395;
const cy = 118;
const unit = 32; // pixels per unit length
// 1 + z² = 0 ⟺ z = ±i
const poles = [
  { re: 0, im: 1, label: "i" },
  { re: 0, im: -1, label: "−i" },
];
const radius = Math.min(...poles.map((p) => Math.hypot(p.re, p.im)));
const ppx = (re: number) => cx + re * unit;
const ppy = (im: number) => cy - im * unit;
---

<figure
  class="wch"
  role="img"
  aria-label={`On the left, the graph of 1 over 1 plus x squared is smooth for every real x, giving no hint of any obstruction. On the right, the same function viewed in the complex plane has poles at i and minus i, each at distance ${radius} from the origin, which is exactly the radius of convergence of its Taylor series about zero.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="wch-head" font-size="12.5" font-weight="bold">The real line hides the reason</text>
    <text x="16" y="38" class="wch-sub" font-size="10.5">f(z) = 1 ⁄ (1 + z²), and why its Taylor series about 0 stops at radius 1</text>

    <line x1="270" y1="52" x2="270" y2="236" class="wch-divide" />

    {/* ---------- left: real graph ---------- */}
    <text x={(lL + lR) / 2} y="54" class="wch-panel" font-size="10" text-anchor="middle">on ℝ: smooth everywhere</text>
    <line x1={lL - 6} y1={axisY} x2={lR + 6} y2={axisY} class="wch-axis" />
    <line x1={lpx(0)} y1={topY - 4} x2={lpx(0)} y2={axisY + 4} class="wch-axis" />
    <polyline points={curve} class="wch-curve" fill="none" />
    <text x={lpx(0)} y="168" class="wch-tick" font-size="9.5" text-anchor="middle">0</text>
    <text x={lpx(-4)} y="168" class="wch-tick" font-size="9.5" text-anchor="middle">−4</text>
    <text x={lpx(4)} y="168" class="wch-tick" font-size="9.5" text-anchor="middle">4</text>
    <text x={(lL + lR) / 2} y="192" class="wch-note" font-size="9.5" text-anchor="middle">No asymptote, no corner, no kink</text>
    <text x={(lL + lR) / 2} y="208" class="wch-note" font-size="9.5" text-anchor="middle">Nothing here explains a radius of 1</text>

    {/* ---------- right: the plane ---------- */}
    <text x={cx} y="54" class="wch-panel" font-size="10" text-anchor="middle">on ℂ: two poles</text>
    <line x1={cx - 3.1 * unit} y1={cy} x2={cx + 3.1 * unit} y2={cy} class="wch-axis" />
    <line x1={cx} y1={cy - 1.6 * unit} x2={cx} y2={cy + 1.6 * unit} class="wch-axis" />

    {/* the disc of convergence: radius = distance to the nearest pole */}
    <circle cx={cx} cy={cy} r={radius * unit} class="wch-disc" />
    <line x1={cx} y1={cy} x2={ppx(radius * Math.SQRT1_2)} y2={ppy(radius * Math.SQRT1_2)} class="wch-radius" />

    {poles.map((p) => (
      <g>
        <line x1={ppx(p.re) - 5} y1={ppy(p.im) - 5} x2={ppx(p.re) + 5} y2={ppy(p.im) + 5} class="wch-pole" />
        <line x1={ppx(p.re) - 5} y1={ppy(p.im) + 5} x2={ppx(p.re) + 5} y2={ppy(p.im) - 5} class="wch-pole" />
      </g>
    ))}
    <text x={ppx(0) + 16} y={ppy(1) - 8} class="wch-plbl" font-size="9.5" text-anchor="start">pole at i</text>
    <text x={ppx(0) + 16} y={ppy(-1) + 14} class="wch-plbl" font-size="9.5" text-anchor="start">pole at −i</text>
    <text x={cx - 8} y={cy + 14} class="wch-tick" font-size="9.5" text-anchor="end">0</text>

    <text x={cx} y="192" class="wch-note" font-size="9.5" text-anchor="middle">{`Nearest singularity is ${radius.toFixed(0)} away`}</text>
    <text x={cx} y="208" class="wch-note" font-size="9.5" text-anchor="middle">So the series converges exactly on that disc</text>

    <text x={w / 2} y="252" class="wch-foot" font-size="10.5" text-anchor="middle">
      {`R = distance from the centre to the nearest singularity = ${radius.toFixed(0)}`}
    </text>
    <text x={w / 2} y="272" class="wch-sub2" font-size="9.5" text-anchor="middle">
      A real-variable question with no real-variable answer, settled by looking off the line
    </text>
    <text x={w / 2} y="288" class="wch-sub2" font-size="9.5" text-anchor="middle">
      This is the pattern of the whole section: the plane explains the line
    </text>
  </svg>
</figure>

<style>
  .wch { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .wch svg { width:100%; max-width:100%; height:auto; }
  .wch-axis { stroke:#888; stroke-width:1.3; }
  .wch-divide { stroke:#3a3a3a; stroke-width:1; }
  .wch-curve { stroke:#58a6ff; stroke-width:2.2; }
  .wch-disc { fill:#58a6ff; fill-opacity:0.1; stroke:#58a6ff; stroke-width:1.4; stroke-dasharray:5,4; }
  .wch-radius { stroke:#7ee787; stroke-width:1.8; }
  .wch-pole { stroke:#ff7b72; stroke-width:2.2; }
  .wch-plbl { fill:#ff7b72; font-family:'Libre Baskerville',Georgia,serif; }
  .wch-tick, .wch-note { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .wch-panel, .wch-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .wch-sub, .wch-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .wch-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .wch-axis { stroke:#666; }
  :global([data-theme="light"]) .wch-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .wch-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .wch-disc { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .wch-foot { fill:#0550ae; }
  :global([data-theme="light"]) .wch-radius { stroke:#116329; }
  :global([data-theme="light"]) .wch-pole { stroke:#a40e26; }
  :global([data-theme="light"]) .wch-plbl { fill:#a40e26; }
  :global([data-theme="light"]) .wch-panel, :global([data-theme="light"]) .wch-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.wch-tick, .wch-note, .wch-sub, .wch-sub2) { fill:#57606a; }
</style>
