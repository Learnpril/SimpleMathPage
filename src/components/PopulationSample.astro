---
/**
 * PopulationSample - a large population of dots with a small random subset
 * highlighted as the sample, plus the parameter/statistic labels.
 */
const w = 520;
const h = 250;
// Deterministic pseudo-random layout so the figure is stable between builds
const cols = 16;
const rows = 9;
const dots: { x: number; y: number; sampled: boolean }[] = [];
const sampledIndices = new Set([7, 19, 33, 46, 58, 71, 84, 97, 110, 123, 136]);
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const i = r * cols + c;
    // small deterministic jitter from a sine hash, keeps it from looking like a grid
    const jx = Math.sin(i * 12.9898) * 4;
    const jy = Math.cos(i * 78.233) * 4;
    dots.push({
      x: 30 + c * 27 + jx,
      y: 58 + r * 19 + jy,
      sampled: sampledIndices.has(i),
    });
  }
}
const sampleCount = dots.filter((d) => d.sampled).length;
---

<figure
  class="pops"
  role="img"
  aria-label={`A population of ${dots.length} individuals shown as small dots, with ${sampleCount} of them highlighted as a randomly selected sample`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Population boundary */}
    <rect x="16" y="42" width={w - 32} height="176" rx="8" class="pops-frame" />
    <text x="24" y="34" class="pops-poplabel" font-size="12.5" font-weight="bold">
      {`Population (N = ${dots.length})`}
    </text>
    <text x="200" y="34" class="pops-note" font-size="10.5">too large or costly to measure entirely</text>

    {/* Dots */}
    {dots.map((d) =>
      d.sampled ? (
        <circle cx={d.x} cy={d.y} r="5.5" class="pops-dot-sample" />
      ) : (
        <circle cx={d.x} cy={d.y} r="3" class="pops-dot" />
      ),
    )}

    {/* Legend and takeaway */}
    <circle cx="30" cy="232" r="3" class="pops-dot" />
    <text x="40" y="236" class="pops-legend" font-size="10">not measured</text>
    <circle cx="140" cy="232" r="5.5" class="pops-dot-sample" />
    <text x="152" y="236" class="pops-legend" font-size="10">
      {`in the sample (n = ${sampleCount})`}
    </text>
    <text x={w - 20} y="236" class="pops-arrow-lbl" font-size="10.5" text-anchor="end">
      statistic x̄ estimates parameter μ
    </text>
  </svg>
</figure>

<style>
  .pops { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .pops svg { width:100%; max-width:100%; height:auto; }
  .pops-frame { fill:none; stroke:#555; stroke-width:1.5; }
  .pops-dot { fill:#666; }
  .pops-dot-sample { fill:#7ee787; stroke:#7ee787; stroke-width:1.5; }
  .pops-poplabel { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .pops-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pops-legend { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .pops-arrow-lbl { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .pops-frame { stroke:#ccc; }
  :global([data-theme="light"]) .pops-dot { fill:#bbb; }
  :global([data-theme="light"]) .pops-dot-sample { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .pops-poplabel { fill:#0550ae; }
  :global([data-theme="light"]) .pops-arrow-lbl { fill:#6639ba; }
</style>
