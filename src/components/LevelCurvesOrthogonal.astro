---
/**
 * LevelCurvesOrthogonal — for an analytic f = u + iv, the level curves of u and
 * of v meet at right angles. Both families are traced by marching along the
 * curves of f(z) = z², and the crossing angle at a sample intersection is
 * computed from the gradients rather than claimed.
 */
const w = 540;
const h = 296;

const cx = 262;
const cy = 158;
const unit = 46;
const xr = 2.5; // half-width in units
const yr = 1.4;

const px = (x: number) => cx + x * unit;
const py = (y: number) => cy - y * unit;

// f(z) = z²: u = x² − y², v = 2xy
const u = (x: number, y: number) => x * x - y * y;
const v = (x: number, y: number) => 2 * x * y;

/** Level curve u = c is the hyperbola x² − y² = c; trace it as two branches. */
function uCurve(c: number, sign: 1 | -1) {
  const pts: string[] = [];
  for (let i = 0; i <= 80; i++) {
    const y = -yr + (i / 80) * (2 * yr);
    const x2 = c + y * y;
    if (x2 < 0) continue;
    const x = sign * Math.sqrt(x2);
    if (Math.abs(x) > xr) continue;
    pts.push(`${px(x).toFixed(1)},${py(y).toFixed(1)}`);
  }
  return pts.length > 1 ? pts.join(" ") : null;
}

/** Level curve v = k is the hyperbola 2xy = k, that is y = k/(2x). */
function vCurve(k: number, sign: 1 | -1) {
  const pts: string[] = [];
  for (let i = 0; i <= 120; i++) {
    const x = sign * (0.08 + (i / 120) * (xr - 0.08));
    const y = k / (2 * x);
    if (Math.abs(y) > yr) continue;
    pts.push(`${px(x).toFixed(1)},${py(y).toFixed(1)}`);
  }
  return pts.length > 1 ? pts.join(" ") : null;
}

const uLevels = [-1.6, -0.7, 0.7, 1.6, 3.2];
const vLevels = [-3, -1.5, 1.5, 3];
const uPaths = uLevels.flatMap((c) => [uCurve(c, 1), uCurve(c, -1)]).filter((p): p is string => p !== null);
const vPaths = vLevels.flatMap((k) => [vCurve(k, 1), vCurve(k, -1)]).filter((p): p is string => p !== null);

// Measure the crossing angle where u = 1 meets v = 1.5.
// x² − y² = 1 and 2xy = 1.5 → solve numerically for the first-quadrant point.
function crossing(c: number, k: number) {
  let x = 1.4;
  for (let i = 0; i < 200; i++) {
    // Newton on g(x) = x² − (k/(2x))² − c
    const y = k / (2 * x);
    const g = x * x - y * y - c;
    const gp = 2 * x + (k * k) / (2 * x * x * x);
    x -= g / gp;
  }
  return { x, y: k / (2 * x) };
}
const P = crossing(1.6, 1.5);
// Gradients of u and v at P
const gu = { x: 2 * P.x, y: -2 * P.y };
const gv = { x: 2 * P.y, y: 2 * P.x };
const dot = gu.x * gv.x + gu.y * gv.y;
const angle =
  (Math.acos(dot / (Math.hypot(gu.x, gu.y) * Math.hypot(gv.x, gv.y))) * 180) / Math.PI;
---

<figure
  class="lco"
  role="img"
  aria-label={`Two families of hyperbolas filling the plane: the level curves of the real part of z squared and those of the imaginary part. At the sampled intersection the two gradients meet at ${angle.toFixed(1)} degrees, so the families are orthogonal.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="lco-head" font-size="12.5" font-weight="bold">The two halves always cross at right angles</text>
    <text x="16" y="38" class="lco-sub" font-size="10.5">Level curves of u = x² − y² and v = 2xy, the parts of f(z) = z²</text>

    <line x1={px(-xr) - 6} y1={cy} x2={px(xr) + 6} y2={cy} class="lco-axis" />
    <line x1={cx} y1={py(yr) - 6} x2={cx} y2={py(-yr) + 6} class="lco-axis" />

    {uPaths.map((d) => <polyline points={d} class="lco-u" fill="none" />)}
    {vPaths.map((d) => <polyline points={d} class="lco-v" fill="none" />)}

    {/* the sampled intersection, with both gradient directions drawn */}
    <line
      x1={px(P.x)}
      y1={py(P.y)}
      x2={px(P.x + (0.5 * gu.x) / Math.hypot(gu.x, gu.y))}
      y2={py(P.y + (0.5 * gu.y) / Math.hypot(gu.x, gu.y))}
      class="lco-gu"
    />
    <line
      x1={px(P.x)}
      y1={py(P.y)}
      x2={px(P.x + (0.5 * gv.x) / Math.hypot(gv.x, gv.y))}
      y2={py(P.y + (0.5 * gv.y) / Math.hypot(gv.x, gv.y))}
      class="lco-gv"
    />
    <circle cx={px(P.x)} cy={py(P.y)} r="4" class="lco-dot" />

    <text x="26" y="240" class="lco-key-u" font-size="9.5" text-anchor="start">u = constant</text>
    <text x="26" y="256" class="lco-key-v" font-size="9.5" text-anchor="start">v = constant</text>
    <text x={w - 26} y="240" class="lco-val" font-size="9.5" text-anchor="end">{`sampled crossing at (${P.x.toFixed(2)}, ${P.y.toFixed(2)})`}</text>
    <text x={w - 26} y="256" class="lco-val" font-size="9.5" text-anchor="end">{`gradients meet at ${angle.toFixed(1)}°`}</text>

    <text x={w / 2} y="278" class="lco-foot" font-size="10.5" text-anchor="middle">
      ∇u · ∇v = uₓvₓ + u_yv_y = 0 by the Cauchy–Riemann equations
    </text>
    <text x={w / 2} y="292" class="lco-sub2" font-size="9.5" text-anchor="middle">
      In physics these are the equipotentials and the field lines of the same problem
    </text>
  </svg>
</figure>

<style>
  .lco { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .lco svg { width:100%; max-width:100%; height:auto; }
  .lco-axis { stroke:#888; stroke-width:1.3; }
  .lco-u { stroke:#58a6ff; stroke-width:1.6; }
  .lco-v { stroke:#f0883e; stroke-width:1.6; }
  .lco-gu { stroke:#58a6ff; stroke-width:2.6; }
  .lco-gv { stroke:#f0883e; stroke-width:2.6; }
  .lco-dot { fill:#7ee787; stroke:#eee; stroke-width:1.2; }
  .lco-key-u { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .lco-key-v { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .lco-val { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .lco-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .lco-sub, .lco-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .lco-foot { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .lco-axis { stroke:#666; }
  :global([data-theme="light"]) :is(.lco-u, .lco-gu) { stroke:#0550ae; }
  :global([data-theme="light"]) .lco-key-u { fill:#0550ae; }
  :global([data-theme="light"]) :is(.lco-v, .lco-gv) { stroke:#b35900; }
  :global([data-theme="light"]) .lco-key-v { fill:#b35900; }
  :global([data-theme="light"]) .lco-dot { fill:#116329; stroke:#fff; }
  :global([data-theme="light"]) .lco-foot { fill:#116329; }
  :global([data-theme="light"]) .lco-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.lco-val, .lco-sub, .lco-sub2) { fill:#57606a; }
</style>
