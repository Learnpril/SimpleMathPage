---
/**
 * FiniteFieldOrders - which orders a finite field can have. There is a field of
 * order n exactly when n is a prime power, and the classification is computed
 * here by factoring each n rather than being listed by hand.
 */
const from = 2;
const to = 16;
const sup = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"];

function primePower(n: number) {
  for (let p = 2; p <= n; p++) {
    let m = n;
    let k = 0;
    while (m % p === 0) {
      m /= p;
      k++;
    }
    if (k > 0) return m === 1 ? { p, k } : null;
  }
  return null;
}

const items = Array.from({ length: to - from + 1 }, (_, i) => {
  const n = from + i;
  const pp = primePower(n);
  return {
    n,
    exists: pp !== null,
    label: pp ? (pp.k === 1 ? `${pp.p}` : `${pp.p}${sup[pp.k]}`) : "none",
  };
});

const missing = items.filter((i) => !i.exists).map((i) => i.n);

const w = 540;
const h = 200;
const gap = 34;
const boxW = 26;
const startX = (w - (items.length - 1) * gap) / 2;
const rowY = 70;
const boxH = 30;
---

<figure
  class="ffo"
  role="img"
  aria-label={`A row of the integers from ${from} to ${to} showing which are orders of finite fields. A field of order n exists exactly when n is a prime power, so ${missing.join(", ")} have none.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="ffo-head" font-size="12.5" font-weight="bold">Which orders can a finite field have?</text>
    <text x="16" y="42" class="ffo-sub" font-size="10.5">A field of order n exists exactly when n is a prime power</text>

    {items.map((it, i) => {
      const cx = startX + i * gap;
      return (
        <g>
          <rect
            x={cx - boxW / 2}
            y={rowY}
            width={boxW}
            height={boxH}
            rx="5"
            class={it.exists ? "ffo-box ffo-yes" : "ffo-box ffo-no"}
          />
          <text x={cx} y={rowY + 20} class={it.exists ? "ffo-n ffo-t-yes" : "ffo-n ffo-t-no"} font-size="11" text-anchor="middle" font-weight="bold">
            {it.n}
          </text>
          <text x={cx} y={rowY + 46} class={it.exists ? "ffo-pp ffo-t-yes" : "ffo-pp ffo-t-no"} font-size="9.5" text-anchor="middle">
            {it.exists ? it.label : "✗"}
          </text>
        </g>
      );
    })}

    <text x={w / 2} y="152" class="ffo-foot" font-size="10.5" text-anchor="middle">
      {`No field has order ${missing.slice(0, -1).join(", ")} or ${missing[missing.length - 1]}, since none is a prime power`}
    </text>
    <text x={w / 2} y="172" class="ffo-sub2" font-size="9.5" text-anchor="middle">
      For every prime power there is exactly one field of that order, up to isomorphism
    </text>
    <text x={w / 2} y="190" class="ffo-sub2" font-size="9.5" text-anchor="middle">
      GF(4) is not ℤ₄: it has characteristic 2, and ℤ₄ is not even a field
    </text>
  </svg>
</figure>

<style>
  .ffo { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ffo svg { width:100%; max-width:100%; height:auto; }
  .ffo-box { stroke-width:1.7; }
  .ffo-yes { fill:#7ee787; fill-opacity:0.16; stroke:#7ee787; }
  .ffo-no { fill:none; stroke:#8b949e; stroke-dasharray:4,3; }
  .ffo-n, .ffo-pp { font-family:'Libre Baskerville',Georgia,serif; }
  .ffo-t-yes { fill:#7ee787; }
  .ffo-t-no { fill:#8b949e; }
  .ffo-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .ffo-sub, .ffo-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .ffo-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .ffo-yes, :global([data-theme="light"]) .ffo-t-yes { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .ffo-yes { fill-opacity:0.12; }
  :global([data-theme="light"]) .ffo-no { stroke:#8b949e; fill:none; }
  :global([data-theme="light"]) .ffo-t-no { fill:#57606a; }
  :global([data-theme="light"]) .ffo-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.ffo-sub, .ffo-sub2) { fill:#57606a; }
  :global([data-theme="light"]) .ffo-foot { fill:#0550ae; }
</style>
