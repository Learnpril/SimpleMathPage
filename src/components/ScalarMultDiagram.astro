---
/**
 * ScalarMultDiagram - shows scalar multiplication: v, 2v, -v
 * v = <2, 1>, 2v = <4, 2>, -v = <-2, -1>
 * Dual-theme with polygon arrowheads.
 */
---
<div class="diagram-container">
<svg viewBox="-130 -30 420 250" width="100%" style="max-width:500px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Scalar multiplication: v, 2v, and negative v">

  <!-- Grid -->
  <g stroke="#333" stroke-width="0.5" opacity="0.2">
    <line x1="-100" y1="0" x2="200" y2="0" /><line x1="-100" y1="40" x2="200" y2="40" />
    <line x1="-100" y1="80" x2="200" y2="80" /><line x1="-100" y1="120" x2="200" y2="120" />
    <line x1="-100" y1="160" x2="200" y2="160" />
    <line x1="-80" y1="-20" x2="-80" y2="170" /><line x1="-40" y1="-20" x2="-40" y2="170" />
    <line x1="0" y1="-20" x2="0" y2="170" /><line x1="40" y1="-20" x2="40" y2="170" />
    <line x1="80" y1="-20" x2="80" y2="170" /><line x1="120" y1="-20" x2="120" y2="170" />
    <line x1="160" y1="-20" x2="160" y2="170" /><line x1="200" y1="-20" x2="200" y2="170" />
  </g>

  <!-- Axes through origin at (0, 120) -->
  <line x1="-105" y1="120" x2="210" y2="120" stroke="#888" stroke-width="1.2" />
  <line x1="0" y1="170" x2="0" y2="-20" stroke="#888" stroke-width="1.2" />

  <!-- Scale: 40px per unit. Origin at (0, 120). y flipped. -->
  <!-- v = (2,1): endpoint (80, 80) -->
  <!-- 2v = (4,2): endpoint (160, 40) -->
  <!-- -v = (-2,-1): endpoint (-80, 160) -->

  <!-- Vector 2v (green) - drawn first so v appears on top -->
  <line x1="0" y1="120" x2="149.3" y2="45.4" stroke="#7ee787" stroke-width="2.5" />
  <polygon points="160,40 151.5,49.9 147.1,40.9" class="sm-green-arrow" fill="#7ee787" />

  <!-- Vector v (blue) - drawn on top of 2v -->
  <line x1="0" y1="120" x2="69.3" y2="85.4" stroke="#58a6ff" stroke-width="2.5" />
  <polygon points="80,80 71.5,89.9 67.1,80.9" class="sm-blue-arrow" fill="#58a6ff" />

  <!-- Vector -v (orange) -->
  <line x1="0" y1="120" x2="-69.3" y2="154.6" stroke="#f0883e" stroke-width="2.5" />
  <polygon points="-80,160 -71.5,150.1 -67.1,159.1" class="sm-orange-arrow" fill="#f0883e" />

  <!-- Labels -->
  <text x="55" y="78" fill="#58a6ff" font-size="13" font-weight="bold" font-family="serif">v</text>
  <text x="140" y="32" fill="#7ee787" font-size="13" font-weight="bold" font-family="serif">2v</text>
  <text x="-75" y="175" fill="#f0883e" font-size="13" font-weight="bold" font-family="serif">-v</text>

  <!-- Origin dot -->
  <circle cx="0" cy="120" r="3" fill="#999" />

  <!-- Legend -->
  <g transform="translate(-110, 195)">
    <line x1="5" y1="0" x2="20" y2="0" stroke="#58a6ff" stroke-width="2.5" />
    <text x="25" y="4" fill="#58a6ff" font-size="9" font-family="serif">v = &#x27E8;2, 1&#x27E9;</text>
    <line x1="105" y1="0" x2="120" y2="0" stroke="#7ee787" stroke-width="2.5" />
    <text x="125" y="4" fill="#7ee787" font-size="9" font-family="serif">2v (longer, same direction)</text>
    <line x1="255" y1="0" x2="270" y2="0" stroke="#f0883e" stroke-width="2.5" />
    <text x="275" y="4" fill="#f0883e" font-size="9" font-family="serif">-v (reversed)</text>
  </g>
</svg>
</div>

<style>
  .sm-blue-arrow { fill: #58a6ff; }
  .sm-green-arrow { fill: #7ee787; }
  .sm-orange-arrow { fill: #f0883e; }
  :global([data-theme="light"]) .sm-blue-arrow { fill: #0550ae; }
  :global([data-theme="light"]) .sm-green-arrow { fill: #1a7f2e; }
  :global([data-theme="light"]) .sm-orange-arrow { fill: #c05010; }
  :global([data-theme="light"]) svg text[fill="#58a6ff"] { fill: #0550ae; }
  :global([data-theme="light"]) svg text[fill="#7ee787"] { fill: #1a7f2e; }
  :global([data-theme="light"]) svg text[fill="#f0883e"] { fill: #c05010; }
  :global([data-theme="light"]) svg line[stroke="#58a6ff"] { stroke: #0550ae; }
  :global([data-theme="light"]) svg line[stroke="#7ee787"] { stroke: #1a7f2e; }
  :global([data-theme="light"]) svg line[stroke="#f0883e"] { stroke: #c05010; }
  :global([data-theme="light"]) svg line[stroke="#888"] { stroke: #bbb; }
  :global([data-theme="light"]) svg g[opacity="0.2"] line { stroke: #ccc; }
  :global([data-theme="light"]) svg circle[fill="#999"] { fill: #777; }
</style>
