---
/**
 * BayesGrid - the base rate fallacy made visible. 100,000 people, a disease
 * affecting 1 in 1,000, and a 99% accurate test. The false positives visually
 * dominate the true positives, which is why a positive result means only ~9%.
 */
const population = 100000;
const prevalence = 0.001;
const accuracy = 0.99;

const diseased = population * prevalence; // 100
const healthy = population - diseased; // 99,900
const truePos = Math.round(diseased * accuracy); // 99
const falseNeg = diseased - truePos; // 1
const falsePos = Math.round(healthy * (1 - accuracy)); // 999
const trueNeg = healthy - falsePos; // 98,901
const allPositives = truePos + falsePos;
const ppv = truePos / allPositives;

const w = 540;
const h = 300;
// Bar showing the composition of everyone who tests positive
const barX = 40;
const barY = 168;
const barW = 460;
const barH = 40;
const tpW = (truePos / allPositives) * barW;
---

<figure
  class="byg"
  role="img"
  aria-label={`Of 100,000 people with a disease affecting 1 in 1,000 and a 99% accurate test, ${truePos} are true positives and ${falsePos} are false positives, so only about ${(ppv * 100).toFixed(0)} percent of positive results indicate disease`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="byg-head" font-size="12.5" font-weight="bold">Why a positive test often means very little</text>
    <text x="16" y="38" class="byg-sub" font-size="10">
      100,000 people · disease affects 1 in 1,000 · test is 99% accurate both ways
    </text>

    {/* Two-way table */}
    <text x="150" y="66" class="byg-colhdr byg-t-orange" font-size="10" text-anchor="middle">has disease</text>
    <text x="290" y="66" class="byg-colhdr byg-t-blue" font-size="10" text-anchor="middle">healthy</text>
    <text x="410" y="66" class="byg-colhdr" font-size="10" text-anchor="middle">row total</text>

    <text x="86" y="90" class="byg-rowhdr" font-size="10" text-anchor="end">tests +</text>
    <text x="150" y="90" class="byg-cell byg-t-green" font-size="12" text-anchor="middle" font-weight="bold">{truePos}</text>
    <text x="290" y="90" class="byg-cell byg-t-orange" font-size="12" text-anchor="middle" font-weight="bold">{falsePos}</text>
    <text x="410" y="90" class="byg-cell" font-size="12" text-anchor="middle">{allPositives}</text>

    <text x="86" y="114" class="byg-rowhdr" font-size="10" text-anchor="end">tests −</text>
    <text x="150" y="114" class="byg-cell byg-dim" font-size="12" text-anchor="middle">{falseNeg}</text>
    <text x="290" y="114" class="byg-cell byg-dim" font-size="12" text-anchor="middle">{trueNeg.toLocaleString()}</text>
    <text x="410" y="114" class="byg-cell byg-dim" font-size="12" text-anchor="middle">{(falseNeg + trueNeg).toLocaleString()}</text>

    <line x1="96" y1="122" x2="450" y2="122" class="byg-rule" />
    <text x="86" y="138" class="byg-rowhdr" font-size="10" text-anchor="end">total</text>
    <text x="150" y="138" class="byg-cell" font-size="11" text-anchor="middle">{diseased}</text>
    <text x="290" y="138" class="byg-cell" font-size="11" text-anchor="middle">{healthy.toLocaleString()}</text>
    <text x="410" y="138" class="byg-cell" font-size="11" text-anchor="middle">{population.toLocaleString()}</text>

    {/* Composition bar of everyone who tested positive */}
    <text x={barX} y={barY - 8} class="byg-barlbl" font-size="10">
      {`everyone who tests positive (${allPositives} people):`}
    </text>
    <rect x={barX} y={barY} width={tpW} height={barH} class="byg-tp" />
    <rect x={barX + tpW} y={barY} width={barW - tpW} height={barH} class="byg-fp" />
    <rect x={barX} y={barY} width={barW} height={barH} class="byg-baroutline" />

    <text x={barX + tpW / 2} y={barY + barH + 14} class="byg-t-green" font-size="9.5" text-anchor="middle">
      {`${truePos} true +`}
    </text>
    <text x={barX + tpW + (barW - tpW) / 2} y={barY + barH + 14} class="byg-t-orange" font-size="9.5" text-anchor="middle">
      {`${falsePos} false positives`}
    </text>

    {/* Conclusion */}
    <text x={w / 2} y="252" class="byg-result" font-size="13" text-anchor="middle" font-weight="bold">
      {`P(disease | positive) = ${truePos} / ${allPositives} ≈ ${(ppv * 100).toFixed(1)}%`}
    </text>
    <text x={w / 2} y="272" class="byg-foot" font-size="10" text-anchor="middle">
      The test is excellent. There are simply 999 healthy people for every sick one,
    </text>
    <text x={w / 2} y="288" class="byg-foot" font-size="10" text-anchor="middle">
      so a 1% error rate on that huge group swamps the true positives.
    </text>
  </svg>
</figure>

<style>
  .byg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .byg svg { width:100%; max-width:100%; height:auto; }
  .byg-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .byg-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .byg-colhdr, .byg-rowhdr { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .byg-cell { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .byg-dim { fill:#777; }
  .byg-t-green { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .byg-t-orange { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .byg-t-blue { fill:#58a6ff; }
  .byg-rule { stroke:#555; stroke-width:1; }
  .byg-tp { fill:#7ee787; fill-opacity:0.6; }
  .byg-fp { fill:#f0883e; fill-opacity:0.35; }
  .byg-baroutline { fill:none; stroke:#555; stroke-width:1; }
  .byg-barlbl { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .byg-result { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .byg-foot { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .byg-head { fill:#24292f; }
  :global([data-theme="light"]) .byg-colhdr, :global([data-theme="light"]) .byg-rowhdr, :global([data-theme="light"]) .byg-cell { fill:#444; }
  :global([data-theme="light"]) .byg-dim { fill:#888; }
  :global([data-theme="light"]) .byg-t-green { fill:#116329; }
  :global([data-theme="light"]) .byg-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .byg-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .byg-tp { fill:#116329; fill-opacity:0.45; }
  :global([data-theme="light"]) .byg-fp { fill:#b35900; fill-opacity:0.28; }
  :global([data-theme="light"]) .byg-baroutline { stroke:#ccc; }
  :global([data-theme="light"]) .byg-barlbl { fill:#444; }
  :global([data-theme="light"]) .byg-result { fill:#6639ba; }
  :global([data-theme="light"]) .byg-rule { stroke:#ccc; }
</style>
