---
/**
 * CubicExampleGraph — plots f(x) = -2x³ + 5x² - 3x + 1
 * Shows end behavior: left up, right down (odd degree, negative leading coeff)
 */
const w = 320;
const h = 260;
const pad = 35;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -1, xMax = 3.2, yMin = -4, yMax = 6;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const f = (x: number) => -2 * x * x * x + 5 * x * x - 3 * x + 1;
const pts: string[] = [];
for (let x = -0.6; x <= 2.9; x += 0.05) {
  const y = f(x);
  if (y >= yMin - 1 && y <= yMax + 1) pts.push(`${sx(x).toFixed(1)},${sy(y).toFixed(1)}`);
}
---

<figure class="ceg" role="img" aria-label="Graph of f(x) = -2x³ + 5x² - 3x + 1 showing end behavior">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[-2, -1, 0, 1, 2, 3, 4, 5].map(v => (
      <g>
        {v >= xMin && v <= xMax && <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="ceg-grid" stroke-width="0.5" />}
        {v >= yMin && v <= yMax && <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="ceg-grid" stroke-width="0.5" />}
      </g>
    ))}
    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="ceg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="ceg-axis" stroke-width="1.5" />
    {/* Curve */}
    <polyline points={pts.join(' ')} fill="none" class="ceg-curve" stroke-width="2.5" />
    {/* y-intercept dot */}
    <circle cx={sx(0)} cy={sy(1)} r="4" class="ceg-dot" />
    {/* Labels */}
    <text class="ceg-lbl" x={sx(1.8)} y={sy(5)} font-size="11" font-weight="bold">f(x) = -2x³ + 5x² - 3x + 1</text>
    <text class="ceg-dot-lbl" x={sx(0) + 8} y={sy(1) - 8} font-size="10">(0, 1)</text>
    {/* End behavior arrows */}
    <text class="ceg-arrow" x={sx(-0.4)} y={sy(4.5)} font-size="14">↗</text>
    <text class="ceg-arrow" x={sx(2.7)} y={sy(-2.5)} font-size="14">↘</text>
  </svg>
</figure>

<style>
  .ceg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ceg svg { max-width:100%; height:auto; }
  .ceg-grid { stroke:#333; }
  .ceg-axis { stroke:#666; }
  .ceg-curve { stroke:#58a6ff; }
  .ceg-dot { fill:#f0883e; }
  .ceg-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ceg-dot-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .ceg-arrow { fill:#7ee787; font-family:sans-serif; }
  :global([data-theme="light"]) .ceg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .ceg-axis { stroke:#999; }
  :global([data-theme="light"]) .ceg-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .ceg-dot { fill:#b35900; }
  :global([data-theme="light"]) .ceg-lbl { fill:#0550ae; }
  :global([data-theme="light"]) .ceg-dot-lbl { fill:#b35900; }
  :global([data-theme="light"]) .ceg-arrow { fill:#116329; }
</style>
