---
/**
 * PascalTriangle — rows 0 through 6 of the binomial coefficients, with row 4
 * highlighted to connect it to the expansion of (x + y)^4.
 * Each entry is the sum of the two above it, which is Pascal's identity.
 */
const rows = 7;
const dx = 48;
const dy = 33;
const w = 520;
const h = 300;
const startY = 46;
const cx = w / 2 + 18;

// Build the triangle
const tri: number[][] = [];
for (let i = 0; i < rows; i++) {
  const row: number[] = [];
  for (let j = 0; j <= i; j++) {
    row.push(j === 0 || j === i ? 1 : tri[i - 1][j - 1] + tri[i - 1][j]);
  }
  tri.push(row);
}
const HL = 4; // highlighted row
const px = (i: number, j: number) => cx + (j - i / 2) * dx;
const py = (i: number) => startY + i * dy;
---

<figure
  class="pst"
  role="img"
  aria-label="Pascal's triangle rows 0 through 6, with row 4 reading 1, 4, 6, 4, 1 highlighted. Each entry is the sum of the two entries above it."
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="14" y="24" class="pst-head" font-size="12.5" font-weight="bold">Pascal's triangle</text>
    <text x="150" y="24" class="pst-sub" font-size="10.5">each entry = the two above it, added</text>

    {/* Lines showing Pascal's identity into the highlighted row's middle entry */}
    <line x1={px(HL - 1, 1)} y1={py(HL - 1) + 6} x2={px(HL, 2) - 4} y2={py(HL) - 10} class="pst-link" />
    <line x1={px(HL - 1, 2)} y1={py(HL - 1) + 6} x2={px(HL, 2) + 4} y2={py(HL) - 10} class="pst-link" />

    {/* Entries */}
    {tri.map((row, i) => (
      <g>
        <text x="24" y={py(i) + 4} class="pst-n" font-size="10">{`n = ${i}`}</text>
        {row.map((v, j) => (
          <text
            x={px(i, j)}
            y={py(i) + 5}
            class={i === HL ? "pst-val pst-hl" : "pst-val"}
            font-size={i === HL ? "15" : "13.5"}
            font-weight={i === HL ? "bold" : "normal"}
            text-anchor="middle"
          >{v}</text>
        ))}
      </g>
    ))}

    {/* Callout for the highlighted row */}
    <text x={px(HL, HL) + 30} y={py(HL) + 5} class="pst-call" font-size="10.5">← (x + y)⁴</text>

    {/* Callout for C(4,2) */}
    <text x={px(HL, 2)} y={py(HL) + 22} class="pst-pick" font-size="9.5" text-anchor="middle">C(4,2)</text>

    <text x={w / 2} y="272" class="pst-foot" font-size="11" text-anchor="middle">
      Row n holds C(n,0) through C(n,n), and every row is a mirror image of itself
    </text>
    <text x={w / 2} y="288" class="pst-sub2" font-size="10" text-anchor="middle">
      Row 4 sums to 1 + 4 + 6 + 4 + 1 = 16 = 2⁴, the number of subsets of a 4-element set
    </text>
  </svg>
</figure>

<style>
  .pst { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .pst svg { max-width:100%; height:auto; }
  .pst-val { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .pst-hl { fill:#7ee787; }
  .pst-n { fill:#666; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pst-head { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .pst-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pst-sub2 { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pst-link { stroke:#d2a8ff; stroke-width:1.3; stroke-dasharray:3,2; }
  .pst-call { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pst-pick { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .pst-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .pst-val { fill:#666; }
  :global([data-theme="light"]) .pst-hl { fill:#116329; }
  :global([data-theme="light"]) .pst-head { fill:#0550ae; }
  :global([data-theme="light"]) .pst-link { stroke:#6639ba; }
  :global([data-theme="light"]) .pst-call { fill:#116329; }
  :global([data-theme="light"]) .pst-pick { fill:#6639ba; }
  :global([data-theme="light"]) .pst-foot { fill:#b35900; }
</style>
