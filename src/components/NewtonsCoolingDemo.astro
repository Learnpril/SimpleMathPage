---
/**
 * NewtonsCoolingDemo - Shows cooling and warming curves approaching ambient.
 * Red: T = 22 + 68*e^{-0.05t} (hot coffee cooling from 90 to 22)
 * Blue: T = 22 - 18*e^{-0.05t} (cold object warming from 4 to 22)
 * Dashed: ambient temperature T_a = 22
 * Legend below chart.
 */

const ox = 50, oy = 240, sx = 5.2, sy = 2.6;
const toPx = (t: number) => ox + t * sx;
const toPy = (T: number) => oy - T * sy;
const X0 = 30, X1 = 390, Y0 = 12, Y1 = 260;

function curve(f: (t: number) => number, tmin: number, tmax: number, step = 0.3) {
  const pts: [number, number][] = [];
  for (let t = tmin; t <= tmax + 1e-9; t += step) {
    const px = toPx(t), py = toPy(f(t));
    if (px >= X0 && px <= X1 && py >= Y0 && py <= Y1) pts.push([px, py]);
  }
  return pts;
}
const ptsStr = (pts: [number, number][]) => pts.map(p => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

const Ta = 22;
const cooling = curve(t => Ta + 68 * Math.exp(-0.05 * t), 0, 65);
const warming = curve(t => Ta - 18 * Math.exp(-0.05 * t), 0, 65);
---

<figure class="ncd" role="img" aria-label="Newton's Law of Cooling: hot object cooling down and cold object warming up toward ambient temperature">
  <svg viewBox="0 0 400 312" xmlns="http://www.w3.org/2000/svg" class="ncd-svg">
    {/* Grid */}
    <g class="ncd-grid">
      {[0,10,20,30,40,50,60].map(t => toPx(t) <= X1 ? <line x1={toPx(t)} y1={Y0} x2={toPx(t)} y2={Y1} /> : null)}
      {[0,20,40,60,80].map(T => toPy(T) >= Y0 && toPy(T) <= Y1 ? <line x1={X0} y1={toPy(T)} x2={X1} y2={toPy(T)} /> : null)}
    </g>

    {/* Axes */}
    <line x1={X0} y1={toPy(0)} x2={X1} y2={toPy(0)} class="ncd-axis" />
    <line x1={toPx(0)} y1={Y0} x2={toPx(0)} y2={Y1} class="ncd-axis" />
    <text x={X1 + 4} y={toPy(0) + 4} class="ncd-lbl axis">t (min)</text>
    <text x={toPx(0) - 4} y={Y0 + 2} class="ncd-lbl axis" text-anchor="end">T°C</text>

    {/* Y-axis ticks */}
    <text x={toPx(0) - 8} y={toPy(20) + 4} class="ncd-lbl tick" text-anchor="end">20</text>
    <text x={toPx(0) - 8} y={toPy(40) + 4} class="ncd-lbl tick" text-anchor="end">40</text>
    <text x={toPx(0) - 8} y={toPy(60) + 4} class="ncd-lbl tick" text-anchor="end">60</text>
    <text x={toPx(0) - 8} y={toPy(80) + 4} class="ncd-lbl tick" text-anchor="end">80</text>

    {/* X-axis ticks */}
    <text x={toPx(20)} y={toPy(0) + 14} class="ncd-lbl tick" text-anchor="middle">20</text>
    <text x={toPx(40)} y={toPy(0) + 14} class="ncd-lbl tick" text-anchor="middle">40</text>
    <text x={toPx(60)} y={toPy(0) + 14} class="ncd-lbl tick" text-anchor="middle">60</text>

    {/* Ambient temperature dashed line */}
    <line x1={X0} y1={toPy(Ta)} x2={X1} y2={toPy(Ta)} class="ncd-ambient" />

    {/* Curves */}
    <polyline points={ptsStr(cooling)} class="ncd-curve c-red" fill="none" />
    <polyline points={ptsStr(warming)} class="ncd-curve c-blue" fill="none" />

    {/* Legend below chart */}
    <line x1="50" y1="278" x2="72" y2="278" class="ncd-curve c-red" />
    <text x="78" y="282" class="ncd-lbl leg">Cooling: T₀ = 90°C → 22°C</text>
    <line x1="50" y1="294" x2="72" y2="294" class="ncd-curve c-blue" />
    <text x="78" y="298" class="ncd-lbl leg">Warming: T₀ = 4°C → 22°C</text>
    <line x1="240" y1="278" x2="262" y2="278" class="ncd-ambient" />
    <text x="268" y="282" class="ncd-lbl leg">Ambient: T_a = 22°C</text>
  </svg>
</figure>

<style>
  .ncd { display: flex; justify-content: center; margin: 1.5rem 0; }
  .ncd-svg { width: 100%; max-width: 500px; height: auto; }
  .ncd-grid line { stroke: #262626; stroke-width: 0.5; }
  .ncd-axis { stroke: #555; stroke-width: 1.2; }
  .ncd-ambient { stroke: #7ee787; stroke-width: 1.4; stroke-dasharray: 6 4; opacity: 0.7; }
  .ncd-curve { stroke-width: 2.6; stroke-linecap: round; }
  .c-red { stroke: #f47067; }
  .c-blue { stroke: #58a6ff; }
  .ncd-lbl { font-family: "Libre Baskerville", Georgia, serif; fill: #aaa; }
  .axis { font-size: 12px; font-weight: bold; fill: #888; }
  .tick { font-size: 10px; fill: #777; }
  .leg { font-size: 10px; }

  :root[data-theme="light"] .ncd-grid line { stroke: #e8e8e8; }
  :root[data-theme="light"] .ncd-axis { stroke: #999; }
  :root[data-theme="light"] .ncd-ambient { stroke: #1a7f2e; }
  :root[data-theme="light"] .c-red { stroke: #c4432b; }
  :root[data-theme="light"] .c-blue { stroke: #0550ae; }
  :root[data-theme="light"] .ncd-lbl { fill: #555; }
  :root[data-theme="light"] .axis { fill: #666; }
  :root[data-theme="light"] .tick { fill: #888; }
</style>
