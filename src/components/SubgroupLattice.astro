---
/**
 * SubgroupLattice - every subgroup of ℤ₁₂, arranged by containment.
 *
 * The subgroups, their element lists, their orders and the containment edges are
 * all computed from n = 12 rather than typed in, so the picture cannot disagree
 * with the arithmetic. Edges are trimmed to the box borders so no connector is
 * drawn across a label.
 */
const n = 12;
const w = 540;
const h = 352;
const bw = 150;
const bh = 54;
const hw = bw / 2;
const hh = bh / 2;

// ⟨d⟩ is the set of multiples of d mod n, and it has n/gcd(d,n) elements.
const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
const divisors = Array.from({ length: n }, (_, i) => i + 1).filter((d) => n % d === 0);

function generated(d: number) {
  const set = new Set<number>();
  for (let k = 0; k < n; k++) set.add((k * d) % n);
  return [...set].sort((a, b) => a - b);
}

// One node per divisor. ⟨12⟩ is the trivial subgroup, so label its generator 0.
const nodes = divisors.map((d) => {
  const els = generated(d);
  return {
    d,
    gen: d === n ? 0 : d,
    els,
    order: els.length,
  };
});

// Hand-placed positions keyed by subgroup order, which is what the lattice
// levels mean. ℤ₁₂'s subgroup lattice mirrors the divisor lattice of 12.
const place: Record<number, { x: number; y: number }> = {
  12: { x: 270, y: 62 },
  3: { x: 168, y: 140 },
  6: { x: 372, y: 140 },
  2: { x: 168, y: 218 },
  4: { x: 372, y: 218 },
  1: { x: 270, y: 292 },
};

// ⟨a⟩ ⊆ ⟨b⟩ exactly when b divides a. Keep only covering pairs, so the diagram
// shows immediate containment and nothing redundant.
const contains = (b: number, a: number) => a % b === 0;
const edges: { from: number; to: number }[] = [];
for (const big of nodes) {
  for (const small of nodes) {
    if (big.d === small.d) continue;
    if (!contains(big.d, small.d)) continue; // ⟨small⟩ ⊆ ⟨big⟩
    const hasMiddle = nodes.some(
      (m) =>
        m.d !== big.d &&
        m.d !== small.d &&
        contains(big.d, m.d) &&
        contains(m.d, small.d),
    );
    if (!hasMiddle) edges.push({ from: big.d, to: small.d });
  }
}

/** Trim a centre-to-centre segment back to each box's border. */
function trimmed(a: { x: number; y: number }, b: { x: number; y: number }) {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const tx = ux === 0 ? Infinity : Math.abs(hw / ux);
  const ty = uy === 0 ? Infinity : Math.abs(hh / uy);
  const t = Math.min(tx, ty) + 3;
  return {
    x1: a.x + ux * t,
    y1: a.y + uy * t,
    x2: b.x - ux * t,
    y2: b.y - uy * t,
  };
}

const setText = (els: number[]) =>
  els.length <= 6 ? `{${els.join(", ")}}` : `{0, 1, …, ${n - 1}}`;
---

<figure
  class="sgl"
  role="img"
  aria-label={`The lattice of all ${nodes.length} subgroups of the integers mod 12, ordered by containment. There is exactly one subgroup for each divisor of 12, with orders 1, 2, 3, 4, 6 and 12.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="sgl-head" font-size="12.5" font-weight="bold">Every subgroup of ℤ₁₂, ordered by containment</text>

    {edges.map((e) => {
      const t = trimmed(place[nodes.find((x) => x.d === e.from)!.order], place[nodes.find((x) => x.d === e.to)!.order]);
      return <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="sgl-link" />;
    })}

    {nodes.map((nd) => {
      const p = place[nd.order];
      const cls = nd.order === n ? "purple" : nd.order === 1 ? "grey" : "green";
      return (
        <g>
          <rect x={p.x - hw} y={p.y - hh} width={bw} height={bh} rx="8" class={`sgl-box sgl-${cls}`} />
          <text x={p.x} y={p.y - 9} class={`sgl-gen sgl-t-${cls}`} font-size="12" text-anchor="middle" font-weight="bold">
            {`⟨${nd.gen}⟩`}
          </text>
          <text x={p.x} y={p.y + 7} class="sgl-els" font-size="9.5" text-anchor="middle">{setText(nd.els)}</text>
          <text x={p.x} y={p.y + 21} class="sgl-ord" font-size="9" text-anchor="middle">{`order ${nd.order}`}</text>
        </g>
      );
    })}

    <text x={w / 2} y="332" class="sgl-foot" font-size="10.5" text-anchor="middle">
      One subgroup for each divisor of 12, and every order divides 12, as Lagrange requires
    </text>
    <text x={w / 2} y="347" class="sgl-sub" font-size="9.5" text-anchor="middle">
      A line means the lower group sits inside the upper one
    </text>
  </svg>
</figure>

<style>
  .sgl { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .sgl svg { width:100%; max-width:100%; height:auto; }
  .sgl-box { fill:none; stroke-width:2; }
  .sgl-green { stroke:#7ee787; }
  .sgl-purple { stroke:#d2a8ff; }
  .sgl-grey { stroke:#8b949e; }
  .sgl-gen { font-family:'Libre Baskerville',Georgia,serif; }
  .sgl-t-green { fill:#7ee787; }
  .sgl-t-purple { fill:#d2a8ff; }
  .sgl-t-grey { fill:#c9d1d9; }
  .sgl-els { fill:#c9d1d9; font-family:'Libre Baskerville',Georgia,serif; }
  .sgl-ord { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .sgl-link { stroke:#888; stroke-width:1.5; }
  .sgl-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .sgl-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .sgl-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .sgl-green, :global([data-theme="light"]) .sgl-t-green { stroke:#116329; fill:#116329; }
  :global([data-theme="light"]) .sgl-green { fill:none; }
  :global([data-theme="light"]) .sgl-purple, :global([data-theme="light"]) .sgl-t-purple { stroke:#6639ba; fill:#6639ba; }
  :global([data-theme="light"]) .sgl-purple { fill:none; }
  :global([data-theme="light"]) .sgl-grey { stroke:#57606a; }
  :global([data-theme="light"]) .sgl-t-grey, :global([data-theme="light"]) .sgl-els { fill:#24292f; }
  :global([data-theme="light"]) :is(.sgl-ord, .sgl-sub) { fill:#57606a; }
  :global([data-theme="light"]) .sgl-link { stroke:#555; }
  :global([data-theme="light"]) .sgl-head { fill:#24292f; }
  :global([data-theme="light"]) .sgl-foot { fill:#0550ae; }
</style>
