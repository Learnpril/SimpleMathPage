---
/**
 * PermutationSlots - filling r ordered slots from n items, with the option
 * count dropping by one each time. Shows P(5,3) = 5 x 4 x 3 = 60.
 */
const w = 470;
const h = 210;
const sw = 78;
const sh = 78;
const y = 56;
const slots = [
  { x: 40, count: "5", note: "any of the 5" },
  { x: 176, count: "4", note: "one is used up" },
  { x: 312, count: "3", note: "two are used up" },
];
---

<figure
  class="pms"
  role="img"
  aria-label="Three ordered slots being filled from five items, with 5 choices then 4 then 3, multiplying to 60 arrangements"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x={w / 2} y="24" class="pms-head" font-size="13" font-weight="bold" text-anchor="middle">
      P(5, 3) - pick 3 of 5, order matters
    </text>

    {/* Slots */}
    {slots.map((s, i) => (
      <g>
        <rect x={s.x} y={y} width={sw} height={sh} rx="8" class="pms-slot" />
        <text x={s.x + sw / 2} y={y + 48} class="pms-count" font-size="30" font-weight="bold" text-anchor="middle">{s.count}</text>
        <text x={s.x + sw / 2} y={y + 66} class="pms-note" font-size="8.5" text-anchor="middle">{s.note}</text>
        <text x={s.x + sw / 2} y={y - 10} class="pms-pos" font-size="10" text-anchor="middle">{`position ${i + 1}`}</text>
      </g>
    ))}

    {/* Multiplication signs */}
    <text x="147" y={y + 46} class="pms-op" font-size="20" text-anchor="middle">×</text>
    <text x="283" y={y + 46} class="pms-op" font-size="20" text-anchor="middle">×</text>

    {/* Result */}
    <text x="410" y={y + 40} class="pms-op" font-size="20" text-anchor="middle">=</text>
    <text x="440" y={y + 46} class="pms-total" font-size="26" font-weight="bold" text-anchor="middle">60</text>

    <text x={w / 2} y="176" class="pms-foot" font-size="11" text-anchor="middle">
      Each slot has one fewer option because items cannot repeat
    </text>
    <text x={w / 2} y="194" class="pms-sub" font-size="10" text-anchor="middle">
      With repetition allowed it would be 5 × 5 × 5 = 125 instead
    </text>
  </svg>
</figure>

<style>
  .pms { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .pms svg { max-width:100%; height:auto; }
  .pms-slot { fill:none; stroke:#58a6ff; stroke-width:2; }
  .pms-count { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .pms-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pms-pos { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pms-op { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .pms-total { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .pms-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .pms-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pms-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .pms-slot { stroke:#0550ae; }
  :global([data-theme="light"]) .pms-count { fill:#0550ae; }
  :global([data-theme="light"]) .pms-op { fill:#555; }
  :global([data-theme="light"]) .pms-total { fill:#b35900; }
  :global([data-theme="light"]) .pms-head { fill:#24292f; }
  :global([data-theme="light"]) .pms-foot { fill:#b35900; }
</style>
