---
interface Props {
  title?: string;
}
const { title = "Circle — C = 2πr" } = Astro.props;
---

<figure class="circle-diagram" role="img" aria-label={title}>
  {title && <figcaption class="circle-title">{title}</figcaption>}
  <svg viewBox="0 0 220 220" width="220" height="220" xmlns="http://www.w3.org/2000/svg">

    <defs>
      <marker id="circ-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path class="circ-arrow-head" d="M0,1 L7,4 L0,7 Z" />
      </marker>
    </defs>

    {/* Main circle */}
    <circle class="circ-outline" cx="110" cy="110" r="80" />

    {/* Circumference arc with arrow (partial arc to suggest going around) */}
    <path
      class="circ-circum"
      d="M 110,30 A 80,80 0 1,1 106,30"
      fill="none"
      stroke-width="2.5"
      stroke-dasharray="8,4"
      marker-end="url(#circ-arrow)"
    />

    {/* Radius line (center to right edge) */}
    <line class="circ-dim" x1="110" y1="110" x2="190" y2="110" />

    {/* Center dot */}
    <circle class="circ-dot" cx="110" cy="110" r="3" />

    {/* Edge dot */}
    <circle class="circ-dot" cx="190" cy="110" r="3" />

    {/* Radius label */}
    <text class="circ-label" x="150" y="104" text-anchor="middle">r</text>

    {/* Circumference label */}
    <text class="circ-label-c" x="60" y="24" text-anchor="middle">C</text>

  </svg>
</figure>

<style>
  .circle-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1.5rem 0;
  }
  .circle-title {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
    font-style: italic;
  }
  .circle-diagram svg {
    max-width: 100%;
    height: auto;
  }

  /* Dark mode (default) */
  .circ-outline { fill: none; stroke: #555; stroke-width: 2; }
  .circ-circum { stroke: #f0c674; }
  .circ-arrow-head { fill: #f0c674; }
  .circ-dim { stroke: #58a6ff; stroke-width: 1.5; }
  .circ-label { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; font-style: italic; font-weight: bold; }
  .circ-label-c { fill: #f0c674; font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; font-style: italic; font-weight: bold; }
  .circ-dot { fill: #58a6ff; }

  /* Light mode */
  :global([data-theme="light"]) .circ-outline { stroke: #bbb; }
  :global([data-theme="light"]) .circ-circum { stroke: #b45309; }
  :global([data-theme="light"]) .circ-arrow-head { fill: #b45309; }
  :global([data-theme="light"]) .circ-dim { stroke: #0969da; }
  :global([data-theme="light"]) .circ-label { fill: #0969da; }
  :global([data-theme="light"]) .circ-label-c { fill: #b45309; }
  :global([data-theme="light"]) .circ-dot { fill: #0969da; }
</style>
