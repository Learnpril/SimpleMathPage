---
/**
 * ChainRuleEx2Tree - Tree diagram for Example 2:
 * z = e^(xy), x = s + t, y = s - t
 * Shows four paths with actual derivative values.
 * Result formulas are in the lesson MDX as proper KaTeX.
 */
const w = 500;
const h = 340;
const cx = w / 2;
const nr = 20;

const zX = cx; const zY = 55;
const xX = cx - 100; const xY = 165;
const yX = cx + 100; const yY = 165;
const sX = cx - 90; const sY = 290;
const tX2 = cx + 90; const tY2 = 290;
---

<figure class="ex2t" role="img" aria-label="Tree diagram for Example 2 showing z depends on x and y, which both depend on s and t, with derivative values">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Edges - outer */}
    <line x1={zX} y1={zY + nr} x2={xX} y2={xY - nr} class="ex2t-edge" stroke-width="1.5" />
    <line x1={zX} y1={zY + nr} x2={yX} y2={yY - nr} class="ex2t-edge" stroke-width="1.5" />
    <line x1={xX} y1={xY + nr} x2={sX} y2={sY - nr} class="ex2t-edge" stroke-width="1.5" />
    <line x1={yX} y1={yY + nr} x2={tX2} y2={tY2 - nr} class="ex2t-edge" stroke-width="1.5" />

    {/* Edges - cross (dashed) */}
    <line x1={xX} y1={xY + nr} x2={tX2} y2={tY2 - nr} class="ex2t-edge-cross" stroke-width="1.5" stroke-dasharray="5,3" />
    <line x1={yX} y1={yY + nr} x2={sX} y2={sY - nr} class="ex2t-edge-cross" stroke-width="1.5" stroke-dasharray="5,3" />

    {/* Edge labels */}
    <text class="ex2t-elabel" x={xX - 24} y={zY + 58} font-size="12" text-anchor="end">ye^(xy)</text>
    <text class="ex2t-dname" x={xX - 24} y={zY + 73} font-size="9" text-anchor="end">∂z/∂x</text>
    <text class="ex2t-elabel" x={yX + 24} y={zY + 58} font-size="12" text-anchor="start">xe^(xy)</text>
    <text class="ex2t-dname" x={yX + 24} y={zY + 73} font-size="9" text-anchor="start">∂z/∂y</text>
    <text class="ex2t-elabel" x={xX - 24} y={xY + 62} font-size="12" text-anchor="end">1</text>
    <text class="ex2t-dname" x={xX - 24} y={xY + 77} font-size="9" text-anchor="end">∂x/∂s</text>
    <text class="ex2t-elabel" x={yX + 24} y={yY + 62} font-size="12" text-anchor="start">-1</text>
    <text class="ex2t-dname" x={yX + 24} y={yY + 77} font-size="9" text-anchor="start">∂y/∂t</text>
    <text class="ex2t-elabel" x={xX + 24} y={xY + 38} font-size="12" text-anchor="start">1</text>
    <text class="ex2t-dname" x={xX + 24} y={xY + 52} font-size="9" text-anchor="start">∂x/∂t</text>
    <text class="ex2t-elabel" x={yX - 24} y={yY + 38} font-size="12" text-anchor="end">1</text>
    <text class="ex2t-dname" x={yX - 24} y={yY + 52} font-size="9" text-anchor="end">∂y/∂s</text>

    {/* Nodes */}
    <circle cx={zX} cy={zY} r={nr} class="ex2t-node" />
    <text class="ex2t-nlabel" x={zX} y={zY + 6} font-size="16" text-anchor="middle">z</text>
    <text class="ex2t-nodeinfo" x={zX} y={zY - nr - 10} font-size="11" text-anchor="middle">= e^(xy)</text>

    <circle cx={xX} cy={xY} r={nr} class="ex2t-node" />
    <text class="ex2t-nlabel" x={xX} y={xY + 6} font-size="16" text-anchor="middle">x</text>
    <text class="ex2t-nodeinfo" x={xX - 24} y={xY + nr + 16} font-size="11" text-anchor="middle">= s + t</text>

    <circle cx={yX} cy={yY} r={nr} class="ex2t-node" />
    <text class="ex2t-nlabel" x={yX} y={yY + 6} font-size="16" text-anchor="middle">y</text>
    <text class="ex2t-nodeinfo" x={yX + 24} y={yY + nr + 16} font-size="11" text-anchor="middle">= s - t</text>

    <circle cx={sX} cy={sY} r={nr} class="ex2t-node-end" />
    <text class="ex2t-nlabel-end" x={sX} y={sY + 6} font-size="16" text-anchor="middle">s</text>

    <circle cx={tX2} cy={tY2} r={nr} class="ex2t-node-end" />
    <text class="ex2t-nlabel-end" x={tX2} y={tY2 + 6} font-size="16" text-anchor="middle">t</text>
  </svg>
</figure>

<style>
  .ex2t { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ex2t svg { max-width:100%; height:auto; }
  .ex2t-edge { stroke:#58a6ff; }
  .ex2t-edge-cross { stroke:#58a6ff; opacity:0.6; }
  .ex2t-elabel { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .ex2t-dname { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .ex2t-node { fill:none; stroke:#58a6ff; stroke-width:2; }
  .ex2t-node-end { fill:none; stroke:#7ee787; stroke-width:2; }
  .ex2t-nlabel { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .ex2t-nlabel-end { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .ex2t-nodeinfo { fill:#999; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .ex2t-edge { stroke:#0550ae; }
  :global([data-theme="light"]) .ex2t-edge-cross { stroke:#0550ae; opacity:0.6; }
  :global([data-theme="light"]) .ex2t-elabel { fill:#b35900; }
  :global([data-theme="light"]) .ex2t-dname { fill:#999; }
  :global([data-theme="light"]) .ex2t-node { stroke:#0550ae; }
  :global([data-theme="light"]) .ex2t-node-end { stroke:#116329; }
  :global([data-theme="light"]) .ex2t-nlabel { fill:#0550ae; }
  :global([data-theme="light"]) .ex2t-nlabel-end { fill:#116329; }
  :global([data-theme="light"]) .ex2t-nodeinfo { fill:#666; }
</style>
