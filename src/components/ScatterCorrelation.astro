---
/**
 * ScatterCorrelation — four scatterplots at different correlations, including
 * the case r = 0 with a perfect parabola, which is the reason to always plot.
 */
const panelW = 132;
const w = 4 * panelW + 16;
const h = 226;
const plotSize = 100;
const plotY = 48;

// Deterministic point sets
function makePoints(kind: string) {
  const pts: { x: number; y: number }[] = [];
  for (let i = 0; i < 22; i++) {
    const t = i / 21;
    const noise = Math.sin(i * 12.9898) * 0.5 + Math.cos(i * 4.113) * 0.5;
    if (kind === "strongPos") pts.push({ x: t, y: t + noise * 0.11 });
    else if (kind === "weakNeg") pts.push({ x: t, y: 1 - t * 0.55 + noise * 0.3 });
    else if (kind === "none") pts.push({ x: t, y: 0.5 + noise * 0.42 });
    else {
      // perfect parabola, symmetric about the middle
      const u = t * 2 - 1;
      pts.push({ x: t, y: u * u });
    }
  }
  return pts;
}

const panels = [
  { kind: "strongPos", r: "r = 0.95", desc: "strong positive", cls: "green" },
  { kind: "weakNeg", r: "r = −0.55", desc: "moderate negative", cls: "blue" },
  { kind: "none", r: "r ≈ 0", desc: "no relationship", cls: "grey" },
  { kind: "parabola", r: "r = 0", desc: "perfect curve!", cls: "orange" },
];
---

<figure
  class="scr"
  role="img"
  aria-label="Four scatterplots: strong positive correlation, moderate negative, no relationship, and a perfect parabola whose correlation is zero despite an exact relationship"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="12" y="20" class="scr-head" font-size="12" font-weight="bold">
      r measures only the LINEAR part of a relationship
    </text>

    {panels.map((p, pi) => {
      const px = 12 + pi * panelW + (panelW - plotSize) / 2;
      const pts = makePoints(p.kind);
      return (
        <g>
          {/* Axes */}
          <line x1={px} y1={plotY + plotSize} x2={px + plotSize} y2={plotY + plotSize} class="scr-axis" />
          <line x1={px} y1={plotY} x2={px} y2={plotY + plotSize} class="scr-axis" />

          {/* Points */}
          {pts.map((pt) => (
            <circle
              cx={px + pt.x * plotSize}
              cy={plotY + plotSize - Math.max(0, Math.min(1, pt.y)) * plotSize}
              r="2.6"
              class={`scr-dot scr-d-${p.cls}`}
            />
          ))}

          <text x={px + plotSize / 2} y={plotY + plotSize + 20} class={`scr-r scr-t-${p.cls}`} font-size="11" text-anchor="middle" font-weight="bold">{p.r}</text>
          <text x={px + plotSize / 2} y={plotY + plotSize + 34} class="scr-desc" font-size="9.5" text-anchor="middle">{p.desc}</text>
        </g>
      );
    })}

    <text x={w / 2} y="206" class="scr-foot" font-size="10" text-anchor="middle">
      The fourth panel is an exact relationship with r = 0, because the rises and falls cancel
    </text>
    <text x={w / 2} y="220" class="scr-sub" font-size="9.5" text-anchor="middle">
      Always plot the data before trusting a correlation coefficient
    </text>
  </svg>
</figure>

<style>
  .scr { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .scr svg { width:100%; max-width:100%; height:auto; }
  .scr-axis { stroke:#666; stroke-width:1.2; }
  .scr-dot { }
  .scr-d-green { fill:#7ee787; }
  .scr-d-blue { fill:#58a6ff; }
  .scr-d-grey { fill:#999; }
  .scr-d-orange { fill:#f0883e; }
  .scr-r { font-family:'Libre Baskerville',Georgia,serif; }
  .scr-t-green { fill:#7ee787; }
  .scr-t-blue { fill:#58a6ff; }
  .scr-t-grey { fill:#999; }
  .scr-t-orange { fill:#f0883e; }
  .scr-desc { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .scr-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .scr-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .scr-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .scr-axis { stroke:#999; }
  :global([data-theme="light"]) .scr-d-green, :global([data-theme="light"]) .scr-t-green { fill:#116329; }
  :global([data-theme="light"]) .scr-d-blue, :global([data-theme="light"]) .scr-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .scr-d-grey, :global([data-theme="light"]) .scr-t-grey { fill:#666; }
  :global([data-theme="light"]) .scr-d-orange, :global([data-theme="light"]) .scr-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .scr-head { fill:#24292f; }
  :global([data-theme="light"]) .scr-foot { fill:#b35900; }
</style>
