---
/**
 * TaylorApproxGraph - shows sin(x) and its Taylor polynomial
 * approximations of degree 1, 3, 5, and 7 centered at 0.
 * Demonstrates how more terms give better approximation.
 */
const w = 420;
const h = 300;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -7, xMax = 7, yMin = -2, yMax = 2;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const N = 300;

// sin(x) exact
const sinPts: string[] = [];
for (let i = 0; i <= N; i++) {
  const x = xMin + (i / N) * (xMax - xMin);
  const y = Math.sin(x);
  if (y >= yMin && y <= yMax) sinPts.push(`${sx(x)},${sy(y)}`);
}

// Taylor polynomials for sin(x): T1 = x, T3 = x - x³/6, T5 = ... T7 = ...
const factorial = (n: number): number => { let r = 1; for (let i = 2; i <= n; i++) r *= i; return r; };
const taylorSin = (x: number, deg: number): number => {
  let sum = 0;
  for (let k = 0; k <= deg; k++) {
    const n = 2 * k + 1;
    if (n > deg + 1) break;
    sum += Math.pow(-1, k) * Math.pow(x, n) / factorial(n);
  }
  return sum;
};

const makePts = (deg: number): string[] => {
  const pts: string[] = [];
  for (let i = 0; i <= N; i++) {
    const x = xMin + (i / N) * (xMax - xMin);
    const y = taylorSin(x, deg);
    if (y >= yMin && y <= yMax) pts.push(`${sx(x)},${sy(y)}`);
  }
  return pts;
};

const t1 = makePts(1);
const t3 = makePts(3);
const t5 = makePts(5);
const t7 = makePts(7);

const xTicks = [-6, -4, -2, 0, 2, 4, 6];
const yTicks = [-1, 0, 1];
---

<figure class="tap" role="img" aria-label="Graph of sin x with Taylor polynomial approximations of increasing degree">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {xTicks.map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="tap-grid" stroke-width="0.5" />
    ))}
    {yTicks.map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="tap-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="tap-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="tap-axis" stroke-width="1.2" />

    {/* Taylor approximations (draw lower degree first so higher covers) */}
    <polyline points={t1.join(" ")} fill="none" class="tap-t1" stroke-width="1.5" />
    <polyline points={t3.join(" ")} fill="none" class="tap-t3" stroke-width="1.5" />
    <polyline points={t5.join(" ")} fill="none" class="tap-t5" stroke-width="1.5" />
    <polyline points={t7.join(" ")} fill="none" class="tap-t7" stroke-width="1.5" />

    {/* sin(x) exact */}
    <polyline points={sinPts.join(" ")} fill="none" class="tap-sin" stroke-width="2.5" />

    {xTicks.filter(v => v !== 0).map(v => (
      <text class="tap-tick" x={sx(v)} y={sy(0) + 16} font-size="10" text-anchor="middle">{v}</text>
    ))}
    {yTicks.filter(v => v !== 0).map(v => (
      <text class="tap-tick" x={sx(0) - 8} y={sy(v) + 4} font-size="10" text-anchor="end">{v}</text>
    ))}
  </svg>
  <div class="tap-legend">
    <span class="tap-leg-item"><span class="tap-swatch tap-sw-sin"></span> sin(x)</span>
    <span class="tap-leg-item"><span class="tap-swatch tap-sw-t1"></span> degree 1</span>
    <span class="tap-leg-item"><span class="tap-swatch tap-sw-t3"></span> degree 3</span>
    <span class="tap-leg-item"><span class="tap-swatch tap-sw-t5"></span> degree 5</span>
    <span class="tap-leg-item"><span class="tap-swatch tap-sw-t7"></span> degree 7</span>
  </div>
</figure>

<style>
  .tap { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .tap svg { max-width:100%; height:auto; }
  .tap-grid { stroke:#333; }
  .tap-axis { stroke:#666; }
  .tap-sin { stroke:#58a6ff; }
  .tap-t1 { stroke:#f47067; opacity:0.6; }
  .tap-t3 { stroke:#f0883e; opacity:0.6; }
  .tap-t5 { stroke:#7ee787; opacity:0.6; }
  .tap-t7 { stroke:#d2a8ff; opacity:0.7; }
  .tap-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .tap-legend {
    display:flex; gap:0.8rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .tap-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .tap-swatch { display:inline-block; width:18px; height:4px; border-radius:2px; }
  .tap-sw-sin { background:#58a6ff; height:4px; }
  .tap-sw-t1 { background:#f47067; }
  .tap-sw-t3 { background:#f0883e; }
  .tap-sw-t5 { background:#7ee787; }
  .tap-sw-t7 { background:#d2a8ff; }
  :global([data-theme="light"]) .tap-grid { stroke:#ddd; }
  :global([data-theme="light"]) .tap-axis { stroke:#999; }
  :global([data-theme="light"]) .tap-sin { stroke:#0550ae; }
  :global([data-theme="light"]) .tap-t1 { stroke:#cf222e; }
  :global([data-theme="light"]) .tap-t3 { stroke:#b35900; }
  :global([data-theme="light"]) .tap-t5 { stroke:#116329; }
  :global([data-theme="light"]) .tap-t7 { stroke:#6639ba; }
  :global([data-theme="light"]) .tap-tick { fill:#666; }
  :global([data-theme="light"]) .tap-sw-sin { background:#0550ae; }
  :global([data-theme="light"]) .tap-sw-t1 { background:#cf222e; }
  :global([data-theme="light"]) .tap-sw-t3 { background:#b35900; }
  :global([data-theme="light"]) .tap-sw-t5 { background:#116329; }
  :global([data-theme="light"]) .tap-sw-t7 { background:#6639ba; }
</style>
