---
/**
 * QuotientGluing - four surfaces built by identifying edges of a square. For each
 * pattern the corner classes, edge classes, Euler characteristic, orientability and
 * number of boundary circles are all computed from the identification data by
 * union-find, so the table under each square is derived rather than looked up.
 */
const w = 540;
const h = 292;

// corners: 0 = top-left, 1 = top-right, 2 = bottom-right, 3 = bottom-left
type EdgeName = "T" | "R" | "B" | "L";
const edgeEnds: Record<EdgeName, [number, number]> = {
  T: [0, 1],
  R: [1, 2],
  B: [3, 2],
  L: [0, 3],
};

type Glue = { e1: EdgeName; e2: EdgeName; flip: boolean };
type Pattern = { name: string; glues: Glue[] };

const patterns: Pattern[] = [
  { name: "cylinder", glues: [{ e1: "L", e2: "R", flip: false }] },
  {
    name: "torus",
    glues: [
      { e1: "L", e2: "R", flip: false },
      { e1: "T", e2: "B", flip: false },
    ],
  },
  { name: "Möbius strip", glues: [{ e1: "L", e2: "R", flip: true }] },
  {
    name: "Klein bottle",
    glues: [
      { e1: "L", e2: "R", flip: false },
      { e1: "T", e2: "B", flip: true },
    ],
  },
];

function analyse(p: Pattern) {
  // union-find on the four corners
  const parent = [0, 1, 2, 3];
  const find = (i: number): number => (parent[i] === i ? i : (parent[i] = find(parent[i])));
  const union = (i: number, j: number) => {
    const a = find(i);
    const b = find(j);
    if (a !== b) parent[a] = b;
  };

  for (const g of p.glues) {
    const [a1, b1] = edgeEnds[g.e1];
    const [a2, b2] = edgeEnds[g.e2];
    if (g.flip) {
      union(a1, b2);
      union(b1, a2);
    } else {
      union(a1, a2);
      union(b1, b2);
    }
  }

  const V = new Set([0, 1, 2, 3].map(find)).size;

  // edge classes: each glued pair collapses to one edge
  const glued = new Set<EdgeName>();
  p.glues.forEach((g) => {
    glued.add(g.e1);
    glued.add(g.e2);
  });
  const free: EdgeName[] = (["T", "R", "B", "L"] as EdgeName[]).filter((e) => !glued.has(e));
  const E = p.glues.length + free.length;
  const F = 1;
  const chi = V - E + F;

  const orientable = p.glues.every((g) => !g.flip);

  // boundary circles: connected components of the graph on corner classes made by free edges
  const nodes = new Set<number>();
  const bparent = new Map<number, number>();
  const bfind = (x: number): number => {
    if (!bparent.has(x)) bparent.set(x, x);
    return bparent.get(x) === x ? x : (bparent.set(x, bfind(bparent.get(x)!)), bparent.get(x)!);
  };
  for (const e of free) {
    const [a, b] = edgeEnds[e];
    const ca = find(a);
    const cb = find(b);
    nodes.add(ca);
    nodes.add(cb);
    const ra = bfind(ca);
    const rb = bfind(cb);
    if (ra !== rb) bparent.set(ra, rb);
  }
  const boundary = new Set([...nodes].map(bfind)).size;

  return { V, E, F, chi, orientable, boundary, free, glued: p.glues };
}

const results = patterns.map((p) => ({ ...p, ...analyse(p) }));

// ---------- geometry ----------
const centres = [84, 216, 348, 480];
const half = 31;
const top = 76;
const bottom = top + 2 * half;

const edgeLine = (cx: number, e: EdgeName) => {
  const l = cx - half;
  const r = cx + half;
  if (e === "T") return { x1: l, y1: top, x2: r, y2: top };
  if (e === "B") return { x1: l, y1: bottom, x2: r, y2: bottom };
  if (e === "L") return { x1: l, y1: top, x2: l, y2: bottom };
  return { x1: r, y1: top, x2: r, y2: bottom };
};

/** A chevron at the midpoint of an edge, pointing along the given direction. */
function chevron(cx: number, e: EdgeName, forward: boolean) {
  const g = edgeLine(cx, e);
  const mx = (g.x1 + g.x2) / 2;
  const my = (g.y1 + g.y2) / 2;
  const dx = (g.x2 - g.x1) / (2 * half);
  const dy = (g.y2 - g.y1) / (2 * half);
  const s = forward ? 1 : -1;
  const ux = dx * s;
  const uy = dy * s;
  const nx = -uy;
  const ny = ux;
  const L = 4.6;
  return `${(mx - ux * L + nx * L).toFixed(1)},${(my - uy * L + ny * L).toFixed(1)} ${(mx + ux * L).toFixed(1)},${(my + uy * L).toFixed(1)} ${(mx - ux * L - nx * L).toFixed(1)},${(my - uy * L - ny * L).toFixed(1)}`;
}

const pairClass = (r: (typeof results)[number], e: EdgeName) => {
  const idx = r.glued.findIndex((g) => g.e1 === e || g.e2 === e);
  return idx < 0 ? "free" : idx === 0 ? "p1" : "p2";
};
---

<figure
  class="qtg"
  role="img"
  aria-label={`Four surfaces built by gluing edges of a square. ${results
    .map(
      (r) =>
        `The ${r.name} has Euler characteristic ${r.chi}, is ${r.orientable ? "orientable" : "non-orientable"}, and has ${r.boundary} boundary circle${r.boundary === 1 ? "" : "s"}`,
    )
    .join("; ")}.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="qtg-head" font-size="12.5" font-weight="bold">Four surfaces from one square</text>
    <text x="16" y="38" class="qtg-sub" font-size="10.5">Matching arrows are glued; a reversed arrow makes the result one-sided</text>

    {results.map((r, i) => (
      <g>
        {(["T", "R", "B", "L"] as EdgeName[]).map((e) => {
          const g = edgeLine(centres[i], e);
          const pc = pairClass(r, e);
          const glue = r.glued.find((q) => q.e1 === e || q.e2 === e);
          const forward = !glue ? true : glue.e2 === e && glue.flip ? false : true;
          return (
            <g>
              <line x1={g.x1} y1={g.y1} x2={g.x2} y2={g.y2} class={`qtg-edge qtg-${pc}`} />
              {pc !== "free" && <polyline points={chevron(centres[i], e, forward)} class={`qtg-chev qtg-${pc}`} fill="none" />}
            </g>
          );
        })}

        <text x={centres[i]} y="158" class="qtg-name" font-size="10" text-anchor="middle" font-weight="bold">{r.name}</text>
        <text x={centres[i]} y="178" class="qtg-row" font-size="9.5" text-anchor="middle">{`V−E+F = ${r.chi}`}</text>
        <text x={centres[i]} y="196" class={`qtg-row qtg-${r.orientable ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">
          {r.orientable ? "orientable" : "one-sided"}
        </text>
        <text x={centres[i]} y="214" class="qtg-row" font-size="9.5" text-anchor="middle">
          {`${r.boundary} edge circle${r.boundary === 1 ? "" : "s"}`}
        </text>
      </g>
    ))}

    <text x={w / 2} y="248" class="qtg-foot" font-size="10.5" text-anchor="middle">
      Gluing is a quotient map, and the quotient topology is what makes it a surface
    </text>
    <text x={w / 2} y="268" class="qtg-sub2" font-size="9.5" text-anchor="middle">
      The Möbius strip and Klein bottle differ from their partners by one reversed arrow
    </text>
    <text x={w / 2} y="286" class="qtg-sub2" font-size="9.5" text-anchor="middle">
      Grey edges are left unglued, and they become the boundary
    </text>
  </svg>
</figure>

<style>
  .qtg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .qtg svg { width:100%; max-width:100%; height:auto; }
  .qtg-edge { stroke-width:2.6; }
  .qtg-chev { stroke-width:2; }
  .qtg-p1 { stroke:#7ee787; }
  .qtg-p2 { stroke:#f0883e; }
  .qtg-free { stroke:#6e7681; }
  .qtg-name { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .qtg-row { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .qtg-ok { fill:#58a6ff; }
  .qtg-bad { fill:#ff7b72; }
  .qtg-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .qtg-sub, .qtg-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .qtg-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .qtg-p1 { stroke:#116329; }
  :global([data-theme="light"]) .qtg-p2 { stroke:#b35900; }
  :global([data-theme="light"]) .qtg-free { stroke:#8c959f; }
  :global([data-theme="light"]) .qtg-ok { fill:#0550ae; }
  :global([data-theme="light"]) .qtg-bad { fill:#a40e26; }
  :global([data-theme="light"]) :is(.qtg-name, .qtg-head) { fill:#24292f; }
  :global([data-theme="light"]) .qtg-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.qtg-row, .qtg-sub, .qtg-sub2) { fill:#57606a; }
</style>
