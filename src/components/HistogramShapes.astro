---
/**
 * HistogramShapes - right-skewed, symmetric, and left-skewed distributions
 * side by side, each labelled with the direction of its tail. The point is
 * that skew is named for the tail, not for where the bulk sits.
 */
const panelW = 168;
const h = 230;
const w = 3 * panelW + 24;
const baseY = 150;
const maxBar = 100;
const nBins = 8;
const binW = 17;

const right = [1.0, 0.78, 0.52, 0.34, 0.22, 0.13, 0.07, 0.03];
const symmetric = [0.14, 0.36, 0.68, 1.0, 1.0, 0.68, 0.36, 0.14];
const left = [0.03, 0.07, 0.13, 0.22, 0.34, 0.52, 0.78, 1.0];

const panels = [
  { bins: right, title: "Right-skewed", tail: "tail points right →", rel: "mean > median", cls: "orange" },
  { bins: symmetric, title: "Symmetric", tail: "no tail", rel: "mean ≈ median", cls: "green" },
  { bins: left, title: "Left-skewed", tail: "← tail points left", rel: "mean < median", cls: "blue" },
];
const panelX = (i: number) => 12 + i * panelW;
---

<figure
  class="hsh"
  role="img"
  aria-label="Three histograms: right-skewed with its tail to the right and mean above median, symmetric with mean equal to median, and left-skewed with mean below median"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {panels.map((p, pi) => {
      const px = panelX(pi);
      const chartStart = px + (panelW - nBins * binW) / 2;
      return (
        <g>
          <text x={px + panelW / 2} y="26" class={`hsh-title hsh-t-${p.cls}`} font-size="12.5" font-weight="bold" text-anchor="middle">{p.title}</text>

          {p.bins.map((v, i) => {
            const bh = v * maxBar;
            return (
              <rect x={chartStart + i * binW} y={baseY - bh} width={binW} height={bh} class={`hsh-bar hsh-b-${p.cls}`} />
            );
          })}

          <line x1={chartStart - 6} y1={baseY} x2={chartStart + nBins * binW + 6} y2={baseY} class="hsh-axis" />

          <text x={px + panelW / 2} y={baseY + 20} class={`hsh-tail hsh-t-${p.cls}`} font-size="10" text-anchor="middle">{p.tail}</text>
          <text x={px + panelW / 2} y={baseY + 38} class="hsh-rel" font-size="10.5" text-anchor="middle">{p.rel}</text>
        </g>
      );
    })}

    <text x={w / 2} y="214" class="hsh-foot" font-size="10.5" text-anchor="middle">
      The skew is named for the direction of the TAIL, not where the bulk of the data sits
    </text>
  </svg>
</figure>

<style>
  .hsh { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .hsh svg { width:100%; max-width:100%; height:auto; }
  .hsh-axis { stroke:#888; stroke-width:1.4; }
  .hsh-bar { fill-opacity:0.35; stroke-width:1.3; }
  .hsh-b-orange { fill:#f0883e; stroke:#f0883e; }
  .hsh-b-green { fill:#7ee787; stroke:#7ee787; }
  .hsh-b-blue { fill:#58a6ff; stroke:#58a6ff; }
  .hsh-title, .hsh-tail { font-family:'Libre Baskerville',Georgia,serif; }
  .hsh-t-orange { fill:#f0883e; }
  .hsh-t-green { fill:#7ee787; }
  .hsh-t-blue { fill:#58a6ff; }
  .hsh-rel { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .hsh-foot { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .hsh-axis { stroke:#666; }
  :global([data-theme="light"]) .hsh-b-orange { fill:#b35900; stroke:#b35900; }
  :global([data-theme="light"]) .hsh-b-green { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .hsh-b-blue { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .hsh-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .hsh-t-green { fill:#116329; }
  :global([data-theme="light"]) .hsh-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .hsh-rel { fill:#444; }
  :global([data-theme="light"]) .hsh-foot { fill:#6639ba; }
</style>
