---
/**
 * NormalCurveAnatomy — a labelled bell curve showing the mean at the centre,
 * inflection points one sigma out, and the effect of changing sigma.
 *
 * Layout rules that keep it readable:
 *   - each panel gets its own x range and every curve is generated to fit it,
 *     so no curve crosses the divider or the viewBox edge
 *   - the interior of the bell holds no text, because the mean and sigma
 *     guide lines run through it; captions live below the axis instead
 *   - the comparison curve heights are derived from their sigmas so the two
 *     really do enclose the same area
 */
const w = 540;
const h = 300;
const baseY = 210;

// Left panel: the anatomy of one curve
const cx = 165;
const sigmaPx = 40;
const peakH = 130;
const leftHalf = 3.4 * sigmaPx; // 136, so the curve spans 29 to 301

// Right panel: two curves with the same mean and different sigma
const rx = 440;
const sdNarrow = 13;
const sdWide = 27;
// Area = height x sigma x sqrt(2 pi), so equal areas need height inversely
// proportional to sigma. This keeps the picture honest.
const areaK = 1300;
const hNarrow = areaK / sdNarrow;
const hWide = areaK / sdWide;
const rightHalf = 3.4 * sdWide; // 91.8, so the panel spans 348 to 532

const dividerX = 336;

function curve(sd: number, height: number, centre: number) {
  const pts: string[] = [];
  for (let i = 0; i <= 140; i++) {
    const t = -3.4 + (i / 140) * 6.8;
    const x = centre + t * sd;
    const y = baseY - height * Math.exp(-(t * t) / 2);
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
  }
  return pts.join(" ");
}

const main = curve(sigmaPx, peakH, cx);
const narrow = curve(sdNarrow, hNarrow, rx);
const wide = curve(sdWide, hWide, rx);

// Inflection points sit one sigma out, at height e^(-1/2) of the peak
const inflectY = baseY - peakH * Math.exp(-0.5);
const inflectRightX = cx + sigmaPx;
---

<figure
  class="nca"
  role="img"
  aria-label="A labelled normal curve with the mean at its centre and inflection points one standard deviation away, beside a comparison of a narrow curve with small sigma and a wide curve with large sigma that enclose the same area"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="nca-head" font-size="12.5" font-weight="bold">The normal curve</text>

    {/* ---- Left panel: one curve, labelled ---- */}
    <polygon points={`${cx - leftHalf},${baseY} ${main} ${cx + leftHalf},${baseY}`} class="nca-fill" />
    <polyline points={main} class="nca-curve" fill="none" />
    <line x1={cx - leftHalf - 14} y1={baseY} x2={cx + leftHalf + 14} y2={baseY} class="nca-axis" />

    {/* Mean, labelled above the peak so the guide line crosses no text */}
    <text x={cx} y="48" class="nca-note" font-size="9.5" text-anchor="middle">mean = median = mode</text>
    <text x={cx} y="62" class="nca-t-purple" font-size="10.5" text-anchor="middle" font-weight="bold">μ</text>
    <line x1={cx} y1="70" x2={cx} y2={baseY} class="nca-mean" />

    {/* Inflection points at plus and minus one sigma */}
    {[-1, 1].map((s) => {
      const px = cx + s * sigmaPx;
      return (
        <g>
          <line x1={px} y1={inflectY} x2={px} y2={baseY} class="nca-sigma-line" />
          <circle cx={px} cy={inflectY} r="4" class="nca-inflect" />
          <text x={px} y={baseY + 15} class="nca-t-green" font-size="9.5" text-anchor="middle">
            {s < 0 ? "μ−σ" : "μ+σ"}
          </text>
        </g>
      );
    })}

    {/* Leader from the right inflection dot out to open space above the tail */}
    <line x1={inflectRightX + 6} y1={inflectY - 3} x2={inflectRightX + 34} y2={inflectY - 18} class="nca-leader" />
    <text x={inflectRightX + 38} y={inflectY - 20} class="nca-note" font-size="9.5">inflection point</text>

    {/* Area captions below the axis, clear of every guide line */}
    <text x={cx} y={baseY + 38} class="nca-area" font-size="10" text-anchor="middle">total area = 1</text>
    <text x={cx} y={baseY + 52} class="nca-note" font-size="9.5" text-anchor="middle">probability is area, not height</text>

    {/* ---- Divider ---- */}
    <line x1={dividerX} y1="40" x2={dividerX} y2="268" class="nca-divide" stroke-dasharray="4,4" />

    {/* ---- Right panel: same mean, different sigma ---- */}
    <text x={rx} y="52" class="nca-cmp-title" font-size="10.5" text-anchor="middle">same μ, different σ</text>
    <polyline points={wide} class="nca-wide" fill="none" />
    <polyline points={narrow} class="nca-narrow" fill="none" />
    <line x1={rx - rightHalf - 8} y1={baseY} x2={rx + rightHalf + 8} y2={baseY} class="nca-axis" />
    <text x={rx} y={baseY + 17} class="nca-t-green" font-size="9.5" text-anchor="middle">small σ: tall and narrow</text>
    <text x={rx} y={baseY + 31} class="nca-t-orange" font-size="9.5" text-anchor="middle">large σ: short and wide</text>
    <text x={rx} y={baseY + 50} class="nca-note" font-size="9.5" text-anchor="middle">both enclose area 1</text>

    <text x={w / 2} y={h - 10} class="nca-foot" font-size="10" text-anchor="middle">
      μ slides the curve along the axis; σ stretches or squeezes it
    </text>
  </svg>
</figure>

<style>
  .nca { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .nca svg { width:100%; max-width:100%; height:auto; }
  .nca-fill { fill:#58a6ff; fill-opacity:0.14; }
  .nca-curve { stroke:#58a6ff; stroke-width:2.2; }
  .nca-axis { stroke:#888; stroke-width:1.4; }
  .nca-mean { stroke:#d2a8ff; stroke-width:2; stroke-dasharray:4,3; }
  .nca-inflect { fill:#7ee787; }
  .nca-sigma-line { stroke:#7ee787; stroke-width:1.2; stroke-dasharray:3,3; }
  .nca-leader { stroke:#7ee787; stroke-width:1; }
  .nca-narrow { stroke:#7ee787; stroke-width:2; }
  .nca-wide { stroke:#f0883e; stroke-width:2; }
  .nca-t-purple { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .nca-t-green { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .nca-t-orange { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .nca-area { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .nca-note { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .nca-cmp-title { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .nca-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .nca-foot { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .nca-divide { stroke:#555; }
  :global([data-theme="light"]) .nca-fill { fill:#0550ae; fill-opacity:0.10; }
  :global([data-theme="light"]) .nca-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .nca-axis { stroke:#666; }
  :global([data-theme="light"]) .nca-mean, :global([data-theme="light"]) .nca-t-purple { stroke:#6639ba; fill:#6639ba; }
  :global([data-theme="light"]) .nca-inflect, :global([data-theme="light"]) .nca-sigma-line, :global([data-theme="light"]) .nca-leader, :global([data-theme="light"]) .nca-narrow, :global([data-theme="light"]) .nca-t-green { stroke:#116329; fill:#116329; }
  :global([data-theme="light"]) .nca-wide, :global([data-theme="light"]) .nca-t-orange { stroke:#b35900; fill:#b35900; }
  :global([data-theme="light"]) .nca-area { fill:#0550ae; }
  :global([data-theme="light"]) .nca-cmp-title { fill:#444; }
  :global([data-theme="light"]) .nca-note, :global([data-theme="light"]) .nca-foot { fill:#57606a; }
  :global([data-theme="light"]) .nca-head { fill:#24292f; }
  :global([data-theme="light"]) .nca-divide { stroke:#ccc; }
</style>
