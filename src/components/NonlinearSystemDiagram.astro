---
/**
 * NonlinearSystemDiagram - shows y = x + 1 (line) and y = x² − 2x + 3 (parabola)
 * intersecting at (1, 2) and (2, 3). Labels clear of curves.
 */
const pad = 55;
const w = 400; const h = 380;
const plotW = 290; const plotH = 280;
const xLo = -1; const xHi = 4;
const yLo = -1; const yHi = 8;
const xRange = xHi - xLo; const yRange = yHi - yLo;

function toX(v: number) { return pad + ((v - xLo) / xRange) * plotW; }
function toY(v: number) { return pad + ((yHi - v) / yRange) * plotH; }

const xAxisY = toY(0); const yAxisX = toX(0);

// Parabola: y = x² − 2x + 3
const parPts: string[] = [];
for (let x = -0.5; x <= 3.8; x += 0.05) {
  const y = x * x - 2 * x + 3;
  if (y <= yHi + 0.5) parPts.push(`${parPts.length === 0 ? 'M' : 'L'}${toX(x).toFixed(1)},${toY(y).toFixed(1)}`);
}

// Line: y = x + 1
const linePts = `M${toX(-0.8).toFixed(1)},${toY(0.2).toFixed(1)} L${toX(3.5).toFixed(1)},${toY(4.5).toFixed(1)}`;

const xTicks = [1, 2, 3];
const yTicks = [2, 4, 6];
---

<figure class="nls-diagram" role="img" aria-label="Line y = x + 1 intersecting parabola y = x² − 2x + 3 at (1,2) and (2,3)">
  <figcaption class="nls-title">y = x + 1 and y = x² − 2x + 3 intersect at two points</figcaption>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <rect class="nls-bg" x="0" y="0" width={w} height={h} rx="8" />

    {xTicks.map(x => <line class="nls-grid" x1={toX(x)} y1={pad} x2={toX(x)} y2={pad + plotH} />)}
    {yTicks.map(y => <line class="nls-grid" x1={pad} y1={toY(y)} x2={pad + plotW} y2={toY(y)} />)}

    <line class="nls-axis" x1={pad} y1={xAxisY} x2={pad + plotW + 5} y2={xAxisY} stroke-width="1.5" />
    <line class="nls-axis" x1={yAxisX} y1={pad + plotH} x2={yAxisX} y2={pad - 5} stroke-width="1.5" />
    <text class="nls-axlabel" x={pad + plotW + 10} y={xAxisY + 4} font-size="13">x</text>
    <text class="nls-axlabel" x={yAxisX + 6} y={pad - 10} font-size="13">y</text>

    {xTicks.map(x => <text class="nls-tick" x={toX(x)} y={xAxisY + 16} font-size="10" text-anchor="middle">{x}</text>)}
    {yTicks.map(y => <text class="nls-tick" x={yAxisX - 8} y={toY(y) + 4} font-size="10" text-anchor="end">{y}</text>)}

    {/* Parabola */}
    <path class="nls-par" d={parPts.join(' ')} fill="none" stroke-width="2.5" />
    <text class="nls-par-label" x={toX(3.2)} y={toY(6.5)} font-size="12" font-weight="bold">y = x² − 2x + 3</text>

    {/* Line */}
    <path class="nls-line" d={linePts} fill="none" stroke-width="2.5" />
    <text class="nls-line-label" x={toX(3)} y={toY(3.2)} font-size="12" font-weight="bold">y = x + 1</text>

    {/* Intersection points */}
    <circle class="nls-pt" cx={toX(1)} cy={toY(2)} r="6" />
    <text class="nls-pt-label" x={toX(1) - 14} y={toY(2) + 20} font-size="12" font-weight="bold" text-anchor="end">(1, 2)</text>

    <circle class="nls-pt" cx={toX(2)} cy={toY(3)} r="6" />
    <text class="nls-pt-label" x={toX(2) - 14} y={toY(3) + 20} font-size="12" font-weight="bold" text-anchor="end">(2, 3)</text>

  </svg>
</figure>

<style>
  .nls-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .nls-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .nls-diagram svg { max-width: 100%; height: auto; }
  .nls-bg { fill: var(--sl-color-bg, #121212); }
  .nls-grid { stroke: #333; stroke-width: 0.5; }
  .nls-axis { stroke: #888; }
  .nls-axlabel { fill: #aaa; font-family: sans-serif; }
  .nls-tick { fill: #aaa; font-family: sans-serif; }
  .nls-par { stroke: #58a6ff; }
  .nls-par-label { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .nls-line { stroke: #7ee787; }
  .nls-line-label { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }
  .nls-pt { fill: #f0c674; stroke: #fff; stroke-width: 2; }
  .nls-pt-label { fill: #f0c674; font-family: 'Libre Baskerville', Georgia, serif; }

  :global([data-theme="light"]) .nls-bg { fill: #f8f9fa; }
  :global([data-theme="light"]) .nls-grid { stroke: #ccc; }
  :global([data-theme="light"]) .nls-axis { stroke: #222; }
  :global([data-theme="light"]) .nls-axlabel { fill: #222; }
  :global([data-theme="light"]) .nls-tick { fill: #333; }
  :global([data-theme="light"]) .nls-par { stroke: #0550ae; }
  :global([data-theme="light"]) .nls-par-label { fill: #0550ae; }
  :global([data-theme="light"]) .nls-line { stroke: #116329; }
  :global([data-theme="light"]) .nls-line-label { fill: #116329; }
  :global([data-theme="light"]) .nls-pt { fill: #b45309; stroke: #fff; }
  :global([data-theme="light"]) .nls-pt-label { fill: #b45309; }
</style>
