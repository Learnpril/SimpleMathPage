---
/**
 * ContradictionFlow — assume the opposite, follow it until two facts collide,
 * and the assumption is destroyed. Uses the square root of 2 proof as the trail.
 */
const bw = 128;
const bh = 58;
const gap = 12;
const margin = 10;
const y = 62;
const w = margin * 2 + 4 * bw + 3 * gap; // 4 boxes fit exactly, nothing clipped
const h = 250;
const stepX = (i: number) => margin + i * (bw + gap);
const steps = [
  { x: stepX(0), title: "Assume ¬S", detail: "√2 = a/b, reduced", cls: "orange" },
  { x: stepX(1), title: "Follow it", detail: "a² = 2b², so a is even", cls: "blue" },
  { x: stepX(2), title: "Keep going", detail: "so b is even too", cls: "blue" },
  { x: stepX(3), title: "Collision", detail: "not lowest terms!", cls: "red" },
];
const lastX = stepX(3);
---

<figure
  class="cdf"
  role="img"
  aria-label="Proof by contradiction flow: assume the negation, follow the consequences until two facts collide, then conclude the original statement is true"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x={w / 2} y="22" class="cdf-head" font-size="13" font-weight="bold" text-anchor="middle">
      Proof by contradiction
    </text>
    <text x={w / 2} y="40" class="cdf-sub" font-size="10.5" text-anchor="middle">
      example: √2 is irrational
    </text>

    {/* Arrows */}
    {steps.slice(0, 3).map((s) => (
      <line x1={s.x + bw + 1} y1={y + bh / 2} x2={s.x + bw + gap - 1} y2={y + bh / 2} class="cdf-arrow" marker-end="url(#cdf-head)" />
    ))}

    {/* Boxes */}
    {steps.map((s) => (
      <g>
        <rect x={s.x} y={y} width={bw} height={bh} rx="7" class={`cdf-box cdf-${s.cls}`} />
        <text x={s.x + bw / 2} y={y + 22} class={`cdf-title cdf-t-${s.cls}`} font-size="12.5" font-weight="bold" text-anchor="middle">{s.title}</text>
        <text x={s.x + bw / 2} y={y + 42} class="cdf-detail" font-size="9.5" text-anchor="middle">{s.detail}</text>
      </g>
    ))}

    {/* Collision burst */}
    <text x={lastX + bw / 2} y={y - 8} class="cdf-bolt" font-size="16" text-anchor="middle">✦</text>

    {/* Return arrow to the conclusion */}
    <path d={`M ${lastX + bw / 2} ${y + bh + 6} L ${lastX + bw / 2} ${y + bh + 26} L ${w / 2} ${y + bh + 26} L ${w / 2} ${y + bh + 46}`}
      class="cdf-arrow-back" fill="none" marker-end="url(#cdf-head-g)" />

    {/* Conclusion */}
    <rect x={w / 2 - 100} y={y + bh + 50} width="200" height="42" rx="7" class="cdf-box cdf-green" />
    <text x={w / 2} y={y + bh + 68} class="cdf-title cdf-t-green" font-size="12.5" font-weight="bold" text-anchor="middle">∴ S is true</text>
    <text x={w / 2} y={y + bh + 84} class="cdf-detail" font-size="9.5" text-anchor="middle">the assumption was impossible</text>

    <text x={w / 2} y="240" class="cdf-foot" font-size="10.5" text-anchor="middle">
      A contradiction means two statements that cannot both hold. Name them explicitly.
    </text>

    <defs>
      <marker id="cdf-head" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="cdf-head-fill" />
      </marker>
      <marker id="cdf-head-g" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="cdf-head-green" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .cdf { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cdf svg { max-width:100%; height:auto; }
  .cdf-box { fill:none; stroke-width:2; }
  .cdf-orange { stroke:#f0883e; }
  .cdf-blue { stroke:#58a6ff; }
  .cdf-green { stroke:#7ee787; }
  .cdf-red { stroke:#ff7b72; stroke-width:2.5; }
  .cdf-title { font-family:'Libre Baskerville',Georgia,serif; }
  .cdf-t-orange { fill:#f0883e; }
  .cdf-t-blue { fill:#58a6ff; }
  .cdf-t-green { fill:#7ee787; }
  .cdf-t-red { fill:#ff7b72; }
  .cdf-detail { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .cdf-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .cdf-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cdf-bolt { fill:#ff7b72; }
  .cdf-arrow { stroke:#888; stroke-width:1.5; }
  .cdf-head-fill { fill:#888; }
  .cdf-arrow-back { stroke:#7ee787; stroke-width:1.5; stroke-dasharray:4,3; }
  .cdf-head-green { fill:#7ee787; }
  .cdf-foot { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .cdf-orange { stroke:#b35900; }
  :global([data-theme="light"]) .cdf-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .cdf-green { stroke:#116329; }
  :global([data-theme="light"]) .cdf-red { stroke:#cf222e; }
  :global([data-theme="light"]) .cdf-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .cdf-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .cdf-t-green { fill:#116329; }
  :global([data-theme="light"]) .cdf-t-red { fill:#cf222e; }
  :global([data-theme="light"]) .cdf-head { fill:#24292f; }
  :global([data-theme="light"]) .cdf-bolt { fill:#cf222e; }
  :global([data-theme="light"]) .cdf-arrow { stroke:#555; }
  :global([data-theme="light"]) .cdf-head-fill { fill:#555; }
  :global([data-theme="light"]) .cdf-arrow-back { stroke:#116329; }
  :global([data-theme="light"]) .cdf-head-green { fill:#116329; }
  :global([data-theme="light"]) .cdf-foot { fill:#6639ba; }
</style>
