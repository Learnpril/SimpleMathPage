---
/**
 * IntegrationOrderDiagram — Shows two panels illustrating the two
 * orders of integration over the rectangle [0,2] x [1,3].
 * Left: dy dx (vertical slices at fixed x)
 * Right: dx dy (horizontal slices at fixed y)
 */
const w = 500;
const h = 320;
const topPad = 70;
const botPad = 45;
const leftPad = 70;
const rightPad = 20;
const gap = 70;
const pw = (w - leftPad - rightPad - gap) / 2;
const ph = h - topPad - botPad;

// Panel origins (top-left of each rectangle)
const p1x = leftPad;
const p1y = topPad;
const p2x = leftPad + pw + gap;
const p2y = topPad;

// Map math to SVG within a panel
const sxL = (x: number) => p1x + (x / 2) * pw;
const syL = (y: number) => p1y + ph - ((y - 1) / 2) * ph;
const sxR = (x: number) => p2x + (x / 2) * pw;
const syR = (y: number) => p2y + ph - ((y - 1) / 2) * ph;

// Vertical slice positions for left panel
const slicesV = [0.4, 0.8, 1.2, 1.6];
// Horizontal slice positions for right panel
const slicesH = [1.4, 1.8, 2.2, 2.6];
---

<figure class="iod" role="img" aria-label="Two panels showing integration order: left panel slices vertically (dy dx), right panel slices horizontally (dx dy)">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* === Left panel: dy dx === */}
    {/* Titles above rectangle */}
    <text class="iod-title" x={p1x + pw / 2} y={20} font-size="14" text-anchor="middle">dy dx (inner: y)</text>
    <text class="iod-subtitle" x={p1x + pw / 2} y={38} font-size="11" text-anchor="middle">slice vertically, sweep x</text>

    {/* Rectangle */}
    <rect x={p1x} y={p1y} width={pw} height={ph}
          fill="none" class="iod-rect" stroke-width="1.5" />

    {/* Vertical slices */}
    {slicesV.map(x => (
      <line x1={sxL(x)} y1={p1y} x2={sxL(x)} y2={p1y + ph}
            class="iod-slice" stroke-width="1.5" />
    ))}

    {/* Highlighted slice */}
    <rect x={sxL(0.8) - 3} y={p1y} width={6} height={ph}
          class="iod-highlight" />

    {/* Axis labels — outside the rectangle */}
    <text class="iod-axlabel" x={p1x + pw / 2} y={p1y + ph + 34} font-size="12" text-anchor="middle">x: 0 → 2</text>
    <text class="iod-axlabel" x={p1x - 18} y={p1y + ph / 2 + 4} font-size="12" text-anchor="end">y</text>

    {/* Tick labels — outside edges */}
    <text class="iod-tick" x={p1x} y={p1y + ph + 16} font-size="11" text-anchor="middle">0</text>
    <text class="iod-tick" x={p1x + pw} y={p1y + ph + 16} font-size="11" text-anchor="middle">2</text>
    <text class="iod-tick" x={p1x - 6} y={p1y + ph + 5} font-size="11" text-anchor="end">1</text>
    <text class="iod-tick" x={p1x - 6} y={p1y + 5} font-size="11" text-anchor="end">3</text>

    {/* === Right panel: dx dy === */}
    <text class="iod-title" x={p2x + pw / 2} y={20} font-size="14" text-anchor="middle">dx dy (inner: x)</text>
    <text class="iod-subtitle" x={p2x + pw / 2} y={38} font-size="11" text-anchor="middle">slice horizontally, sweep y</text>

    <rect x={p2x} y={p2y} width={pw} height={ph}
          fill="none" class="iod-rect" stroke-width="1.5" />

    {/* Horizontal slices */}
    {slicesH.map(y => (
      <line x1={p2x} y1={syR(y)} x2={p2x + pw} y2={syR(y)}
            class="iod-slice" stroke-width="1.5" />
    ))}

    {/* Highlighted slice */}
    <rect x={p2x} y={syR(1.8) - 3} width={pw} height={6}
          class="iod-highlight" />

    {/* Axis labels */}
    <text class="iod-axlabel" x={p2x + pw / 2} y={p2y + ph + 34} font-size="12" text-anchor="middle">x</text>
    <text class="iod-axlabel" x={p2x - 12} y={p2y + ph / 2 + 4} font-size="12" text-anchor="end">y: 1 → 3</text>

    {/* Tick labels */}
    <text class="iod-tick" x={p2x} y={p2y + ph + 16} font-size="11" text-anchor="middle">0</text>
    <text class="iod-tick" x={p2x + pw} y={p2y + ph + 16} font-size="11" text-anchor="middle">2</text>
    <text class="iod-tick" x={p2x - 6} y={p2y + ph + 5} font-size="11" text-anchor="end">1</text>
    <text class="iod-tick" x={p2x - 6} y={p2y + 5} font-size="11" text-anchor="end">3</text>
  </svg>
  <div class="iod-caption">
    Both orders integrate over the same rectangle. Left: fix x, integrate y from 1 to 3, then sweep x from 0 to 2. Right: fix y, integrate x from 0 to 2, then sweep y from 1 to 3. Same volume either way.
  </div>
</figure>

<style>
  .iod { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .iod svg { max-width:100%; height:auto; }
  .iod-rect { stroke:#58a6ff; }
  .iod-slice { stroke:#58a6ff; opacity:0.3; }
  .iod-highlight { fill:#f0883e; opacity:0.25; }
  .iod-axlabel { fill:#999; font-family:'Libre Baskerville',Georgia,serif; }
  .iod-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .iod-title { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .iod-subtitle { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .iod-caption {
    max-width:420px; text-align:center; margin-top:0.5rem;
    font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
    color:#999; line-height:1.5;
  }
  :global([data-theme="light"]) .iod-rect { stroke:#0550ae; }
  :global([data-theme="light"]) .iod-slice { stroke:#0550ae; }
  :global([data-theme="light"]) .iod-highlight { fill:#b35900; }
  :global([data-theme="light"]) .iod-axlabel { fill:#666; }
  :global([data-theme="light"]) .iod-tick { fill:#666; }
  :global([data-theme="light"]) .iod-title { fill:#b35900; }
  :global([data-theme="light"]) .iod-subtitle { fill:#666; }
  :global([data-theme="light"]) .iod-caption { color:#666; }
</style>
