---
/**
 * EpsilonDelta — the definition of a limit, drawn as a box.
 *
 * The delta is computed, not chosen for looks: it is the largest value for which
 * the whole delta-interval maps inside the epsilon-band, found from the inverse
 * of x². So the picture demonstrates a working delta rather than illustrating one.
 */
const w = 540;
const h = 324;
const left = 80;
const right = 440;
const bottom = 250;
const top = 70;
const xMax = 2;
const yMax = 4.4;

const f = (x: number) => x * x;
const a = 1.4;
const L = f(a);
const eps = 0.5;

// Largest delta that keeps f within eps of L on both sides
const deltaRight = Math.sqrt(L + eps) - a;
const deltaLeft = a - Math.sqrt(L - eps);
const delta = Math.min(deltaLeft, deltaRight);

const px = (x: number) => left + (x / xMax) * (right - left);
const py = (y: number) => bottom - (y / yMax) * (bottom - top);

const curve = Array.from({ length: 121 }, (_, i) => {
  const x = (i / 120) * xMax;
  return `${px(x).toFixed(1)},${py(f(x)).toFixed(1)}`;
}).join(" ");
---

<figure
  class="epd"
  role="img"
  aria-label={`The graph of x squared with a horizontal band of half-width ${eps} around the value ${L.toFixed(2)} at the point ${a}, and the corresponding vertical strip of half-width ${delta.toFixed(3)}. Every x within delta of a is sent by the function into the epsilon band.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="epd-head" font-size="12.5" font-weight="bold">Epsilon-delta: choose the band, then find the strip</text>

    {/* The epsilon band on the output, and the delta strip on the input */}
    <rect x={left} y={py(L + eps)} width={right - left} height={py(L - eps) - py(L + eps)} class="epd-band" />
    <rect x={px(a - delta)} y={top} width={px(a + delta) - px(a - delta)} height={bottom - top} class="epd-strip" />

    <line x1={left} y1={py(L)} x2={right} y2={py(L)} class="epd-guide epd-g-green" />
    <line x1={px(a)} y1={top} x2={px(a)} y2={bottom} class="epd-guide epd-g-purple" />

    <polyline points={curve} class="epd-curve" fill="none" />
    <circle cx={px(a)} cy={py(L)} r="4.2" class="epd-dot" />

    {/* Axes */}
    <line x1={left - 10} y1={bottom} x2={right + 6} y2={bottom} class="epd-axis" />
    <line x1={left} y1={top - 6} x2={left} y2={bottom} class="epd-axis" />

    <text x="88" y="92" class="epd-fn" font-size="10.5">f(x) = x²</text>

    <text x={left - 8} y={py(L + eps) + 4} class="epd-ylbl epd-t-green" font-size="9.5" text-anchor="end">L + ε</text>
    <text x={left - 8} y={py(L) + 4} class="epd-ylbl epd-t-green" font-size="9.5" text-anchor="end" font-weight="bold">L</text>
    <text x={left - 8} y={py(L - eps) + 4} class="epd-ylbl epd-t-green" font-size="9.5" text-anchor="end">L − ε</text>

    <text x={px(a - delta)} y="266" class="epd-xlbl epd-t-purple" font-size="9.5" text-anchor="middle">a − δ</text>
    <text x={px(a)} y="266" class="epd-xlbl epd-t-purple" font-size="9.5" text-anchor="middle" font-weight="bold">a</text>
    <text x={px(a + delta)} y="266" class="epd-xlbl epd-t-purple" font-size="9.5" text-anchor="middle">a + δ</text>

    <text x={w / 2} y="294" class="epd-foot" font-size="10.5" text-anchor="middle">
      {`With a = ${a} and ε = ${eps}, a δ of ${delta.toFixed(3)} sends the whole strip into the band`}
    </text>
    <text x={w / 2} y="312" class="epd-sub" font-size="9.5" text-anchor="middle">
      Every ε gets its own δ, and shrinking ε forces δ to shrink with it
    </text>
  </svg>
</figure>

<style>
  .epd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .epd svg { width:100%; max-width:100%; height:auto; }
  .epd-band { fill:#7ee787; fill-opacity:0.14; stroke:#7ee787; stroke-width:1; stroke-dasharray:4,3; }
  .epd-strip { fill:#d2a8ff; fill-opacity:0.14; stroke:#d2a8ff; stroke-width:1; stroke-dasharray:4,3; }
  .epd-guide { stroke-width:1.3; stroke-dasharray:3,3; }
  .epd-g-green { stroke:#7ee787; }
  .epd-g-purple { stroke:#d2a8ff; }
  .epd-curve { stroke:#58a6ff; stroke-width:2.2; }
  .epd-dot { fill:#58a6ff; stroke:#eee; stroke-width:1.2; }
  .epd-axis { stroke:#888; stroke-width:1.4; }
  .epd-fn { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .epd-ylbl, .epd-xlbl { font-family:'Libre Baskerville',Georgia,serif; }
  .epd-t-green { fill:#7ee787; }
  .epd-t-purple { fill:#d2a8ff; }
  .epd-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .epd-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .epd-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .epd-band { fill:#116329; fill-opacity:0.1; stroke:#116329; }
  :global([data-theme="light"]) .epd-strip { fill:#6639ba; fill-opacity:0.1; stroke:#6639ba; }
  :global([data-theme="light"]) .epd-g-green, :global([data-theme="light"]) .epd-t-green { stroke:#116329; fill:#116329; }
  :global([data-theme="light"]) .epd-g-purple, :global([data-theme="light"]) .epd-t-purple { stroke:#6639ba; fill:#6639ba; }
  :global([data-theme="light"]) .epd-curve, :global([data-theme="light"]) .epd-fn, :global([data-theme="light"]) .epd-foot { stroke:#0550ae; fill:#0550ae; }
  :global([data-theme="light"]) .epd-curve { fill:none; }
  :global([data-theme="light"]) .epd-dot { fill:#0550ae; stroke:#fff; }
  :global([data-theme="light"]) .epd-axis { stroke:#666; }
  :global([data-theme="light"]) .epd-head { fill:#24292f; }
  :global([data-theme="light"]) .epd-sub { fill:#57606a; }
</style>
