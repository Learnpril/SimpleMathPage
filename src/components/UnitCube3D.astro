---
/**
 * UnitCube3D — Interactive 3D visual of the unit cube [0,1]³
 * with semi-transparent faces and axis labels.
 * Used to illustrate the region for triple integrals.
 */
---

<figure class="uc3" role="img" aria-label="Interactive 3D unit cube from 0 to 1 in each dimension">
  <div class="uc3-canvas" data-uc3d></div>
  <div class="uc3-hint">Drag to rotate · Scroll/Pinch to zoom</div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initScene(container: HTMLElement) {
    const width = Math.min(container.clientWidth, 480);
    const height = 340;
    const isDark = document.documentElement.dataset.theme !== "light";
    const bgColor = isDark ? 0x121212 : 0xf8f9fa;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(bgColor);

    const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 200);
    camera.position.set(2.5, 2, 2.5);
    camera.lookAt(0.5, 0.5, 0.5);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Unit cube
    const cubeGeo = new THREE.BoxGeometry(1, 1, 1);
    const cubeMat = new THREE.MeshPhongMaterial({
      color: isDark ? 0x58a6ff : 0x0550ae,
      transparent: true, opacity: 0.15,
      side: THREE.DoubleSide,
    });
    const cube = new THREE.Mesh(cubeGeo, cubeMat);
    cube.position.set(0.5, 0.5, 0.5);
    scene.add(cube);

    // Wireframe
    const wireGeo = new THREE.BoxGeometry(1, 1, 1);
    const wireMat = new THREE.MeshBasicMaterial({
      color: isDark ? 0x58a6ff : 0x0550ae,
      wireframe: true, transparent: true, opacity: 0.4,
    });
    const wire = new THREE.Mesh(wireGeo, wireMat);
    wire.position.set(0.5, 0.5, 0.5);
    scene.add(wire);

    // Axes
    const axColor = isDark ? 0x666666 : 0x999999;
    const axMat = new THREE.LineBasicMaterial({ color: axColor });
    for (const dir of [[1.8, 0, 0], [0, 1.8, 0], [0, 0, 1.8]] as [number, number, number][]) {
      const pts = [new THREE.Vector3(0, 0, 0), new THREE.Vector3(...dir)];
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), axMat));
    }

    // Labels
    function makeLabel(text: string, pos: [number, number, number], color: string, size = 0.3) {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      canvas.width = 256; canvas.height = 64;
      ctx.font = "bold 32px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText(text, 128, 32);
      const tex = new THREE.CanvasTexture(canvas);
      const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
      const sprite = new THREE.Sprite(mat);
      sprite.position.set(...pos);
      sprite.scale.set(size * 2.5, size * 0.6, 1);
      scene.add(sprite);
    }

    const lc = isDark ? "#888" : "#666";
    makeLabel("x", [1.6, -0.1, 0], lc);
    makeLabel("y", [0, 1.6, 0], lc);
    makeLabel("z", [0, -0.1, 1.6], lc);
    makeLabel("1", [1, -0.15, 0], lc, 0.25);
    makeLabel("1", [0, 1, -0.15], lc, 0.25);
    makeLabel("1", [-0.15, -0.1, 1], lc, 0.25);
    makeLabel("[0,1]³", [0.5, 1.3, 0.5], isDark ? "#d2a8ff" : "#6639ba", 0.35);

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const dl = new THREE.DirectionalLight(0xffffff, 0.6);
    dl.position.set(2, 3, 2);
    scene.add(dl);

    // Controls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.5;
    controls.enableZoom = true;
    controls.minDistance = 2;
    controls.maxDistance = 12;
    controls.target.set(0.5, 0.5, 0.5);

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    return () => { cancelAnimationFrame(animId); renderer.dispose(); };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-uc3d]").forEach((el) => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(
        (entries) => { if (entries[0].isIntersecting) { obs.disconnect(); initScene(el); } },
        { threshold: 0.05 }
      );
      obs.observe(el);
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .uc3 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .uc3-canvas {
    width:100%; max-width:480px; min-height:340px;
    border-radius:8px; overflow:hidden;
  }
  .uc3-canvas canvas { border-radius:8px; }
  .uc3-hint {
    font-family:'Libre Baskerville',Georgia,serif;
    font-size:0.8rem; color:#888; margin-top:0.4rem;
  }
</style>
