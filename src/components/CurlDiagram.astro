---
/**
 * CurlDiagram — SVG showing the rotational field F=<-y,x> with
 * swirling arrows and a curl vector pointing out of the page (z-axis),
 * illustrating positive curl in the xy-plane.
 */
---

<figure class="diagram-container" role="img" aria-label="Curl diagram showing counterclockwise swirling arrows in the xy-plane with the curl vector pointing upward out of the page">
  <svg viewBox="-130 -130 260 290" width="260" height="290" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="cu-ah" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto">
        <path d="M0,0 L6,2 L0,4 Z" class="cu-arrow" />
      </marker>
    </defs>
    <!-- Circular swirl arrows (counterclockwise) -->
    <!-- Outer ring -->
    <path d="M 90 0 A 90 90 0 0 0 0 -90" class="cu-swirl" fill="none" marker-end="url(#cu-ah)" />
    <path d="M 0 -90 A 90 90 0 0 0 -90 0" class="cu-swirl" fill="none" marker-end="url(#cu-ah)" />
    <path d="M -90 0 A 90 90 0 0 0 0 90" class="cu-swirl" fill="none" marker-end="url(#cu-ah)" />
    <path d="M 0 90 A 90 90 0 0 0 90 0" class="cu-swirl" fill="none" marker-end="url(#cu-ah)" />
    <!-- Inner ring -->
    <path d="M 50 0 A 50 50 0 0 0 0 -50" class="cu-swirl-inner" fill="none" marker-end="url(#cu-ah)" />
    <path d="M 0 -50 A 50 50 0 0 0 -50 0" class="cu-swirl-inner" fill="none" marker-end="url(#cu-ah)" />
    <path d="M -50 0 A 50 50 0 0 0 0 50" class="cu-swirl-inner" fill="none" marker-end="url(#cu-ah)" />
    <path d="M 0 50 A 50 50 0 0 0 50 0" class="cu-swirl-inner" fill="none" marker-end="url(#cu-ah)" />
    <!-- Center dot -->
    <circle cx="0" cy="0" r="4" class="cu-center" />
    <!-- Curl vector symbol (dot in circle = vector pointing out of page) -->
    <circle cx="0" cy="0" r="12" class="cu-out-circle" fill="none" />
    <circle cx="0" cy="0" r="3" class="cu-out-dot" />
    <!-- Labels -->
    <text x="0" y="130" text-anchor="middle" class="cu-label">curl F points out of the page</text>
    <text x="0" y="148" text-anchor="middle" class="cu-sublabel">Counterclockwise rotation = positive curl</text>
  </svg>
</figure>

<style>
  .cu-swirl { stroke: #58a6ff; stroke-width: 2; }
  .cu-swirl-inner { stroke: #58a6ff; stroke-width: 1.5; opacity: 0.6; }
  .cu-arrow { fill: #58a6ff; }
  .cu-center { fill: #d2a8ff; }
  .cu-out-circle { stroke: #f0883e; stroke-width: 2; }
  .cu-out-dot { fill: #f0883e; }
  .cu-label { font: bold 12px 'Libre Baskerville', Georgia, serif; fill: #f0883e; }
  .cu-sublabel { font: 11px 'Libre Baskerville', Georgia, serif; fill: #888; }
  [data-theme="light"] .cu-swirl { stroke: #0550ae; }
  [data-theme="light"] .cu-swirl-inner { stroke: #0550ae; }
  [data-theme="light"] .cu-arrow { fill: #0550ae; }
  [data-theme="light"] .cu-center { fill: #6639ba; }
  [data-theme="light"] .cu-out-circle { stroke: #b35900; }
  [data-theme="light"] .cu-out-dot { fill: #b35900; }
  [data-theme="light"] .cu-label { fill: #b35900; }
  [data-theme="light"] .cu-sublabel { fill: #666; }
</style>
