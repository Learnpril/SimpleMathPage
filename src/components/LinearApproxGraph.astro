---
/**
 * LinearApproxGraph - shows f(x) = sqrt(x) with tangent line at x=9.
 * The tangent line L(x) = 3 + (1/6)(x-9) approximates sqrt(x) near 9.
 * Shows the gap between curve and tangent growing as you move away.
 */
const w = 440;
const h = 300;
const pad = 55;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 16, yMin = 0, yMax = 5;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// f(x) = sqrt(x)
const pts: string[] = [];
for (let i = 0; i <= 80; i++) {
  const x = 0.1 + i * (xMax - 0.1) / 80;
  const y = Math.sqrt(x);
  if (y <= yMax) pts.push(`${sx(x)},${sy(y)}`);
}

// Tangent at x=9: f(9)=3, f'(9)=1/6, L(x) = 3 + (x-9)/6
const a = 9;
const fa = 3;
const slope = 1 / 6;
const tanX1 = 2, tanX2 = 16;
const tanY1 = fa + slope * (tanX1 - a);
const tanY2 = fa + slope * (tanX2 - a);
---

<figure class="lag" role="img" aria-label="Square root of x with tangent line approximation at x equals 9">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[2,4,6,8,10,12,14].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="lag-grid" stroke-width="0.5" />
    ))}
    {[1,2,3,4].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="lag-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="lag-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="lag-axis" stroke-width="1.2" />

    {/* Curve */}
    <polyline points={pts.join(' ')} fill="none" class="lag-curve" stroke-width="3" />

    {/* Tangent line */}
    <line x1={sx(tanX1)} y1={sy(tanY1)} x2={sx(tanX2)} y2={sy(tanY2)}
          class="lag-tangent" stroke-width="2.5" />

    {/* Point of tangency */}
    <circle cx={sx(a)} cy={sy(fa)} r="7" class="lag-dot" />

    {/* Dashed guides */}
    <line x1={sx(a)} y1={sy(0)} x2={sx(a)} y2={sy(fa)}
          class="lag-guide" stroke-width="1" stroke-dasharray="5,4" />

    {/* Tick */}
    <text class="lag-tick" x={sx(a)} y={sy(0) + 16} font-size="11" text-anchor="middle">9</text>
    <text class="lag-tick" x={sx(0) - 8} y={sy(fa) + 4} font-size="11" text-anchor="end">3</text>
  </svg>
  <div class="lag-legend">
    <span class="lag-leg-item"><span class="lag-swatch lag-sw-curve"></span> f(x) = √x</span>
    <span class="lag-leg-item"><span class="lag-swatch lag-sw-tan"></span> L(x) = 3 + (x-9)/6</span>
    <span class="lag-leg-item lag-leg-note">close to x = 9, the tangent line ≈ the curve</span>
  </div>
</figure>

<style>
  .lag { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .lag svg { max-width:100%; height:auto; }
  .lag-grid { stroke:#333; }
  .lag-axis { stroke:#666; }
  .lag-curve { stroke:#58a6ff; }
  .lag-tangent { stroke:#7ee787; }
  .lag-guide { stroke:#d2a8ff; }
  .lag-dot { fill:#f0883e; }
  .lag-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .lag-legend {
    display:flex; gap:1.2rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.85rem;
  }
  .lag-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .lag-swatch { display:inline-block; width:18px; height:4px; border-radius:2px; }
  .lag-sw-curve { background:#58a6ff; }
  .lag-sw-tan { background:#7ee787; }
  .lag-leg-note { color:#d2a8ff; font-style:italic; }

  :global([data-theme="light"]) .lag-grid { stroke:#ddd; }
  :global([data-theme="light"]) .lag-axis { stroke:#999; }
  :global([data-theme="light"]) .lag-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .lag-tangent { stroke:#116329; }
  :global([data-theme="light"]) .lag-guide { stroke:#6639ba; }
  :global([data-theme="light"]) .lag-dot { fill:#b35900; }
  :global([data-theme="light"]) .lag-tick { fill:#666; }
  :global([data-theme="light"]) .lag-sw-curve { background:#0550ae; }
  :global([data-theme="light"]) .lag-sw-tan { background:#116329; }
  :global([data-theme="light"]) .lag-leg-note { color:#6639ba; }
</style>
