---
/**
 * IVTDiagram — a continuous function changing sign must cross zero; one with a
 * jump can step over it.
 *
 * The root is located by bisection inside the component, so the marked crossing
 * is the actual root of the plotted function rather than an eyeballed position.
 * All annotations sit outside the plot area, so no curve can run through a label.
 */
const w = 540;
const h = 306;
const bottom = 230;
const top = 70;
const yLo = -0.8;
const yHi = 2.0;

const f = (x: number) => x * x * x + x - 0.5;
// Bisection for the root of f on [0,1]
let lo = 0;
let hi = 1;
for (let i = 0; i < 60; i++) {
  const mid = (lo + hi) / 2;
  if (f(mid) < 0) lo = mid;
  else hi = mid;
}
const root = (lo + hi) / 2;

const panels = [
  { l: 50, r: 250, title: "Continuous: it must cross" },
  { l: 310, r: 510, title: "With a jump: it can skip" },
];
const pxOf = (p: (typeof panels)[0], x: number) => p.l + x * (p.r - p.l);
const py = (y: number) => bottom - ((y - yLo) / (yHi - yLo)) * (bottom - top);

const curve = Array.from({ length: 121 }, (_, i) => {
  const x = i / 120;
  return `${pxOf(panels[0], x).toFixed(1)},${py(f(x)).toFixed(1)}`;
}).join(" ");

// The jump function: −0.5 then +1.0, never zero
const jumpLo = -0.5;
const jumpHi = 1.0;
const labelY = 252;
---

<figure
  class="ivt"
  role="img"
  aria-label={`Two panels. On the left a continuous function is negative at the left endpoint and positive at the right, and it crosses zero at approximately ${root.toFixed(4)}. On the right a function with a jump goes from negative to positive without ever taking the value zero.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="ivt-head" font-size="12.5" font-weight="bold">A sign change forces a root, if there are no jumps</text>

    {panels.map((p) => (
      <g>
        <text x={(p.l + p.r) / 2} y="54" class="ivt-title" font-size="10.5" text-anchor="middle" font-weight="bold">{p.title}</text>
        <line x1={p.l} y1={py(0)} x2={p.r + 8} y2={py(0)} class="ivt-zero" />
        <line x1={p.l} y1={top - 4} x2={p.l} y2={bottom} class="ivt-axis" />
        <line x1={p.l} y1={bottom} x2={p.r + 8} y2={bottom} class="ivt-axis" />
      </g>
    ))}

    <text x="44" y={py(0) + 4} class="ivt-zerolbl" font-size="9" text-anchor="end">y = 0</text>

    {/* ---------- Continuous ---------- */}
    <polyline points={curve} class="ivt-curve" fill="none" />
    <circle cx={pxOf(panels[0], root)} cy={py(0)} r="4.4" class="ivt-root" />

    {/* ---------- Jump ---------- */}
    <polyline
      points={`${pxOf(panels[1], 0)},${py(jumpLo)} ${pxOf(panels[1], 0.5)},${py(jumpLo)}`}
      class="ivt-curve ivt-c-orange"
      fill="none"
    />
    <polyline
      points={`${pxOf(panels[1], 0.5)},${py(jumpHi)} ${pxOf(panels[1], 1)},${py(jumpHi)}`}
      class="ivt-curve ivt-c-orange"
      fill="none"
    />
    <circle cx={pxOf(panels[1], 0.5)} cy={py(jumpLo)} r="4" class="ivt-filled" />
    <circle cx={pxOf(panels[1], 0.5)} cy={py(jumpHi)} r="4" class="ivt-hole" />

    {/* All annotations live below the axis, clear of both curves */}
    <text x={pxOf(panels[0], 0)} y={labelY} class="ivt-endlbl" font-size="9" text-anchor="middle">f(a) &lt; 0</text>
    <text x={pxOf(panels[0], root)} y={labelY} class="ivt-clbl" font-size="9.5" text-anchor="middle">
      {`c ≈ ${root.toFixed(3)}`}
    </text>
    <text x={pxOf(panels[0], 1)} y={labelY} class="ivt-endlbl" font-size="9" text-anchor="middle">f(b) &gt; 0</text>
    <text x={pxOf(panels[1], 0)} y={labelY} class="ivt-endlbl" font-size="9" text-anchor="middle">g(a) &lt; 0</text>
    <text x={pxOf(panels[1], 1)} y={labelY} class="ivt-endlbl" font-size="9" text-anchor="middle">g(b) &gt; 0</text>

    <text x={w / 2} y="274" class="ivt-foot" font-size="10.5" text-anchor="middle">
      Continuous on [a, b] with f(a) &lt; 0 &lt; f(b) guarantees some c with f(c) = 0
    </text>
    <text x={w / 2} y="292" class="ivt-sub" font-size="9.5" text-anchor="middle">
      The proof takes c = sup{"{"}x : f(x) &lt; 0{"}"}, which exists only because ℝ is complete
    </text>
  </svg>
</figure>

<style>
  .ivt { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ivt svg { width:100%; max-width:100%; height:auto; }
  .ivt-axis { stroke:#888; stroke-width:1.3; }
  .ivt-zero { stroke:#7ee787; stroke-width:1.4; stroke-dasharray:5,4; }
  .ivt-zerolbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .ivt-curve { stroke:#58a6ff; stroke-width:2.2; }
  .ivt-c-orange { stroke:#f0883e; }
  .ivt-root { fill:#7ee787; stroke:#eee; stroke-width:1.2; }
  .ivt-filled { fill:#f0883e; stroke:#f0883e; stroke-width:2; }
  .ivt-hole { fill:#0d1117; stroke:#f0883e; stroke-width:2; }
  .ivt-title { fill:#c9d1d9; font-family:'Libre Baskerville',Georgia,serif; }
  .ivt-clbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .ivt-endlbl { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .ivt-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .ivt-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ivt-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .ivt-axis { stroke:#666; }
  :global([data-theme="light"]) .ivt-zero, :global([data-theme="light"]) .ivt-zerolbl, :global([data-theme="light"]) .ivt-clbl { stroke:#116329; fill:#116329; }
  :global([data-theme="light"]) .ivt-root { fill:#116329; stroke:#fff; }
  :global([data-theme="light"]) .ivt-curve, :global([data-theme="light"]) .ivt-foot { stroke:#0550ae; fill:#0550ae; }
  :global([data-theme="light"]) .ivt-curve { fill:none; }
  :global([data-theme="light"]) .ivt-c-orange, :global([data-theme="light"]) .ivt-filled { stroke:#b35900; fill:#b35900; }
  :global([data-theme="light"]) .ivt-c-orange { fill:none; }
  :global([data-theme="light"]) .ivt-hole { fill:#ffffff; stroke:#b35900; }
  :global([data-theme="light"]) .ivt-title { fill:#24292f; }
  :global([data-theme="light"]) :is(.ivt-endlbl, .ivt-sub) { fill:#57606a; }
  :global([data-theme="light"]) .ivt-head { fill:#24292f; }
</style>
