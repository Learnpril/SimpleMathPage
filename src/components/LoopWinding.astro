---
/**
 * LoopWinding - loops in the punctured plane, labelled by their winding number about
 * the hole. Each winding number is measured by accumulating the change in angle along
 * the drawn loop, so the labels are read off the curves rather than assigned.
 */
const w = 540;
const h = 306;

const cy = 152;
const unit = 40;

type Loop = { cx: number; name: string; n: number; cls: string };

/** A loop that winds n times about the hole, drawn with a little radial wobble. */
function points(cx: number, n: number) {
  const N = 720;
  const pts: { x: number; y: number }[] = [];
  for (let k = 0; k <= N; k++) {
    const u = k / N;
    const a = 2 * Math.PI * n * u;
    const r = n === 0 ? 0.55 : 0.62 + 0.24 * Math.sin(2 * Math.PI * u);
    if (n === 0) {
      // a loop off to one side, not enclosing the hole
      pts.push({ x: 1.05 + r * Math.cos(2 * Math.PI * u), y: r * Math.sin(2 * Math.PI * u) });
    } else {
      pts.push({ x: r * Math.cos(a), y: r * Math.sin(a) });
    }
  }
  return pts;
}

/** Accumulated change in argument about the origin, divided by 2π. */
function winding(pts: { x: number; y: number }[]) {
  let total = 0;
  for (let k = 1; k < pts.length; k++) {
    let d = Math.atan2(pts[k].y, pts[k].x) - Math.atan2(pts[k - 1].y, pts[k - 1].x);
    while (d > Math.PI) d -= 2 * Math.PI;
    while (d < -Math.PI) d += 2 * Math.PI;
    total += d;
  }
  return total / (2 * Math.PI);
}

const loops: Loop[] = [
  { cx: 92, name: "constant class", n: 0, cls: "g" },
  { cx: 246, name: "once around", n: 1, cls: "b" },
  { cx: 400, name: "twice around", n: 2, cls: "p" },
];

const measured = loops.map((L) => {
  const pts = points(L.cx, L.n);
  return {
    ...L,
    measure: winding(pts),
    path: pts.map((p) => `${(L.cx + p.x * unit).toFixed(1)},${(cy - p.y * unit).toFixed(1)}`).join(" "),
  };
});
---

<figure
  class="lwn"
  role="img"
  aria-label={`Three loops in the punctured plane. Their winding numbers about the hole, measured by accumulating the change in angle, are ${measured
    .map((m) => Math.round(m.measure))
    .join(", ")}. Loops are homotopic exactly when these integers agree, so the fundamental group of the punctured plane is the integers.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="lwn-head" font-size="12.5" font-weight="bold">Loops remember how often they went round</text>
    <text x="16" y="38" class="lwn-sub" font-size="10.5">Winding number about the puncture, measured from each drawn loop</text>

    {measured.map((m) => (
      <g>
        <text x={m.cx} y="62" class={`lwn-name lwn-t-${m.cls}`} font-size="10" text-anchor="middle" font-weight="bold">{m.name}</text>
        <polyline points={m.path} class={`lwn-loop lwn-s-${m.cls}`} fill="none" />
        <line x1={m.cx - 5.5} y1={cy - 5.5} x2={m.cx + 5.5} y2={cy + 5.5} class="lwn-hole" />
        <line x1={m.cx - 5.5} y1={cy + 5.5} x2={m.cx + 5.5} y2={cy - 5.5} class="lwn-hole" />
        <text x={m.cx} y="222" class={`lwn-val lwn-t-${m.cls}`} font-size="10.5" text-anchor="middle" font-weight="bold">
          {`winding = ${Math.round(m.measure)}`}
        </text>
        <text x={m.cx} y="240" class="lwn-note" font-size="9" text-anchor="middle">{`measured ${m.measure.toFixed(3)}`}</text>
      </g>
    ))}

    <text x="486" y="152" class="lwn-side" font-size="9.5" text-anchor="middle">× marks</text>
    <text x="486" y="168" class="lwn-side" font-size="9.5" text-anchor="middle">the hole</text>

    <text x={w / 2} y="268" class="lwn-foot" font-size="10.5" text-anchor="middle">
      π₁(ℝ² ∖ {"{"}0{"}"}) ≅ ℤ, with the winding number as the isomorphism
    </text>
    <text x={w / 2} y="288" class="lwn-sub2" font-size="9.5" text-anchor="middle">
      Concatenating loops adds winding numbers, which is why the group is ℤ and not just a set
    </text>
  </svg>
</figure>

<style>
  .lwn { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .lwn svg { width:100%; max-width:100%; height:auto; }
  .lwn-loop { stroke-width:2; }
  .lwn-s-g { stroke:#7ee787; }
  .lwn-s-b { stroke:#58a6ff; }
  .lwn-s-p { stroke:#d2a8ff; }
  .lwn-t-g { fill:#7ee787; }
  .lwn-t-b { fill:#58a6ff; }
  .lwn-t-p { fill:#d2a8ff; }
  .lwn-hole { stroke:#ff7b72; stroke-width:2.6; }
  .lwn-name, .lwn-val { font-family:'Libre Baskerville',Georgia,serif; }
  .lwn-note, .lwn-side { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .lwn-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .lwn-sub, .lwn-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .lwn-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .lwn-s-g { stroke:#116329; }
  :global([data-theme="light"]) .lwn-t-g { fill:#116329; }
  :global([data-theme="light"]) .lwn-s-b { stroke:#0550ae; }
  :global([data-theme="light"]) .lwn-t-b { fill:#0550ae; }
  :global([data-theme="light"]) .lwn-s-p { stroke:#6639ba; }
  :global([data-theme="light"]) .lwn-t-p { fill:#6639ba; }
  :global([data-theme="light"]) .lwn-hole { stroke:#a40e26; }
  :global([data-theme="light"]) .lwn-head { fill:#24292f; }
  :global([data-theme="light"]) .lwn-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.lwn-note, .lwn-side, .lwn-sub, .lwn-sub2) { fill:#57606a; }
</style>
