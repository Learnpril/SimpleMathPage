---
/**
 * TanGraph — plots y = tan(x) from -π/2 to 3π/2 (two periods)
 * with asymptotes shown as dashed vertical lines.
 */
const w = 520;
const h = 280;
const pad = 40;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const cxO = pad;
const cyO = pad + gh / 2;
const xMin = -Math.PI / 2 - 0.3;
const xMax = 3 * Math.PI / 2 + 0.3;
const scaleX = gw / (xMax - xMin);
const scaleY = gh / 6; // clamp visual range to about -3 to 3

function px(x: number) { return cxO + (x - xMin) * scaleX; }
function py(y: number) { return cyO - y * scaleY; }

// Generate tan curve segments (skip near asymptotes)
const segments: string[][] = [];
let seg: string[] = [];
for (let t = -Math.PI / 2 + 0.08; t <= 3 * Math.PI / 2 - 0.08; t += 0.02) {
  const v = Math.tan(t);
  if (Math.abs(v) > 3.2) {
    if (seg.length > 1) segments.push(seg);
    seg = [];
    continue;
  }
  seg.push(`${seg.length === 0 ? 'M' : 'L'}${px(t).toFixed(1)},${py(v).toFixed(1)}`);
}
if (seg.length > 1) segments.push(seg);

const asymptotes = [-Math.PI / 2, Math.PI / 2, 3 * Math.PI / 2];
const xTicks = [
  { val: 0, label: '0' },
  { val: Math.PI / 2, label: 'π/2' },
  { val: Math.PI, label: 'π' },
  { val: 3 * Math.PI / 2, label: '3π/2' },
];
---

<figure class="tng" role="img" aria-label="Graph of y = tan(x) showing two periods with asymptotes">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Axes */}
    <line x1={cxO - 5} y1={cyO} x2={w - pad + 10} y2={cyO} class="tng-axis" stroke-width="1.5" />
    <line x1={px(0)} y1={pad - 5} x2={px(0)} y2={h - pad + 5} class="tng-axis" stroke-width="1.5" />

    {/* Asymptotes */}
    {asymptotes.map(a => (
      <line x1={px(a)} y1={pad - 5} x2={px(a)} y2={h - pad + 5} class="tng-asymptote" stroke-width="1.5" stroke-dasharray="6,4" />
    ))}

    {/* Y ticks */}
    <text class="tng-tick" x={px(0) - 8} y={py(1) + 4} font-size="11" text-anchor="end">1</text>
    <text class="tng-tick" x={px(0) - 8} y={py(-1) + 4} font-size="11" text-anchor="end">-1</text>

    {/* X ticks */}
    {xTicks.map(t => (
      <text class="tng-tick" x={px(t.val)} y={cyO + 18} font-size="11" text-anchor="middle">{t.label}</text>
    ))}

    {/* Tan curve segments */}
    {segments.map(s => (
      <path d={s.join(' ')} fill="none" class="tng-curve" stroke-width="2.5" />
    ))}

    {/* Key point at origin */}
    <circle cx={px(0)} cy={py(0)} r="4" class="tng-dot" />
    <circle cx={px(Math.PI)} cy={py(0)} r="4" class="tng-dot" />

    {/* Legend */}
    <line x1={w - 120} y1="14" x2={w - 100} y2="14" class="tng-curve" stroke-width="2.5" />
    <text class="tng-legend" x={w - 95} y="18" font-size="12">y = tan(x)</text>
  </svg>
</figure>

<style>
  .tng { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .tng svg { max-width:100%; height:auto; }
  .tng-axis { stroke:#666; }
  .tng-asymptote { stroke:#f47067; opacity:0.6; }
  .tng-tick { fill:#999; font-family:'Libre Baskerville',Georgia,serif; }
  .tng-curve { stroke:#f0883e; }
  .tng-dot { fill:#f0883e; }
  .tng-legend { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }

  :global([data-theme="light"]) .tng-axis { stroke:#999; }
  :global([data-theme="light"]) .tng-asymptote { stroke:#cf222e; }
  :global([data-theme="light"]) .tng-tick { fill:#555; }
  :global([data-theme="light"]) .tng-curve { stroke:#d4700a; }
  :global([data-theme="light"]) .tng-dot { fill:#d4700a; }
  :global([data-theme="light"]) .tng-legend { fill:#d4700a; }
</style>
