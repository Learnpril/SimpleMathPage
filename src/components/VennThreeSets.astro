---
/**
 * VennThreeSets - the three-circle Venn diagram with all 8 regions filled in,
 * using the developer survey numbers from the inclusion-exclusion example.
 * Working from the centre outward is what keeps the counts consistent.
 */
const w = 480;
const h = 330;
const r = 70;
const P = { cx: 180, cy: 125 };
const J = { cx: 260, cy: 125 };
const R = { cx: 220, cy: 192 };
const regions = [
  { x: 145, y: 130, n: "25" },
  { x: 297, y: 130, n: "15" },
  { x: 220, y: 92, n: "20" },
  { x: 172, y: 178, n: "10" },
  { x: 268, y: 178, n: "5" },
  { x: 220, y: 152, n: "5" },
  { x: 220, y: 226, n: "10" },
];
---

<figure
  class="v3s"
  role="img"
  aria-label="Three overlapping circles for Python, JavaScript and Rust users, with all eight regions labelled: 25 Python only, 15 JavaScript only, 10 Rust only, 20 Python and JavaScript, 10 Python and Rust, 5 JavaScript and Rust, 5 all three, and 10 using none"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Universe */}
    <rect x="20" y="42" width="440" height="228" rx="4" class="v3s-universe" />
    <text x="28" y="58" class="v3s-u" font-size="11">U = 100 surveyed</text>

    {/* Circles */}
    <circle cx={P.cx} cy={P.cy} r={r} class="v3s-c v3s-p" />
    <circle cx={J.cx} cy={J.cy} r={r} class="v3s-c v3s-j" />
    <circle cx={R.cx} cy={R.cy} r={r} class="v3s-c v3s-r" />

    {/* Set names */}
    <text x="118" y="82" class="v3s-name v3s-t-p" font-size="13" font-weight="bold" text-anchor="middle">Python</text>
    <text x="322" y="82" class="v3s-name v3s-t-j" font-size="13" font-weight="bold" text-anchor="middle">JavaScript</text>
    <text x="220" y="252" class="v3s-name v3s-t-r" font-size="13" font-weight="bold" text-anchor="middle">Rust</text>

    {/* Region counts */}
    {regions.map((g) => (
      <text x={g.x} y={g.y} class="v3s-count" font-size="14" font-weight="bold" text-anchor="middle">{g.n}</text>
    ))}

    {/* The "none" region */}
    <text x="410" y="240" class="v3s-count v3s-none" font-size="14" font-weight="bold" text-anchor="middle">10</text>
    <text x="410" y="256" class="v3s-none-lbl" font-size="9.5" text-anchor="middle">none</text>

    {/* Footer */}
    <text x={w / 2} y="290" class="v3s-foot" font-size="11" text-anchor="middle">
      Fill the centre first, then work outward
    </text>
    <text x={w / 2} y="306" class="v3s-sub" font-size="10" text-anchor="middle">
      25 + 15 + 10 + 20 + 10 + 5 + 5 = 90 use at least one
    </text>
    <text x={w / 2} y="320" class="v3s-sub" font-size="10" text-anchor="middle">
      Inclusion-exclusion agrees: 60 + 45 + 30 − 25 − 15 − 10 + 5 = 90
    </text>
  </svg>
</figure>

<style>
  .v3s { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .v3s svg { max-width:100%; height:auto; }
  .v3s-universe { fill:none; stroke:#555; stroke-width:1; }
  .v3s-c { fill-opacity:0.10; stroke-width:2; }
  .v3s-p { fill:#7ee787; stroke:#7ee787; }
  .v3s-j { fill:#58a6ff; stroke:#58a6ff; }
  .v3s-r { fill:#f0883e; stroke:#f0883e; }
  .v3s-name { font-family:'Libre Baskerville',Georgia,serif; }
  .v3s-t-p { fill:#7ee787; }
  .v3s-t-j { fill:#58a6ff; }
  .v3s-t-r { fill:#f0883e; }
  .v3s-count { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .v3s-none { fill:#888; }
  .v3s-none-lbl { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .v3s-u { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .v3s-foot { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .v3s-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .v3s-universe { stroke:#ccc; }
  :global([data-theme="light"]) .v3s-p { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .v3s-j { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .v3s-r { fill:#b35900; stroke:#b35900; }
  :global([data-theme="light"]) .v3s-t-p { fill:#116329; }
  :global([data-theme="light"]) .v3s-t-j { fill:#0550ae; }
  :global([data-theme="light"]) .v3s-t-r { fill:#b35900; }
  :global([data-theme="light"]) .v3s-count { fill:#24292f; }
  :global([data-theme="light"]) .v3s-none { fill:#666; }
  :global([data-theme="light"]) .v3s-foot { fill:#6639ba; }
</style>
