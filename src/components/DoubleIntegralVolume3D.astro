---
/**
 * DoubleIntegralVolume3D - Interactive 3D visual showing the volume
 * under z = x + 2y over the rectangle [0,2] x [1,3].
 * The surface is a tilted plane, and the volume underneath is shaded.
 * Lazy-loads Three.js via IntersectionObserver.
 */
---

<figure class="div3" role="img" aria-label="Interactive 3D visualization of the volume under z equals x plus 2y over the rectangle [0,2] times [1,3]">
  <div class="div3-canvas" data-div3d></div>
  <div class="div3-hint">Drag to rotate · Scroll/Pinch to zoom</div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initScene(container: HTMLElement) {
    const width = Math.min(container.clientWidth, 520);
    const height = 380;
    const isDark = document.documentElement.dataset.theme !== "light";
    const bgColor = isDark ? 0x121212 : 0xf8f9fa;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(bgColor);

    const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 200);
    camera.position.set(6, 5, 7);
    camera.lookAt(1, 2, 2);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Surface z = x + 2y over [0,2] x [1,3]
    // In Three.js: x = math x, z = math y, y = math z (up)
    const seg = 20;
    const surfGeo = new THREE.BufferGeometry();
    const verts: number[] = [];
    const colors: number[] = [];
    const indices: number[] = [];

    for (let i = 0; i <= seg; i++) {
      for (let j = 0; j <= seg; j++) {
        const x = (2 * i) / seg;       // 0 to 2
        const my = 1 + (2 * j) / seg;  // 1 to 3
        const z = x + 2 * my;          // z = x + 2y
        verts.push(x, z * 0.4, my);    // scale z for visual

        const t = (z - 2) / 6;
        if (isDark) {
          colors.push(0.34 + t * 0.3, 0.5 + t * 0.2, 1.0 - t * 0.3);
        } else {
          colors.push(0.02 + t * 0.2, 0.25 + t * 0.15, 0.68 - t * 0.2);
        }
      }
    }

    for (let i = 0; i < seg; i++) {
      for (let j = 0; j < seg; j++) {
        const a = i * (seg + 1) + j;
        const b = a + 1;
        const c = a + seg + 1;
        const d = c + 1;
        indices.push(a, b, c, b, d, c);
      }
    }

    surfGeo.setAttribute("position", new THREE.Float32BufferAttribute(verts, 3));
    surfGeo.setAttribute("color", new THREE.Float32BufferAttribute(colors, 3));
    surfGeo.setIndex(indices);
    surfGeo.computeVertexNormals();

    const surfMat = new THREE.MeshPhongMaterial({
      vertexColors: true, side: THREE.DoubleSide,
      shininess: 30, transparent: true, opacity: 0.7,
    });
    scene.add(new THREE.Mesh(surfGeo, surfMat));

    // Base rectangle on the xy-plane (y=0 in Three.js)
    const baseGeo = new THREE.PlaneGeometry(2, 2);
    baseGeo.rotateX(-Math.PI / 2);
    baseGeo.translate(1, 0, 2); // center at (1, 0, 2) in Three.js = (1, 2) in math
    const baseMat = new THREE.MeshBasicMaterial({
      color: isDark ? 0x7ee787 : 0x116329,
      transparent: true, opacity: 0.2, side: THREE.DoubleSide,
    });
    scene.add(new THREE.Mesh(baseGeo, baseMat));

    // Vertical walls (sides of the volume)
    const wallColor = isDark ? 0x58a6ff : 0x0550ae;
    const wallMat = new THREE.MeshBasicMaterial({
      color: wallColor, transparent: true, opacity: 0.08, side: THREE.DoubleSide,
    });

    // Front wall: x=0, y from 1 to 3
    for (const [fx, fy1, fy2, fz1, fz2] of [
      [0, 1, 3, 0, 0],   // x=0
      [2, 1, 3, 0, 0],   // x=2
    ] as [number, number, number, number, number][]) {
      const wGeo = new THREE.BufferGeometry();
      const wv: number[] = [];
      const wi: number[] = [];
      const wSeg = 10;
      for (let j = 0; j <= wSeg; j++) {
        const my = fy1 + (fy2 - fy1) * j / wSeg;
        const z = fx + 2 * my;
        wv.push(fx, 0, my);
        wv.push(fx, z * 0.4, my);
      }
      for (let j = 0; j < wSeg; j++) {
        const a = j * 2;
        wi.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
      }
      wGeo.setAttribute("position", new THREE.Float32BufferAttribute(wv, 3));
      wGeo.setIndex(wi);
      wGeo.computeVertexNormals();
      scene.add(new THREE.Mesh(wGeo, wallMat));
    }

    // Axes
    const axColor = isDark ? 0x666666 : 0x999999;
    const axMat = new THREE.LineBasicMaterial({ color: axColor });
    for (const dir of [[4, 0, 0], [0, 4, 0], [0, 0, 4.5]] as [number, number, number][]) {
      const pts = [new THREE.Vector3(0, 0, 0), new THREE.Vector3(...dir)];
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), axMat));
    }

    // Axis labels
    function makeLabel(text: string, pos: [number, number, number], color: string, size = 0.4) {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      canvas.width = 256; canvas.height = 64;
      ctx.font = "bold 32px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText(text, 128, 32);
      const tex = new THREE.CanvasTexture(canvas);
      const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
      const sprite = new THREE.Sprite(mat);
      sprite.position.set(...pos);
      sprite.scale.set(size * 2.5, size * 0.6, 1);
      scene.add(sprite);
    }

    const lc = isDark ? "#888" : "#666";
    makeLabel("x", [3.8, -0.2, 0], lc, 0.4);
    makeLabel("z", [0, 3.8, 0], lc, 0.4);
    makeLabel("y", [0, -0.2, 4.2], lc, 0.4);
    makeLabel("[0,2]×[1,3]", [1, -0.4, 2], isDark ? "#7ee787" : "#116329", 0.5);

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.5));
    const dl = new THREE.DirectionalLight(0xffffff, 0.8);
    dl.position.set(3, 6, 4);
    scene.add(dl);

    // Controls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.6;
    controls.enableZoom = true;
    controls.minDistance = 5;
    controls.maxDistance = 25;
    controls.target.set(1, 1.5, 2);

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    return () => { cancelAnimationFrame(animId); renderer.dispose(); };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-div3d]").forEach((el) => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(
        (entries) => { if (entries[0].isIntersecting) { obs.disconnect(); initScene(el); } },
        { threshold: 0.05 }
      );
      obs.observe(el);
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .div3 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .div3-canvas {
    width:100%; max-width:520px; min-height:380px;
    border-radius:8px; overflow:hidden;
  }
  .div3-canvas canvas { border-radius:8px; }
  .div3-hint {
    font-family:'Libre Baskerville',Georgia,serif;
    font-size:0.8rem; color:#888; margin-top:0.4rem;
  }
</style>
