---
/**
 * ProbabilityScale — the 0 to 1 number line with landmark probabilities and
 * everyday events placed along it.
 */
const w = 540;
const h = 212;
const left = 40;
const right = 500;
const barY = 92;
const barH = 22;
const sx = (p: number) => left + p * (right - left);

const ticks = [0, 0.25, 0.5, 0.75, 1];
const events = [
  { p: 0, label: "impossible", note: "a 7 on one die", up: true },
  { p: 1 / 6, label: "1/6", note: "rolling a six", up: false },
  { p: 0.5, label: "even odds", note: "a coin lands heads", up: true },
  { p: 5 / 6, label: "5/6", note: "not rolling a six", up: false },
  { p: 1, label: "certain", note: "rolling under 7", up: true },
];
---

<figure
  class="prs"
  role="img"
  aria-label="A probability scale from 0 for impossible to 1 for certain, with landmark events such as rolling a six at one sixth and a coin landing heads at one half"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="prs-head" font-size="12.5" font-weight="bold">Every probability lives between 0 and 1</text>

    {/* Gradient bar */}
    <defs>
      <linearGradient id="prs-grad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" class="prs-stop-lo" />
        <stop offset="50%" class="prs-stop-mid" />
        <stop offset="100%" class="prs-stop-hi" />
      </linearGradient>
    </defs>
    <rect x={left} y={barY} width={right - left} height={barH} rx="4" fill="url(#prs-grad)" class="prs-bar" />

    {/* Ticks */}
    {ticks.map((t) => (
      <g>
        <line x1={sx(t)} y1={barY + barH} x2={sx(t)} y2={barY + barH + 7} class="prs-axis" />
        <text x={sx(t)} y={barY + barH + 20} class="prs-tick" font-size="10" text-anchor="middle">{t}</text>
        <text x={sx(t)} y={barY + barH + 33} class="prs-pct" font-size="9.5" text-anchor="middle">{`${t * 100}%`}</text>
      </g>
    ))}

    {/* Event markers */}
    {events.map((e) => (
      <g>
        <line
          x1={sx(e.p)}
          y1={e.up ? barY - 4 : barY + barH + 4}
          x2={sx(e.p)}
          y2={e.up ? barY - 16 : barY + barH + 40}
          class="prs-mark"
        />
        <text
          x={sx(e.p)}
          y={e.up ? barY - 22 : barY + barH + 52}
          class="prs-elabel"
          font-size="9.5"
          text-anchor="middle"
          font-weight="bold"
        >{e.label}</text>
        <text
          x={sx(e.p)}
          y={e.up ? barY - 37 : barY + barH + 66}
          class="prs-enote"
          font-size="9.5"
          text-anchor="middle"
        >{e.note}</text>
      </g>
    ))}

    <text x={w / 2} y={h - 8} class="prs-foot" font-size="10" text-anchor="middle">
      A computed probability above 1 or below 0 always means an error somewhere
    </text>
  </svg>
</figure>

<style>
  .prs { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .prs svg { width:100%; max-width:100%; height:auto; }
  .prs-bar { stroke:#555; stroke-width:1; }
  .prs-stop-lo { stop-color:#f0883e; stop-opacity:0.55; }
  .prs-stop-mid { stop-color:#d2a8ff; stop-opacity:0.5; }
  .prs-stop-hi { stop-color:#7ee787; stop-opacity:0.55; }
  .prs-axis { stroke:#888; stroke-width:1.3; }
  .prs-tick { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .prs-pct { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .prs-mark { stroke:#58a6ff; stroke-width:1.4; }
  .prs-elabel { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .prs-enote { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .prs-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .prs-foot { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .prs-bar { stroke:#ccc; }
  :global([data-theme="light"]) .prs-stop-lo { stop-color:#b35900; stop-opacity:0.35; }
  :global([data-theme="light"]) .prs-stop-mid { stop-color:#6639ba; stop-opacity:0.3; }
  :global([data-theme="light"]) .prs-stop-hi { stop-color:#116329; stop-opacity:0.35; }
  :global([data-theme="light"]) .prs-tick { fill:#444; }
  :global([data-theme="light"]) .prs-mark { stroke:#0550ae; }
  :global([data-theme="light"]) .prs-elabel { fill:#0550ae; }
  :global([data-theme="light"]) .prs-head { fill:#24292f; }
</style>
