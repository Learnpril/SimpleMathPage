---
/**
 * ConfidenceIntervalDiagram — twenty intervals from twenty samples against a
 * fixed true parameter. One misses, which is the point: the confidence level
 * describes the method's long-run hit rate, not one interval's probability.
 */
const w = 540;
const h = 308;
const trueX = 300;
const rowTop = 60;
const rowGap = 9.6;
const count = 20;

// Deterministic offsets and widths so the figure is stable across builds
const intervals = Array.from({ length: count }, (_, i) => {
  const centre = trueX + Math.sin(i * 2.7) * 46;
  const half = 42 + Math.cos(i * 1.9) * 7;
  const contains = centre - half <= trueX && centre + half >= trueX;
  return { y: rowTop + i * rowGap, centre, half, contains };
});
const misses = intervals.filter((iv) => !iv.contains).length;
const hits = count - misses;
---

<figure
  class="cid"
  role="img"
  aria-label={`Twenty confidence intervals from twenty different samples plotted against a fixed true parameter. ${hits} of them contain the parameter and ${misses} miss it, illustrating that the confidence level describes the method rather than a single interval.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="cid-head" font-size="12.5" font-weight="bold">Twenty samples, twenty intervals</text>
    <text x="16" y="38" class="cid-sub" font-size="10">the parameter never moves; the intervals do</text>

    {/* True parameter line */}
    <line x1={trueX} y1={rowTop - 14} x2={trueX} y2={rowTop + count * rowGap + 6} class="cid-true" />
    <text x={trueX} y={rowTop - 20} class="cid-true-lbl" font-size="10.5" text-anchor="middle" font-weight="bold">
      true μ
    </text>

    {/* Intervals */}
    {intervals.map((iv) => (
      <g>
        <line
          x1={iv.centre - iv.half}
          y1={iv.y}
          x2={iv.centre + iv.half}
          y2={iv.y}
          class={iv.contains ? "cid-bar-hit" : "cid-bar-miss"}
        />
        <line x1={iv.centre - iv.half} y1={iv.y - 3} x2={iv.centre - iv.half} y2={iv.y + 3} class={iv.contains ? "cid-cap-hit" : "cid-cap-miss"} />
        <line x1={iv.centre + iv.half} y1={iv.y - 3} x2={iv.centre + iv.half} y2={iv.y + 3} class={iv.contains ? "cid-cap-hit" : "cid-cap-miss"} />
        <circle cx={iv.centre} cy={iv.y} r="2.4" class={iv.contains ? "cid-dot-hit" : "cid-dot-miss"} />
        {!iv.contains && (
          /* Label on the side facing away from the parameter, so the dashed
             true-mu line never runs through the word */
          iv.centre < trueX ? (
            <text x={iv.centre - iv.half - 10} y={iv.y + 3} class="cid-miss-lbl" font-size="9.5" text-anchor="end">misses</text>
          ) : (
            <text x={iv.centre + iv.half + 10} y={iv.y + 3} class="cid-miss-lbl" font-size="9.5">misses</text>
          )
        )}
      </g>
    ))}

    {/* Legend */}
    <line x1="30" y1="268" x2="62" y2="268" class="cid-bar-hit" />
    <text x="70" y="271" class="cid-legend" font-size="9.5">{`contains μ (${hits} of ${count})`}</text>
    <line x1="220" y1="268" x2="252" y2="268" class="cid-bar-miss" />
    <text x="260" y="271" class="cid-legend" font-size="9.5">{`misses μ (${misses} of ${count})`}</text>

    <text x={w / 2} y="286" class="cid-foot" font-size="10" text-anchor="middle">
      “95% confident” describes the method's long-run hit rate
    </text>
    <text x={w / 2} y="300" class="cid-foot" font-size="10" text-anchor="middle">
      not the probability that this one interval is lucky
    </text>
  </svg>
</figure>

<style>
  .cid { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cid svg { width:100%; max-width:100%; height:auto; }
  .cid-true { stroke:#d2a8ff; stroke-width:2.2; stroke-dasharray:5,3; }
  .cid-true-lbl { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .cid-bar-hit { stroke:#7ee787; stroke-width:2; }
  .cid-bar-miss { stroke:#f0883e; stroke-width:2.4; }
  .cid-cap-hit { stroke:#7ee787; stroke-width:2; }
  .cid-cap-miss { stroke:#f0883e; stroke-width:2.4; }
  .cid-dot-hit { fill:#7ee787; }
  .cid-dot-miss { fill:#f0883e; }
  .cid-miss-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cid-legend { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .cid-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .cid-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cid-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .cid-true, :global([data-theme="light"]) .cid-true-lbl { stroke:#6639ba; fill:#6639ba; }
  :global([data-theme="light"]) .cid-bar-hit, :global([data-theme="light"]) .cid-cap-hit, :global([data-theme="light"]) .cid-dot-hit { stroke:#116329; fill:#116329; }
  :global([data-theme="light"]) .cid-bar-miss, :global([data-theme="light"]) .cid-cap-miss, :global([data-theme="light"]) .cid-dot-miss { stroke:#b35900; fill:#b35900; }
  :global([data-theme="light"]) .cid-miss-lbl { fill:#b35900; }
  :global([data-theme="light"]) .cid-head { fill:#24292f; }
  :global([data-theme="light"]) .cid-foot { fill:#0550ae; }
</style>
