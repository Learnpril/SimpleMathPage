---
/**
 * CauchyRiemannCheck — the Cauchy–Riemann test applied to z² and to conj(z).
 * Every partial derivative shown is computed by a central difference on the
 * actual u and v, and the verdict is decided by comparing those numbers, so the
 * figure cannot claim a pass or fail that the arithmetic does not support.
 */
const w = 540;
const h = 284;

const x0 = 2;
const y0 = 1;
const eps = 1e-5;

type Comp = (x: number, y: number) => number;
const dx = (g: Comp) => (g(x0 + eps, y0) - g(x0 - eps, y0)) / (2 * eps);
const dy = (g: Comp) => (g(x0, y0 + eps) - g(x0, y0 - eps)) / (2 * eps);
const tidy = (v: number) => {
  const r = Math.abs(v) < 1e-6 ? 0 : v;
  const s = Math.abs(r - Math.round(r)) < 1e-4 ? String(Math.round(r)) : r.toFixed(3);
  return s.replace("-", "−");
};

const cases = [
  {
    cx: 140,
    title: "f(z) = z²",
    uText: "u = x² − y²",
    vText: "v = 2xy",
    u: (x: number, y: number) => x * x - y * y,
    v: (x: number, y: number) => 2 * x * y,
  },
  {
    cx: 400,
    title: "f(z) = z̄",
    uText: "u = x",
    vText: "v = −y",
    u: (x: number) => x,
    v: (_x: number, y: number) => -y,
  },
].map((c) => {
  const ux = dx(c.u);
  const uy = dy(c.u);
  const vx = dx(c.v);
  const vy = dy(c.v);
  const first = Math.abs(ux - vy) < 1e-4;
  const second = Math.abs(uy + vx) < 1e-4;
  return { ...c, ux, uy, vx, vy, first, second, pass: first && second };
});
---

<figure
  class="crc"
  role="img"
  aria-label={`The Cauchy-Riemann equations tested at the point 2 plus i. For z squared both equations hold, so the function is differentiable there. For the conjugate, the first equation fails because u sub x is ${tidy(cases[1].ux)} while v sub y is ${tidy(cases[1].vy)}, so it is not differentiable.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="crc-head" font-size="12.5" font-weight="bold">The test that decides differentiability</text>
    <text x="16" y="38" class="crc-sub" font-size="10.5">{`uₓ = v_y and u_y = −vₓ, checked at z = ${x0} + ${y0}i`}</text>

    <line x1="270" y1="52" x2="270" y2="212" class="crc-divide" />

    {cases.map((c) => (
      <g>
        <text x={c.cx} y="66" class={`crc-title crc-${c.pass ? "ok" : "bad"}`} font-size="11.5" text-anchor="middle" font-weight="bold">{c.title}</text>

        <text x={c.cx} y="90" class="crc-row" font-size="10" text-anchor="middle">{c.uText}</text>
        <text x={c.cx} y="108" class="crc-row" font-size="10" text-anchor="middle">{c.vText}</text>

        <text x={c.cx} y="136" class={`crc-eq crc-${c.first ? "ok" : "bad"}`} font-size="10" text-anchor="middle">
          {`uₓ = ${tidy(c.ux)}   v_y = ${tidy(c.vy)}   ${c.first ? "✓" : "✗"}`}
        </text>
        <text x={c.cx} y="156" class={`crc-eq crc-${c.second ? "ok" : "bad"}`} font-size="10" text-anchor="middle">
          {`u_y = ${tidy(c.uy)}   −vₓ = ${tidy(-c.vx)}   ${c.second ? "✓" : "✗"}`}
        </text>

        <text x={c.cx} y="184" class={`crc-verdict crc-${c.pass ? "ok" : "bad"}`} font-size="11" text-anchor="middle" font-weight="bold">
          {c.pass ? "both hold: differentiable" : "one fails: not differentiable"}
        </text>
        <text x={c.cx} y="204" class="crc-note" font-size="9.5" text-anchor="middle">
          {c.pass ? `f′(z) = uₓ + i vₓ = ${tidy(c.ux)} + ${tidy(c.vx)}i` : "no derivative at any point"}
        </text>
      </g>
    ))}

    <text x={w / 2} y="238" class="crc-foot" font-size="10.5" text-anchor="middle">
      Complex differentiability at a point requires both equations, plus continuous partials nearby
    </text>
    <text x={w / 2} y="258" class="crc-sub2" font-size="9.5" text-anchor="middle">
      The equations are what "the limit is the same from every direction" turns into
    </text>
    <text x={w / 2} y="276" class="crc-sub2" font-size="9.5" text-anchor="middle">
      Conjugation fails everywhere, which is why z̄ never appears in an analytic formula
    </text>
  </svg>
</figure>

<style>
  .crc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .crc svg { width:100%; max-width:100%; height:auto; }
  .crc-divide { stroke:#3a3a3a; stroke-width:1; }
  .crc-title, .crc-eq, .crc-verdict { font-family:'Libre Baskerville',Georgia,serif; }
  .crc-ok { fill:#7ee787; }
  .crc-bad { fill:#ff7b72; }
  .crc-row, .crc-note { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .crc-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .crc-sub, .crc-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .crc-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .crc-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .crc-ok { fill:#116329; }
  :global([data-theme="light"]) .crc-bad { fill:#a40e26; }
  :global([data-theme="light"]) .crc-head { fill:#24292f; }
  :global([data-theme="light"]) .crc-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.crc-row, .crc-note, .crc-sub, .crc-sub2) { fill:#57606a; }
</style>
