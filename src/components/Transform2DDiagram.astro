---
/**
 * Transform2DDiagram - shows a unit square being rotated by 45°
 * Blue = original, Green = transformed
 * Grid + axes for reference.
 */
---
<div class="diagram-container">
<svg viewBox="-30 -30 310 280" width="100%" style="max-width:380px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="2D transformation: unit square rotated 45 degrees">

  {/* Grid */}
  <g stroke="#333" stroke-width="0.5" opacity="0.15">
    {[0,40,80,120,160,200,240].map(x => <line x1={x} y1="-20" x2={x} y2="220" />)}
    {[0,40,80,120,160,200].map(y => <line x1="-20" y1={y} x2="250" y2={y} />)}
  </g>

  {/* Axes: origin at (120, 160), scale 40px/unit */}
  <line x1="-20" y1="160" x2="250" y2="160" stroke="#666" stroke-width="1" class="t2d-axis" />
  <line x1="120" y1="220" x2="120" y2="-20" stroke="#666" stroke-width="1" class="t2d-axis" />

  {/* Axis labels */}
  <text x="245" y="155" fill="#888" font-size="10" font-family="serif">x</text>
  <text x="125" y="-12" fill="#888" font-size="10" font-family="serif">y</text>

  {/* Tick marks */}
  {[-2,-1,1,2].map(i => (
    <g>
      <line x1={120 + i*40} y1="157" x2={120 + i*40} y2="163" stroke="#666" stroke-width="0.8" class="t2d-axis" />
      <text x={120 + i*40} y="175" fill="#888" font-size="8" font-family="serif" text-anchor="middle">{i}</text>
    </g>
  ))}
  {[-2,-1,1,2].map(i => (
    <g>
      <line x1="117" y1={160 - i*40} x2="123" y2={160 - i*40} stroke="#666" stroke-width="0.8" class="t2d-axis" />
      <text x="110" y={160 - i*40 + 3} fill="#888" font-size="8" font-family="serif" text-anchor="end">{i}</text>
    </g>
  ))}

  {/* Original unit square (blue): (0,0), (1,0), (1,1), (0,1) */}
  <polygon
    points="120,160 160,160 160,120 120,120"
    fill="#58a6ff" fill-opacity="0.1" stroke="#58a6ff" stroke-width="2"
    class="t2d-blue-shape"
  />

  {/* Rotated by 45°: cos45 ≈ 0.707, sin45 ≈ 0.707 */}
  {/* (0,0) -> (0,0) = (120,160) */}
  {/* (1,0) -> (0.707, 0.707) = (120+28.3, 160-28.3) = (148.3, 131.7) */}
  {/* (1,1) -> (0, 1.414) = (120, 160-56.6) = (120, 103.4) */}
  {/* (0,1) -> (-0.707, 0.707) = (120-28.3, 160-28.3) = (91.7, 131.7) */}
  <polygon
    points="120,160 148.3,131.7 120,103.4 91.7,131.7"
    fill="#7ee787" fill-opacity="0.1" stroke="#7ee787" stroke-width="2"
    class="t2d-green-shape"
  />

  {/* Vertex dots - original */}
  <circle cx="120" cy="160" r="3" fill="#58a6ff" class="t2d-blue-dot" />
  <circle cx="160" cy="160" r="3" fill="#58a6ff" class="t2d-blue-dot" />
  <circle cx="160" cy="120" r="3" fill="#58a6ff" class="t2d-blue-dot" />
  <circle cx="120" cy="120" r="3" fill="#58a6ff" class="t2d-blue-dot" />

  {/* Vertex dots - transformed */}
  <circle cx="120" cy="160" r="3" fill="#7ee787" class="t2d-green-dot" />
  <circle cx="148.3" cy="131.7" r="3" fill="#7ee787" class="t2d-green-dot" />
  <circle cx="120" cy="103.4" r="3" fill="#7ee787" class="t2d-green-dot" />
  <circle cx="91.7" cy="131.7" r="3" fill="#7ee787" class="t2d-green-dot" />

  {/* Curved arrow showing rotation */}
  <path d="M 165,155 A 50,50 0 0,0 153,127" fill="none" stroke="#f0883e" stroke-width="1.5" class="t2d-orange-stroke" />
  <polygon points="153,127 158,132 150,133" fill="#f0883e" class="t2d-orange-fill" />
  <text x="170" y="140" fill="#f0883e" font-size="10" font-family="serif" class="t2d-orange-text">45°</text>

  {/* Labels */}
  <text x="165" y="118" fill="#58a6ff" font-size="9" font-family="serif" class="t2d-blue-text">(1,1)</text>
  <text x="163" y="172" fill="#58a6ff" font-size="9" font-family="serif" class="t2d-blue-text">(1,0)</text>
  <text x="84" y="135" fill="#7ee787" font-size="9" font-family="serif" text-anchor="end" class="t2d-green-text">(-0.71, 0.71)</text>
  <text x="100" y="98" fill="#7ee787" font-size="9" font-family="serif" class="t2d-green-text">(0, 1.41)</text>

  {/* Legend */}
  <g transform="translate(-20, 200)">
    <line x1="10" y1="0" x2="25" y2="0" stroke="#58a6ff" stroke-width="2" class="t2d-blue-line" />
    <text x="30" y="4" fill="#888" font-size="9" font-family="serif">Original unit square</text>
    <line x1="150" y1="0" x2="165" y2="0" stroke="#7ee787" stroke-width="2" class="t2d-green-line" />
    <text x="170" y="4" fill="#888" font-size="9" font-family="serif">After 45° rotation</text>
  </g>
</svg>
</div>

<style>
  .t2d-blue-shape { fill: #58a6ff; stroke: #58a6ff; }
  .t2d-green-shape { fill: #7ee787; stroke: #7ee787; }
  .t2d-blue-dot { fill: #58a6ff; }
  .t2d-green-dot { fill: #7ee787; }
  .t2d-blue-text { fill: #58a6ff; }
  .t2d-green-text { fill: #7ee787; }
  .t2d-orange-stroke { stroke: #f0883e; }
  .t2d-orange-fill { fill: #f0883e; }
  .t2d-orange-text { fill: #f0883e; }
  .t2d-blue-line { stroke: #58a6ff; }
  .t2d-green-line { stroke: #7ee787; }
  .t2d-axis { stroke: #666; }

  :global([data-theme="light"]) .t2d-blue-shape { fill: #0550ae; stroke: #0550ae; }
  :global([data-theme="light"]) .t2d-green-shape { fill: #1a7f2e; stroke: #1a7f2e; }
  :global([data-theme="light"]) .t2d-blue-dot { fill: #0550ae; }
  :global([data-theme="light"]) .t2d-green-dot { fill: #1a7f2e; }
  :global([data-theme="light"]) .t2d-blue-text { fill: #0550ae; }
  :global([data-theme="light"]) .t2d-green-text { fill: #1a7f2e; }
  :global([data-theme="light"]) .t2d-orange-stroke { stroke: #c05010; }
  :global([data-theme="light"]) .t2d-orange-fill { fill: #c05010; }
  :global([data-theme="light"]) .t2d-orange-text { fill: #c05010; }
  :global([data-theme="light"]) .t2d-blue-line { stroke: #0550ae; }
  :global([data-theme="light"]) .t2d-green-line { stroke: #1a7f2e; }
  :global([data-theme="light"]) .t2d-axis { stroke: #999; }
  :global([data-theme="light"]) svg text[fill="#888"] { fill: #555; }
  :global([data-theme="light"]) svg g[opacity="0.15"] line { stroke: #ccc; }
</style>
