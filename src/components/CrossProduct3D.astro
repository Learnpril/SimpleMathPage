---
/**
 * CrossProduct3D — Interactive Three.js showing u, v, and u×v
 * u = <1,2,3>, v = <4,5,6>, u×v = <-3,6,-3>
 * Shows the perpendicular result and the parallelogram.
 */
---

<figure class="cp3d" role="img" aria-label="Interactive 3D cross product visualization">
  <div class="cp3d-canvas" data-crossproduct3d></div>
  <div class="cp3d-hint">Drag to rotate · Scroll/Pinch to zoom</div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initScene(container: HTMLElement) {
    const width = container.clientWidth || 480;
    const height = 360;
    const isDark = document.documentElement.dataset.theme !== "light";

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(isDark ? 0x121212 : 0xf8f9fa);

    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    camera.position.set(8, 6, 10);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Grid
    const gc = isDark ? 0x333333 : 0xcccccc;
    scene.add(new THREE.GridHelper(10, 10, gc, gc));

    // Axes
    const ac = isDark ? 0x666666 : 0x999999;
    const am = new THREE.LineBasicMaterial({ color: ac });
    [[6,0,0],[0,6,0],[0,0,6]].forEach(d => {
      const g = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(0,0,0), new THREE.Vector3(d[0],d[1],d[2])
      ]);
      scene.add(new THREE.Line(g, am));
    });

    // u = <1,2,3> (blue)
    const uDir = new THREE.Vector3(1, 2, 3);
    scene.add(new THREE.ArrowHelper(
      uDir.clone().normalize(), new THREE.Vector3(0,0,0), uDir.length(),
      isDark ? 0x58a6ff : 0x0550ae, 0.3, 0.18
    ));

    // v = <4,5,6> (green)
    const vDir = new THREE.Vector3(4, 5, 6);
    scene.add(new THREE.ArrowHelper(
      vDir.clone().normalize(), new THREE.Vector3(0,0,0), vDir.length(),
      isDark ? 0x7ee787 : 0x1a7f2e, 0.3, 0.18
    ));

    // u×v = <-3,6,-3> (orange)
    const crossDir = new THREE.Vector3(-3, 6, -3);
    scene.add(new THREE.ArrowHelper(
      crossDir.clone().normalize(), new THREE.Vector3(0,0,0), crossDir.length(),
      isDark ? 0xf0883e : 0xc05010, 0.3, 0.18
    ));

    // Parallelogram (shaded quad between u and v)
    const pgGeo = new THREE.BufferGeometry();
    const verts = new Float32Array([
      0,0,0, 1,2,3, 5,7,9, 4,5,6
    ]);
    pgGeo.setAttribute('position', new THREE.BufferAttribute(verts, 3));
    pgGeo.setIndex([0,1,2, 0,2,3]);
    pgGeo.computeVertexNormals();
    const pgMat = new THREE.MeshBasicMaterial({
      color: isDark ? 0xd2a8ff : 0x6b3fa0,
      transparent: true, opacity: 0.15, side: THREE.DoubleSide
    });
    scene.add(new THREE.Mesh(pgGeo, pgMat));

    // Labels
    function label(text: string, pos: number[], color: string, s = 0.7) {
      const c = document.createElement("canvas");
      c.width = 512; c.height = 128;
      const ctx = c.getContext("2d")!;
      ctx.font = "bold 56px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(text, 256, 64);
      const t = new THREE.CanvasTexture(c);
      const m = new THREE.SpriteMaterial({ map: t, transparent: true, depthTest: false });
      const sp = new THREE.Sprite(m);
      sp.position.set(pos[0], pos[1], pos[2]);
      sp.scale.set(s * 4, s, 1);
      scene.add(sp);
    }

    const lc = isDark ? "#888" : "#555";
    label("x", [6.3, -0.2, 0], lc, 0.6);
    label("y", [0, 6.3, 0], lc, 0.6);
    label("z", [0, -0.2, 6.3], lc, 0.6);
    label("u = (1,2,3)", [1.5, 2.8, 3.5], isDark ? "#58a6ff" : "#0550ae", 0.65);
    label("v = (4,5,6)", [4.5, 5.5, 6.5], isDark ? "#7ee787" : "#1a7f2e", 0.65);
    label("u x v = (-3,6,-3)", [-3.5, 7, -3.5], isDark ? "#f0883e" : "#c05010", 0.65);

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));

    const ctrl = new OrbitControls(camera, renderer.domElement);
    ctrl.enableDamping = true;
    ctrl.dampingFactor = 0.08;
    ctrl.autoRotate = true;
    ctrl.autoRotateSpeed = 0.6;
    ctrl.enablePan = false;
    ctrl.minDistance = 5;
    ctrl.maxDistance = 25;

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      ctrl.update();
      renderer.render(scene, camera);
    }
    animate();
    return () => { cancelAnimationFrame(animId); renderer.dispose(); };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-crossproduct3d]").forEach(el => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { obs.disconnect(); initScene(el); }
      }, { threshold: 0.05 });
      obs.observe(el);
    });
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .cp3d { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cp3d-canvas { width:100%; max-width:480px; min-height:360px; border-radius:8px; overflow:hidden; }
  .cp3d-canvas canvas { border-radius:8px; }
  .cp3d-hint { font-family:"Libre Baskerville",Georgia,serif; font-size:0.8rem; color:#888; margin-top:0.4rem; }
</style>
