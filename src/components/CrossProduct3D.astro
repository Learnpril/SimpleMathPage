---
/**
 * CrossProduct3D — shows vectors u=(1,2,3), v=(4,-1,2) and their
 * cross product u×v=(7,10,-9) in interactive 3D with orbit controls.
 */
---

<figure class="cp3" role="img" aria-label="Interactive 3D view of two vectors and their cross product">
  <div class="cp3-canvas" data-cp3></div>
  <div class="cp3-hint">Drag to rotate · Scroll/Pinch to zoom</div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initScene(container: HTMLElement) {
    const width = Math.min(container.clientWidth, 520);
    const height = 360;

    const isDark = document.documentElement.dataset.theme !== "light";
    const bgColor = isDark ? 0x121212 : 0xf8f9fa;
    const axColor = isDark ? 0x444444 : 0xbbbbbb;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(bgColor);

    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    camera.position.set(8, 6, 10);
    camera.lookAt(2, 1, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Helper: arrow from origin
    function addArrow(dir: number[], color: number, len?: number) {
      const d = new THREE.Vector3(dir[0], dir[1], dir[2]);
      const length = len || d.length();
      d.normalize();
      const arrow = new THREE.ArrowHelper(d, new THREE.Vector3(0, 0, 0), length, color, 0.4, 0.2);
      scene.add(arrow);
    }

    // Vectors from the example
    const uColor = isDark ? 0x58a6ff : 0x0550ae; // blue
    const vColor = isDark ? 0x7ee787 : 0x116329; // green
    const crossColor = isDark ? 0xf0883e : 0xb35900; // orange

    addArrow([1, 2, 3], uColor);       // u
    addArrow([4, -1, 2], vColor);      // v
    addArrow([7, 10, -9], crossColor); // u × v

    // Axes (thin lines)
    const axMat = new THREE.LineBasicMaterial({ color: axColor });
    for (const dir of [[12, 0, 0], [0, 12, 0], [0, 0, 12]]) {
      const pts = [
        new THREE.Vector3(-dir[0] * 0.2, -dir[1] * 0.2, -dir[2] * 0.2),
        new THREE.Vector3(dir[0] * 0.8, dir[1] * 0.8, dir[2] * 0.8),
      ];
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), axMat));
    }

    // Text label helper (billboard sprite)
    function makeLabel(text: string, pos: number[], color: string, size = 0.7) {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      canvas.width = 128;
      canvas.height = 64;
      ctx.font = "bold 36px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(text, 64, 32);
      const tex = new THREE.CanvasTexture(canvas);
      const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
      const sprite = new THREE.Sprite(mat);
      sprite.position.set(pos[0], pos[1], pos[2]);
      sprite.scale.set(size * 2, size, 1);
      scene.add(sprite);
    }

    // Axis labels
    const labelColor = isDark ? "#888" : "#666";
    makeLabel("x", [10, -0.5, 0], labelColor);
    makeLabel("y", [0, 10, 0], labelColor);
    makeLabel("z", [0, -0.5, 10], labelColor);

    // Vector labels
    const uLabelColor = isDark ? "#58a6ff" : "#0550ae";
    const vLabelColor = isDark ? "#7ee787" : "#116329";
    const crossLabelColor = isDark ? "#f0883e" : "#b35900";
    makeLabel("u", [1.3, 2.5, 3.5], uLabelColor, 0.6);
    makeLabel("v", [4.5, -0.5, 2.5], vLabelColor, 0.6);
    makeLabel("u\u00d7v", [7.5, 10.5, -8.5], crossLabelColor, 0.8);

    // Parallelogram between u and v (shaded)
    const pGeo = new THREE.BufferGeometry();
    const verts = new Float32Array([
      0, 0, 0,  1, 2, 3,  5, 1, 5,  // triangle 1: origin, u, u+v
      0, 0, 0,  4, -1, 2, 5, 1, 5,  // triangle 2: origin, v, u+v
    ]);
    pGeo.setAttribute("position", new THREE.BufferAttribute(verts, 3));
    pGeo.computeVertexNormals();
    const pMat = new THREE.MeshBasicMaterial({
      color: isDark ? 0x58a6ff : 0x0550ae,
      transparent: true,
      opacity: 0.12,
      side: THREE.DoubleSide,
    });
    scene.add(new THREE.Mesh(pGeo, pMat));

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));

    // Controls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.8;
    controls.enableZoom = true;
    controls.minDistance = 5;
    controls.maxDistance = 30;

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    return () => { cancelAnimationFrame(animId); renderer.dispose(); };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-cp3]").forEach((el) => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) { obs.disconnect(); initScene(el); }
        },
        { threshold: 0.05 }
      );
      obs.observe(el);
    });
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .cp3 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cp3-canvas { width:100%; max-width:520px; min-height:360px; border-radius:8px; overflow:hidden; }
  .cp3-canvas canvas { border-radius:8px; }
  .cp3-hint { font-family:'Libre Baskerville',Georgia,serif; font-size:0.8rem; color:#888; margin-top:0.4rem; }
</style>
