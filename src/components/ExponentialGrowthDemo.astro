---
/**
 * ExponentialGrowthDemo - Compares exponential growth with logistic growth.
 * Red curve: A = 100 e^{0.3t} (unlimited exponential)
 * Blue curve: P = 1000 / (1 + 9 e^{-0.4t}) (logistic, K=1000)
 * Dashed line: carrying capacity K = 1000
 * Labels offset ~18px from their curves.
 */

const ox = 50, oy = 260, sx = 32, sy = 0.24;
const toPx = (t: number) => ox + t * sx;
const toPy = (v: number) => oy - v * sy;
const X0 = 30, X1 = 385, Y0 = 12, Y1 = 280;

function curve(f: (t: number) => number, tmin: number, tmax: number, step = 0.1) {
  const pts: [number, number][] = [];
  for (let t = tmin; t <= tmax + 1e-9; t += step) {
    const px = toPx(t), py = toPy(f(t));
    if (px >= X0 && px <= X1 && py >= Y0 && py <= Y1) pts.push([px, py]);
    else if (pts.length > 0) break;
  }
  return pts;
}
const ptsStr = (pts: [number, number][]) => pts.map(p => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

const expCurve = curve(t => 100 * Math.exp(0.3 * t), 0, 10);
const logCurve = curve(t => 1000 / (1 + 9 * Math.exp(-0.4 * t)), 0, 10);
const K = 1000;
---

<figure class="egd" role="img" aria-label="Comparison of exponential growth and logistic growth curves">
  <svg viewBox="0 0 400 326" xmlns="http://www.w3.org/2000/svg" class="egd-svg">
    {/* Grid */}
    <g class="egd-grid">
      {[0,2,4,6,8,10].map(t => <line x1={toPx(t)} y1={Y0} x2={toPx(t)} y2={Y1} />)}
      {[0,200,400,600,800,1000].map(v => toPy(v) >= Y0 && toPy(v) <= Y1 ? <line x1={X0} y1={toPy(v)} x2={X1} y2={toPy(v)} /> : null)}
    </g>

    {/* Axes */}
    <line x1={X0} y1={toPy(0)} x2={X1} y2={toPy(0)} class="egd-axis" />
    <line x1={toPx(0)} y1={Y0} x2={toPx(0)} y2={Y1} class="egd-axis" />
    <text x={X1 + 4} y={toPy(0) + 4} class="egd-lbl axis">t</text>
    <text x={toPx(0) - 4} y={Y0 + 2} class="egd-lbl axis" text-anchor="end">A, P</text>

    {/* Y-axis scale */}
    <text x={toPx(0) - 8} y={toPy(200) + 4} class="egd-lbl tick" text-anchor="end">200</text>
    <text x={toPx(0) - 8} y={toPy(500) + 4} class="egd-lbl tick" text-anchor="end">500</text>
    <text x={toPx(0) - 8} y={toPy(1000) + 4} class="egd-lbl tick" text-anchor="end">1000</text>

    {/* X-axis scale */}
    <text x={toPx(2)} y={toPy(0) + 14} class="egd-lbl tick" text-anchor="middle">2</text>
    <text x={toPx(4)} y={toPy(0) + 14} class="egd-lbl tick" text-anchor="middle">4</text>
    <text x={toPx(6)} y={toPy(0) + 14} class="egd-lbl tick" text-anchor="middle">6</text>
    <text x={toPx(8)} y={toPy(0) + 14} class="egd-lbl tick" text-anchor="middle">8</text>
    <text x={toPx(10)} y={toPy(0) + 14} class="egd-lbl tick" text-anchor="middle">10</text>

    {/* Carrying capacity dashed line */}
    <line x1={X0} y1={toPy(K)} x2={X1} y2={toPy(K)} class="egd-cap" />
    <text x={X1 - 4} y={toPy(K) - 8} class="egd-lbl cap-lbl" text-anchor="end">K = 1000</text>

    {/* Curves */}
    <polyline points={ptsStr(expCurve)} class="egd-curve exp" fill="none" />
    <polyline points={ptsStr(logCurve)} class="egd-curve log" fill="none" />

    {/* Curve labels - legend below chart, clear of all plot elements */}
    <line x1="100" y1="300" x2="125" y2="300" class="egd-curve exp" />
    <text x="132" y="304" class="egd-lbl exp-lbl">Exponential: A₀e^(kt)</text>
    <line x1="100" y1="316" x2="125" y2="316" class="egd-curve log" />
    <text x="132" y="320" class="egd-lbl log-lbl">Logistic: K/(1 + Ae^(−rt))</text>
  </svg>
</figure>

<style>
  .egd { display: flex; justify-content: center; margin: 1.5rem 0; }
  .egd-svg { width: 100%; max-width: 500px; height: auto; }
  .egd-grid line { stroke: #262626; stroke-width: 0.5; }
  .egd-axis { stroke: #555; stroke-width: 1.2; }
  .egd-cap { stroke: #7ee787; stroke-width: 1.4; stroke-dasharray: 6 4; opacity: 0.7; }
  .egd-curve { stroke-width: 2.6; stroke-linecap: round; }
  .exp { stroke: #f47067; }
  .log { stroke: #58a6ff; }
  .egd-lbl { font-family: "Libre Baskerville", Georgia, serif; fill: #aaa; }
  .axis { font-size: 13px; font-weight: bold; fill: #888; }
  .tick { font-size: 10px; fill: #777; }
  .cap-lbl { font-size: 11px; fill: #7ee787; font-style: italic; }
  .exp-lbl { font-size: 11px; fill: #f47067; }
  .log-lbl { font-size: 11px; fill: #58a6ff; }

  :root[data-theme="light"] .egd-grid line { stroke: #e8e8e8; }
  :root[data-theme="light"] .egd-axis { stroke: #999; }
  :root[data-theme="light"] .egd-cap { stroke: #1a7f2e; }
  :root[data-theme="light"] .exp { stroke: #c4432b; }
  :root[data-theme="light"] .log { stroke: #0550ae; }
  :root[data-theme="light"] .egd-lbl { fill: #555; }
  :root[data-theme="light"] .axis { fill: #666; }
  :root[data-theme="light"] .tick { fill: #888; }
  :root[data-theme="light"] .cap-lbl { fill: #1a7f2e; }
  :root[data-theme="light"] .exp-lbl { fill: #c4432b; }
  :root[data-theme="light"] .log-lbl { fill: #0550ae; }
</style>
