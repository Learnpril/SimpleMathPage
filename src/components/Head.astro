---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';

/* Absolute URL for the social sharing card image. Astro.site comes from the
   `site` option in astro.config.mjs. */
const ogImage = new URL('/og-image.png', Astro.site).href;
---
<Default {...Astro.props}><slot /></Default>

{/* Social sharing card image — Starlight sets twitter:card=summary_large_image
    but does not provide an image, which renders an empty card. */}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Mom's Basement University - Learn Math for Free - Arithmetic and Beyond"
/>
<meta name="twitter:image" content={ogImage} />

<script>
  import { initAuthButton } from "../lib/auth-modal";

  function init() {
    try {
      initAuthButton();
    } catch {
      /* Supabase not configured */
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>
