---
/**
 * FluxHemisphere3D - Interactive 3D visual of the upper hemisphere
 * with outward normal vectors and the field F=<0,0,z> arrows,
 * illustrating flux through a surface.
 */
---

<figure class="fh3" role="img" aria-label="Interactive 3D upper hemisphere with outward normal vectors showing flux of the field F equals 0 0 z through the surface">
  <div class="fh3-canvas" data-fh3d></div>
  <div class="fh3-hint">Drag to rotate · Scroll/Pinch to zoom</div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initScene(container: HTMLElement) {
    const width = Math.min(container.clientWidth, 480);
    const height = 360;
    const isDark = document.documentElement.dataset.theme !== "light";
    const bgColor = isDark ? 0x121212 : 0xf8f9fa;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(bgColor);

    const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 200);
    camera.position.set(2.5, 2, 2.5);
    camera.lookAt(0, 0.3, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const accentColor = isDark ? 0x58a6ff : 0x0550ae;
    const orangeColor = isDark ? 0xf0883e : 0xb35900;

    // Upper hemisphere (Three.js y = math z)
    const hemiGeo = new THREE.SphereGeometry(1, 32, 16, 0, Math.PI * 2, 0, Math.PI / 2);
    const hemiMat = new THREE.MeshPhongMaterial({
      color: accentColor,
      transparent: true, opacity: 0.15,
      side: THREE.DoubleSide,
    });
    const hemi = new THREE.Mesh(hemiGeo, hemiMat);
    scene.add(hemi);

    // Wireframe
    const wireGeo = new THREE.SphereGeometry(1, 12, 6, 0, Math.PI * 2, 0, Math.PI / 2);
    const wireMat = new THREE.MeshBasicMaterial({
      color: accentColor,
      wireframe: true, transparent: true, opacity: 0.25,
    });
    scene.add(new THREE.Mesh(wireGeo, wireMat));

    // Normal vectors at sample points on the hemisphere
    const arrowColor = new THREE.Color(orangeColor);
    const normals: [number, number, number][] = [
      [0, 1, 0],           // top
      [0.7, 0.7, 0],       // front-right
      [-0.7, 0.7, 0],      // front-left
      [0, 0.7, 0.7],       // back
      [0, 0.7, -0.7],      // front
      [0.5, 0.87, 0],      // upper-right
      [-0.5, 0.87, 0],     // upper-left
    ];
    for (const n of normals) {
      const len = Math.sqrt(n[0]*n[0] + n[1]*n[1] + n[2]*n[2]);
      const dir = new THREE.Vector3(n[0]/len, n[1]/len, n[2]/len);
      const origin = dir.clone().multiplyScalar(1);
      const arrow = new THREE.ArrowHelper(dir, origin, 0.35, arrowColor, 0.08, 0.06);
      scene.add(arrow);
    }

    // Base circle
    const circleGeo = new THREE.RingGeometry(0.98, 1.02, 48);
    const circleMat = new THREE.MeshBasicMaterial({
      color: accentColor, transparent: true, opacity: 0.4, side: THREE.DoubleSide,
    });
    const circle = new THREE.Mesh(circleGeo, circleMat);
    circle.rotation.x = -Math.PI / 2;
    scene.add(circle);

    // Axes
    const axColor = isDark ? 0x666666 : 0x999999;
    const axMat = new THREE.LineBasicMaterial({ color: axColor });
    for (const dir of [[2, 0, 0], [0, 2, 0], [0, 0, 2]] as [number, number, number][]) {
      const pts = [new THREE.Vector3(0, 0, 0), new THREE.Vector3(...dir)];
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), axMat));
    }

    // Labels
    function makeLabel(text: string, pos: [number, number, number], color: string, size = 0.35) {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      canvas.width = 512; canvas.height = 128;
      ctx.font = "bold 64px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText(text, 256, 64);
      const tex = new THREE.CanvasTexture(canvas);
      const mat = new THREE.SpriteMaterial({ map: tex, transparent: true });
      const sprite = new THREE.Sprite(mat);
      sprite.position.set(...pos);
      sprite.scale.set(size * 2.5, size * 0.6, 1);
      scene.add(sprite);
    }

    const lc = isDark ? "#888" : "#666";
    makeLabel("x", [1.8, -0.1, 0], lc, 0.7);
    makeLabel("z", [0, 1.8, 0], lc, 0.7);
    makeLabel("y", [0, -0.1, 1.8], lc, 0.7);

    const nc = isDark ? "#f0883e" : "#b35900";
    makeLabel("n", [0.15, 1.5, 0], nc, 0.6);

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const dl = new THREE.DirectionalLight(0xffffff, 0.6);
    dl.position.set(2, 3, 2);
    scene.add(dl);

    // Controls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.5;
    controls.enableZoom = true;
    controls.minDistance = 2;
    controls.maxDistance = 12;
    controls.target.set(0, 0.3, 0);

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    return () => { cancelAnimationFrame(animId); renderer.dispose(); };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-fh3d]").forEach((el) => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(
        (entries) => { if (entries[0].isIntersecting) { obs.disconnect(); initScene(el); } },
        { threshold: 0.05 }
      );
      obs.observe(el);
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .fh3 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .fh3-canvas {
    width:100%; max-width:480px; min-height:360px;
    border-radius:8px; overflow:hidden;
  }
  .fh3-canvas canvas { border-radius:8px; }
  .fh3-hint {
    font-family:'Libre Baskerville',Georgia,serif;
    font-size:0.8rem; color:#888; margin-top:0.4rem;
  }
</style>
