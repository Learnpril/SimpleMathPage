---
/**
 * CotGraph - plots y = cot(x) = cos(x)/sin(x) from 0 to 2π
 * with asymptotes at x = 0, π, 2π (where sin = 0).
 */
const w = 520;
const h = 280;
const pad = 40;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const cxO = pad;
const cyO = pad + gh / 2;
const xMin = -0.3;
const xMax = 2 * Math.PI + 0.3;
const scaleX = gw / (xMax - xMin);
const scaleY = gh / 6;

function px(x: number) { return cxO + (x - xMin) * scaleX; }
function py(y: number) { return cyO - y * scaleY; }

// Generate cot curve segments (skip near asymptotes)
const segments: string[][] = [];
let seg: string[] = [];
for (let t = 0.08; t <= 2 * Math.PI - 0.08; t += 0.02) {
  const v = Math.cos(t) / Math.sin(t);
  if (Math.abs(v) > 3.2) {
    if (seg.length > 1) segments.push(seg);
    seg = [];
    continue;
  }
  seg.push(`${seg.length === 0 ? 'M' : 'L'}${px(t).toFixed(1)},${py(v).toFixed(1)}`);
}
if (seg.length > 1) segments.push(seg);

const asymptotes = [0, Math.PI, 2 * Math.PI];
const xTicks = [
  { val: 0, label: '0' },
  { val: Math.PI / 2, label: 'π/2' },
  { val: Math.PI, label: 'π' },
  { val: 3 * Math.PI / 2, label: '3π/2' },
  { val: 2 * Math.PI, label: '2π' },
];
---

<figure class="cotg" role="img" aria-label="Graph of y = cot(x) showing asymptotes at multiples of π">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Axes */}
    <line x1={cxO - 5} y1={cyO} x2={w - pad + 10} y2={cyO} class="cotg-axis" stroke-width="1.5" />
    <line x1={px(0)} y1={pad - 5} x2={px(0)} y2={h - pad + 5} class="cotg-axis" stroke-width="1.5" />

    {/* Asymptotes */}
    {asymptotes.map(a => (
      <line x1={px(a)} y1={pad - 5} x2={px(a)} y2={h - pad + 5} class="cotg-asymptote" stroke-width="1.5" stroke-dasharray="6,4" />
    ))}

    {/* Y ticks */}
    <text class="cotg-tick" x={px(0) - 8} y={py(1) + 4} font-size="11" text-anchor="end">1</text>
    <text class="cotg-tick" x={px(0) - 8} y={py(-1) + 4} font-size="11" text-anchor="end">-1</text>

    {/* X ticks */}
    {xTicks.map(t => (
      <text class="cotg-tick" x={px(t.val)} y={cyO + 18} font-size="11" text-anchor="middle">{t.label}</text>
    ))}

    {/* Cot curve segments */}
    {segments.map(s => (
      <path d={s.join(' ')} fill="none" class="cotg-curve" stroke-width="2.5" />
    ))}

    {/* Key points where cot = 0 */}
    <circle cx={px(Math.PI / 2)} cy={py(0)} r="4" class="cotg-dot" />
    <circle cx={px(3 * Math.PI / 2)} cy={py(0)} r="4" class="cotg-dot" />

    {/* Legend */}
    <line x1={w - 120} y1="14" x2={w - 100} y2="14" class="cotg-curve" stroke-width="2.5" />
    <text class="cotg-legend" x={w - 95} y="18" font-size="12">y = cot(x)</text>
  </svg>
</figure>

<style>
  .cotg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cotg svg { max-width:100%; height:auto; }
  .cotg-axis { stroke:#666; }
  .cotg-asymptote { stroke:#f47067; opacity:0.6; }
  .cotg-tick { fill:#999; font-family:'Libre Baskerville',Georgia,serif; }
  .cotg-curve { stroke:#d2a8ff; }
  .cotg-dot { fill:#d2a8ff; }
  .cotg-legend { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }

  :global([data-theme="light"]) .cotg-axis { stroke:#999; }
  :global([data-theme="light"]) .cotg-asymptote { stroke:#cf222e; }
  :global([data-theme="light"]) .cotg-tick { fill:#555; }
  :global([data-theme="light"]) .cotg-curve { stroke:#6639ba; }
  :global([data-theme="light"]) .cotg-dot { fill:#6639ba; }
  :global([data-theme="light"]) .cotg-legend { fill:#6639ba; }
</style>
