---
/**
 * ComplexAddDiagram — shows (3+4i) + (5−2i) = 8+2i on the complex plane.
 * Vectors from origin to each point, parallelogram to the sum.
 */

const pad = 55;
const w = 420;
const h = 380;
const plotW = 310;
const plotH = 280;
const xLo = -1;
const xHi = 10;
const yLo = -4;
const yHi = 6;
const xRange = xHi - xLo;
const yRange = yHi - yLo;

function toX(v: number) { return pad + ((v - xLo) / xRange) * plotW; }
function toY(v: number) { return pad + ((yHi - v) / yRange) * plotH; }

const realAxisY = toY(0);
const imagAxisX = toX(0);

const xTicks = [1, 2, 3, 4, 5, 6, 7, 8, 9];
const yTicks = [-3, -2, -1, 1, 2, 3, 4, 5];
---

<figure class="ca-diagram" role="img" aria-label="Complex addition: (3+4i) + (5−2i) = 8+2i shown as vectors on the complex plane">
  <figcaption class="ca-title">Adding complex numbers: (3 + 4i) + (5 − 2i) = 8 + 2i</figcaption>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">

    <rect class="ca-bg" x="0" y="0" width={w} height={h} rx="8" />

    <defs>
      <marker id="ca-arr-b" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,1 L7,4 L0,7 Z" fill="#58a6ff" />
      </marker>
      <marker id="ca-arr-o" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,1 L7,4 L0,7 Z" fill="#f78166" />
      </marker>
      <marker id="ca-arr-g" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,1 L7,4 L0,7 Z" fill="#7ee787" />
      </marker>
    </defs>

    {/* Grid */}
    {xTicks.map(x => <line class="ca-grid" x1={toX(x)} y1={pad} x2={toX(x)} y2={pad + plotH} />)}
    {yTicks.map(y => <line class="ca-grid" x1={pad} y1={toY(y)} x2={pad + plotW} y2={toY(y)} />)}

    {/* Axes */}
    <line class="ca-axis" x1={pad} y1={realAxisY} x2={pad + plotW + 5} y2={realAxisY} stroke-width="1.5" />
    <line class="ca-axis" x1={imagAxisX} y1={pad + plotH} x2={imagAxisX} y2={pad - 5} stroke-width="1.5" />
    <text class="ca-axlabel" x={pad + plotW + 8} y={realAxisY - 8} font-size="12">Real</text>
    <text class="ca-axlabel" x={imagAxisX + 8} y={pad - 8} font-size="12">Imag</text>

    {/* Tick labels */}
    {xTicks.filter(x => x % 2 === 0 || x === 1).map(x => (
      <text class="ca-tick" x={toX(x)} y={realAxisY + 16} font-size="10" text-anchor="middle">{x}</text>
    ))}
    {yTicks.filter(y => y !== 0).map(y => (
      <text class="ca-tick" x={imagAxisX - 8} y={toY(y) + 4} font-size="10" text-anchor="end">{y}i</text>
    ))}

    {/* Vector 1: origin → (3, 4i) — blue */}
    <line class="ca-vec1" x1={toX(0)} y1={toY(0)} x2={toX(3) - 4} y2={toY(4) + 4}
      stroke-width="2.5" marker-end="url(#ca-arr-b)" />
    <circle class="ca-pt1" cx={toX(3)} cy={toY(4)} r="5" />
    <text class="ca-label1" x={toX(3) - 14} y={toY(4) - 10} font-size="13" font-weight="bold" text-anchor="end">3 + 4i</text>

    {/* Vector 2: origin → (5, −2i) — orange */}
    <line class="ca-vec2" x1={toX(0)} y1={toY(0)} x2={toX(5) - 4} y2={toY(-2) - 2}
      stroke-width="2.5" marker-end="url(#ca-arr-o)" />
    <circle class="ca-pt2" cx={toX(5)} cy={toY(-2)} r="5" />
    <text class="ca-label2" x={toX(5) + 10} y={toY(-2) + 18} font-size="13" font-weight="bold">5 − 2i</text>

    {/* Parallelogram dashed lines */}
    <line class="ca-para" x1={toX(3)} y1={toY(4)} x2={toX(8)} y2={toY(2)} stroke-width="1.5" stroke-dasharray="5,4" />
    <line class="ca-para" x1={toX(5)} y1={toY(-2)} x2={toX(8)} y2={toY(2)} stroke-width="1.5" stroke-dasharray="5,4" />

    {/* Result vector: origin → (8, 2i) — green */}
    <line class="ca-vec3" x1={toX(0)} y1={toY(0)} x2={toX(8) - 4} y2={toY(2) + 2}
      stroke-width="2.5" marker-end="url(#ca-arr-g)" />
    <circle class="ca-pt3" cx={toX(8)} cy={toY(2)} r="6" />
    <text class="ca-label3" x={toX(8) + 10} y={toY(2) - 8} font-size="14" font-weight="bold">8 + 2i</text>

  </svg>
</figure>

<style>
  .ca-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .ca-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .ca-diagram svg { max-width: 100%; height: auto; }

  .ca-bg { fill: var(--sl-color-bg, #121212); }
  .ca-grid { stroke: #333; stroke-width: 0.5; }
  .ca-axis { stroke: #888; }
  .ca-axlabel { fill: #aaa; font-family: 'Libre Baskerville', Georgia, serif; font-weight: bold; }
  .ca-tick { fill: #aaa; font-family: sans-serif; }

  .ca-vec1 { stroke: #58a6ff; }
  .ca-pt1 { fill: #58a6ff; stroke: #fff; stroke-width: 1.5; }
  .ca-label1 { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }

  .ca-vec2 { stroke: #f78166; }
  .ca-pt2 { fill: #f78166; stroke: #fff; stroke-width: 1.5; }
  .ca-label2 { fill: #f78166; font-family: 'Libre Baskerville', Georgia, serif; }

  .ca-para { stroke: #666; }

  .ca-vec3 { stroke: #7ee787; }
  .ca-pt3 { fill: #7ee787; stroke: #fff; stroke-width: 2; }
  .ca-label3 { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }

  :global([data-theme="light"]) .ca-bg { fill: #f8f9fa; }
  :global([data-theme="light"]) .ca-grid { stroke: #ccc; }
  :global([data-theme="light"]) .ca-axis { stroke: #222; }
  :global([data-theme="light"]) .ca-axlabel { fill: #222; }
  :global([data-theme="light"]) .ca-tick { fill: #333; }
  :global([data-theme="light"]) .ca-vec1 { stroke: #0969da; }
  :global([data-theme="light"]) .ca-pt1 { fill: #0969da; stroke: #fff; }
  :global([data-theme="light"]) .ca-label1 { fill: #0969da; }
  :global([data-theme="light"]) .ca-vec2 { stroke: #cf222e; }
  :global([data-theme="light"]) .ca-pt2 { fill: #cf222e; stroke: #fff; }
  :global([data-theme="light"]) .ca-label2 { fill: #cf222e; }
  :global([data-theme="light"]) .ca-para { stroke: #999; }
  :global([data-theme="light"]) .ca-vec3 { stroke: #1a7f37; }
  :global([data-theme="light"]) .ca-pt3 { fill: #1a7f37; stroke: #fff; }
  :global([data-theme="light"]) .ca-label3 { fill: #1a7f37; }
</style>
