---
/**
 * MobiusDiscMap — the Möbius transformation w = (z − i)/(z + i) carries the upper
 * half plane onto the unit disc. Every image curve is obtained by applying the map
 * to sampled points, and the largest modulus among all of them is reported, which
 * is the check that nothing escaped the disc.
 */
const w = 540;
const h = 310;

type C = { re: number; im: number };
const div = (a: C, b: C): C => {
  const d = b.re * b.re + b.im * b.im;
  return { re: (a.re * b.re + a.im * b.im) / d, im: (a.im * b.re - a.re * b.im) / d };
};
/** w = (z − i)/(z + i) */
const T = (z: C): C => div({ re: z.re, im: z.im - 1 }, { re: z.re, im: z.im + 1 });

const lcx = 128;
const lcy = 212;
const lu = 28;
const rcx = 400;
const rcy = 160;
const ru = 62;

const lx = (re: number) => lcx + re * lu;
const ly = (im: number) => lcy - im * lu;
const rx = (re: number) => rcx + re * ru;
const ry = (im: number) => rcy - im * ru;

const xMax = 3.1;
const yMax = 3.4;
const hLevels = [0.4, 0.9, 1.8, 3.2];
const vLevels = [-2, -1, 0, 1, 2];

let maxMod = 0;
const track = (z: C) => {
  const p = T(z);
  maxMod = Math.max(maxMod, Math.hypot(p.re, p.im));
  return p;
};

/** A horizontal line Im z = c in the source, and its image. */
function hPair(c: number) {
  const src: string[] = [];
  const img: string[] = [];
  for (let i = 0; i <= 120; i++) {
    const x = -xMax + (i / 120) * (2 * xMax);
    src.push(`${lx(x).toFixed(1)},${ly(c).toFixed(1)}`);
    const p = track({ re: x, im: c });
    img.push(`${rx(p.re).toFixed(1)},${ry(p.im).toFixed(1)}`);
  }
  return { src: src.join(" "), img: img.join(" ") };
}

/** A vertical ray Re z = c, y from 0 up, and its image. */
function vPair(c: number) {
  const src: string[] = [];
  const img: string[] = [];
  for (let i = 0; i <= 120; i++) {
    const y = (i / 120) * yMax;
    src.push(`${lx(c).toFixed(1)},${ly(y).toFixed(1)}`);
    const p = track({ re: c, im: y });
    img.push(`${rx(p.re).toFixed(1)},${ry(p.im).toFixed(1)}`);
  }
  return { src: src.join(" "), img: img.join(" ") };
}

const hs = hLevels.map(hPair);
const vs = vLevels.map(vPair);

// Three landmark points, computed
const marks = [
  { z: { re: 0, im: 1 }, label: "i ↦ 0" },
  { z: { re: 0, im: 0 }, label: "0 ↦ −1" },
];
const marked = marks.map((m) => ({ ...m, w: T(m.z) }));
---

<figure
  class="mdm"
  role="img"
  aria-label={`The upper half plane on the left, gridded by horizontal lines and vertical rays, and its image on the right under w equals z minus i over z plus i. Every image curve lies inside the unit circle; the largest modulus among all sampled image points is ${maxMod.toFixed(4)}. The point i maps to the centre and 0 maps to minus 1.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="mdm-head" font-size="12.5" font-weight="bold">A half plane becomes a disc</text>
    <text x="16" y="38" class="mdm-sub" font-size="10.5">w = (z − i) ⁄ (z + i), applied to a grid on the upper half plane</text>

    <line x1="268" y1="58" x2="268" y2="272" class="mdm-divide" />

    {/* ---------- source ---------- */}
    <text x={lcx} y="76" class="mdm-panel" font-size="10" text-anchor="middle">upper half plane</text>
    {hs.map((p) => <polyline points={p.src} class="mdm-h" fill="none" />)}
    {vs.map((p) => <polyline points={p.src} class="mdm-v" fill="none" />)}
    <line x1={lx(-xMax) - 6} y1={lcy} x2={lx(xMax) + 6} y2={lcy} class="mdm-axis" />

    {/* ---------- image ---------- */}
    <text x={rcx} y="76" class="mdm-panel" font-size="10" text-anchor="middle">the unit disc</text>
    <circle cx={rcx} cy={rcy} r={ru} class="mdm-circle" />
    {hs.map((p) => <polyline points={p.img} class="mdm-h" fill="none" />)}
    {vs.map((p) => <polyline points={p.img} class="mdm-v" fill="none" />)}

    {marked.map((m) => (
      <circle cx={rx(m.w.re)} cy={ry(m.w.im)} r="4" class="mdm-mark" />
    ))}

    <text x={lcx} y="246" class="mdm-key-h" font-size="9.5" text-anchor="middle">horizontal lines Im z = const</text>
    <text x={lcx} y="262" class="mdm-key-v" font-size="9.5" text-anchor="middle">vertical rays Re z = const</text>
    <text x={rcx} y="246" class="mdm-mark-lbl" font-size="9.5" text-anchor="middle">i ↦ 0 and 0 ↦ −1</text>
    <text x={rcx} y="262" class="mdm-val" font-size="9.5" text-anchor="middle">{`largest |w| sampled: ${maxMod.toFixed(4)}`}</text>

    <text x={w / 2} y="288" class="mdm-foot" font-size="10.5" text-anchor="middle">
      Möbius maps send circles and lines to circles and lines, and preserve angles
    </text>
    <text x={w / 2} y="304" class="mdm-sub2" font-size="9.5" text-anchor="middle">
      The real axis becomes the unit circle, and the grid stays orthogonal after the map
    </text>
  </svg>
</figure>

<style>
  .mdm { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .mdm svg { width:100%; max-width:100%; height:auto; }
  .mdm-axis { stroke:#888; stroke-width:1.4; }
  .mdm-divide { stroke:#3a3a3a; stroke-width:1; }
  .mdm-circle { fill:none; stroke:#888; stroke-width:1.6; }
  .mdm-h { stroke:#58a6ff; stroke-width:1.5; }
  .mdm-v { stroke:#f0883e; stroke-width:1.5; }
  .mdm-mark { fill:#7ee787; stroke:#eee; stroke-width:1.1; }
  .mdm-key-h { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .mdm-key-v { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .mdm-mark-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .mdm-val { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .mdm-panel, .mdm-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .mdm-sub, .mdm-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .mdm-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) :is(.mdm-axis, .mdm-circle) { stroke:#666; }
  :global([data-theme="light"]) .mdm-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .mdm-h { stroke:#0550ae; }
  :global([data-theme="light"]) .mdm-key-h, :global([data-theme="light"]) .mdm-foot { fill:#0550ae; }
  :global([data-theme="light"]) .mdm-v { stroke:#b35900; }
  :global([data-theme="light"]) .mdm-key-v { fill:#b35900; }
  :global([data-theme="light"]) .mdm-mark { fill:#116329; stroke:#fff; }
  :global([data-theme="light"]) .mdm-mark-lbl { fill:#116329; }
  :global([data-theme="light"]) .mdm-panel, :global([data-theme="light"]) .mdm-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.mdm-val, .mdm-sub, .mdm-sub2) { fill:#57606a; }
</style>
