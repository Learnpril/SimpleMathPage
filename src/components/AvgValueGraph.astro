---
/**
 * AvgValueGraph — shows f(x) = x² on [0, 3] with shaded area,
 * plus a dashed horizontal line at y = 3 (the average value).
 * The rectangle base 3, height 3 has the same area (9) as the
 * region under the curve.
 */
const w = 420;
const h = 300;
const pad = 55;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -0.5, xMax = 3.8, yMin = 0, yMax = 10;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const f = (x: number) => x * x;

// Curve points
const curvePts: string[] = [];
for (let i = 0; i <= 60; i++) {
  const x = xMin + i * (xMax - xMin) / 60;
  const y = f(x);
  if (y <= yMax && x >= 0) curvePts.push(`${sx(x)},${sy(y)}`);
}

// Shaded area under curve from 0 to 3
const shadePts: string[] = [`${sx(0)},${sy(0)}`];
for (let i = 0; i <= 40; i++) {
  const x = i * 3 / 40;
  shadePts.push(`${sx(x)},${sy(f(x))}`);
}
shadePts.push(`${sx(3)},${sy(0)}`);

// Average value rectangle (dashed outline)
const avgY = 3;
---

<figure class="avg" role="img" aria-label="Graph of x squared on 0 to 3 with shaded area and average value rectangle at height 3">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {[0,1,2,3].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="avg-grid" stroke-width="0.5" />
    ))}
    {[2,4,6,8].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="avg-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="avg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="avg-axis" stroke-width="1.2" />

    {/* Shaded area under curve */}
    <polygon points={shadePts.join(' ')} class="avg-shade" />

    {/* Average value rectangle (dashed outline) */}
    <rect x={sx(0)} y={sy(avgY)} width={sx(3) - sx(0)} height={sy(0) - sy(avgY)}
          fill="none" class="avg-rect" stroke-width="2" stroke-dasharray="7,5" />

    {/* Curve */}
    <polyline points={curvePts.join(' ')} fill="none" class="avg-curve" stroke-width="3" />

    {/* Ticks */}
    <text class="avg-tick" x={sx(3)} y={sy(0) + 18} font-size="11" text-anchor="middle">3</text>
    <text class="avg-tick" x={sx(0) - 8} y={sy(avgY) + 4} font-size="11" text-anchor="end">3</text>
  </svg>
  <div class="avg-legend">
    <span class="avg-leg-item"><span class="avg-swatch avg-sw-curve"></span> f(x) = x²</span>
    <span class="avg-leg-item"><span class="avg-swatch avg-sw-shade"></span> area under curve = 9</span>
    <span class="avg-leg-item"><span class="avg-swatch avg-sw-rect"></span> rectangle: 3 x 3 = 9 (same area)</span>
  </div>
</figure>

<style>
  .avg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .avg svg { max-width:100%; height:auto; }
  .avg-grid { stroke:#333; }
  .avg-axis { stroke:#666; }
  .avg-curve { stroke:#58a6ff; }
  .avg-shade { fill:rgba(88,166,255,0.2); }
  .avg-rect { stroke:#f0883e; }
  .avg-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .avg-legend {
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .avg-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .avg-swatch { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .avg-sw-curve { background:#58a6ff; height:4px; }
  .avg-sw-shade { background:rgba(88,166,255,0.35); }
  .avg-sw-rect { background:none; border:2px dashed #f0883e; height:10px; }
  :global([data-theme="light"]) .avg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .avg-axis { stroke:#999; }
  :global([data-theme="light"]) .avg-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .avg-shade { fill:rgba(5,80,174,0.12); }
  :global([data-theme="light"]) .avg-rect { stroke:#b35900; }
  :global([data-theme="light"]) .avg-tick { fill:#666; }
  :global([data-theme="light"]) .avg-sw-curve { background:#0550ae; }
  :global([data-theme="light"]) .avg-sw-shade { background:rgba(5,80,174,0.2); }
  :global([data-theme="light"]) .avg-sw-rect { border-color:#b35900; }
</style>
