---
/**
 * EmpiricalRule — the 68-95-99.7 rule drawn as banded areas under a normal
 * curve.
 *
 * The 95% and 99.7% figures are labelled with span brackets below the axis
 * rather than with text inside the bands. Near the tails the curve is only a
 * few pixels above the axis, so any text placed there gets cut by the curve.
 */
const w = 540;
const h = 316;
const cx = w / 2;
const baseY = 176;
const peakH = 110;
const sig = 62;

function curveY(t: number) {
  return baseY - peakH * Math.exp(-(t * t) / 2);
}
function band(from: number, to: number) {
  const pts: string[] = [`${cx + from * sig},${baseY}`];
  const steps = 60;
  for (let i = 0; i <= steps; i++) {
    const t = from + (i / steps) * (to - from);
    pts.push(`${(cx + t * sig).toFixed(1)},${curveY(t).toFixed(1)}`);
  }
  pts.push(`${cx + to * sig},${baseY}`);
  return pts.join(" ");
}
const fullCurve = Array.from({ length: 141 }, (_, i) => {
  const t = -3.5 + (i / 140) * 7;
  return `${(cx + t * sig).toFixed(1)},${curveY(t).toFixed(1)}`;
}).join(" ");

// Span brackets below the axis, one row each
const brackets = [
  { sd: 2, y: 214, label: "95% within ±2σ", cls: "blue" },
  { sd: 3, y: 252, label: "99.7% within ±3σ", cls: "purple" },
];
---

<figure
  class="emr"
  role="img"
  aria-label="A normal curve divided into bands: about 68% of the area within one standard deviation, 95% within two, and 99.7% within three, with about 2.5% in each tail beyond two standard deviations"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="emr-head" font-size="12.5" font-weight="bold">The 68-95-99.7 rule</text>
    <text x="16" y="38" class="emr-sub" font-size="10">for approximately normal distributions only</text>

    {/* Bands, widest first so narrower ones layer on top */}
    <polygon points={band(-3, 3)} class="emr-b3" />
    <polygon points={band(-2, 2)} class="emr-b2" />
    <polygon points={band(-1, 1)} class="emr-b1" />

    <polyline points={fullCurve} class="emr-curve" fill="none" />
    <line x1={cx - 3.6 * sig} y1={baseY} x2={cx + 3.6 * sig} y2={baseY} class="emr-axis" />

    {/* Only the central figure goes inside the curve, where there is headroom */}
    <text x={cx} y={baseY - 64} class="emr-pct emr-t-green" font-size="14" text-anchor="middle" font-weight="bold">68%</text>
    <text x={cx} y={baseY - 48} class="emr-inner" font-size="9.5" text-anchor="middle">within ±1σ</text>

    {/* Tail callouts, above the tails where the curve is below them */}
    {[-1, 1].map((s) => (
      <g>
        <line x1={cx + s * 2.62 * sig} y1={baseY - 40} x2={cx + s * 2.62 * sig} y2={baseY - 6} class="emr-leader" />
        <text x={cx + s * 2.62 * sig} y={baseY - 46} class="emr-tail" font-size="9.5" text-anchor="middle">2.5%</text>
      </g>
    ))}

    {/* Sigma gridlines and labels */}
    {[-3, -2, -1, 0, 1, 2, 3].map((s) => (
      <g>
        <line x1={cx + s * sig} y1={baseY} x2={cx + s * sig} y2={baseY + 6} class="emr-axis" />
        <text x={cx + s * sig} y={baseY + 19} class="emr-tick" font-size="9.5" text-anchor="middle">
          {s === 0 ? "μ" : `${s > 0 ? "+" : "−"}${Math.abs(s)}σ`}
        </text>
      </g>
    ))}

    {/* Span brackets */}
    {brackets.map((b) => (
      <g>
        <line x1={cx - b.sd * sig} y1={b.y} x2={cx + b.sd * sig} y2={b.y} class={`emr-brk emr-k-${b.cls}`} />
        <line x1={cx - b.sd * sig} y1={b.y - 5} x2={cx - b.sd * sig} y2={b.y + 5} class={`emr-brk emr-k-${b.cls}`} />
        <line x1={cx + b.sd * sig} y1={b.y - 5} x2={cx + b.sd * sig} y2={b.y + 5} class={`emr-brk emr-k-${b.cls}`} />
        <text x={cx} y={b.y + 18} class={`emr-pct emr-t-${b.cls}`} font-size="11" text-anchor="middle" font-weight="bold">
          {b.label}
        </text>
      </g>
    ))}

    <text x={w / 2} y="288" class="emr-foot" font-size="10.5" text-anchor="middle">
      The 2.5% per tail is where the familiar 95% confidence level comes from
    </text>
    <text x={w / 2} y="306" class="emr-sub" font-size="9.5" text-anchor="middle">
      Skewed data does not follow these percentages
    </text>
  </svg>
</figure>

<style>
  .emr { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .emr svg { width:100%; max-width:100%; height:auto; }
  .emr-b1 { fill:#7ee787; fill-opacity:0.30; }
  .emr-b2 { fill:#58a6ff; fill-opacity:0.22; }
  .emr-b3 { fill:#d2a8ff; fill-opacity:0.16; }
  .emr-curve { stroke:#eee; stroke-width:2; }
  .emr-axis { stroke:#888; stroke-width:1.4; }
  .emr-tick { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .emr-pct { font-family:'Libre Baskerville',Georgia,serif; }
  .emr-inner { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .emr-t-green { fill:#7ee787; }
  .emr-t-blue { fill:#58a6ff; }
  .emr-t-purple { fill:#d2a8ff; }
  .emr-brk { stroke-width:1.4; }
  .emr-k-blue { stroke:#58a6ff; }
  .emr-k-purple { stroke:#d2a8ff; }
  .emr-leader { stroke:#f0883e; stroke-width:1; stroke-dasharray:3,2; }
  .emr-tail { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .emr-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .emr-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .emr-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .emr-b1 { fill:#116329; fill-opacity:0.22; }
  :global([data-theme="light"]) .emr-b2 { fill:#0550ae; fill-opacity:0.16; }
  :global([data-theme="light"]) .emr-b3 { fill:#6639ba; fill-opacity:0.12; }
  :global([data-theme="light"]) .emr-curve { stroke:#24292f; }
  :global([data-theme="light"]) .emr-axis { stroke:#666; }
  :global([data-theme="light"]) .emr-tick { fill:#444; }
  :global([data-theme="light"]) .emr-t-green, :global([data-theme="light"]) .emr-inner { fill:#116329; }
  :global([data-theme="light"]) .emr-t-blue, :global([data-theme="light"]) .emr-k-blue { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .emr-t-purple, :global([data-theme="light"]) .emr-k-purple { fill:#6639ba; stroke:#6639ba; }
  :global([data-theme="light"]) .emr-tail, :global([data-theme="light"]) .emr-leader { fill:#b35900; stroke:#b35900; }
  :global([data-theme="light"]) .emr-head { fill:#24292f; }
  :global([data-theme="light"]) .emr-sub { fill:#57606a; }
  :global([data-theme="light"]) .emr-foot { fill:#b35900; }
</style>
