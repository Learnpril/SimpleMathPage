---
/**
 * BoxplotAnatomy - a labelled boxplot with the five-number summary, the IQR
 * box, whiskers, fences, and an outlier plotted separately.
 */
const w = 540;
const h = 270;
const axisY = 210;
const boxY = 96;
const boxH = 54;
const minV = 0;
const maxV = 100;
const left = 50;
const rightEdge = 500;
const sx = (v: number) => left + ((v - minV) / (maxV - minV)) * (rightEdge - left);

// Five-number summary for the illustration. The values are spread widely
// enough that every callout label has horizontal room of its own, and both
// fences land inside the plotted range.
const minimum = 12;
const q1 = 30;
const median = 38;
const q3 = 48;
const maxNonOutlier = 68;
const outlier = 88;
const iqr = q3 - q1;
const lowerFence = q1 - 1.5 * iqr;
const upperFence = q3 + 1.5 * iqr;
---

<figure
  class="bpa"
  role="img"
  aria-label={`A labelled boxplot with minimum ${minimum}, Q1 ${q1}, median ${median}, Q3 ${q3}, whisker ending at ${maxNonOutlier}, and an outlier at ${outlier} beyond the upper fence of ${upperFence}`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="bpa-head" font-size="12.5" font-weight="bold">Anatomy of a boxplot</text>

    {/* Fences */}
    <line x1={sx(lowerFence)} y1={boxY - 18} x2={sx(lowerFence)} y2={boxY + boxH + 18} class="bpa-fence" />
    <line x1={sx(upperFence)} y1={boxY - 18} x2={sx(upperFence)} y2={boxY + boxH + 18} class="bpa-fence" />
    <text x={sx(lowerFence)} y={boxY - 24} class="bpa-fence-lbl" font-size="9.5" text-anchor="middle">lower fence</text>
    <text x={sx(upperFence)} y={boxY - 24} class="bpa-fence-lbl" font-size="9.5" text-anchor="middle">upper fence</text>

    {/* Whiskers */}
    <line x1={sx(minimum)} y1={boxY + boxH / 2} x2={sx(q1)} y2={boxY + boxH / 2} class="bpa-whisker" />
    <line x1={sx(q3)} y1={boxY + boxH / 2} x2={sx(maxNonOutlier)} y2={boxY + boxH / 2} class="bpa-whisker" />
    <line x1={sx(minimum)} y1={boxY + 10} x2={sx(minimum)} y2={boxY + boxH - 10} class="bpa-cap" />
    <line x1={sx(maxNonOutlier)} y1={boxY + 10} x2={sx(maxNonOutlier)} y2={boxY + boxH - 10} class="bpa-cap" />

    {/* Box */}
    <rect x={sx(q1)} y={boxY} width={sx(q3) - sx(q1)} height={boxH} class="bpa-box" />
    <line x1={sx(median)} y1={boxY} x2={sx(median)} y2={boxY + boxH} class="bpa-median" />

    {/* Outlier */}
    <circle cx={sx(outlier)} cy={boxY + boxH / 2} r="5" class="bpa-outlier" />

    {/* IQR bracket under the box */}
    <line x1={sx(q1)} y1={boxY + boxH + 12} x2={sx(q3)} y2={boxY + boxH + 12} class="bpa-iqr" />
    <text x={(sx(q1) + sx(q3)) / 2} y={boxY + boxH + 26} class="bpa-iqr-lbl" font-size="10" text-anchor="middle">
      {`IQR = ${iqr}`}
    </text>
    <text x={(sx(q1) + sx(q3)) / 2} y={boxY + boxH + 41} class="bpa-sub" font-size="9.5" text-anchor="middle">middle 50%</text>

    {/* Callout labels above */}
    <text x={sx(minimum)} y={boxY - 4} class="bpa-lbl" font-size="9.5" text-anchor="middle">min</text>
    <text x={sx(q1) - 4} y={boxY - 4} class="bpa-lbl" font-size="9.5" text-anchor="end">Q1</text>
    <text x={sx(median)} y={boxY - 4} class="bpa-lbl bpa-t-purple" font-size="9.5" text-anchor="middle" font-weight="bold">median</text>
    <text x={sx(q3) + 4} y={boxY - 4} class="bpa-lbl" font-size="9.5">Q3</text>
    {/* Anchored to the left of the cap so the upper fence line stays clear */}
    <text x={sx(maxNonOutlier) - 6} y={boxY - 4} class="bpa-lbl" font-size="9.5" text-anchor="end">whisker end</text>
    <text x={sx(outlier)} y={boxY - 4} class="bpa-t-orange" font-size="9.5" text-anchor="middle" font-weight="bold">outlier</text>

    {/* Axis */}
    <line x1={left - 10} y1={axisY} x2={rightEdge + 12} y2={axisY} class="bpa-axis" />
    {[0, 20, 40, 60, 80, 100].map((v) => (
      <g>
        <line x1={sx(v)} y1={axisY} x2={sx(v)} y2={axisY + 5} class="bpa-axis" />
        <text x={sx(v)} y={axisY + 17} class="bpa-tick" font-size="9.5" text-anchor="middle">{v}</text>
      </g>
    ))}

    {/* Footer */}
    <text x={w / 2} y={h - 26} class="bpa-foot" font-size="10.5" text-anchor="middle">
      {`Fences sit 1.5 × IQR beyond each quartile: ${lowerFence} and ${upperFence}`}
    </text>
    <text x={w / 2} y={h - 10} class="bpa-sub" font-size="9.5" text-anchor="middle">
      A flagged outlier is worth investigating, not automatically deleting
    </text>
  </svg>
</figure>

<style>
  .bpa { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .bpa svg { width:100%; max-width:100%; height:auto; }
  .bpa-box { fill:#58a6ff; fill-opacity:0.18; stroke:#58a6ff; stroke-width:2; }
  .bpa-median { stroke:#d2a8ff; stroke-width:3; }
  .bpa-whisker { stroke:#888; stroke-width:1.8; }
  .bpa-cap { stroke:#888; stroke-width:2.4; }
  .bpa-outlier { fill:none; stroke:#f0883e; stroke-width:2.4; }
  .bpa-fence { stroke:#f0883e; stroke-width:1.2; stroke-dasharray:4,3; }
  .bpa-fence-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .bpa-iqr { stroke:#58a6ff; stroke-width:1.4; }
  .bpa-iqr-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .bpa-axis { stroke:#888; stroke-width:1.4; }
  .bpa-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .bpa-lbl { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .bpa-t-purple { fill:#d2a8ff; }
  .bpa-t-orange { fill:#f0883e; }
  .bpa-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .bpa-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .bpa-foot { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .bpa-box { fill:#0550ae; fill-opacity:0.14; stroke:#0550ae; }
  :global([data-theme="light"]) .bpa-median { stroke:#6639ba; }
  :global([data-theme="light"]) .bpa-whisker, :global([data-theme="light"]) .bpa-cap { stroke:#666; }
  :global([data-theme="light"]) .bpa-outlier { stroke:#b35900; }
  :global([data-theme="light"]) .bpa-fence { stroke:#b35900; }
  :global([data-theme="light"]) .bpa-fence-lbl { fill:#b35900; }
  :global([data-theme="light"]) .bpa-iqr, :global([data-theme="light"]) .bpa-iqr-lbl { stroke:#0550ae; fill:#0550ae; }
  :global([data-theme="light"]) .bpa-axis { stroke:#666; }
  :global([data-theme="light"]) .bpa-lbl { fill:#444; }
  :global([data-theme="light"]) .bpa-t-purple { fill:#6639ba; }
  :global([data-theme="light"]) .bpa-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .bpa-head { fill:#24292f; }
  :global([data-theme="light"]) .bpa-foot { fill:#116329; }
</style>
