---
/**
 * CircleTangent - circle x² + y² = 25 (radius 5) with a tangent
 * line at (3, 4) showing slope = -3/4. Demonstrates implicit
 * differentiation: you can find the slope without solving for y.
 */
const w = 400;
const h = 400;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -6, xMax = 6, yMin = -6, yMax = 6;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const R = 5;
const cx = sx(0);
const cy = sy(0);
const rPx = sx(R) - sx(0); // radius in pixels

// Tangent point (3, 4), slope = -3/4
const px = 3, py = 4;
const slope = -3 / 4;
const tanX1 = -1, tanX2 = 6;
const tanY1 = py + slope * (tanX1 - px);
const tanY2 = py + slope * (tanX2 - px);
---

<figure class="ctg" role="img" aria-label="Circle x squared plus y squared equals 25 with tangent line at (3, 4)">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[-4,-2,2,4].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="ctg-grid" stroke-width="0.5" />
    ))}
    {[-4,-2,2,4].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="ctg-grid" stroke-width="0.5" />
    ))}
    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="ctg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="ctg-axis" stroke-width="1.2" />

    {/* Circle */}
    <circle cx={cx} cy={cy} r={rPx} fill="none" class="ctg-circle" stroke-width="3" />

    {/* Tangent line */}
    <line x1={sx(tanX1)} y1={sy(tanY1)} x2={sx(tanX2)} y2={sy(tanY2)}
          class="ctg-tangent" stroke-width="2.5" />

    {/* Dashed radius to tangent point */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(px)} y2={sy(py)}
          class="ctg-radius" stroke-width="1.5" stroke-dasharray="6,4" />

    {/* Tangent point */}
    <circle cx={sx(px)} cy={sy(py)} r="7" class="ctg-dot" />

    {/* Tick labels */}
    <text class="ctg-tick" x={sx(px)} y={sy(0) + 18} font-size="11" text-anchor="middle">3</text>
    <text class="ctg-tick" x={sx(0) - 10} y={sy(py) + 4} font-size="11" text-anchor="end">4</text>
  </svg>
  <div class="ctg-legend">
    <span class="ctg-leg-item"><span class="ctg-swatch ctg-sw-circle"></span> x² + y² = 25</span>
    <span class="ctg-leg-item"><span class="ctg-swatch ctg-sw-tan"></span> tangent at (3, 4), slope = -3/4</span>
    <span class="ctg-leg-item"><span class="ctg-swatch ctg-sw-rad"></span> radius</span>
  </div>
</figure>

<style>
  .ctg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ctg svg { max-width:100%; height:auto; }
  .ctg-grid { stroke:#333; }
  .ctg-axis { stroke:#666; }
  .ctg-circle { stroke:#58a6ff; }
  .ctg-tangent { stroke:#7ee787; }
  .ctg-radius { stroke:#d2a8ff; }
  .ctg-dot { fill:#f0883e; }
  .ctg-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .ctg-legend {
    display:flex; gap:1.2rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.85rem;
  }
  .ctg-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .ctg-swatch { display:inline-block; width:18px; height:4px; border-radius:2px; }
  .ctg-sw-circle { background:#58a6ff; }
  .ctg-sw-tan { background:#7ee787; }
  .ctg-sw-rad { background:#d2a8ff; border-style:dashed; }

  :global([data-theme="light"]) .ctg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .ctg-axis { stroke:#999; }
  :global([data-theme="light"]) .ctg-circle { stroke:#0550ae; }
  :global([data-theme="light"]) .ctg-tangent { stroke:#116329; }
  :global([data-theme="light"]) .ctg-radius { stroke:#6639ba; }
  :global([data-theme="light"]) .ctg-dot { fill:#b35900; }
  :global([data-theme="light"]) .ctg-tick { fill:#666; }
  :global([data-theme="light"]) .ctg-sw-circle { background:#0550ae; }
  :global([data-theme="light"]) .ctg-sw-tan { background:#116329; }
  :global([data-theme="light"]) .ctg-sw-rad { background:#6639ba; }
</style>
