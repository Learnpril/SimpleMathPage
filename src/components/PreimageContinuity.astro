---
/**
 * PreimageContinuity - continuity as "preimages of open sets are open". For each
 * function the preimage of an open band is found by scanning, its maximal runs are
 * reported, and openness is decided by testing whether f at a run boundary lands
 * strictly inside the band, which would mean the preimage contains a boundary point.
 */
const w = 540;
const h = 318;

const plotTop = 72;
const plotBottom = 190;

type Case = {
  cx0: number;
  cx1: number;
  title: string;
  f: (x: number) => number;
  yLo: number;
  yHi: number;
  band: [number, number];
  label: string;
};

const xLo = -2.6;
const xHi = 2.6;

const cases: Case[] = [
  {
    cx0: 40,
    cx1: 250,
    title: "f(x) = x², continuous",
    f: (x) => x * x,
    yLo: -0.4,
    yHi: 5.2,
    band: [1, 4],
    label: "(1, 4)",
  },
  {
    cx0: 300,
    cx1: 510,
    title: "a step at 0, not continuous",
    f: (x) => (x < 0 ? 0 : 1),
    yLo: -0.7,
    yHi: 1.9,
    band: [0.5, 1.5],
    label: "(0.5, 1.5)",
  },
];

const N = 4000;
function analyse(c: Case) {
  const inSet: boolean[] = [];
  const xs: number[] = [];
  for (let i = 0; i <= N; i++) {
    const x = xLo + (i / N) * (xHi - xLo);
    xs.push(x);
    const v = c.f(x);
    inSet.push(v > c.band[0] && v < c.band[1]);
  }
  // maximal runs of consecutive in-set samples
  const runs: { a: number; b: number }[] = [];
  let start = -1;
  for (let i = 0; i <= N; i++) {
    if (inSet[i] && start < 0) start = i;
    if ((!inSet[i] || i === N) && start >= 0) {
      const end = inSet[i] ? i : i - 1;
      runs.push({ a: xs[start], b: xs[end] });
      start = -1;
    }
  }
  // A run boundary strictly inside the band means the preimage holds a boundary point
  const tol = 0.02 * (c.band[1] - c.band[0]);
  let open = true;
  for (const r of runs) {
    for (const e of [r.a, r.b]) {
      const atEdge = Math.abs(e - xLo) < 1e-9 || Math.abs(e - xHi) < 1e-9;
      if (atEdge) continue;
      const v = c.f(e);
      if (v > c.band[0] + tol && v < c.band[1] - tol) open = false;
    }
  }
  return { runs, open };
}

const results = cases.map((c) => {
  const a = analyse(c);
  const px = (x: number) => c.cx0 + ((x - xLo) / (xHi - xLo)) * (c.cx1 - c.cx0);
  const py = (y: number) =>
    plotBottom - ((y - c.yLo) / (c.yHi - c.yLo)) * (plotBottom - plotTop);
  const clamp = (y: number) => Math.max(c.yLo, Math.min(c.yHi, y));
  const curve = Array.from({ length: 301 }, (_, i) => {
    const x = xLo + (i / 300) * (xHi - xLo);
    return `${px(x).toFixed(1)},${py(clamp(c.f(x))).toFixed(1)}`;
  }).join(" ");
  // Bracket style per endpoint: included when f there lands strictly inside the band
  const tol = 0.02 * (c.band[1] - c.band[0]);
  const inside = (x: number) => {
    const v = c.f(x);
    return v > c.band[0] + tol && v < c.band[1] - tol;
  };
  const atWindow = (x: number) =>
    Math.abs(x - xLo) < 1e-9 || Math.abs(x - xHi) < 1e-9;
  const desc = a.runs
    .map((r) => {
      const left = atWindow(r.a) ? "( …" : `${inside(r.a) ? "[" : "("}${r.a.toFixed(2)}`;
      const right = atWindow(r.b) ? "… )" : `${r.b.toFixed(2)}${inside(r.b) ? "]" : ")"}`;
      return `${left}, ${right}`;
    })
    .join(" ∪ ");
  return { ...c, ...a, px, py, curve, desc };
});
---

<figure
  class="prc"
  role="img"
  aria-label={`Two functions with the preimage of an open band computed. For x squared the preimage of the band from 1 to 4 is ${results[0].desc}, which is open. For the step function the preimage of the band from 0.5 to 1.5 is ${results[1].desc}, which contains its left boundary point and so is not open, showing the function is not continuous.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="prc-head" font-size="12.5" font-weight="bold">Continuity means preimages of open sets are open</text>
    <text x="16" y="38" class="prc-sub" font-size="10.5">Take an open band on the output side and pull it back</text>

    <line x1="275" y1="52" x2="275" y2="278" class="prc-divide" />

    {results.map((r) => (
      <g>
        <text x={(r.cx0 + r.cx1) / 2} y="60" class={`prc-title prc-${r.open ? "ok" : "bad"}`} font-size="10.5" text-anchor="middle" font-weight="bold">{r.title}</text>

        {/* the open band on the output side */}
        <rect x={r.cx0} y={r.py(r.band[1])} width={r.cx1 - r.cx0} height={r.py(r.band[0]) - r.py(r.band[1])} class="prc-band" />
        <line x1={r.cx0} y1={r.py(r.band[0])} x2={r.cx1} y2={r.py(r.band[0])} class="prc-edge" />
        <line x1={r.cx0} y1={r.py(r.band[1])} x2={r.cx1} y2={r.py(r.band[1])} class="prc-edge" />

        <line x1={r.cx0 - 6} y1={r.py(0)} x2={r.cx1 + 6} y2={r.py(0)} class="prc-axis" />
        <polyline points={r.curve} class={`prc-curve prc-c-${r.open ? "ok" : "bad"}`} fill="none" />

        {/* the preimage, drawn on its own line below the plot */}
        <line x1={r.cx0 - 6} y1="212" x2={r.cx1 + 6} y2="212" class="prc-axis" />
        {r.runs.map((run) => (
          <line x1={r.px(run.a)} y1="212" x2={r.px(run.b)} y2="212" class={`prc-pre prc-c-${r.open ? "ok" : "bad"}`} />
        ))}

        <text x={(r.cx0 + r.cx1) / 2} y="232" class="prc-row" font-size="9.5" text-anchor="middle">{`band ${r.label} pulls back to`}</text>
        <text x={(r.cx0 + r.cx1) / 2} y="250" class={`prc-row prc-${r.open ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">{r.desc}</text>
        <text x={(r.cx0 + r.cx1) / 2} y="272" class={`prc-verdict prc-${r.open ? "ok" : "bad"}`} font-size="10" text-anchor="middle" font-weight="bold">
          {r.open ? "open - continuous here" : "not open - so not continuous"}
        </text>
      </g>
    ))}

    <text x={w / 2} y="298" class="prc-foot" font-size="10.5" text-anchor="middle">
      f is continuous ⟺ f⁻¹(U) is open for every open U
    </text>
    <text x={w / 2} y="314" class="prc-sub2" font-size="9.5" text-anchor="middle">
      No epsilons, no distances - and it works in any topological space
    </text>
  </svg>
</figure>

<style>
  .prc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .prc svg { width:100%; max-width:100%; height:auto; }
  .prc-axis { stroke:#666; stroke-width:1.2; }
  .prc-divide { stroke:#3a3a3a; stroke-width:1; }
  .prc-band { fill:#d2a8ff; fill-opacity:0.13; stroke:none; }
  .prc-edge { stroke:#d2a8ff; stroke-width:1.2; stroke-dasharray:5,4; }
  .prc-curve { stroke-width:2.4; }
  .prc-pre { stroke-width:4.2; }
  .prc-c-ok { stroke:#7ee787; }
  .prc-c-bad { stroke:#ff7b72; }
  .prc-ok { fill:#7ee787; }
  .prc-bad { fill:#ff7b72; }
  .prc-title, .prc-verdict { font-family:'Libre Baskerville',Georgia,serif; }
  .prc-row { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .prc-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .prc-sub, .prc-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .prc-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .prc-axis { stroke:#666; }
  :global([data-theme="light"]) .prc-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .prc-band { fill:#6639ba; fill-opacity:0.1; }
  :global([data-theme="light"]) .prc-edge { stroke:#6639ba; }
  :global([data-theme="light"]) .prc-c-ok { stroke:#116329; }
  :global([data-theme="light"]) .prc-ok { fill:#116329; }
  :global([data-theme="light"]) .prc-c-bad { stroke:#a40e26; }
  :global([data-theme="light"]) .prc-bad { fill:#a40e26; }
  :global([data-theme="light"]) .prc-head { fill:#24292f; }
  :global([data-theme="light"]) .prc-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.prc-row, .prc-sub, .prc-sub2) { fill:#57606a; }
</style>
