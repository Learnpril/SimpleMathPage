---
/**
 * GradientPerp — shows the f=9 level curve (circle of radius 3)
 * with gradient arrows at (3,0) and (0,3) pointing perpendicular
 * to the circle. Demonstrates that ∇f ⊥ level curves.
 */
const w = 340;
const h = 340;
const cx = w / 2;
const cy = h / 2;
const scale = 40; // pixels per unit
const R = 3 * scale; // radius 3

// Convert math to SVG
const sx = (x: number) => cx + x * scale;
const sy = (y: number) => cy - y * scale;

const arrowLen = 50;

// Point 1: (3, 0), gradient = ⟨6, 0⟩ → points right
const p1x = sx(3);
const p1y = sy(0);

// Point 2: (0, 3), gradient = ⟨0, 6⟩ → points up
const p2x = sx(0);
const p2y = sy(3);

// Tick marks
const ticks = [-3, -2, -1, 1, 2, 3];
---

<figure class="gp" role="img" aria-label="Circle x squared plus y squared equals 9 with gradient arrows perpendicular to the curve at points (3,0) and (0,3)">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="gp-arr" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0,0 8,3 0,6" class="gp-arr-fill" />
      </marker>
    </defs>

    {/* Axes */}
    <line x1={10} y1={cy} x2={w - 10} y2={cy} class="gp-axis" stroke-width="1" />
    <line x1={cx} y1={10} x2={cx} y2={h - 10} class="gp-axis" stroke-width="1" />
    <text class="gp-tick" x={w - 12} y={cy - 8} font-size="10">x</text>
    <text class="gp-tick" x={cx + 8} y={20} font-size="10">y</text>

    {/* Tick marks */}
    {ticks.map(t => (
      <line x1={sx(t)} y1={cy - 3} x2={sx(t)} y2={cy + 3} class="gp-axis" stroke-width="1" />
    ))}
    {ticks.map(t => (
      <line x1={cx - 3} y1={sy(t)} x2={cx + 3} y2={sy(t)} class="gp-axis" stroke-width="1" />
    ))}

    {/* f = 9 circle */}
    <circle cx={cx} cy={cy} r={R} fill="none" class="gp-level" stroke-width="2" />
    <text class="gp-level-label" x={cx + R * Math.cos(-Math.PI / 4) + 6} y={cy - R * Math.sin(-Math.PI / 4) + 4} font-size="10">f = 9</text>

    {/* Point (3, 0) */}
    <circle cx={p1x} cy={p1y} r="5" class="gp-dot" />
    <text class="gp-dot-label" x={p1x - 4} y={p1y + 18} font-size="10">(3, 0)</text>

    {/* Gradient at (3,0): ⟨6, 0⟩ → points right */}
    <line x1={p1x} y1={p1y} x2={p1x + arrowLen} y2={p1y}
          class="gp-grad" stroke-width="2.5" marker-end="url(#gp-arr)" />
    <text class="gp-grad-label" x={p1x + arrowLen + 6} y={p1y + 4} font-size="10">⟨6, 0⟩</text>

    {/* Point (0, 3) */}
    <circle cx={p2x} cy={p2y} r="5" class="gp-dot" />
    <text class="gp-dot-label" x={p2x + 10} y={p2y + 5} font-size="10">(0, 3)</text>

    {/* Gradient at (0,3): ⟨0, 6⟩ → points up */}
    <line x1={p2x} y1={p2y} x2={p2x} y2={p2y - arrowLen}
          class="gp-grad" stroke-width="2.5" marker-end="url(#gp-arr)" />
    <text class="gp-grad-label" x={p2x + 8} y={p2y - arrowLen - 6} font-size="10">⟨0, 6⟩</text>

    {/* Right angle indicators */}
    {/* At (3,0): gradient goes right, circle tangent goes up/down → right angle */}
    <polyline points={`${p1x + 10},${p1y} ${p1x + 10},${p1y - 10} ${p1x},${p1y - 10}`}
             fill="none" class="gp-right-angle" stroke-width="1" />
    {/* At (0,3): gradient goes up, circle tangent goes left/right → right angle */}
    <polyline points={`${p2x},${p2y - 10} ${p2x + 10},${p2y - 10} ${p2x + 10},${p2y}`}
             fill="none" class="gp-right-angle" stroke-width="1" />

    {/* Origin */}
    <circle cx={cx} cy={cy} r="2" class="gp-origin" />
  </svg>
  <div class="gp-caption">
    At every point on the circle, the gradient points straight outward, perpendicular to the curve. The small squares mark the right angles.
  </div>
</figure>

<style>
  .gp { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .gp svg { max-width:100%; height:auto; }
  .gp-axis { stroke:#555; }
  .gp-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .gp-level { stroke:#58a6ff; opacity:0.6; }
  .gp-level-label { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .gp-dot { fill:#d2a8ff; }
  .gp-dot-label { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .gp-grad { stroke:#f0883e; }
  .gp-arr-fill { fill:#f0883e; }
  .gp-grad-label { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .gp-right-angle { stroke:#7ee787; }
  .gp-origin { fill:#666; }
  .gp-caption {
    max-width:340px; text-align:center; margin-top:0.6rem;
    font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
    color:#999; line-height:1.5;
  }
  :global([data-theme="light"]) .gp-axis { stroke:#bbb; }
  :global([data-theme="light"]) .gp-tick { fill:#666; }
  :global([data-theme="light"]) .gp-level { stroke:#0550ae; }
  :global([data-theme="light"]) .gp-level-label { fill:#0550ae; }
  :global([data-theme="light"]) .gp-dot { fill:#6639ba; }
  :global([data-theme="light"]) .gp-dot-label { fill:#6639ba; }
  :global([data-theme="light"]) .gp-grad { stroke:#b35900; }
  :global([data-theme="light"]) .gp-arr-fill { fill:#b35900; }
  :global([data-theme="light"]) .gp-grad-label { fill:#b35900; }
  :global([data-theme="light"]) .gp-right-angle { stroke:#116329; }
  :global([data-theme="light"]) .gp-origin { fill:#aaa; }
  :global([data-theme="light"]) .gp-caption { color:#666; }
</style>
