---
/**
 * NetVsTotalGraph - shows f(x) = x on [-2, 3].
 * Green shaded area above x-axis (positive), red below (negative).
 * Net = 2.5, Total = 6.5.
 */
const w = 420;
const h = 280;
const pad = 55;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -3, xMax = 4, yMin = -3, yMax = 4;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// Negative triangle: (-2,0) to (0,0) to (0,-2) - actually (-2,-2) to (0,0)
const negPts = `${sx(-2)},${sy(0)} ${sx(-2)},${sy(-2)} ${sx(0)},${sy(0)}`;
// Positive triangle: (0,0) to (3,3) to (3,0)
const posPts = `${sx(0)},${sy(0)} ${sx(3)},${sy(3)} ${sx(3)},${sy(0)}`;
---

<figure class="nvt" role="img" aria-label="f(x) = x from -2 to 3 showing positive area above axis and negative area below">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {[-2,-1,0,1,2,3].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="nvt-grid" stroke-width="0.5" />
    ))}
    {[-2,-1,0,1,2,3].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="nvt-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="nvt-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="nvt-axis" stroke-width="1.2" />

    {/* Negative area (red) */}
    <polygon points={negPts} class="nvt-neg" />
    {/* Positive area (green) */}
    <polygon points={posPts} class="nvt-pos" />

    {/* Line f(x) = x */}
    <line x1={sx(-2)} y1={sy(-2)} x2={sx(3)} y2={sy(3)} class="nvt-line" stroke-width="3" />

    <text class="nvt-tick" x={sx(-2)} y={sy(0) + 18} font-size="10" text-anchor="middle">-2</text>
    <text class="nvt-tick" x={sx(3)} y={sy(0) + 18} font-size="10" text-anchor="middle">3</text>
  </svg>
  <div class="nvt-legend">
    <span class="nvt-leg-item"><span class="nvt-swatch nvt-sw-pos"></span> positive area = 4.5</span>
    <span class="nvt-leg-item"><span class="nvt-swatch nvt-sw-neg"></span> negative area = -2</span>
    <span class="nvt-leg-item nvt-leg-note">net = 2.5, total = 6.5</span>
  </div>
</figure>

<style>
  .nvt { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .nvt svg { max-width:100%; height:auto; }
  .nvt-grid { stroke:#333; }
  .nvt-axis { stroke:#666; }
  .nvt-line { stroke:#58a6ff; }
  .nvt-pos { fill:rgba(126,231,135,0.25); }
  .nvt-neg { fill:rgba(244,112,103,0.25); }
  .nvt-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .nvt-legend {
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .nvt-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .nvt-swatch { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .nvt-sw-pos { background:rgba(126,231,135,0.4); }
  .nvt-sw-neg { background:rgba(244,112,103,0.4); }
  .nvt-leg-note { color:#d2a8ff; font-style:italic; }
  :global([data-theme="light"]) .nvt-grid { stroke:#ddd; }
  :global([data-theme="light"]) .nvt-axis { stroke:#999; }
  :global([data-theme="light"]) .nvt-line { stroke:#0550ae; }
  :global([data-theme="light"]) .nvt-pos { fill:rgba(17,99,41,0.15); }
  :global([data-theme="light"]) .nvt-neg { fill:rgba(207,34,46,0.15); }
  :global([data-theme="light"]) .nvt-tick { fill:#666; }
  :global([data-theme="light"]) .nvt-sw-pos { background:rgba(17,99,41,0.25); }
  :global([data-theme="light"]) .nvt-sw-neg { background:rgba(207,34,46,0.25); }
  :global([data-theme="light"]) .nvt-leg-note { color:#6639ba; }
</style>
