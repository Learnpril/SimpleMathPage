---
/**
 * CyclicClock — which elements of ℤ₁₂ generate the whole group, and what
 * happens when one doesn't.
 *
 * Generators are computed from gcd(k, 12) = 1 and the orbit on the right is
 * computed by repeated addition, so the picture is derived rather than asserted.
 */
const n = 12;
const w = 540;
const h = 316;
const r = 84;
const labelR = 100;
const cy = 162;
const leftCx = 140;
const rightCx = 400;

const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
const generators = Array.from({ length: n }, (_, k) => k).filter(
  (k) => gcd(k, n) === 1,
);

// The subgroup generated by 3, found by adding 3 until it returns to 0
const step = 3;
const orbit: number[] = [];
let cur = 0;
do {
  orbit.push(cur);
  cur = (cur + step) % n;
} while (cur !== 0);

const pos = (k: number, radius: number, cx: number) => {
  const a = (-90 + k * (360 / n)) * (Math.PI / 180);
  return { x: cx + radius * Math.cos(a), y: cy + radius * Math.sin(a) };
};

const orbitSet = new Set(orbit);
const genSet = new Set(generators);
---

<figure
  class="cyc"
  role="img"
  aria-label={`Two clock diagrams of the integers mod 12. On the left the generators ${generators.join(", ")} are highlighted, being the values coprime to 12. On the right, repeatedly adding 3 visits only ${orbit.join(", ")} before returning to zero, so it generates a subgroup of order ${orbit.length}.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="cyc-head" font-size="12.5" font-weight="bold">Which elements sweep out all of ℤ₁₂?</text>

    {/* ---------- Left: the generators ---------- */}
    <text x={leftCx} y="40" class="cyc-title cyc-t-green" font-size="11.5" text-anchor="middle" font-weight="bold">Generators of ℤ₁₂</text>
    <circle cx={leftCx} cy={cy} r={r} class="cyc-ring" />
    {Array.from({ length: n }, (_, k) => {
      const p = pos(k, r, leftCx);
      const l = pos(k, labelR, leftCx);
      const isGen = genSet.has(k);
      return (
        <g>
          <circle cx={p.x} cy={p.y} r="6" class={isGen ? "cyc-dot cyc-dot-gen" : "cyc-dot cyc-dot-plain"} />
          <text x={l.x} y={l.y + 3.5} class={isGen ? "cyc-lbl cyc-t-green" : "cyc-lbl cyc-dim"} font-size="10" text-anchor="middle">{k}</text>
        </g>
      );
    })}

    {/* ---------- Right: an element that closes early ---------- */}
    <text x={rightCx} y="40" class="cyc-title cyc-t-orange" font-size="11.5" text-anchor="middle" font-weight="bold">
      {`⟨${step}⟩ closes after ${orbit.length} steps`}
    </text>
    <circle cx={rightCx} cy={cy} r={r} class="cyc-ring" />
    {orbit.map((k, i) => {
      const a = pos(k, r, rightCx);
      const b = pos(orbit[(i + 1) % orbit.length], r, rightCx);
      return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class="cyc-chord" />;
    })}
    {Array.from({ length: n }, (_, k) => {
      const p = pos(k, r, rightCx);
      const l = pos(k, labelR, rightCx);
      const on = orbitSet.has(k);
      return (
        <g>
          <circle cx={p.x} cy={p.y} r={on ? 6 : 4} class={on ? "cyc-dot cyc-dot-orbit" : "cyc-dot cyc-dot-off"} />
          <text x={l.x} y={l.y + 3.5} class={on ? "cyc-lbl cyc-t-orange" : "cyc-lbl cyc-dim"} font-size="10" text-anchor="middle">{k}</text>
        </g>
      );
    })}

    <text x={w / 2} y="288" class="cyc-foot" font-size="10" text-anchor="middle">
      {`k generates ℤ₁₂ exactly when gcd(k, 12) = 1, so the generators are ${generators.join(", ")}`}
    </text>
    <text x={w / 2} y="304" class="cyc-sub" font-size="9.5" text-anchor="middle">
      {`Otherwise ⟨k⟩ has order 12 / gcd(k, 12) — here ⟨${step}⟩ has order ${orbit.length}`}
    </text>
  </svg>
</figure>

<style>
  .cyc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cyc svg { width:100%; max-width:100%; height:auto; }
  .cyc-ring { fill:none; stroke:#444; stroke-width:1.4; }
  .cyc-dot { stroke-width:1.6; }
  .cyc-dot-gen { fill:#7ee787; stroke:#7ee787; }
  .cyc-dot-plain { fill:none; stroke:#666; }
  .cyc-dot-orbit { fill:#f0883e; stroke:#f0883e; }
  .cyc-dot-off { fill:none; stroke:#666; }
  .cyc-chord { stroke:#f0883e; stroke-width:1.8; }
  .cyc-lbl, .cyc-title { font-family:'Libre Baskerville',Georgia,serif; }
  .cyc-t-green { fill:#7ee787; }
  .cyc-t-orange { fill:#f0883e; }
  .cyc-dim { fill:#8b949e; }
  .cyc-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .cyc-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .cyc-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .cyc-ring { stroke:#d0d7de; }
  :global([data-theme="light"]) .cyc-dot-gen, :global([data-theme="light"]) .cyc-t-green { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .cyc-dot-orbit, :global([data-theme="light"]) .cyc-t-orange, :global([data-theme="light"]) .cyc-chord { fill:#b35900; stroke:#b35900; }
  :global([data-theme="light"]) :is(.cyc-dot-plain, .cyc-dot-off) { stroke:#8b949e; fill:none; }
  :global([data-theme="light"]) .cyc-dim { fill:#57606a; }
  :global([data-theme="light"]) .cyc-head { fill:#24292f; }
  :global([data-theme="light"]) .cyc-foot { fill:#0550ae; }
  :global([data-theme="light"]) .cyc-sub { fill:#57606a; }
</style>
