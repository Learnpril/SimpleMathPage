---
/**
 * ExpectedValueDiagram — expected value as a weighted balance point. Blocks
 * sized by probability sit on a beam, and the fulcrum is at E(X), which is not
 * one of the possible outcomes.
 */
const dist = [
  { x: 0, p: 1 / 8 },
  { x: 1, p: 3 / 8 },
  { x: 2, p: 3 / 8 },
  { x: 3, p: 1 / 8 },
];
const ev = dist.reduce((s, d) => s + d.x * d.p, 0); // 1.5

const w = 520;
const h = 266;
const left = 90;
const right = 440;
const beamY = 150;
const sx = (v: number) => left + (v / 3) * (right - left);
const maxBlock = 78;
---

<figure
  class="evd"
  role="img"
  aria-label="Expected value shown as a balance point. Blocks sized by probability sit at 0, 1, 2 and 3 heads, and the fulcrum sits at 1.5, which is not a possible outcome."
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="evd-head" font-size="12.5" font-weight="bold">Expected value is a weighted balance point</text>
    <text x="16" y="38" class="evd-sub" font-size="10">number of heads in three coin flips</text>

    {/* Probability blocks */}
    {dist.map((d) => {
      const bh = d.p * maxBlock * 2.2;
      const bw = 40;
      return (
        <g>
          <rect x={sx(d.x) - bw / 2} y={beamY - bh} width={bw} height={bh} class="evd-block" />
          <text x={sx(d.x)} y={beamY - bh - 6} class="evd-prob" font-size="9.5" text-anchor="middle">
            {d.p === 1 / 8 ? "1/8" : "3/8"}
          </text>
          <text x={sx(d.x)} y={beamY + 16} class="evd-xval" font-size="11.5" text-anchor="middle" font-weight="bold">{d.x}</text>
        </g>
      );
    })}

    {/* Beam */}
    <line x1={left - 30} y1={beamY} x2={right + 30} y2={beamY} class="evd-beam" />

    {/* Fulcrum at E(X) */}
    <polygon
      points={`${sx(ev)},${beamY + 4} ${sx(ev) - 14},${beamY + 34} ${sx(ev) + 14},${beamY + 34}`}
      class="evd-fulcrum"
    />
    <line x1={sx(ev)} y1={beamY + 34} x2={sx(ev)} y2={beamY + 42} class="evd-stem" />
    <text x={sx(ev)} y={beamY + 58} class="evd-ev" font-size="12" text-anchor="middle" font-weight="bold">
      {`E(X) = ${ev}`}
    </text>
    <text x={sx(ev)} y={beamY + 72} class="evd-note" font-size="9.5" text-anchor="middle">the balance point</text>

    {/* Arithmetic */}
    <text x={w / 2} y={h - 28} class="evd-calc" font-size="10.5" text-anchor="middle">
      0(1/8) + 1(3/8) + 2(3/8) + 3(1/8) = 12/8 = 1.5
    </text>
    <text x={w / 2} y={h - 8} class="evd-foot" font-size="10" text-anchor="middle">
      You can never flip 1.5 heads — expected value is a long-run average, not a prediction
    </text>
  </svg>
</figure>

<style>
  .evd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .evd svg { width:100%; max-width:100%; height:auto; }
  .evd-block { fill:#58a6ff; fill-opacity:0.35; stroke:#58a6ff; stroke-width:1.6; }
  .evd-beam { stroke:#888; stroke-width:3; }
  .evd-fulcrum { fill:#f0883e; fill-opacity:0.5; stroke:#f0883e; stroke-width:1.8; }
  .evd-stem { stroke:#f0883e; stroke-width:2; }
  .evd-prob { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .evd-xval { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .evd-ev { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .evd-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .evd-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .evd-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .evd-calc { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .evd-foot { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .evd-block { fill:#0550ae; fill-opacity:0.25; stroke:#0550ae; }
  :global([data-theme="light"]) .evd-beam { stroke:#666; }
  :global([data-theme="light"]) .evd-fulcrum { fill:#b35900; fill-opacity:0.35; stroke:#b35900; }
  :global([data-theme="light"]) .evd-stem { stroke:#b35900; }
  :global([data-theme="light"]) .evd-xval { fill:#444; }
  :global([data-theme="light"]) .evd-ev { fill:#b35900; }
  :global([data-theme="light"]) .evd-head { fill:#24292f; }
  :global([data-theme="light"]) .evd-calc { fill:#116329; }
</style>
