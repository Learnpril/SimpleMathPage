---
/**
 * PolarEquationExamples - shows three common polar equations side by side:
 * r = 3 (circle at origin), r = 3cosθ (circle on x-axis), r = 3sinθ (circle on y-axis)
 */
const cellW = 150;
const cellH = 150;
const gap = 12;
const pad = 8;
const w = 3 * cellW + 2 * gap + 2 * pad;
const h = cellH + 2 * pad + 20;

const cases = [
  { label: 'r = 3', cx: 0, cy: 0, radius: 40, color: '#58a6ff' },
  { label: 'r = 3 cos θ', cx: 20, cy: 0, radius: 20, color: '#7ee787' },
  { label: 'r = 3 sin θ', cx: 0, cy: -20, radius: 20, color: '#d2a8ff' },
];
---

<figure class="peq" role="img" aria-label="Three common polar equations: r=a circle at origin, r=a cos θ circle on x-axis, r=a sin θ circle on y-axis">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {cases.map((c, i) => {
      const x0 = pad + i * (cellW + gap);
      const y0 = pad;
      const midX = x0 + cellW / 2;
      const midY = y0 + cellH / 2;
      return (
        <g>
          {/* Card background */}
          <rect x={x0} y={y0} width={cellW} height={cellH} rx="8" class="peq-card" />

          {/* Light axes */}
          <line x1={x0 + 10} y1={midY} x2={x0 + cellW - 10} y2={midY} class="peq-axis" stroke-width="0.8" />
          <line x1={midX} y1={y0 + 10} x2={midX} y2={y0 + cellH - 10} class="peq-axis" stroke-width="0.8" />

          {/* Circle */}
          <circle cx={midX + c.cx} cy={midY + c.cy} r={c.radius} fill="none" stroke={c.color} stroke-width="2.5" />

          {/* Origin dot */}
          <circle cx={midX} cy={midY} r="2.5" class="peq-origin" />

          {/* Label below card */}
          <text x={midX} y={y0 + cellH + 14} font-size="11" font-weight="bold" text-anchor="middle" fill={c.color} class="peq-lbl">{c.label}</text>
        </g>
      );
    })}
  </svg>
</figure>

<style>
  .peq { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .peq svg { max-width:100%; height:auto; }
  .peq-card { fill:#1c2128; stroke:#444; stroke-width:1; }
  .peq-axis { stroke:#555; }
  .peq-origin { fill:#f0883e; }
  .peq-lbl { font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .peq-card { fill:#f0f0f0; stroke:#ccc; }
  :global([data-theme="light"]) .peq-axis { stroke:#bbb; }
  :global([data-theme="light"]) .peq-origin { fill:#b35900; }
</style>
