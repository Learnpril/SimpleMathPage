---
/**
 * TempModelGraph — plots T(t) = -30cos(πt/6) + 60 over 12 months
 * with a horizontal line at T = 60 and intersection points marked.
 */
const w = 520;
const h = 260;
const pad = 45;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const cxO = pad;
const cyO = pad;
const tMin = 0;
const tMax = 12;
const yMin = 20;
const yMax = 100;
const scaleX = gw / (tMax - tMin);
const scaleY = gh / (yMax - yMin);

function px(t: number) { return cxO + (t - tMin) * scaleX; }
function py(y: number) { return cyO + (yMax - y) * scaleY; }

// Temperature curve
const pts: string[] = [];
for (let t = 0; t <= 12; t += 0.1) {
  const v = -30 * Math.cos(Math.PI * t / 6) + 60;
  pts.push(`${pts.length === 0 ? 'M' : 'L'}${px(t).toFixed(1)},${py(v).toFixed(1)}`);
}

const months = ['J','F','M','A','M','J','J','A','S','O','N','D'];
---

<figure class="tmg" role="img" aria-label="Temperature model showing T = -30cos(πt/6) + 60 with 60°F line">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Axes */}
    <line x1={cxO} y1={py(yMin)} x2={px(tMax) + 5} y2={py(yMin)} class="tmg-axis" stroke-width="1.5" />
    <line x1={cxO} y1={py(yMax) - 5} x2={cxO} y2={py(yMin)} class="tmg-axis" stroke-width="1.5" />

    {/* Y ticks */}
    {[30, 60, 90].map(v => (
      <g>
        <line x1={cxO - 4} y1={py(v)} x2={cxO} y2={py(v)} class="tmg-axis" stroke-width="1" />
        <text class="tmg-tick" x={cxO - 8} y={py(v) + 4} font-size="11" text-anchor="end">{v}°</text>
      </g>
    ))}

    {/* Month labels */}
    {months.map((m, i) => (
      <text class="tmg-tick" x={px(i + 0.5)} y={py(yMin) + 16} font-size="10" text-anchor="middle">{m}</text>
    ))}

    {/* 60°F reference line */}
    <line x1={cxO} y1={py(60)} x2={px(tMax)} y2={py(60)} class="tmg-ref" stroke-width="1.5" stroke-dasharray="6,4" />
    <text class="tmg-ref-label" x={px(tMax) + 4} y={py(60) + 4} font-size="10">60°F</text>

    {/* Temperature curve */}
    <path d={pts.join(' ')} fill="none" class="tmg-curve" stroke-width="2.5" />

    {/* Intersection points at t=3 (March) and t=9 (September) */}
    <circle cx={px(3)} cy={py(60)} r="5" class="tmg-dot" />
    <circle cx={px(9)} cy={py(60)} r="5" class="tmg-dot" />
    <text class="tmg-dot-label" x={px(3) - 16} y={py(60) - 10} font-size="11" text-anchor="middle">Mar</text>
    <text class="tmg-dot-label" x={px(9) + 16} y={py(60) - 10} font-size="11" text-anchor="middle">Sep</text>

    {/* Min/Max labels */}
    <text class="tmg-minmax" x={px(0)} y={py(30) + 16} font-size="10" text-anchor="middle">30°F</text>
    <text class="tmg-minmax" x={px(6)} y={py(90) - 8} font-size="10" text-anchor="middle">90°F</text>

    {/* Legend */}
    <line x1={w - 160} y1="14" x2={w - 140} y2="14" class="tmg-curve" stroke-width="2.5" />
    <text class="tmg-legend" x={w - 135} y="18" font-size="11">T(t) = -30cos(πt/6) + 60</text>
  </svg>
</figure>

<style>
  .tmg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .tmg svg { max-width:100%; height:auto; }
  .tmg-axis { stroke:#666; }
  .tmg-tick { fill:#999; font-family:'Libre Baskerville',Georgia,serif; }
  .tmg-ref { stroke:#e3922a; opacity:0.6; }
  .tmg-ref-label { fill:#e3922a; font-family:'Libre Baskerville',Georgia,serif; }
  .tmg-curve { stroke:#f47067; }
  .tmg-dot { fill:#58a6ff; }
  .tmg-dot-label { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .tmg-minmax { fill:#999; font-family:'Libre Baskerville',Georgia,serif; }
  .tmg-legend { fill:#f47067; font-family:'Libre Baskerville',Georgia,serif; }

  :global([data-theme="light"]) .tmg-axis { stroke:#999; }
  :global([data-theme="light"]) .tmg-tick { fill:#555; }
  :global([data-theme="light"]) .tmg-curve { stroke:#cf222e; }
  :global([data-theme="light"]) .tmg-dot { fill:#0969da; }
  :global([data-theme="light"]) .tmg-dot-label { fill:#0969da; }
  :global([data-theme="light"]) .tmg-legend { fill:#cf222e; }
</style>
