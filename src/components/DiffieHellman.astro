---
/**
 * DiffieHellman — key exchange in the cyclic group U(p), with every number
 * computed by modular exponentiation rather than typed in. Both sides really do
 * arrive at the same secret, and the figure would break visibly if they did not.
 */
const p = 23;
const g = 5;
const aSecret = 6;
const bSecret = 15;

function modPow(base: number, exp: number, mod: number) {
  let result = 1;
  let b = base % mod;
  let e = exp;
  while (e > 0) {
    if (e & 1) result = (result * b) % mod;
    b = (b * b) % mod;
    e >>= 1;
  }
  return result;
}

const aPublic = modPow(g, aSecret, p);
const bPublic = modPow(g, bSecret, p);
const aShared = modPow(bPublic, aSecret, p);
const bShared = modPow(aPublic, bSecret, p);
const agree = aShared === bShared;

const w = 540;
const h = 326;
const leftCx = 110;
const rightCx = 430;
---

<figure
  class="dhx"
  role="img"
  aria-label={`Diffie-Hellman key exchange modulo ${p} with generator ${g}. Alice's secret ${aSecret} gives public value ${aPublic}, Bob's secret ${bSecret} gives ${bPublic}, and both compute the same shared secret ${aShared} without ever transmitting it.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="dhx-head" font-size="12.5" font-weight="bold">A shared secret nobody transmitted</text>

    <rect x="150" y="34" width="240" height="28" rx="6" class="dhx-public" />
    <text x={w / 2} y="53" class="dhx-publbl" font-size="10.5" text-anchor="middle">
      {`public: p = ${p}, g = ${g}`}
    </text>

    <text x={leftCx} y="84" class="dhx-who dhx-t-blue" font-size="12" text-anchor="middle" font-weight="bold">Alice</text>
    <text x={rightCx} y="84" class="dhx-who dhx-t-green" font-size="12" text-anchor="middle" font-weight="bold">Bob</text>

    <text x={leftCx} y="110" class="dhx-secret" font-size="10" text-anchor="middle">{`secret a = ${aSecret}`}</text>
    <text x={rightCx} y="110" class="dhx-secret" font-size="10" text-anchor="middle">{`secret b = ${bSecret}`}</text>

    <text x={leftCx} y="136" class="dhx-calc dhx-t-blue" font-size="10" text-anchor="middle">
      {`A = gᵃ mod p = ${aPublic}`}
    </text>
    <text x={rightCx} y="136" class="dhx-calc dhx-t-green" font-size="10" text-anchor="middle">
      {`B = gᵇ mod p = ${bPublic}`}
    </text>

    {/* The public exchange */}
    <text x={w / 2} y="152" class="dhx-wire" font-size="9.5" text-anchor="middle">{`sends ${aPublic}`}</text>
    <line x1="205" y1="162" x2="333" y2="162" class="dhx-arrow dhx-a-blue" marker-end="url(#dhx-h-blue)" />
    <line x1="335" y1="182" x2="207" y2="182" class="dhx-arrow dhx-a-green" marker-end="url(#dhx-h-green)" />
    <text x={w / 2} y="196" class="dhx-wire" font-size="9.5" text-anchor="middle">{`sends ${bPublic}`}</text>

    <text x={leftCx} y="218" class="dhx-calc dhx-t-blue" font-size="10" text-anchor="middle">
      {`Bᵃ mod p = ${aShared}`}
    </text>
    <text x={rightCx} y="218" class="dhx-calc dhx-t-green" font-size="10" text-anchor="middle">
      {`Aᵇ mod p = ${bShared}`}
    </text>

    <rect x="170" y="240" width="200" height="32" rx="7" class="dhx-shared" />
    <text x={w / 2} y="261" class="dhx-sharedlbl" font-size="11" text-anchor="middle" font-weight="bold">
      {agree ? `shared secret = ${aShared}` : "MISMATCH"}
    </text>

    <text x={w / 2} y="296" class="dhx-foot" font-size="10.5" text-anchor="middle">
      {`An eavesdropper sees p, g, ${aPublic} and ${bPublic}, and must solve a discrete logarithm`}
    </text>
    <text x={w / 2} y="314" class="dhx-sub" font-size="9.5" text-anchor="middle">
      {`Both sides land on g^(ab) = ${aShared}, because exponents commute in the cyclic group U(${p})`}
    </text>

    <defs>
      <marker id="dhx-h-blue" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="dhx-hf-blue" />
      </marker>
      <marker id="dhx-h-green" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="dhx-hf-green" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .dhx { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .dhx svg { width:100%; max-width:100%; height:auto; }
  .dhx-public { fill:none; stroke:#8b949e; stroke-width:1.3; stroke-dasharray:5,4; }
  .dhx-publbl { fill:#c9d1d9; font-family:'Libre Baskerville',Georgia,serif; }
  .dhx-who, .dhx-calc, .dhx-secret { font-family:'Libre Baskerville',Georgia,serif; }
  .dhx-t-blue { fill:#58a6ff; }
  .dhx-t-green { fill:#7ee787; }
  .dhx-secret { fill:#f0883e; font-style:italic; }
  .dhx-wire { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .dhx-arrow { stroke-width:1.6; }
  .dhx-a-blue { stroke:#58a6ff; }
  .dhx-a-green { stroke:#7ee787; }
  .dhx-hf-blue { fill:#58a6ff; }
  .dhx-hf-green { fill:#7ee787; }
  .dhx-shared { fill:#d2a8ff; fill-opacity:0.16; stroke:#d2a8ff; stroke-width:1.8; }
  .dhx-sharedlbl { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .dhx-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .dhx-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .dhx-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .dhx-public { stroke:#57606a; }
  :global([data-theme="light"]) .dhx-publbl { fill:#24292f; }
  :global([data-theme="light"]) .dhx-t-blue, :global([data-theme="light"]) .dhx-a-blue, :global([data-theme="light"]) .dhx-hf-blue { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .dhx-t-green, :global([data-theme="light"]) .dhx-a-green, :global([data-theme="light"]) .dhx-hf-green { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .dhx-secret, :global([data-theme="light"]) .dhx-foot { fill:#b35900; }
  :global([data-theme="light"]) .dhx-shared, :global([data-theme="light"]) .dhx-sharedlbl { fill:#6639ba; stroke:#6639ba; }
  :global([data-theme="light"]) .dhx-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.dhx-wire, .dhx-sub) { fill:#57606a; }
</style>
