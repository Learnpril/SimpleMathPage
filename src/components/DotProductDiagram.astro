---
/**
 * DotProductDiagram - shows two vectors with the angle between them
 * u = <3, 4>, v = <-2, 5>, angle ~59 degrees, dot product = 14
 * Dual-theme with polygon arrowheads.
 */
---
<div class="diagram-container">
<svg viewBox="-80 -30 430 280" width="100%" style="max-width:520px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Dot product: angle between vectors u and v">

  <!-- Grid -->
  <g stroke="#333" stroke-width="0.5" opacity="0.2">
    <line x1="-40" y1="0" x2="240" y2="0" /><line x1="-40" y1="40" x2="240" y2="40" />
    <line x1="-40" y1="80" x2="240" y2="80" /><line x1="-40" y1="120" x2="240" y2="120" />
    <line x1="-40" y1="160" x2="240" y2="160" /><line x1="-40" y1="200" x2="240" y2="200" />
    <line x1="-40" y1="-20" x2="-40" y2="210" /><line x1="0" y1="-20" x2="0" y2="210" />
    <line x1="40" y1="-20" x2="40" y2="210" /><line x1="80" y1="-20" x2="80" y2="210" />
    <line x1="120" y1="-20" x2="120" y2="210" /><line x1="160" y1="-20" x2="160" y2="210" />
    <line x1="200" y1="-20" x2="200" y2="210" /><line x1="240" y1="-20" x2="240" y2="210" />
  </g>

  <!-- Axes through origin at (0, 200) -->
  <line x1="-50" y1="200" x2="250" y2="200" stroke="#888" stroke-width="1.2" />
  <line x1="0" y1="210" x2="0" y2="-20" stroke="#888" stroke-width="1.2" />

  <!-- Scale: 30px per unit. Origin at (0, 200). y flipped. -->
  <!-- u = (3,4): endpoint (90, 80) -->
  <!-- v = (-2,5): endpoint (-60, 50) -->

  <!-- Angle arc between u and v (radius 35, from u direction to v direction) -->
  <!-- Origin (0,200). u angle: -53.1 deg, v angle: -111.8 deg in SVG coords -->
  <!-- u point at r=35: (21, 172), v point at r=35: (-13, 167.5) -->
  <path d="M 21 172 A 35 35 0 0 0 -13 167.5" fill="none" stroke="#d2a8ff" stroke-width="1.5" class="dp-arc" />
  <text x="8" y="158" fill="#d2a8ff" font-size="11" font-family="serif" class="dp-angle-text">59°</text>

  <!-- Vector u (blue): origin to (90, 80) -->
  <line x1="0" y1="200" x2="82.8" y2="89.6" stroke="#58a6ff" stroke-width="2.5" />
  <polygon points="90,80 86.8,92.6 78.8,86.6" class="dp-blue-arrow" fill="#58a6ff" />

  <!-- Vector v (green): origin to (-60, 50) -->
  <line x1="0" y1="200" x2="-55.5" y2="61.1" stroke="#7ee787" stroke-width="2.5" />
  <polygon points="-60,50 -50.9,59.2 -60.1,63.0" class="dp-green-arrow" fill="#7ee787" />

  <!-- Labels -->
  <text x="70" y="70" fill="#58a6ff" font-size="13" font-weight="bold" font-family="serif">u</text>
  <text x="-55" y="42" fill="#7ee787" font-size="13" font-weight="bold" font-family="serif">v</text>

  <!-- Dot product result -->
  <text x="100" y="140" fill="#999" font-size="12" font-family="serif" font-style="italic">u · v = 14</text>

  <!-- Origin dot -->
  <circle cx="0" cy="200" r="3" fill="#999" />

  <!-- Legend -->
  <g transform="translate(-70, 220)">
    <line x1="5" y1="0" x2="20" y2="0" stroke="#58a6ff" stroke-width="2.5" />
    <text x="25" y="4" fill="#58a6ff" font-size="9" font-family="serif">u = &#x27E8;3, 4&#x27E9;</text>
    <line x1="105" y1="0" x2="120" y2="0" stroke="#7ee787" stroke-width="2.5" />
    <text x="125" y="4" fill="#7ee787" font-size="9" font-family="serif">v = &#x27E8;-2, 5&#x27E9;</text>
    <line x1="205" y1="0" x2="220" y2="0" stroke="#d2a8ff" stroke-width="1.5" />
    <text x="225" y="4" fill="#d2a8ff" font-size="9" font-family="serif">&#x03B8; = 59° (dot product)</text>
  </g>
</svg>
</div>

<style>
  .dp-blue-arrow { fill: #58a6ff; }
  .dp-green-arrow { fill: #7ee787; }
  :global([data-theme="light"]) .dp-blue-arrow { fill: #0550ae; }
  :global([data-theme="light"]) .dp-green-arrow { fill: #1a7f2e; }
  :global([data-theme="light"]) svg text[fill="#58a6ff"] { fill: #0550ae; }
  :global([data-theme="light"]) svg text[fill="#7ee787"] { fill: #1a7f2e; }
  :global([data-theme="light"]) svg text[fill="#d2a8ff"] { fill: #6b3fa0; }
  :global([data-theme="light"]) svg text[fill="#999"] { fill: #555; }
  :global([data-theme="light"]) svg line[stroke="#58a6ff"] { stroke: #0550ae; }
  :global([data-theme="light"]) svg line[stroke="#7ee787"] { stroke: #1a7f2e; }
  :global([data-theme="light"]) svg line[stroke="#d2a8ff"] { stroke: #6b3fa0; }
  :global([data-theme="light"]) svg line[stroke="#888"] { stroke: #bbb; }
  :global([data-theme="light"]) svg .dp-arc { stroke: #6b3fa0; }
  :global([data-theme="light"]) svg .dp-angle-text { fill: #6b3fa0; }
  :global([data-theme="light"]) svg g[opacity="0.2"] line { stroke: #ccc; }
  :global([data-theme="light"]) svg circle[fill="#999"] { fill: #777; }
</style>
