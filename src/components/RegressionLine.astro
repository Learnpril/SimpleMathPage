---
/**
 * RegressionLine - a least-squares line with residuals drawn as vertical
 * segments, illustrating that the line minimizes the sum of squared residuals.
 * The line is genuinely computed from the plotted points.
 */
const raw = [
  { x: 1, y: 57 },
  { x: 2, y: 63 },
  { x: 3, y: 58 },
  { x: 4, y: 72 },
  { x: 5, y: 70 },
  { x: 6, y: 84 },
  { x: 7, y: 79 },
  { x: 8, y: 90 },
];
const n = raw.length;
const mx = raw.reduce((s, p) => s + p.x, 0) / n;
const my = raw.reduce((s, p) => s + p.y, 0) / n;
const sxy = raw.reduce((s, p) => s + (p.x - mx) * (p.y - my), 0);
const sxx = raw.reduce((s, p) => s + (p.x - mx) ** 2, 0);
const slope = sxy / sxx;
const intercept = my - slope * mx;

const w = 520;
const h = 282;
const plotL = 70;
const plotR = 404;
const plotT = 48;
// Right-hand key panel: kept far enough from the edge that the widest line,
// the regression equation, still fits inside the viewBox.
const panelX = plotR + 22;
const plotB = 192;
const xMin = 0;
const xMax = 9;
const yMin = 45;
const yMax = 100;
const px = (x: number) => plotL + ((x - xMin) / (xMax - xMin)) * (plotR - plotL);
const py = (y: number) => plotB - ((y - yMin) / (yMax - yMin)) * (plotB - plotT);
const fit = (x: number) => intercept + slope * x;
---

<figure
  class="rgl"
  role="img"
  aria-label={`A scatterplot with a fitted least-squares line of slope ${slope.toFixed(2)}, with vertical residual segments from each point to the line`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="rgl-head" font-size="12.5" font-weight="bold">Least squares minimizes the squared residuals</text>

    {/* Axes */}
    <line x1={plotL} y1={plotB} x2={plotR + 10} y2={plotB} class="rgl-axis" />
    <line x1={plotL} y1={plotT - 10} x2={plotL} y2={plotB} class="rgl-axis" />
    <text x={(plotL + plotR) / 2} y={plotB + 30} class="rgl-axlbl" font-size="10" text-anchor="middle">hours studied (x)</text>
    <text x={plotL - 46} y={(plotT + plotB) / 2} class="rgl-axlbl" font-size="10" text-anchor="middle">score (y)</text>

    {/* Regression line */}
    <line x1={px(0.4)} y1={py(fit(0.4))} x2={px(8.6)} y2={py(fit(8.6))} class="rgl-line" />

    {/* Residuals then points */}
    {raw.map((p) => (
      <line x1={px(p.x)} y1={py(p.y)} x2={px(p.x)} y2={py(fit(p.x))} class="rgl-resid" />
    ))}
    {raw.map((p) => (
      <circle cx={px(p.x)} cy={py(p.y)} r="4" class="rgl-dot" />
    ))}

    {/* Mean point, which the line always passes through */}
    <circle cx={px(mx)} cy={py(my)} r="5" class="rgl-meanpt" />
    {/* Up and to the left: the fitted line rises to the right, so labelling on
        that side puts the text directly on the line */}
    <text x={px(mx) - 12} y={py(my) - 16} class="rgl-meanlbl" font-size="9.5" text-anchor="end">(x̄, ȳ)</text>

    {/* Equation panel */}
    <text x={panelX} y={plotT + 10} class="rgl-eq" font-size="10.5" font-weight="bold">ŷ = b₀ + b₁x</text>
    <text x={panelX} y={plotT + 30} class="rgl-eqval" font-size="10">
      {`b₁ ≈ ${slope.toFixed(2)}`}
    </text>
    <text x={panelX} y={plotT + 44} class="rgl-note" font-size="9.5">slope</text>
    <text x={panelX} y={plotT + 62} class="rgl-eqval" font-size="10">
      {`b₀ ≈ ${intercept.toFixed(1)}`}
    </text>
    <text x={panelX} y={plotT + 76} class="rgl-note" font-size="9.5">intercept</text>

    <line x1={panelX} y1={plotT + 96} x2={panelX + 30} y2={plotT + 96} class="rgl-resid" />
    <text x={panelX} y={plotT + 112} class="rgl-note" font-size="9.5">residual</text>
    <text x={panelX} y={plotT + 128} class="rgl-note" font-size="9.5">y − ŷ</text>

    {/* Footer */}
    <text x={w / 2} y="242" class="rgl-foot" font-size="10.5" text-anchor="middle">
      The line minimizes the total of the squared vertical gaps
    </text>
    <text x={w / 2} y="258" class="rgl-sub" font-size="9.5" text-anchor="middle">
      It always passes through the point of averages, a handy check
    </text>
    <text x={w / 2} y="274" class="rgl-sub" font-size="9.5" text-anchor="middle">
      A fitted slope describes association, not necessarily cause
    </text>
  </svg>
</figure>

<style>
  .rgl { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .rgl svg { width:100%; max-width:100%; height:auto; }
  .rgl-axis { stroke:#888; stroke-width:1.4; }
  .rgl-line { stroke:#58a6ff; stroke-width:2.4; }
  .rgl-resid { stroke:#f0883e; stroke-width:1.6; stroke-dasharray:3,2; }
  .rgl-dot { fill:#7ee787; }
  .rgl-meanpt { fill:none; stroke:#d2a8ff; stroke-width:2; }
  .rgl-meanlbl { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .rgl-axlbl { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .rgl-eq { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .rgl-eqval { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .rgl-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .rgl-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .rgl-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .rgl-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .rgl-axis { stroke:#666; }
  :global([data-theme="light"]) .rgl-line, :global([data-theme="light"]) .rgl-eq { stroke:#0550ae; fill:#0550ae; }
  :global([data-theme="light"]) .rgl-resid { stroke:#b35900; }
  :global([data-theme="light"]) .rgl-dot { fill:#116329; }
  :global([data-theme="light"]) .rgl-meanpt, :global([data-theme="light"]) .rgl-meanlbl { stroke:#6639ba; fill:#6639ba; }
  :global([data-theme="light"]) .rgl-eqval { fill:#444; }
  :global([data-theme="light"]) .rgl-head { fill:#24292f; }
  :global([data-theme="light"]) .rgl-foot { fill:#b35900; }
</style>
