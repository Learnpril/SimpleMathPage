---
/**
 * IdealAbsorb — the difference between a subring and an ideal. Multiplying an
 * element of 3ℤ by any integer stays in 3ℤ, so 3ℤ absorbs multiplication and is
 * an ideal. Multiplying 1 ∈ ℤ by ½ ∈ ℚ leaves ℤ, so ℤ is a subring of ℚ but not
 * an ideal of it.
 */
const w = 540;
const h = 272;

// Left: 3ℤ inside ℤ, with 5 · 6 = 30
const k = 3;
const a = 6;
const mult = 5;
const product = a * mult;

const leftOuter = { x: 24, y: 64, w: 228, h: 148 };
const leftInner = { x: 48, y: 110, w: 180, h: 68 };
const rightOuter = { x: 300, y: 64, w: 216, h: 148 };
const rightInner = { x: 316, y: 110, w: 108, h: 68 };
const leftCx = leftOuter.x + leftOuter.w / 2;
const rightCx = rightOuter.x + rightOuter.w / 2;
---

<figure
  class="ida"
  role="img"
  aria-label={`Two panels contrasting an ideal with a subring. Multiplying ${a} in ${k}ℤ by ${mult} gives ${product}, which stays inside ${k}ℤ, so ${k}ℤ is an ideal of the integers. Multiplying 1 in ℤ by one half gives one half, which leaves ℤ, so ℤ is a subring of the rationals but not an ideal.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="ida-head" font-size="12.5" font-weight="bold">An ideal absorbs multiplication; a subring need not</text>

    {/* ---------- Left: an ideal ---------- */}
    <text x={leftCx} y="56" class="ida-outerlbl" font-size="11" text-anchor="middle" font-weight="bold">R = ℤ</text>
    <rect x={leftOuter.x} y={leftOuter.y} width={leftOuter.w} height={leftOuter.h} rx="10" class="ida-outer" />
    <text x={leftCx} y="102" class="ida-innerlbl ida-t-green" font-size="10.5" text-anchor="middle" font-weight="bold">
      {`I = ${k}ℤ`}
    </text>
    <rect x={leftInner.x} y={leftInner.y} width={leftInner.w} height={leftInner.h} rx="8" class="ida-inner ida-in-green" />

    <text x={leftCx} y="130" class="ida-op ida-t-green" font-size="9.5" text-anchor="middle">{`× ${mult}`}</text>
    <line x1="111" y1="144" x2="165" y2="144" class="ida-arrow ida-a-green" marker-end="url(#ida-head-g)" />
    <circle cx="96" cy="144" r="15" class="ida-dot ida-d-green" />
    <text x="96" y="148" class="ida-el" font-size="11" text-anchor="middle">{a}</text>
    <circle cx="180" cy="144" r="15" class="ida-dot ida-d-green" />
    <text x="180" y="148" class="ida-el" font-size="11" text-anchor="middle">{product}</text>

    <text x={leftCx} y="198" class="ida-cap ida-t-green" font-size="9" text-anchor="middle">
      {`${mult} · ${a} = ${product} stays in ${k}ℤ, so ${k}ℤ is an ideal`}
    </text>

    {/* ---------- Right: a subring that is not an ideal ---------- */}
    <text x={rightCx} y="56" class="ida-outerlbl" font-size="11" text-anchor="middle" font-weight="bold">R = ℚ</text>
    <rect x={rightOuter.x} y={rightOuter.y} width={rightOuter.w} height={rightOuter.h} rx="10" class="ida-outer" />
    <text x={rightInner.x + rightInner.w / 2} y="102" class="ida-innerlbl ida-t-orange" font-size="10.5" text-anchor="middle" font-weight="bold">ℤ</text>
    <rect x={rightInner.x} y={rightInner.y} width={rightInner.w} height={rightInner.h} rx="8" class="ida-inner ida-in-orange" />

    <text x="407" y="130" class="ida-op ida-t-orange" font-size="9.5" text-anchor="middle">× ½</text>
    <line x1="361" y1="144" x2="453" y2="144" class="ida-arrow ida-a-orange" marker-end="url(#ida-head-o)" />
    <circle cx="346" cy="144" r="15" class="ida-dot ida-d-orange" />
    <text x="346" y="148" class="ida-el" font-size="11" text-anchor="middle">1</text>
    <circle cx="472" cy="144" r="15" class="ida-esc" />
    <text x="472" y="148" class="ida-el ida-t-orange" font-size="11" text-anchor="middle">½</text>

    <text x={rightCx} y="198" class="ida-cap ida-t-orange" font-size="9" text-anchor="middle">
      ½ · 1 leaves ℤ, so ℤ is not an ideal of ℚ
    </text>

    <text x={w / 2} y="240" class="ida-foot" font-size="10.5" text-anchor="middle">
      An ideal must satisfy r · I ⊆ I for every r in the ring, not just for r in I
    </text>
    <text x={w / 2} y="258" class="ida-sub" font-size="9.5" text-anchor="middle">
      That absorption is exactly what makes the quotient ring R/I well-defined
    </text>

    <defs>
      <marker id="ida-head-g" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" class="ida-hf-green" />
      </marker>
      <marker id="ida-head-o" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" class="ida-hf-orange" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .ida { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ida svg { width:100%; max-width:100%; height:auto; }
  .ida-outer { fill:none; stroke:#8b949e; stroke-width:1.5; }
  .ida-inner { fill-opacity:0.12; stroke-width:1.8; }
  .ida-in-green { fill:#7ee787; stroke:#7ee787; }
  .ida-in-orange { fill:#f0883e; stroke:#f0883e; stroke-dasharray:6,4; }
  .ida-dot { stroke-width:1.7; fill-opacity:0.2; }
  .ida-d-green { fill:#7ee787; stroke:#7ee787; }
  .ida-d-orange { fill:#f0883e; stroke:#f0883e; }
  .ida-esc { fill:none; stroke:#ff7b72; stroke-width:2.4; }
  .ida-el { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .ida-outerlbl { fill:#c9d1d9; font-family:'Libre Baskerville',Georgia,serif; }
  .ida-innerlbl, .ida-op, .ida-cap { font-family:'Libre Baskerville',Georgia,serif; }
  .ida-t-green { fill:#7ee787; }
  .ida-t-orange { fill:#f0883e; }
  .ida-arrow { stroke-width:1.6; }
  .ida-a-green { stroke:#7ee787; }
  .ida-a-orange { stroke:#f0883e; stroke-dasharray:4,3; }
  .ida-hf-green { fill:#7ee787; }
  .ida-hf-orange { fill:#f0883e; }
  .ida-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .ida-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ida-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .ida-outer { stroke:#57606a; }
  :global([data-theme="light"]) .ida-in-green, :global([data-theme="light"]) .ida-d-green, :global([data-theme="light"]) .ida-t-green, :global([data-theme="light"]) .ida-a-green, :global([data-theme="light"]) .ida-hf-green { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .ida-in-orange, :global([data-theme="light"]) .ida-d-orange, :global([data-theme="light"]) .ida-t-orange, :global([data-theme="light"]) .ida-a-orange, :global([data-theme="light"]) .ida-hf-orange { fill:#b35900; stroke:#b35900; }
  :global([data-theme="light"]) .ida-esc { stroke:#a40e26; }
  :global([data-theme="light"]) .ida-el, :global([data-theme="light"]) .ida-outerlbl { fill:#24292f; }
  :global([data-theme="light"]) .ida-head { fill:#24292f; }
  :global([data-theme="light"]) .ida-foot { fill:#0550ae; }
  :global([data-theme="light"]) .ida-sub { fill:#57606a; }
</style>
