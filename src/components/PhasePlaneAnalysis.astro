---
/**
 * PhasePlaneAnalysis - Saddle point phase portrait for x' = x, y' = -y.
 * Eigenvalues: +1, -1 (saddle). Eigenvectors along axes.
 * Trajectories: hyperbolas xy = C. Shows approach along y-axis, escape along x-axis.
 * Legend below chart.
 */

const ox = 200, oy = 145, s = 50;
const toPx = (x: number) => ox + x * s;
const toPy = (y: number) => oy - y * s;
const X0 = 15, X1 = 385, Y0 = 10, Y1 = 270;

// Trajectories for saddle: x(t) = x0*e^t, y(t) = y0*e^{-t}, so xy = x0*y0 = C
// We parametrize by t and plot for various ICs
function saddleTraj(x0: number, y0: number, tmin: number, tmax: number, step = 0.03) {
  const pts: [number, number][] = [];
  for (let t = tmin; t <= tmax; t += step) {
    const x = x0 * Math.exp(t);
    const y = y0 * Math.exp(-t);
    const px = toPx(x), py = toPy(y);
    if (px >= X0 && px <= X1 && py >= Y0 && py <= Y1) pts.push([px, py]);
  }
  return pts;
}
const ptsStr = (pts: [number, number][]) => pts.map(p => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

// Trajectories in each quadrant
const trajs = [
  { x0: 0.3, y0: 2.5, tmin: -1.5, tmax: 2.2, color: "#58a6ff" },
  { x0: 0.5, y0: 1.5, tmin: -1.2, tmax: 2.0, color: "#58a6ff" },
  { x0: -0.3, y0: 2.5, tmin: -1.5, tmax: 2.2, color: "#7ee787" },
  { x0: -0.5, y0: 1.5, tmin: -1.2, tmax: 2.0, color: "#7ee787" },
  { x0: 0.3, y0: -2.5, tmin: -1.5, tmax: 2.2, color: "#d2a8ff" },
  { x0: 0.5, y0: -1.5, tmin: -1.2, tmax: 2.0, color: "#d2a8ff" },
  { x0: -0.3, y0: -2.5, tmin: -1.5, tmax: 2.2, color: "#f0883e" },
  { x0: -0.5, y0: -1.5, tmin: -1.2, tmax: 2.0, color: "#f0883e" },
].map(t => ({ pts: saddleTraj(t.x0, t.y0, t.tmin, t.tmax), color: t.color }));
---

<figure class="ppa" role="img" aria-label="Saddle point phase portrait showing trajectories approaching along the y-axis and diverging along the x-axis">
  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg" class="ppa-svg">
    {/* Grid */}
    <g class="ppa-grid">
      {[-3,-2,-1,0,1,2,3].map(x => toPx(x) >= X0 && toPx(x) <= X1 ? <line x1={toPx(x)} y1={Y0} x2={toPx(x)} y2={Y1} /> : null)}
      {[-2,-1,0,1,2].map(y => toPy(y) >= Y0 && toPy(y) <= Y1 ? <line x1={X0} y1={toPy(y)} x2={X1} y2={toPy(y)} /> : null)}
    </g>

    {/* Eigenvector directions (the axes themselves for this system) */}
    <line x1={X0} y1={toPy(0)} x2={X1} y2={toPy(0)} class="ppa-eigen stable" />
    <line x1={toPx(0)} y1={Y0} x2={toPx(0)} y2={Y1} class="ppa-eigen unstable" />

    {/* Trajectories */}
    {trajs.map(t => t.pts.length > 2 ? <polyline points={ptsStr(t.pts)} style={`stroke:${t.color}`} class="ppa-traj" fill="none" /> : null)}

    {/* Origin (saddle point) */}
    <circle cx={toPx(0)} cy={toPy(0)} r="5" class="ppa-saddle" />

    {/* Axis labels */}
    <text x={X1 + 4} y={toPy(0) - 8} class="ppa-lbl axis">x</text>
    <text x={toPx(0) + 8} y={Y0 + 6} class="ppa-lbl axis">y</text>

    {/* Manifold labels */}
    <text x={X1 - 6} y={toPy(0) + 44} class="ppa-lbl man-lbl" text-anchor="end">unstable manifold (λ = +1)</text>
    <text x={toPx(0) + 30} y={Y0 + 20} class="ppa-lbl man-lbl">stable manifold (λ = −1)</text>

    {/* Legend below */}
    <text x="50" y="290" class="ppa-lbl leg-title">Saddle Point: x' = x, y' = −y</text>
    <text x="50" y="306" class="ppa-lbl leg">Trajectories approach along y-axis, escape along x-axis</text>
  </svg>
</figure>

<style>
  .ppa { display: flex; justify-content: center; margin: 1.5rem 0; }
  .ppa-svg { width: 100%; max-width: 500px; height: auto; }
  .ppa-grid line { stroke: #262626; stroke-width: 0.5; }
  .ppa-eigen { stroke-width: 1.8; }
  .ppa-eigen.stable { stroke: #7ee787; stroke-dasharray: 6 4; opacity: 0.5; }
  .ppa-eigen.unstable { stroke: #f47067; stroke-dasharray: 6 4; opacity: 0.5; }
  .ppa-traj { stroke-width: 2; stroke-linecap: round; }
  .ppa-saddle { fill: none; stroke: #f47067; stroke-width: 2; }
  .ppa-lbl { font-family: "Libre Baskerville", Georgia, serif; fill: #aaa; }
  .axis { font-size: 14px; font-weight: bold; fill: #888; }
  .man-lbl { font-size: 9.5px; fill: #888; font-style: italic; }
  .leg-title { font-size: 11px; fill: #f0883e; font-style: italic; }
  .leg { font-size: 10px; fill: #888; }

  :root[data-theme="light"] .ppa-grid line { stroke: #e8e8e8; }
  :root[data-theme="light"] .ppa-eigen.stable { stroke: #1a7f2e; }
  :root[data-theme="light"] .ppa-eigen.unstable { stroke: #c4432b; }
  :root[data-theme="light"] .ppa-saddle { stroke: #c4432b; }
  :root[data-theme="light"] .ppa-lbl { fill: #555; }
  :root[data-theme="light"] .axis { fill: #666; }
  :root[data-theme="light"] .man-lbl { fill: #666; }
  :root[data-theme="light"] .leg-title { fill: #c05010; }
  :root[data-theme="light"] .leg { fill: #666; }
</style>
