---
/**
 * DomainRangeConcept — visual showing domain (inputs) → function → range (outputs).
 * Simple conceptual diagram, no math computation needed.
 */
---

<figure class="drc-diagram" role="img" aria-label="Domain is the set of inputs, range is the set of outputs">
  <figcaption class="drc-title">Domain → Function → Range</figcaption>
  <svg viewBox="0 0 440 180" width="440" height="180" xmlns="http://www.w3.org/2000/svg">

    <defs>
      <marker id="drc-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path class="drc-arrow-head" d="M0,1 L7,4 L0,7 Z" />
      </marker>
    </defs>

    {/* Domain oval */}
    <text class="drc-domain-title" x="80" y="16" font-size="13" text-anchor="middle" font-weight="bold">Domain</text>
    <text class="drc-domain-sub" x="80" y="30" font-size="10" text-anchor="middle">(inputs)</text>
    <ellipse class="drc-domain-oval" cx="80" cy="105" rx="65" ry="55" />
    <text class="drc-domain-item" x="80" y="85" font-size="14" text-anchor="middle">−2</text>
    <text class="drc-domain-item" x="80" y="108" font-size="14" text-anchor="middle">0</text>
    <text class="drc-domain-item" x="80" y="131" font-size="14" text-anchor="middle">3</text>

    {/* Arrow: domain → function */}
    <line class="drc-pipe" x1="150" y1="105" x2="185" y2="105" stroke-width="2" marker-end="url(#drc-arrow)" />

    {/* Function box */}
    <rect class="drc-box" x="190" y="70" width="80" height="70" rx="10" />
    <text class="drc-box-label" x="230" y="99" font-size="12" text-anchor="middle">f(x)</text>
    <text class="drc-box-rule" x="230" y="121" font-size="14" text-anchor="middle">x² + 1</text>

    {/* Arrow: function → range */}
    <line class="drc-pipe" x1="275" y1="105" x2="310" y2="105" stroke-width="2" marker-end="url(#drc-arrow)" />

    {/* Range oval */}
    <text class="drc-range-title" x="375" y="16" font-size="13" text-anchor="middle" font-weight="bold">Range</text>
    <text class="drc-range-sub" x="375" y="30" font-size="10" text-anchor="middle">(outputs)</text>
    <ellipse class="drc-range-oval" cx="375" cy="105" rx="55" ry="55" />
    <text class="drc-range-item" x="375" y="85" font-size="14" text-anchor="middle">5</text>
    <text class="drc-range-item" x="375" y="108" font-size="14" text-anchor="middle">1</text>
    <text class="drc-range-item" x="375" y="131" font-size="14" text-anchor="middle">10</text>

  </svg>
</figure>

<style>
  .drc-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .drc-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .drc-diagram svg { max-width: 100%; height: auto; }

  .drc-domain-oval { fill: none; stroke: #7ee787; stroke-width: 2; }
  .drc-domain-title { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }
  .drc-domain-sub { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; opacity: 0.7; }
  .drc-domain-item { fill: #ccc; font-family: 'Libre Baskerville', Georgia, serif; }

  .drc-pipe { stroke: #888; }
  .drc-arrow-head { fill: #888; }

  .drc-box { fill: none; stroke: #999; stroke-width: 2; }
  .drc-box-label { fill: #aaa; font-family: 'Libre Baskerville', Georgia, serif; }
  .drc-box-rule { fill: #ccc; font-family: 'Libre Baskerville', Georgia, serif; font-weight: bold; }

  .drc-range-oval { fill: none; stroke: #d2a8ff; stroke-width: 2; }
  .drc-range-title { fill: #d2a8ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .drc-range-sub { fill: #d2a8ff; font-family: 'Libre Baskerville', Georgia, serif; opacity: 0.7; }
  .drc-range-item { fill: #ccc; font-family: 'Libre Baskerville', Georgia, serif; }

  :global([data-theme="light"]) .drc-domain-oval { stroke: #1a7f37; }
  :global([data-theme="light"]) .drc-domain-title { fill: #1a7f37; }
  :global([data-theme="light"]) .drc-domain-sub { fill: #1a7f37; }
  :global([data-theme="light"]) .drc-domain-item { fill: #333; }
  :global([data-theme="light"]) .drc-pipe { stroke: #555; }
  :global([data-theme="light"]) .drc-arrow-head { fill: #555; }
  :global([data-theme="light"]) .drc-box { stroke: #444; }
  :global([data-theme="light"]) .drc-box-label { fill: #555; }
  :global([data-theme="light"]) .drc-box-rule { fill: #333; }
  :global([data-theme="light"]) .drc-range-oval { stroke: #8250df; }
  :global([data-theme="light"]) .drc-range-title { fill: #8250df; }
  :global([data-theme="light"]) .drc-range-sub { fill: #8250df; }
  :global([data-theme="light"]) .drc-range-item { fill: #333; }
</style>
