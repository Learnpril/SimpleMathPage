---
/**
 * SeparableEquationsDemo — Family of solution curves for dy/dx = xy.
 * Exact solutions: y = C e^{x²/2}. Shows multiple C values as a family.
 * Also shows the slope field to confirm curves follow it.
 */

const ox = 200, oy = 150, s = 60;
const toPx = (x: number) => ox + x * s;
const toPy = (y: number) => oy - y * s;
const X0 = 20, X1 = 380, Y0 = 10, Y1 = 290;

function curve(f: (x: number) => number, xmin: number, xmax: number, step = 0.03) {
  const pts: [number, number][] = [];
  for (let x = xmin; x <= xmax + 1e-9; x += step) {
    const px = toPx(x), py = toPy(f(x));
    if (px >= X0 && px <= X1 && py >= Y0 && py <= Y1) pts.push([px, py]);
    else if (pts.length > 0) break;
  }
  return pts;
}
const ptsStr = (pts: [number, number][]) => pts.map(p => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

// Family of curves y = C * e^{x²/2}
const cVals = [2, 1, 0.5, -0.5, -1, -2];
const colors = ["#58a6ff", "#7ee787", "#d2a8ff", "#d2a8ff", "#7ee787", "#58a6ff"];
const curves = cVals.map(c => curve(x => c * Math.exp(x * x / 2), -2.8, 2.8));

// Slope field for dy/dx = xy
const field: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let xi = -2.5; xi <= 2.501; xi += 0.5) {
  for (let yi = -2; yi <= 2.001; yi += 0.5) {
    const slope = xi * yi;
    const ang = Math.atan(slope);
    const L = 8;
    const px = toPx(xi), py = toPy(yi);
    if (px >= X0 + 5 && px <= X1 - 5 && py >= Y0 + 5 && py <= Y1 - 5) {
      field.push({
        x1: px - L * Math.cos(ang), y1: py + L * Math.sin(ang),
        x2: px + L * Math.cos(ang), y2: py - L * Math.sin(ang),
      });
    }
  }
}
---

<figure class="seqd" role="img" aria-label="Family of solution curves for dy/dx = xy showing exponential growth and decay">
  <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="seqd-svg">
    {/* Grid */}
    <g class="seqd-grid">
      {[-3,-2,-1,0,1,2,3].map(x => toPx(x) >= X0 && toPx(x) <= X1 ? <line x1={toPx(x)} y1={Y0} x2={toPx(x)} y2={Y1} /> : null)}
      {[-2,-1,0,1,2].map(y => toPy(y) >= Y0 && toPy(y) <= Y1 ? <line x1={X0} y1={toPy(y)} x2={X1} y2={toPy(y)} /> : null)}
    </g>

    {/* Axes */}
    <line x1={X0} y1={toPy(0)} x2={X1} y2={toPy(0)} class="seqd-axis" />
    <line x1={toPx(0)} y1={Y0} x2={toPx(0)} y2={Y1} class="seqd-axis" />
    <text x={X1 + 4} y={toPy(0) + 4} class="seqd-lbl axis">x</text>
    <text x={toPx(0) + 6} y={Y0 + 2} class="seqd-lbl axis">y</text>

    {/* Slope field */}
    {field.map(f => <line x1={f.x1} y1={f.y1} x2={f.x2} y2={f.y2} class="seqd-slope" />)}

    {/* Solution curves */}
    {curves.map((pts, i) => pts.length > 1 ? <polyline points={ptsStr(pts)} style={`stroke:${colors[i]}`} class="seqd-curve" fill="none" /> : null)}

    {/* Labels */}
    <text x={X0 + 6} y={Y0 + 30} class="seqd-lbl eq">dy/dx = xy</text>
    <text x={X1 - 6} y={Y1 - 22} class="seqd-lbl fam" text-anchor="end">y = Ce^(x²/2)</text>
  </svg>
</figure>

<style>
  .seqd { display: flex; justify-content: center; margin: 1.5rem 0; }
  .seqd-svg { width: 100%; max-width: 500px; height: auto; }
  .seqd-grid line { stroke: #262626; stroke-width: 0.5; }
  .seqd-axis { stroke: #555; stroke-width: 1.2; }
  .seqd-slope { stroke: #4a4a4a; stroke-width: 0.8; stroke-linecap: round; }
  .seqd-curve { stroke-width: 2.4; stroke-linecap: round; }
  .seqd-lbl { font-family: "Libre Baskerville", Georgia, serif; fill: #aaa; }
  .axis { font-size: 14px; font-weight: bold; fill: #888; }
  .eq { font-size: 14px; font-style: italic; fill: #f0883e; }
  .fam { font-size: 12px; fill: #888; font-style: italic; }

  :root[data-theme="light"] .seqd-grid line { stroke: #e8e8e8; }
  :root[data-theme="light"] .seqd-axis { stroke: #999; }
  :root[data-theme="light"] .seqd-slope { stroke: #ccc; }
  :root[data-theme="light"] .seqd-curve { opacity: 0.85; }
  :root[data-theme="light"] .seqd-lbl { fill: #555; }
  :root[data-theme="light"] .axis { fill: #666; }
  :root[data-theme="light"] .eq { fill: #c05010; }
  :root[data-theme="light"] .fam { fill: #666; }
</style>
