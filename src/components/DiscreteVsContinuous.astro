---
/**
 * DiscreteVsContinuous — two number lines side by side. The discrete one has
 * isolated dots with visible gaps; the continuous one is an unbroken bar.
 */
const w = 520;
const h = 190;
const x0 = 50;
const x1 = 470;
const yD = 60;
const yC = 150;
const ticks = 7; // 0 through 6
const step = (x1 - x0) / (ticks - 1);
---

<figure
  class="dvc"
  role="img"
  aria-label="Comparison of a discrete number line made of separated dots at the integers with a continuous number line drawn as an unbroken bar"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* ---- Discrete ---- */}
    <text x={x0} y="26" class="dvc-title dvc-t-green" font-size="14" font-weight="bold">Discrete</text>
    <text x={x0 + 82} y="26" class="dvc-note" font-size="11">countable, with gaps</text>
    <line x1={x0} y1={yD} x2={x1} y2={yD} class="dvc-axis" />
    {Array.from({ length: ticks }).map((_, i) => (
      <g>
        <circle cx={x0 + i * step} cy={yD} r="6" class="dvc-dot" />
        <text x={x0 + i * step} y={yD + 24} class="dvc-num" font-size="11" text-anchor="middle">{i}</text>
      </g>
    ))}
    {/* Gap callout between 3 and 4 */}
    <line x1={x0 + 3 * step + 8} y1={yD - 18} x2={x0 + 4 * step - 8} y2={yD - 18} class="dvc-gap" stroke-dasharray="3,2" />
    <text x={x0 + 3.5 * step} y={yD - 24} class="dvc-gap-label" font-size="10" text-anchor="middle">nothing here</text>

    {/* ---- Continuous ---- */}
    <text x={x0} y="116" class="dvc-title dvc-t-blue" font-size="14" font-weight="bold">Continuous</text>
    <text x={x0 + 104} y="116" class="dvc-note" font-size="11">no gaps anywhere</text>
    <rect x={x0} y={yC - 5} width={x1 - x0} height="10" rx="5" class="dvc-bar" />
    {Array.from({ length: ticks }).map((_, i) => (
      <text x={x0 + i * step} y={yC + 26} class="dvc-num" font-size="11" text-anchor="middle">{i}</text>
    ))}
    <text x={x0 + 3.5 * step} y={yC - 16} class="dvc-bar-label" font-size="10" text-anchor="middle">3.5, 3.14, 3.0001, ...</text>
  </svg>
</figure>

<style>
  .dvc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .dvc svg { max-width:100%; height:auto; }
  .dvc-axis { stroke:#555; stroke-width:1.5; }
  .dvc-dot { fill:#7ee787; }
  .dvc-bar { fill:#58a6ff; }
  .dvc-num { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .dvc-title { font-family:'Libre Baskerville',Georgia,serif; }
  .dvc-t-green { fill:#7ee787; }
  .dvc-t-blue { fill:#58a6ff; }
  .dvc-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .dvc-gap { stroke:#f0883e; stroke-width:1.5; }
  .dvc-gap-label { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .dvc-bar-label { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .dvc-axis { stroke:#ccc; }
  :global([data-theme="light"]) .dvc-dot { fill:#116329; }
  :global([data-theme="light"]) .dvc-bar { fill:#0550ae; }
  :global([data-theme="light"]) .dvc-t-green { fill:#116329; }
  :global([data-theme="light"]) .dvc-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .dvc-gap { stroke:#b35900; }
  :global([data-theme="light"]) .dvc-gap-label { fill:#b35900; }
  :global([data-theme="light"]) .dvc-bar-label { fill:#6639ba; }
</style>
