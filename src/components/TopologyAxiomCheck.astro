---
/**
 * TopologyAxiomCheck - candidate families of subsets of {a, b, c} tested against
 * the three topology axioms. The sets are stored as bitmasks and the axioms are
 * checked by brute force over all unions and intersections, so each verdict is
 * computed rather than stated.
 */
const w = 540;
const h = 306;

const names = ["a", "b", "c"];
const FULL = 0b111;

const label = (mask: number) => {
  if (mask === 0) return "∅";
  if (mask === FULL) return "X";
  const parts = names.filter((_, i) => mask & (1 << i));
  return `{${parts.join("")}}`;
};

/** Test the three axioms over every pair drawn from the family. */
function check(family: number[]) {
  const set = new Set(family);
  const hasEmptyAndAll = set.has(0) && set.has(FULL);
  let unionOk = true;
  let interOk = true;
  for (const p of family) {
    for (const q of family) {
      if (!set.has(p | q)) unionOk = false;
      if (!set.has(p & q)) interOk = false;
    }
  }
  return { hasEmptyAndAll, unionOk, interOk, pass: hasEmptyAndAll && unionOk && interOk };
}

const candidates = [
  { cx: 96, title: "trivial", family: [0, FULL] },
  { cx: 270, title: "a nested chain", family: [0, 0b001, 0b011, FULL] },
  { cx: 444, title: "two singletons", family: [0, 0b001, 0b010, FULL] },
].map((c) => ({ ...c, ...check(c.family) }));

/** Which axiom fails first, for the caption. */
const why = (c: (typeof candidates)[number]) => {
  if (c.pass) return "all three axioms hold";
  if (!c.hasEmptyAndAll) return "missing ∅ or X";
  if (!c.unionOk) return "a union is missing";
  return "an intersection is missing";
};

// For the failing case, find and name the offending union
function offendingUnion(family: number[]) {
  const set = new Set(family);
  for (const p of family) {
    for (const q of family) {
      if (!set.has(p | q)) return `${label(p)} ∪ ${label(q)} = ${label(p | q)}`;
    }
  }
  return null;
}
const bad = offendingUnion(candidates[2].family);
---

<figure
  class="tac"
  role="img"
  aria-label={`Three candidate families of subsets of a three-element set, tested against the topology axioms. The trivial family and the nested chain both pass. The family containing two singletons fails because ${bad} is not in it.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="tac-head" font-size="12.5" font-weight="bold">Three short rules decide what counts as a topology</text>
    <text x="16" y="38" class="tac-sub" font-size="10.5">Candidate families of subsets of X = {"{"}a, b, c{"}"}, checked by brute force</text>

    <line x1="183" y1="52" x2="183" y2="248" class="tac-divide" />
    <line x1="357" y1="52" x2="357" y2="248" class="tac-divide" />

    {candidates.map((c) => (
      <g>
        <text x={c.cx} y="64" class={`tac-title tac-${c.pass ? "ok" : "bad"}`} font-size="11" text-anchor="middle" font-weight="bold">{c.title}</text>

        {c.family.map((m, j) => (
          <text x={c.cx} y={90 + j * 18} class="tac-set" font-size="10" text-anchor="middle">{label(m)}</text>
        ))}

        <text x={c.cx} y="176" class={`tac-ax tac-${c.hasEmptyAndAll ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">
          {`∅ and X   ${c.hasEmptyAndAll ? "✓" : "✗"}`}
        </text>
        <text x={c.cx} y="194" class={`tac-ax tac-${c.unionOk ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">
          {`unions   ${c.unionOk ? "✓" : "✗"}`}
        </text>
        <text x={c.cx} y="212" class={`tac-ax tac-${c.interOk ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">
          {`intersections   ${c.interOk ? "✓" : "✗"}`}
        </text>

        <text x={c.cx} y="238" class={`tac-verdict tac-${c.pass ? "ok" : "bad"}`} font-size="10" text-anchor="middle" font-weight="bold">
          {c.pass ? "a topology" : "not a topology"}
        </text>
      </g>
    ))}

    <text x={w / 2} y="266" class="tac-foot" font-size="10.5" text-anchor="middle">
      {`The third family fails on ${bad}, which it does not contain`}
    </text>
    <text x={w / 2} y="286" class="tac-sub2" font-size="9.5" text-anchor="middle">
      Arbitrary unions must stay inside; only finite intersections are required
    </text>
    <text x={w / 2} y="302" class="tac-sub2" font-size="9.5" text-anchor="middle">
      Nothing here mentions distance, and nothing needs to
    </text>
  </svg>
</figure>

<style>
  .tac { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .tac svg { width:100%; max-width:100%; height:auto; }
  .tac-divide { stroke:#3a3a3a; stroke-width:1; }
  .tac-title, .tac-ax, .tac-verdict { font-family:'Libre Baskerville',Georgia,serif; }
  .tac-ok { fill:#7ee787; }
  .tac-bad { fill:#ff7b72; }
  .tac-set { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .tac-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .tac-sub, .tac-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .tac-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .tac-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .tac-ok { fill:#116329; }
  :global([data-theme="light"]) .tac-bad { fill:#a40e26; }
  :global([data-theme="light"]) .tac-head { fill:#24292f; }
  :global([data-theme="light"]) .tac-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.tac-set, .tac-sub, .tac-sub2) { fill:#57606a; }
</style>
