---
/**
 * LogExpDiagram - shows y = 2^x and y = log₂(x) as inverse functions,
 * reflected over y = x. Labels clear of curves.
 */
const pad = 55;
const w = 400; const h = 400;
const plotW = 290; const plotH = 290;
const lo = -4; const hi = 8;
const range = hi - lo;

function toX(v: number) { return pad + ((v - lo) / range) * plotW; }
function toY(v: number) { return pad + ((hi - v) / range) * plotH; }

const xAxisY = toY(0); const yAxisX = toX(0);

// y = 2^x
const expPts: string[] = [];
for (let x = -3.5; x <= 3.2; x += 0.06) {
  const y = Math.pow(2, x);
  if (y <= hi - 0.5) expPts.push(`${expPts.length === 0 ? 'M' : 'L'}${toX(x).toFixed(1)},${toY(y).toFixed(1)}`);
}

// y = log₂(x)
const logPts: string[] = [];
for (let x = 0.08; x <= 7.5; x += 0.06) {
  const y = Math.log2(x);
  if (y >= lo + 0.5) logPts.push(`${logPts.length === 0 ? 'M' : 'L'}${toX(x).toFixed(1)},${toY(y).toFixed(1)}`);
}

// y = x line
const yxD = `M${toX(lo).toFixed(1)},${toY(lo).toFixed(1)} L${toX(hi).toFixed(1)},${toY(hi).toFixed(1)}`;

const ticks = [-2, 2, 4, 6];
---

<figure class="led-diagram" role="img" aria-label="y = 2^x and y = log₂(x) as inverse functions reflected over y = x">
  <figcaption class="led-title">y = 2ˣ and y = log₂(x) are inverses - reflected over y = x</figcaption>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <rect class="led-bg" x="0" y="0" width={w} height={h} rx="8" />

    {/* Grid */}
    {ticks.map(t => (
      <line class="led-grid" x1={toX(t)} y1={pad} x2={toX(t)} y2={pad + plotH} />
    ))}
    {ticks.map(t => (
      <line class="led-grid" x1={pad} y1={toY(t)} x2={pad + plotW} y2={toY(t)} />
    ))}

    {/* Axes */}
    <line class="led-axis" x1={pad} y1={xAxisY} x2={pad + plotW + 5} y2={xAxisY} stroke-width="1.5" />
    <line class="led-axis" x1={yAxisX} y1={pad + plotH} x2={yAxisX} y2={pad - 5} stroke-width="1.5" />
    <text class="led-axlabel" x={pad + plotW + 10} y={xAxisY + 4} font-size="13">x</text>
    <text class="led-axlabel" x={yAxisX + 6} y={pad - 10} font-size="13">y</text>

    {/* Tick labels */}
    {ticks.map(t => (
      <text class="led-tick" x={toX(t)} y={xAxisY + 16} font-size="10" text-anchor="middle">{t}</text>
    ))}
    {ticks.map(t => (
      <text class="led-tick" x={yAxisX - 8} y={toY(t) + 4} font-size="10" text-anchor="end">{t}</text>
    ))}

    {/* y = x dashed */}
    <path class="led-yx" d={yxD} stroke-width="1.5" stroke-dasharray="6,4" fill="none" />
    <text class="led-yx-label" x={toX(6.5)} y={toY(7)} font-size="12">y = x</text>

    {/* y = 2^x */}
    <path class="led-exp" d={expPts.join(' ')} fill="none" stroke-width="2.5" />
    <text class="led-exp-label" x={toX(-2)} y={toY(0.8)} font-size="13" font-weight="bold">y = 2ˣ</text>

    {/* y = log₂(x) */}
    <path class="led-log" d={logPts.join(' ')} fill="none" stroke-width="2.5" />
    <text class="led-log-label" x={toX(5.5)} y={toY(1.8)} font-size="13" font-weight="bold">y = log₂(x)</text>

    {/* Key point (1, 0) on log curve */}
    <circle class="led-pt" cx={toX(1)} cy={toY(0)} r="4" />

  </svg>
</figure>

<style>
  .led-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .led-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .led-diagram svg { max-width: 100%; height: auto; }
  .led-bg { fill: var(--sl-color-bg, #121212); }
  .led-grid { stroke: #333; stroke-width: 0.5; }
  .led-axis { stroke: #888; }
  .led-axlabel { fill: #aaa; font-family: sans-serif; }
  .led-tick { fill: #aaa; font-family: sans-serif; }
  .led-yx { stroke: #666; }
  .led-yx-label { fill: #666; font-family: 'Libre Baskerville', Georgia, serif; font-style: italic; }
  .led-exp { stroke: #7ee787; }
  .led-exp-label { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }
  .led-log { stroke: #58a6ff; }
  .led-log-label { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .led-pt { fill: #f0c674; stroke: #fff; stroke-width: 1.5; }

  :global([data-theme="light"]) .led-bg { fill: #f8f9fa; }
  :global([data-theme="light"]) .led-grid { stroke: #ccc; }
  :global([data-theme="light"]) .led-axis { stroke: #222; }
  :global([data-theme="light"]) .led-axlabel { fill: #222; }
  :global([data-theme="light"]) .led-tick { fill: #333; }
  :global([data-theme="light"]) .led-yx { stroke: #999; }
  :global([data-theme="light"]) .led-yx-label { fill: #666; }
  :global([data-theme="light"]) .led-exp { stroke: #116329; }
  :global([data-theme="light"]) .led-exp-label { fill: #116329; }
  :global([data-theme="light"]) .led-log { stroke: #0550ae; }
  :global([data-theme="light"]) .led-log-label { fill: #0550ae; }
  :global([data-theme="light"]) .led-pt { fill: #b45309; stroke: #fff; }
</style>
