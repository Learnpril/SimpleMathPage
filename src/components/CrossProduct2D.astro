---
/**
 * CrossProduct2D - 2D projection (xy-plane) of vectors u=(1,2,3), v=(4,-1,2)
 * and their cross product u×v=(7,10,-9). Shows the parallelogram and angle.
 * Complements the 3D Three.js version above it.
 */
const w = 420;
const h = 340;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -2, xMax = 9, yMin = -3, yMax = 12;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// Vectors (using x,y components only for 2D view)
const u = [1, 2];
const v = [4, -1];
const cross = [7, 10]; // u×v projected (x,y)
const uPlusV = [u[0] + v[0], u[1] + v[1]]; // for parallelogram

// Grid ticks
const xTicks = [0, 2, 4, 6, 8];
const yTicks = [-2, 0, 2, 4, 6, 8, 10];
---

<figure class="cp2" role="img" aria-label="2D projection of vectors u, v, and their cross product showing the parallelogram and angle between them">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="cp2-arr-b" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0,0 8,3 0,6" class="cp2-arr-blue" />
      </marker>
      <marker id="cp2-arr-g" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0,0 8,3 0,6" class="cp2-arr-green" />
      </marker>
      <marker id="cp2-arr-o" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0,0 8,3 0,6" class="cp2-arr-orange" />
      </marker>
    </defs>

    {/* Grid */}
    {xTicks.map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="cp2-grid" stroke-width="0.5" />
    ))}
    {yTicks.map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="cp2-grid" stroke-width="0.5" />
    ))}

    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="cp2-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="cp2-axis" stroke-width="1.2" />

    {/* Parallelogram (shaded) */}
    <polygon
      points={`${sx(0)},${sy(0)} ${sx(u[0])},${sy(u[1])} ${sx(uPlusV[0])},${sy(uPlusV[1])} ${sx(v[0])},${sy(v[1])}`}
      class="cp2-para" />

    {/* Vector u (blue) */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(u[0])} y2={sy(u[1])}
          class="cp2-u" stroke-width="2.5" marker-end="url(#cp2-arr-b)" />

    {/* Vector v (green) */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(v[0])} y2={sy(v[1])}
          class="cp2-v" stroke-width="2.5" marker-end="url(#cp2-arr-g)" />

    {/* Cross product u×v (orange) */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(cross[0])} y2={sy(cross[1])}
          class="cp2-cross" stroke-width="2.5" marker-end="url(#cp2-arr-o)" />

    {/* Angle arc between u and v */}
    {(() => {
      const r = 25;
      const a1 = Math.atan2(u[1], u[0]);
      const a2 = Math.atan2(v[1], v[0]);
      const startX = sx(0) + r * Math.cos(-a1);
      const startY = sy(0) + r * Math.sin(-a1);
      const endX = sx(0) + r * Math.cos(-a2);
      const endY = sy(0) + r * Math.sin(-a2);
      return (
        <path d={`M ${startX} ${startY} A ${r} ${r} 0 0 1 ${endX} ${endY}`}
              fill="none" class="cp2-angle" stroke-width="1.5" />
      );
    })()}

    {/* Labels - positioned to avoid overlap */}
    <text class="cp2-label cp2-label-u" x={sx(u[0]) - 12} y={sy(u[1]) - 8} font-size="13">u</text>
    <text class="cp2-label cp2-label-v" x={sx(v[0]) + 6} y={sy(v[1]) + 16} font-size="13">v</text>
    <text class="cp2-label cp2-label-c" x={sx(cross[0]) + 6} y={sy(cross[1]) - 4} font-size="12">u×v</text>

    {/* Tick labels */}
    {xTicks.filter(v => v !== 0).map(v => (
      <text class="cp2-tick" x={sx(v)} y={sy(0) + 16} font-size="10" text-anchor="middle">{v}</text>
    ))}
    {yTicks.filter(v => v !== 0 && v % 2 === 0).map(v => (
      <text class="cp2-tick" x={sx(0) - 8} y={sy(v) + 4} font-size="10" text-anchor="end">{v}</text>
    ))}
    <text class="cp2-tick" x={sx(xMax) - 4} y={sy(0) + 16} font-size="10" text-anchor="end">x</text>
    <text class="cp2-tick" x={sx(0) + 8} y={sy(yMax) + 12} font-size="10" text-anchor="start">y</text>
  </svg>
  <div class="cp2-legend">
    <span class="cp2-leg-item"><span class="cp2-swatch cp2-sw-u"></span> u = (1, 2, 3)</span>
    <span class="cp2-leg-item"><span class="cp2-swatch cp2-sw-v"></span> v = (4, -1, 2)</span>
    <span class="cp2-leg-item"><span class="cp2-swatch cp2-sw-c"></span> u×v = (7, 10, -9)</span>
    <span class="cp2-leg-item"><span class="cp2-swatch cp2-sw-p"></span> parallelogram</span>
  </div>
</figure>

<style>
  .cp2 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cp2 svg { max-width:100%; height:auto; }
  .cp2-grid { stroke:#333; }
  .cp2-axis { stroke:#666; }
  .cp2-u { stroke:#58a6ff; }
  .cp2-v { stroke:#7ee787; }
  .cp2-cross { stroke:#f0883e; }
  .cp2-arr-blue { fill:#58a6ff; }
  .cp2-arr-green { fill:#7ee787; }
  .cp2-arr-orange { fill:#f0883e; }
  .cp2-para { fill:rgba(88,166,255,0.1); stroke:#58a6ff; stroke-width:0.5; stroke-dasharray:4,3; }
  .cp2-angle { stroke:#d2a8ff; }
  .cp2-label { font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .cp2-label-u { fill:#58a6ff; }
  .cp2-label-v { fill:#7ee787; }
  .cp2-label-c { fill:#f0883e; }
  .cp2-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .cp2-legend {
    display:flex; gap:0.8rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .cp2-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .cp2-swatch { display:inline-block; width:18px; height:4px; border-radius:2px; }
  .cp2-sw-u { background:#58a6ff; }
  .cp2-sw-v { background:#7ee787; }
  .cp2-sw-c { background:#f0883e; }
  .cp2-sw-p { background:rgba(88,166,255,0.25); border:1px dashed #58a6ff; height:10px; width:14px; }
  :global([data-theme="light"]) .cp2-grid { stroke:#ddd; }
  :global([data-theme="light"]) .cp2-axis { stroke:#999; }
  :global([data-theme="light"]) .cp2-u { stroke:#0550ae; }
  :global([data-theme="light"]) .cp2-v { stroke:#116329; }
  :global([data-theme="light"]) .cp2-cross { stroke:#b35900; }
  :global([data-theme="light"]) .cp2-arr-blue { fill:#0550ae; }
  :global([data-theme="light"]) .cp2-arr-green { fill:#116329; }
  :global([data-theme="light"]) .cp2-arr-orange { fill:#b35900; }
  :global([data-theme="light"]) .cp2-para { fill:rgba(5,80,174,0.08); stroke:#0550ae; }
  :global([data-theme="light"]) .cp2-angle { stroke:#6639ba; }
  :global([data-theme="light"]) .cp2-label-u { fill:#0550ae; }
  :global([data-theme="light"]) .cp2-label-v { fill:#116329; }
  :global([data-theme="light"]) .cp2-label-c { fill:#b35900; }
  :global([data-theme="light"]) .cp2-tick { fill:#666; }
  :global([data-theme="light"]) .cp2-sw-u { background:#0550ae; }
  :global([data-theme="light"]) .cp2-sw-v { background:#116329; }
  :global([data-theme="light"]) .cp2-sw-c { background:#b35900; }
  :global([data-theme="light"]) .cp2-sw-p { background:rgba(5,80,174,0.15); border-color:#0550ae; }
</style>
