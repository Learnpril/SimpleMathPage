---
/**
 * ErrorTypes — the 2x2 grid of decision versus reality, with Type I and
 * Type II errors on the diagonal and the boy-who-cried-wolf mnemonic.
 */
const cell = 132;
const cellH = 84;
const gx = 150;
const gy = 78;
const w = 520;
const h = gy + 2 * cellH + 92;

const cells = [
  { r: 0, c: 0, title: "Type I error", sub: "false positive", note: "rate = α", bad: true },
  { r: 0, c: 1, title: "Correct", sub: "true positive", note: "power = 1 − β", bad: false },
  { r: 1, c: 0, title: "Correct", sub: "true negative", note: "", bad: false },
  { r: 1, c: 1, title: "Type II error", sub: "false negative", note: "rate = β", bad: true },
];
---

<figure
  class="ert"
  role="img"
  aria-label="A two by two table of test decision against reality. Rejecting a true null is a Type I error with rate alpha, and failing to reject a false null is a Type II error with rate beta."
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="ert-head" font-size="12.5" font-weight="bold">Two ways a test can be wrong</text>

    {/* Column headers: reality */}
    <text x={gx + cell} y="44" class="ert-axis-title" font-size="10.5" text-anchor="middle">REALITY</text>
    <text x={gx + cell / 2} y="66" class="ert-colhdr" font-size="10" text-anchor="middle">H₀ is true</text>
    <text x={gx + cell + cell / 2} y="66" class="ert-colhdr" font-size="10" text-anchor="middle">H₀ is false</text>

    {/* Row headers: decision */}
    <text x="26" y={gy + cellH - 6} class="ert-axis-title" font-size="10.5">DECISION</text>
    <text x={gx - 12} y={gy + cellH / 2 - 2} class="ert-rowhdr" font-size="10" text-anchor="end">reject H₀</text>
    <text x={gx - 12} y={gy + cellH + cellH / 2 - 8} class="ert-rowhdr" font-size="10" text-anchor="end">fail to</text>
    <text x={gx - 12} y={gy + cellH + cellH / 2 + 8} class="ert-rowhdr" font-size="10" text-anchor="end">reject H₀</text>

    {/* Cells */}
    {cells.map((c) => {
      const x = gx + c.c * cell;
      const y = gy + c.r * cellH;
      return (
        <g>
          <rect x={x} y={y} width={cell} height={cellH} class={c.bad ? "ert-cell ert-cell-bad" : "ert-cell ert-cell-ok"} />
          <text x={x + cell / 2} y={y + 30} class={c.bad ? "ert-title ert-t-bad" : "ert-title ert-t-ok"} font-size="12" text-anchor="middle" font-weight="bold">{c.title}</text>
          <text x={x + cell / 2} y={y + 48} class="ert-sub" font-size="9.5" text-anchor="middle">{c.sub}</text>
          {c.note && <text x={x + cell / 2} y={y + 66} class={c.bad ? "ert-note ert-t-bad" : "ert-note ert-t-ok"} font-size="9.5" text-anchor="middle">{c.note}</text>}
        </g>
      );
    })}

    {/* Mnemonic */}
    <text x="16" y={gy + 2 * cellH + 30} class="ert-mnem-title" font-size="10.5" font-weight="bold">The boy who cried wolf</text>
    <text x="16" y={gy + 2 * cellH + 46} class="ert-mnem" font-size="9.5">
      Type I: he cried wolf when there was none — a false alarm.
    </text>
    <text x="16" y={gy + 2 * cellH + 60} class="ert-mnem" font-size="9.5">
      Type II: the villagers ignored a real wolf — a missed detection.
    </text>
    <text x="16" y={gy + 2 * cellH + 80} class="ert-foot" font-size="9.5">
      For a fixed sample size, lowering one error rate raises the other. Only more data reduces both.
    </text>
  </svg>
</figure>

<style>
  .ert { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ert svg { width:100%; max-width:100%; height:auto; }
  .ert-cell { stroke-width:1.6; }
  .ert-cell-bad { fill:#f0883e; fill-opacity:0.14; stroke:#f0883e; }
  .ert-cell-ok { fill:#7ee787; fill-opacity:0.10; stroke:#7ee787; }
  .ert-title { font-family:'Libre Baskerville',Georgia,serif; }
  .ert-t-bad { fill:#f0883e; }
  .ert-t-ok { fill:#7ee787; }
  .ert-sub { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .ert-note { font-family:'Libre Baskerville',Georgia,serif; }
  .ert-colhdr, .ert-rowhdr { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ert-axis-title { fill:#888; font-family:'Libre Baskerville',Georgia,serif; letter-spacing:0.08em; }
  .ert-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .ert-mnem-title { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ert-mnem { fill:#bbb; font-family:'Libre Baskerville',Georgia,serif; }
  .ert-foot { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .ert-cell-bad { fill:#b35900; fill-opacity:0.10; stroke:#b35900; }
  :global([data-theme="light"]) .ert-cell-ok { fill:#116329; fill-opacity:0.08; stroke:#116329; }
  :global([data-theme="light"]) .ert-t-bad { fill:#b35900; }
  :global([data-theme="light"]) .ert-t-ok { fill:#116329; }
  :global([data-theme="light"]) .ert-sub, :global([data-theme="light"]) .ert-mnem { fill:#444; }
  :global([data-theme="light"]) .ert-colhdr, :global([data-theme="light"]) .ert-rowhdr { fill:#0550ae; }
  :global([data-theme="light"]) .ert-head { fill:#24292f; }
  :global([data-theme="light"]) .ert-mnem-title { fill:#6639ba; }
</style>
