---
/**
 * VectorEx1Diagram - Example 1: vector v = <3, 4> on a 2D grid
 * showing the right triangle formed by components and the magnitude.
 */
---
<div class="diagram-container">
<svg viewBox="-25 -25 260 230" width="100%" style="max-width:380px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Vector v = (3,4) on a 2D grid with magnitude shown">

  <!-- Grid -->
  <g stroke="#333" stroke-width="0.5" opacity="0.25">
    <line x1="0" y1="0" x2="0" y2="200" /><line x1="50" y1="0" x2="50" y2="200" />
    <line x1="100" y1="0" x2="100" y2="200" /><line x1="150" y1="0" x2="150" y2="200" />
    <line x1="200" y1="0" x2="200" y2="200" />
    <line x1="0" y1="0" x2="200" y2="0" /><line x1="0" y1="50" x2="200" y2="50" />
    <line x1="0" y1="100" x2="200" y2="100" /><line x1="0" y1="150" x2="200" y2="150" />
    <line x1="0" y1="200" x2="200" y2="200" />
  </g>

  <!-- Axes -->
  <line x1="0" y1="200" x2="220" y2="200" stroke="#888" stroke-width="1.2" />
  <line x1="0" y1="200" x2="0" y2="-10" stroke="#888" stroke-width="1.2" />
  <text x="225" y="204" fill="#888" font-size="11" font-family="serif">x</text>
  <text x="-4" y="-14" fill="#888" font-size="11" font-family="serif" text-anchor="middle">y</text>

  <!-- Ticks -->
  <text x="50" y="214" fill="#666" font-size="9" text-anchor="middle">1</text>
  <text x="100" y="214" fill="#666" font-size="9" text-anchor="middle">2</text>
  <text x="150" y="214" fill="#666" font-size="9" text-anchor="middle">3</text>
  <text x="200" y="214" fill="#666" font-size="9" text-anchor="middle">4</text>
  <text x="-8" y="154" fill="#666" font-size="9" text-anchor="end">1</text>
  <text x="-8" y="104" fill="#666" font-size="9" text-anchor="end">2</text>
  <text x="-8" y="54" fill="#666" font-size="9" text-anchor="end">3</text>
  <text x="-8" y="4" fill="#666" font-size="9" text-anchor="end">4</text>

  <!-- Right triangle: horizontal then vertical (dashed) -->
  <line x1="0" y1="200" x2="150" y2="200" stroke="#f0883e" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.6" />
  <line x1="150" y1="200" x2="150" y2="0" stroke="#7ee787" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.6" />

  <!-- Right angle marker -->
  <polyline points="140,200 140,190 150,190" fill="none" stroke="#999" stroke-width="1" />

  <!-- Vector arrow: line shortened, explicit arrowhead -->
  <line x1="0" y1="200" x2="142.8" y2="9.6" stroke="#58a6ff" stroke-width="2.5" />
  <polygon points="150,0 146.8,12.6 138.8,6.6" class="v-ex1-blue-arrow" fill="#58a6ff" />

  <!-- Labels away from lines -->
  <text x="75" y="196" fill="#f0883e" font-size="11" text-anchor="middle" font-family="serif">3</text>
  <text x="162" y="105" fill="#7ee787" font-size="11" font-family="serif">4</text>
  <text x="30" y="85" fill="#58a6ff" font-size="12" font-weight="bold" font-family="serif">||v|| = 5</text>
  <text x="160" y="-5" fill="#58a6ff" font-size="11" font-family="serif">v = &#x27E8;3, 4&#x27E9;</text>

  <!-- Origin dot -->
  <circle cx="0" cy="200" r="3" fill="#58a6ff" />
</svg>
</div>

<style>
  .v-ex1-blue-arrow { fill: #58a6ff; }
  :global([data-theme="light"]) .v-ex1-blue-arrow { fill: #0550ae; }
  :global([data-theme="light"]) svg g[opacity="0.25"] line { stroke: #ccc; }
  :global([data-theme="light"]) svg line[stroke="#888"] { stroke: #bbb; }
  :global([data-theme="light"]) svg text[fill="#58a6ff"] { fill: #0550ae; }
  :global([data-theme="light"]) svg text[fill="#f0883e"] { fill: #c05010; }
  :global([data-theme="light"]) svg text[fill="#7ee787"] { fill: #1a7f2e; }
  :global([data-theme="light"]) svg text[fill="#666"] { fill: #999; }
  :global([data-theme="light"]) svg line[stroke="#58a6ff"] { stroke: #0550ae; }
  :global([data-theme="light"]) svg line[stroke="#f0883e"] { stroke: #c05010; }
  :global([data-theme="light"]) svg line[stroke="#7ee787"] { stroke: #1a7f2e; }
  :global([data-theme="light"]) svg polyline[stroke="#999"] { stroke: #aaa; }
  :global([data-theme="light"]) svg circle[fill="#58a6ff"] { fill: #0550ae; }
</style>
