---
/**
 * RationalBellGraph — plots h(x) = 5/(x²+1)
 * Bell-shaped curve, no VA, HA at y=0, max at (0,5)
 */
const w = 300;
const h = 240;
const pad = 35;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -5, xMax = 5, yMin = -1, yMax = 6;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const f = (x: number) => 5 / (x * x + 1);
const pts: string[] = [];
for (let x = xMin; x <= xMax; x += 0.08) {
  const y = f(x);
  pts.push(`${sx(x).toFixed(1)},${sy(y).toFixed(1)}`);
}
---

<figure class="rbg" role="img" aria-label="Graph of h(x) = 5/(x²+1), bell-shaped with max at (0,5) and HA at y=0">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {[-4,-2,0,2,4].map(v => (
      <g>
        {v >= xMin && v <= xMax && <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="rbg-grid" stroke-width="0.5" />}
      </g>
    ))}
    {[0,1,2,3,4,5].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="rbg-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="rbg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="rbg-axis" stroke-width="1.5" />
    {/* HA at y=0 is the x-axis itself */}
    <polyline points={pts.join(' ')} fill="none" class="rbg-curve" stroke-width="2.5" />
    <circle cx={sx(0)} cy={sy(5)} r="4" class="rbg-max" />
    <text class="rbg-lbl" x={sx(2.5)} y={sy(4.5)} font-size="11" font-weight="bold">h(x) = 5/(x²+1)</text>
    <text class="rbg-max-lbl" x={sx(0) + 8} y={sy(5) - 8} font-size="10">(0, 5)</text>
    <text class="rbg-ha-lbl" x={sx(xMax) - 40} y={sy(0.6)} font-size="10">HA: y = 0</text>
  </svg>
</figure>

<style>
  .rbg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .rbg svg { max-width:100%; height:auto; }
  .rbg-grid { stroke:#333; }
  .rbg-axis { stroke:#666; }
  .rbg-curve { stroke:#7ee787; }
  .rbg-max { fill:#f0883e; }
  .rbg-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .rbg-max-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .rbg-ha-lbl { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .rbg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .rbg-axis { stroke:#999; }
  :global([data-theme="light"]) .rbg-curve { stroke:#116329; }
  :global([data-theme="light"]) .rbg-max { fill:#b35900; }
  :global([data-theme="light"]) .rbg-lbl { fill:#116329; }
  :global([data-theme="light"]) .rbg-max-lbl { fill:#b35900; }
</style>
