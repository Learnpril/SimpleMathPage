---
/**
 * CountingTree — the multiplication principle as a branching tree.
 * 3 sizes then 2 syrups gives 3 x 2 = 6 leaves.
 */
const w = 520;
const h = 250;
const rootX = 40;
const rootY = 110;
const sizes = ["S", "M", "L"];
const syrups = ["vanilla", "caramel"];
const midX = 190;
const leafX = 350;
const sizeY = [40, 110, 180];
const leafGap = 30;
---

<figure
  class="cnt"
  role="img"
  aria-label="Tree diagram branching into 3 sizes, each splitting into 2 syrups, producing 6 total combinations"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="20" y="20" class="cnt-stage cnt-t-grey" font-size="11">start</text>
    <text x={midX} y="20" class="cnt-stage cnt-t-green" font-size="11" text-anchor="middle">3 sizes</text>
    <text x={leafX + 20} y="20" class="cnt-stage cnt-t-blue" font-size="11" text-anchor="middle">× 2 syrups</text>

    {/* Root */}
    <circle cx={rootX} cy={rootY} r="7" class="cnt-root" />

    {sizes.map((s, i) => {
      const y = sizeY[i];
      return (
        <g>
          {/* Root to size */}
          <line x1={rootX + 7} y1={rootY} x2={midX - 14} y2={y} class="cnt-edge-g" />
          <circle cx={midX} cy={y} r="13" class="cnt-node-g" />
          <text x={midX} y={y + 4} class="cnt-lbl" font-size="11" text-anchor="middle">{s}</text>

          {/* Size to each syrup */}
          {syrups.map((sy, j) => {
            const ly = y - leafGap / 2 + j * leafGap;
            return (
              <g>
                <line x1={midX + 13} y1={y} x2={leafX - 3} y2={ly} class="cnt-edge-b" />
                <circle cx={leafX} cy={ly} r="4.5" class="cnt-leaf" />
                <text x={leafX + 10} y={ly + 4} class="cnt-leaf-lbl" font-size="9.5">{`${s}, ${sy}`}</text>
              </g>
            );
          })}
        </g>
      );
    })}

    {/* Count bracket */}
    <text x={480} y={rootY - 6} class="cnt-total" font-size="14" font-weight="bold" text-anchor="middle">6</text>
    <text x={480} y={rootY + 10} class="cnt-total-lbl" font-size="9.5" text-anchor="middle">leaves</text>

    <text x={w / 2} y="228" class="cnt-foot" font-size="11" text-anchor="middle">
      Every size offers the same number of syrups, so the counts multiply: 3 × 2 = 6
    </text>
    <text x={w / 2} y="243" class="cnt-sub" font-size="10" text-anchor="middle">
      If one size had fewer syrups you would split into cases instead
    </text>
  </svg>
</figure>

<style>
  .cnt { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cnt svg { max-width:100%; height:auto; }
  .cnt-root { fill:#d2a8ff; }
  .cnt-node-g { fill:none; stroke:#7ee787; stroke-width:2; }
  .cnt-leaf { fill:#58a6ff; }
  .cnt-edge-g { stroke:#7ee787; stroke-width:1.4; }
  .cnt-edge-b { stroke:#58a6ff; stroke-width:1.2; }
  .cnt-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .cnt-leaf-lbl { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .cnt-stage { font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cnt-t-grey { fill:#888; }
  .cnt-t-green { fill:#7ee787; }
  .cnt-t-blue { fill:#58a6ff; }
  .cnt-total { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .cnt-total-lbl { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cnt-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cnt-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .cnt-root { fill:#6639ba; }
  :global([data-theme="light"]) .cnt-node-g { stroke:#116329; }
  :global([data-theme="light"]) .cnt-leaf { fill:#0550ae; }
  :global([data-theme="light"]) .cnt-edge-g { stroke:#116329; }
  :global([data-theme="light"]) .cnt-edge-b { stroke:#0550ae; }
  :global([data-theme="light"]) .cnt-lbl { fill:#116329; }
  :global([data-theme="light"]) .cnt-t-green { fill:#116329; }
  :global([data-theme="light"]) .cnt-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .cnt-total { fill:#b35900; }
  :global([data-theme="light"]) .cnt-foot { fill:#b35900; }
</style>
