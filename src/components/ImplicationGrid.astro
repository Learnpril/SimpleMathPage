---
/**
 * ImplicationGrid - the four cases of p implies q as a 2x2 grid, with the
 * single false case highlighted. Makes the "one broken promise" idea visual.
 */
const cell = 96;
const cols = 2;
const rows = 2;
const gx = 134; // grid left edge, leaves room for the p = T / p = F row labels
const gy = 76; // grid top edge, leaves room for the title and q headers
const gridBottom = gy + rows * cell;
const w = 470;
const h = gridBottom + 62; // room for two footer lines below the grid
const cases = [
  { r: 0, c: 0, val: "T", note: ["promise", "kept"], bad: false },
  { r: 0, c: 1, val: "F", note: ["promise", "BROKEN"], bad: true },
  { r: 1, c: 0, val: "T", note: ["nothing", "promised"], bad: false },
  { r: 1, c: 1, val: "T", note: ["nothing", "promised"], bad: false },
];
---

<figure
  class="ig"
  role="img"
  aria-label="Two by two grid of the four truth combinations for p implies q. Only the case where p is true and q is false gives a false implication."
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x={gx + (cols * cell) / 2} y="30" class="ig-title" font-size="15" font-weight="bold" text-anchor="middle">p → q</text>

    {/* Column headers (q) */}
    {Array.from({ length: cols }).map((_, c) => (
      <text x={gx + c * cell + cell / 2} y={gy - 14} class="ig-hdr" font-size="12" text-anchor="middle">
        {c === 0 ? "q = T" : "q = F"}
      </text>
    ))}

    {/* Row headers (p) */}
    {Array.from({ length: rows }).map((_, r) => (
      <text x={gx - 16} y={gy + r * cell + cell / 2 + 4} class="ig-hdr" font-size="12" text-anchor="end">
        {r === 0 ? "p = T" : "p = F"}
      </text>
    ))}

    {/* Cells */}
    {cases.map((c) => {
      const x = gx + c.c * cell;
      const y = gy + c.r * cell;
      return (
        <g>
          <rect x={x} y={y} width={cell} height={cell} class={c.bad ? "ig-cell ig-cell-bad" : "ig-cell"} />
          <text x={x + cell / 2} y={y + 40} class={c.bad ? "ig-val ig-val-bad" : "ig-val"} font-size="26" font-weight="bold" text-anchor="middle">{c.val}</text>
          <text x={x + cell / 2} y={y + 64} class={c.bad ? "ig-note ig-note-bad" : "ig-note"} font-size="9.5" text-anchor="middle">{c.note[0]}</text>
          <text x={x + cell / 2} y={y + 78} class={c.bad ? "ig-note ig-note-bad" : "ig-note"} font-size="9.5" text-anchor="middle">{c.note[1]}</text>
        </g>
      );
    })}

    {/* Footers, safely below the grid */}
    <text x={w / 2} y={gridBottom + 28} class="ig-foot" font-size="11.5" text-anchor="middle">
      An implication fails in exactly one of the four cases
    </text>
    <text x={w / 2} y={gridBottom + 46} class="ig-sub" font-size="10" text-anchor="middle">
      When p is false it makes no claim, so it cannot be violated
    </text>
  </svg>
</figure>

<style>
  .ig { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ig svg { max-width:100%; height:auto; }
  .ig-cell { fill:none; stroke:#555; stroke-width:1.5; }
  .ig-cell-bad { fill:#f0883e; fill-opacity:0.15; stroke:#f0883e; stroke-width:2.5; }
  .ig-val { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .ig-val-bad { fill:#f0883e; }
  .ig-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .ig-note-bad { fill:#f0883e; font-style:normal; font-weight:bold; }
  .ig-hdr { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ig-title { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ig-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .ig-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .ig-cell { stroke:#ccc; }
  :global([data-theme="light"]) .ig-cell-bad { fill:#b35900; fill-opacity:0.12; stroke:#b35900; }
  :global([data-theme="light"]) .ig-val { fill:#116329; }
  :global([data-theme="light"]) .ig-val-bad { fill:#b35900; }
  :global([data-theme="light"]) .ig-note-bad { fill:#b35900; }
  :global([data-theme="light"]) .ig-hdr { fill:#0550ae; }
  :global([data-theme="light"]) .ig-title { fill:#6639ba; }
  :global([data-theme="light"]) .ig-foot { fill:#b35900; }
</style>
