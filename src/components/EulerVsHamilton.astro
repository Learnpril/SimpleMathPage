---
/**
 * EulerVsHamilton — the two conditions are completely independent.
 * Left: two triangles sharing a vertex has an Euler circuit but no Hamilton circuit.
 * Right: K4 has a Hamilton circuit but no Euler circuit.
 */
const w = 540;
const h = 286;
const cy = 118;

// Bowtie: two triangles sharing the middle vertex
const bow = [
  { x: 40, y: cy - 42, l: "A" },
  { x: 40, y: cy + 42, l: "B" },
  { x: 130, y: cy, l: "C" },
  { x: 220, y: cy - 42, l: "D" },
  { x: 220, y: cy + 42, l: "E" },
];
const bowEdges: [number, number][] = [[0, 1], [0, 2], [1, 2], [2, 3], [2, 4], [3, 4]];

// K4: every pair joined
const k4 = [
  { x: 350, y: cy - 46, l: "P" },
  { x: 460, y: cy - 46, l: "Q" },
  { x: 350, y: cy + 46, l: "R" },
  { x: 460, y: cy + 46, l: "S" },
];
const k4Edges: [number, number][] = [[0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 3]];
---

<figure
  class="evh"
  role="img"
  aria-label="Two graphs compared. Two triangles sharing a vertex has an Euler circuit but no Hamilton circuit. The complete graph on four vertices has a Hamilton circuit but no Euler circuit."
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* ---------- Left: bowtie ---------- */}
    <text x="130" y="26" class="evh-title" font-size="12.5" font-weight="bold" text-anchor="middle">Two triangles, shared vertex</text>
    <text x="130" y="44" class="evh-degs" font-size="10" text-anchor="middle">degrees 2, 2, 4, 2, 2 — all even</text>

    {bowEdges.map(([a, b]) => (
      <line x1={bow[a].x} y1={bow[a].y} x2={bow[b].x} y2={bow[b].y} class="evh-edge" />
    ))}
    {bow.map((p, i) => (
      <g>
        <circle cx={p.x} cy={p.y} r="14" class={i === 2 ? "evh-node evh-cut" : "evh-node"} />
        <text x={p.x} y={p.y + 5} class="evh-vl" font-size="12" font-weight="bold" text-anchor="middle">{p.l}</text>
      </g>
    ))}
    <text x="130" y={cy + 80} class="evh-cut-note" font-size="9.5" text-anchor="middle">C is a cut vertex</text>

    <text x="130" y="226" class="evh-yes" font-size="11" text-anchor="middle">Euler circuit ✓</text>
    <text x="130" y="246" class="evh-no" font-size="11" text-anchor="middle">Hamilton circuit ✗</text>
    <text x="130" y="266" class="evh-why" font-size="9" text-anchor="middle">would have to pass through C twice</text>

    {/* Divider */}
    <line x1="278" y1="40" x2="278" y2="208" class="evh-divide" stroke-dasharray="4,4" />

    {/* ---------- Right: K4 ---------- */}
    <text x="405" y="26" class="evh-title" font-size="12.5" font-weight="bold" text-anchor="middle">Complete graph K₄</text>
    <text x="405" y="44" class="evh-degs" font-size="10" text-anchor="middle">degrees 3, 3, 3, 3 — all odd</text>

    {k4Edges.map(([a, b]) => (
      <line x1={k4[a].x} y1={k4[a].y} x2={k4[b].x} y2={k4[b].y} class="evh-edge" />
    ))}
    {k4.map((p) => (
      <g>
        <circle cx={p.x} cy={p.y} r="14" class="evh-node" />
        <text x={p.x} y={p.y + 5} class="evh-vl" font-size="12" font-weight="bold" text-anchor="middle">{p.l}</text>
      </g>
    ))}

    <text x="405" y="226" class="evh-no" font-size="11" text-anchor="middle">Euler circuit ✗</text>
    <text x="405" y="246" class="evh-yes" font-size="11" text-anchor="middle">Hamilton circuit ✓</text>
    <text x="405" y="266" class="evh-why" font-size="9" text-anchor="middle">P → Q → S → R → P visits each once</text>
  </svg>
</figure>

<style>
  .evh { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .evh svg { max-width:100%; height:auto; }
  .evh-edge { stroke:#888; stroke-width:1.8; }
  .evh-node { fill:#121212; stroke:#58a6ff; stroke-width:2.2; }
  .evh-cut { stroke:#f0883e; stroke-width:3; }
  .evh-vl { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .evh-title { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .evh-degs { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .evh-cut-note { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .evh-yes { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .evh-no { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .evh-why { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .evh-divide { stroke:#555; }
  :global([data-theme="light"]) .evh-edge { stroke:#666; }
  :global([data-theme="light"]) .evh-node { fill:#ffffff; stroke:#0550ae; }
  :global([data-theme="light"]) .evh-cut { stroke:#b35900; }
  :global([data-theme="light"]) .evh-vl { fill:#24292f; }
  :global([data-theme="light"]) .evh-title { fill:#24292f; }
  :global([data-theme="light"]) .evh-cut-note { fill:#b35900; }
  :global([data-theme="light"]) .evh-yes { fill:#116329; }
  :global([data-theme="light"]) .evh-no { fill:#b35900; }
  :global([data-theme="light"]) .evh-divide { stroke:#ccc; }
</style>
