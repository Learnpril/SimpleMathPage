---
/**
 * VectorScalarDiagram — shows scalar multiplication:
 * v, 2v, and -v all from the origin.
 */
const w = 300;
const h = 220;
const pad = 35;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -4, xMax = 5, yMin = -3, yMax = 5;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;
---

<figure class="vsd" role="img" aria-label="Scalar multiplication: v, 2v, and -v shown from the origin">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {[-4,-2,0,2,4].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="vsd-grid" stroke-width="0.5" />
    ))}
    {[-2,0,2,4].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="vsd-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="vsd-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="vsd-axis" stroke-width="1" />

    <defs>
      <marker id="vsd-ah-b" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" fill="#58a6ff" />
      </marker>
      <marker id="vsd-ah-g" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" fill="#7ee787" />
      </marker>
      <marker id="vsd-ah-r" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" fill="#f47067" />
      </marker>
    </defs>

    {/* v = <2, 1> */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(2)} y2={sy(1)} class="vsd-v" stroke-width="2.5" marker-end="url(#vsd-ah-b)" />
    {/* 2v = <4, 2> */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(4)} y2={sy(2)} class="vsd-2v" stroke-width="2" marker-end="url(#vsd-ah-g)" />
    {/* -v = <-2, -1> */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(-2)} y2={sy(-1)} class="vsd-neg" stroke-width="2" marker-end="url(#vsd-ah-r)" />

    {/* Labels */}
    <text class="vsd-v-lbl" x={sx(2.2)} y={sy(1.4)} font-size="11" font-weight="bold">v</text>
    <text class="vsd-2v-lbl" x={sx(4.2)} y={sy(2.4)} font-size="11" font-weight="bold">2v</text>
    <text class="vsd-neg-lbl" x={sx(-2.8)} y={sy(-1.4)} font-size="11" font-weight="bold">-v</text>
  </svg>
</figure>

<style>
  .vsd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .vsd svg { max-width:100%; height:auto; }
  .vsd-grid { stroke:#333; }
  .vsd-axis { stroke:#666; }
  .vsd-v { stroke:#58a6ff; }
  .vsd-2v { stroke:#7ee787; }
  .vsd-neg { stroke:#f47067; }
  .vsd-v-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .vsd-2v-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .vsd-neg-lbl { fill:#f47067; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .vsd-grid { stroke:#ddd; }
  :global([data-theme="light"]) .vsd-axis { stroke:#999; }
  :global([data-theme="light"]) .vsd-v { stroke:#0550ae; }
  :global([data-theme="light"]) .vsd-2v { stroke:#116329; }
  :global([data-theme="light"]) .vsd-neg { stroke:#cf222e; }
  :global([data-theme="light"]) .vsd-v-lbl { fill:#0550ae; }
  :global([data-theme="light"]) .vsd-2v-lbl { fill:#116329; }
  :global([data-theme="light"]) .vsd-neg-lbl { fill:#cf222e; }
</style>
