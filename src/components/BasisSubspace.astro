---
/**
 * BasisSubspace - left: a basis of intervals whose unions generate an open set,
 * with the covering intervals chosen by an actual greedy computation. Right: the
 * subspace topology, where intersecting an ambient open set with [0,1] produces a
 * set that is open in the subspace but not in ℝ.
 */
const w = 540;
const h = 300;

// ---------- left: covering (0.15, 0.85) ∪ (1.1, 1.9) by basis intervals ----------
const lo = -0.25;
const hi = 2.25;
const pxL = 32;
const pxR = 240;
const lx = (v: number) => pxL + ((v - lo) / (hi - lo)) * (pxR - pxL);

const target = [
  { a: 0.15, b: 0.85 },
  { a: 1.1, b: 1.9 },
];

/** Cover each target interval with overlapping basis intervals of fixed width. */
function cover(a: number, b: number, width: number) {
  const out: { a: number; b: number }[] = [];
  const step = width / 2;
  for (let c = a + step; c < b; c += step) {
    out.push({ a: Math.max(a, c - step), b: Math.min(b, c + step) });
  }
  return out;
}
const basisIvs = target.flatMap((t) => cover(t.a, t.b, 0.34));
const rowsNeeded = 3;
const laneY = (k: number) => 118 + k * 15;

// ---------- right: the subspace [0,1] inside ℝ ----------
const rLo = -0.6;
const rHi = 1.6;
const rpxL = 306;
const rpxR = 510;
const rx = (v: number) => rpxL + ((v - rLo) / (rHi - rLo)) * (rpxR - rpxL);

const ambient = { a: -0.4, b: 0.45 };
const subspace = { a: 0, b: 1 };
const meet = { a: Math.max(ambient.a, subspace.a), b: Math.min(ambient.b, subspace.b) };
// The intersection keeps the left endpoint of the subspace, so it is half-open in ℝ
const meetLeftClosed = ambient.a < subspace.a;
---

<figure
  class="bss"
  role="img"
  aria-label={`On the left, an open set built as a union of ${basisIvs.length} basis intervals, showing that a basis generates a topology by taking unions. On the right, the ambient open interval from ${ambient.a} to ${ambient.b} meets the subspace from 0 to 1 in the half-open set from 0 to ${meet.b}, which is open in the subspace but not in the real line.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="bss-head" font-size="12.5" font-weight="bold">Generating a topology, and inheriting one</text>
    <text x="16" y="38" class="bss-sub" font-size="10.5">A basis builds open sets by union; a subspace gets them by intersection</text>

    <line x1="272" y1="52" x2="272" y2="252" class="bss-divide" />

    {/* ---------- left panel ---------- */}
    <text x={(pxL + pxR) / 2} y="62" class="bss-panel" font-size="10" text-anchor="middle">basis of open intervals</text>
    <line x1={pxL - 6} y1="88" x2={pxR + 6} y2="88" class="bss-axis" />
    {target.map((t) => (
      <line x1={lx(t.a)} y1="88" x2={lx(t.b)} y2="88" class="bss-target" />
    ))}
    <text x={(pxL + pxR) / 2} y="104" class="bss-note" font-size="9" text-anchor="middle">the open set to be built</text>

    {basisIvs.map((b, k) => (
      <line x1={lx(b.a)} y1={laneY(k % rowsNeeded)} x2={lx(b.b)} y2={laneY(k % rowsNeeded)} class="bss-basis" />
    ))}

    <text x={(pxL + pxR) / 2} y="186" class="bss-val" font-size="9.5" text-anchor="middle">{`${basisIvs.length} basis intervals, unioned`}</text>
    <text x={(pxL + pxR) / 2} y="204" class="bss-note" font-size="9" text-anchor="middle">every open set of ℝ arises this way</text>

    {/* ---------- right panel ---------- */}
    <text x={(rpxL + rpxR) / 2} y="62" class="bss-panel" font-size="10" text-anchor="middle">the subspace [0, 1] ⊂ ℝ</text>

    <line x1={rpxL - 6} y1="94" x2={rpxR + 6} y2="94" class="bss-axis" />
    <line x1={rx(ambient.a)} y1="94" x2={rx(ambient.b)} y2="94" class="bss-ambient" />
    <circle cx={rx(ambient.a)} cy="94" r="3.2" class="bss-hollow" />
    <circle cx={rx(ambient.b)} cy="94" r="3.2" class="bss-hollow" />
    <text x={(rpxL + rpxR) / 2} y="112" class="bss-note" font-size="9" text-anchor="middle">{`open in ℝ: (${ambient.a}, ${ambient.b})`}</text>

    <line x1={rpxL - 6} y1="140" x2={rpxR + 6} y2="140" class="bss-axis" />
    <line x1={rx(subspace.a)} y1="140" x2={rx(subspace.b)} y2="140" class="bss-sub-line" />
    <circle cx={rx(subspace.a)} cy="140" r="3.2" class="bss-solid-sub" />
    <circle cx={rx(subspace.b)} cy="140" r="3.2" class="bss-solid-sub" />
    <text x={(rpxL + rpxR) / 2} y="158" class="bss-note" font-size="9" text-anchor="middle">the subspace [0, 1]</text>

    <line x1={rpxL - 6} y1="186" x2={rpxR + 6} y2="186" class="bss-axis" />
    <line x1={rx(meet.a)} y1="186" x2={rx(meet.b)} y2="186" class="bss-meet" />
    <circle cx={rx(meet.a)} cy="186" r="3.2" class={meetLeftClosed ? "bss-solid-meet" : "bss-hollow"} />
    <circle cx={rx(meet.b)} cy="186" r="3.2" class="bss-hollow" />
    <text x={(rpxL + rpxR) / 2} y="204" class="bss-val2" font-size="9.5" text-anchor="middle">{`their intersection: [${meet.a}, ${meet.b})`}</text>

    <text x={(rpxL + rpxR) / 2} y="226" class="bss-note" font-size="9" text-anchor="middle">open in [0, 1], not open in ℝ</text>

    <text x={w / 2} y="268" class="bss-foot" font-size="10.5" text-anchor="middle">
      A basis needs only that every open set is a union of basis elements
    </text>
    <text x={w / 2} y="288" class="bss-sub2" font-size="9.5" text-anchor="middle">
      And "open" always means open in a stated space, never open on its own
    </text>
  </svg>
</figure>

<style>
  .bss { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .bss svg { width:100%; max-width:100%; height:auto; }
  .bss-axis { stroke:#555; stroke-width:1; }
  .bss-divide { stroke:#3a3a3a; stroke-width:1; }
  .bss-target { stroke:#58a6ff; stroke-width:4; }
  .bss-basis { stroke:#7ee787; stroke-width:2.6; }
  .bss-ambient { stroke:#f0883e; stroke-width:3.4; }
  .bss-sub-line { stroke:#d2a8ff; stroke-width:3.4; }
  .bss-meet { stroke:#7ee787; stroke-width:3.4; }
  .bss-hollow { fill:#121212; stroke:#9198a1; stroke-width:1.6; }
  .bss-solid-sub { fill:#d2a8ff; stroke:none; }
  .bss-solid-meet { fill:#7ee787; stroke:none; }
  .bss-val { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .bss-val2 { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .bss-note { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .bss-panel, .bss-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .bss-sub, .bss-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .bss-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .bss-axis { stroke:#8c959f; }
  :global([data-theme="light"]) .bss-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .bss-target { stroke:#0550ae; }
  :global([data-theme="light"]) .bss-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.bss-basis, .bss-meet) { stroke:#116329; }
  :global([data-theme="light"]) :is(.bss-val, .bss-val2) { fill:#116329; }
  :global([data-theme="light"]) .bss-solid-meet { fill:#116329; }
  :global([data-theme="light"]) .bss-ambient { stroke:#b35900; }
  :global([data-theme="light"]) .bss-sub-line { stroke:#6639ba; }
  :global([data-theme="light"]) .bss-solid-sub { fill:#6639ba; }
  :global([data-theme="light"]) .bss-hollow { fill:#ffffff; stroke:#57606a; }
  :global([data-theme="light"]) .bss-panel, :global([data-theme="light"]) .bss-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.bss-note, .bss-sub, .bss-sub2) { fill:#57606a; }
</style>
