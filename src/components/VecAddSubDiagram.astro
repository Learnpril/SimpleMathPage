---
/**
 * VecAddSubDiagram - shows u + v using the triangle rule
 * u = <2,3>, v = <5,-1>, u+v = <7,2>
 * With proper polygon arrowheads and dual-theme colors.
 */
---
<div class="diagram-container">
<svg viewBox="-30 -30 340 230" width="100%" style="max-width:480px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Vector addition: u plus v equals u+v using the triangle rule">

  <!-- Grid -->
  <g stroke="#333" stroke-width="0.5" opacity="0.25">
    <line x1="0" y1="0" x2="280" y2="0" /><line x1="0" y1="40" x2="280" y2="40" />
    <line x1="0" y1="80" x2="280" y2="80" /><line x1="0" y1="120" x2="280" y2="120" />
    <line x1="0" y1="160" x2="280" y2="160" />
    <line x1="0" y1="0" x2="0" y2="160" /><line x1="40" y1="0" x2="40" y2="160" />
    <line x1="80" y1="0" x2="80" y2="160" /><line x1="120" y1="0" x2="120" y2="160" />
    <line x1="160" y1="0" x2="160" y2="160" /><line x1="200" y1="0" x2="200" y2="160" />
    <line x1="240" y1="0" x2="240" y2="160" /><line x1="280" y1="0" x2="280" y2="160" />
  </g>

  <!-- Axes -->
  <line x1="0" y1="160" x2="295" y2="160" stroke="#888" stroke-width="1.2" />
  <line x1="0" y1="160" x2="0" y2="-15" stroke="#888" stroke-width="1.2" />

  <!-- Origin = (0, 160), scale = 40px per unit, y flipped -->
  <!-- u = (2,3): endpoint (80, 40) -->
  <!-- v = (5,-1): from tip of u: (80,40) to (280, 80) -->
  <!-- u+v = (7,2): from origin to (280, 80) -->

  <!-- Vector u (blue): origin to (80, 40) -->
  <line x1="0" y1="160" x2="72" y2="48" stroke="#58a6ff" stroke-width="2.5" />
  <polygon points="80,40 76,52 68,46" class="vop-blue-arrow" fill="#58a6ff" />

  <!-- Vector v (green): from tip of u to (280, 80) -->
  <line x1="80" y1="40" x2="270" y2="77" stroke="#7ee787" stroke-width="2.5" />
  <polygon points="280,80 270,84 268,74" class="vop-green-arrow" fill="#7ee787" />

  <!-- Result u+v (orange): origin to (280, 80) -->
  <line x1="0" y1="160" x2="270" y2="84" stroke="#f0883e" stroke-width="2" stroke-dasharray="6 3" />
  <polygon points="280,80 270,88 266,78" class="vop-orange-arrow" fill="#f0883e" />

  <!-- Labels -->
  <text x="25" y="85" fill="#58a6ff" font-size="13" font-weight="bold" font-family="serif">u</text>
  <text x="175" y="48" fill="#7ee787" font-size="13" font-weight="bold" font-family="serif">v</text>
  <text x="150" y="140" fill="#f0883e" font-size="13" font-weight="bold" font-family="serif">u + v</text>

  <!-- Origin dot -->
  <circle cx="0" cy="160" r="3" fill="#58a6ff" />

  <!-- Legend -->
  <g transform="translate(0, 175)">
    <line x1="5" y1="0" x2="20" y2="0" stroke="#58a6ff" stroke-width="2.5" />
    <text x="25" y="4" fill="#58a6ff" font-size="9" font-family="serif">u = &#x27E8;2, 3&#x27E9;</text>
    <line x1="100" y1="0" x2="115" y2="0" stroke="#7ee787" stroke-width="2.5" />
    <text x="120" y="4" fill="#7ee787" font-size="9" font-family="serif">v = &#x27E8;5, -1&#x27E9;</text>
    <line x1="205" y1="0" x2="220" y2="0" stroke="#f0883e" stroke-width="2" stroke-dasharray="4 2" />
    <text x="225" y="4" fill="#f0883e" font-size="9" font-family="serif">u + v = &#x27E8;7, 2&#x27E9;</text>
  </g>
</svg>
</div>

<style>
  .vop-blue-arrow { fill: #58a6ff; }
  .vop-green-arrow { fill: #7ee787; }
  .vop-orange-arrow { fill: #f0883e; }
  :global([data-theme="light"]) .vop-blue-arrow { fill: #0550ae; }
  :global([data-theme="light"]) .vop-green-arrow { fill: #1a7f2e; }
  :global([data-theme="light"]) .vop-orange-arrow { fill: #c05010; }
  :global([data-theme="light"]) svg text[fill="#58a6ff"] { fill: #0550ae; }
  :global([data-theme="light"]) svg text[fill="#7ee787"] { fill: #1a7f2e; }
  :global([data-theme="light"]) svg text[fill="#f0883e"] { fill: #c05010; }
  :global([data-theme="light"]) svg line[stroke="#58a6ff"] { stroke: #0550ae; }
  :global([data-theme="light"]) svg line[stroke="#7ee787"] { stroke: #1a7f2e; }
  :global([data-theme="light"]) svg line[stroke="#f0883e"] { stroke: #c05010; }
  :global([data-theme="light"]) svg line[stroke="#888"] { stroke: #bbb; }
  :global([data-theme="light"]) svg g[opacity="0.25"] line { stroke: #ccc; }
  :global([data-theme="light"]) svg circle[fill="#58a6ff"] { fill: #0550ae; }
</style>
