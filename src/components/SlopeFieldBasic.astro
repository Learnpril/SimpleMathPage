---
/**
 * SlopeFieldBasic - slope field for dy/dx = 2x
 * with three solution curves y = x² + C for C = -2, 0, 2.
 * Shows small line segments at grid points indicating the slope.
 */
const w = 420;
const h = 340;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -3, xMax = 3, yMin = -4, yMax = 10;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// Slope field segments
const segLen = 10;
const segments: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let xi = -2.5; xi <= 2.5; xi += 0.5) {
  for (let yi = -3; yi <= 9; yi += 1) {
    const slope = 2 * xi;
    const angle = Math.atan(slope);
    const dx = segLen * Math.cos(angle);
    // Flip dy because SVG y is inverted
    const dy = -segLen * Math.sin(angle);
    const cx = sx(xi);
    const cy = sy(yi);
    segments.push({ x1: cx - dx / 2, y1: cy - dy / 2, x2: cx + dx / 2, y2: cy + dy / 2 });
  }
}

// Solution curves y = x² + C
const curves = [
  { c: -2, cls: "sf-c1" },
  { c: 0, cls: "sf-c2" },
  { c: 2, cls: "sf-c3" },
];
const curvePaths: { pts: string; cls: string }[] = [];
for (const { c, cls } of curves) {
  const pts: string[] = [];
  for (let i = 0; i <= 120; i++) {
    const x = xMin + (i / 120) * (xMax - xMin);
    const y = x * x + c;
    if (y >= yMin && y <= yMax) {
      pts.push(`${sx(x)},${sy(y)}`);
    }
  }
  if (pts.length > 1) curvePaths.push({ pts: pts.join(" "), cls });
}

// Axis ticks
const xTicks = [-2, -1, 0, 1, 2];
const yTicks = [-2, 0, 2, 4, 6, 8];
---

<figure class="sf" role="img" aria-label="Slope field for dy/dx = 2x with three solution curves y = x squared plus C">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid lines */}
    {xTicks.map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="sf-grid" stroke-width="0.5" />
    ))}
    {yTicks.map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="sf-grid" stroke-width="0.5" />
    ))}

    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="sf-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="sf-axis" stroke-width="1.2" />

    {/* Slope field segments */}
    {segments.map(s => (
      <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class="sf-seg" stroke-width="1" />
    ))}

    {/* Solution curves */}
    {curvePaths.map(c => (
      <polyline points={c.pts} fill="none" class={c.cls} stroke-width="2.5" />
    ))}

    {/* Tick labels */}
    {xTicks.filter(v => v !== 0).map(v => (
      <text class="sf-tick" x={sx(v)} y={sy(0) + 16} font-size="10" text-anchor="middle">{v}</text>
    ))}
    {yTicks.filter(v => v !== 0).map(v => (
      <text class="sf-tick" x={sx(0) - 8} y={sy(v) + 4} font-size="10" text-anchor="end">{v}</text>
    ))}
  </svg>
  <div class="sf-legend">
    <span class="sf-leg-item"><span class="sf-swatch sf-sw-seg"></span> slope field: dy/dx = 2x</span>
    <span class="sf-leg-item"><span class="sf-swatch sf-sw-c1"></span> y = x² − 2</span>
    <span class="sf-leg-item"><span class="sf-swatch sf-sw-c2"></span> y = x²</span>
    <span class="sf-leg-item"><span class="sf-swatch sf-sw-c3"></span> y = x² + 2</span>
  </div>
</figure>

<style>
  .sf { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .sf svg { max-width:100%; height:auto; }
  .sf-grid { stroke:#333; }
  .sf-axis { stroke:#666; }
  .sf-seg { stroke:#666; opacity:0.5; }
  .sf-c1 { stroke:#f47067; }
  .sf-c2 { stroke:#58a6ff; }
  .sf-c3 { stroke:#7ee787; }
  .sf-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .sf-legend {
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .sf-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .sf-swatch { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .sf-sw-seg { background:#666; opacity:0.5; height:3px; }
  .sf-sw-c1 { background:#f47067; height:4px; }
  .sf-sw-c2 { background:#58a6ff; height:4px; }
  .sf-sw-c3 { background:#7ee787; height:4px; }
  :global([data-theme="light"]) .sf-grid { stroke:#ddd; }
  :global([data-theme="light"]) .sf-axis { stroke:#999; }
  :global([data-theme="light"]) .sf-seg { stroke:#999; opacity:0.45; }
  :global([data-theme="light"]) .sf-c1 { stroke:#cf222e; }
  :global([data-theme="light"]) .sf-c2 { stroke:#0550ae; }
  :global([data-theme="light"]) .sf-c3 { stroke:#116329; }
  :global([data-theme="light"]) .sf-tick { fill:#666; }
  :global([data-theme="light"]) .sf-sw-seg { background:#999; }
  :global([data-theme="light"]) .sf-sw-c1 { background:#cf222e; }
  :global([data-theme="light"]) .sf-sw-c2 { background:#0550ae; }
  :global([data-theme="light"]) .sf-sw-c3 { background:#116329; }
</style>
