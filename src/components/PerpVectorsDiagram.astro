---
/**
 * PerpVectorsDiagram — shows two perpendicular vectors
 * u = <3, -2> and v = <4, 6> with a right-angle marker.
 */
const w = 260;
const h = 240;
const pad = 35;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -1, xMax = 5, yMin = -3, yMax = 7;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;
---

<figure class="pvd" role="img" aria-label="Perpendicular vectors: u and v with a right-angle marker">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {[0,1,2,3,4,5].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="pvd-grid" stroke-width="0.5" />
    ))}
    {[-2,0,2,4,6].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="pvd-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="pvd-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="pvd-axis" stroke-width="1" />

    <defs>
      <marker id="pvd-ah-b" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#58a6ff" />
      </marker>
      <marker id="pvd-ah-o" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#f0883e" />
      </marker>
    </defs>

    {/* u = <3, -2> */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(3)} y2={sy(-2)} class="pvd-u" stroke-width="2.5" marker-end="url(#pvd-ah-b)" />
    {/* v = <4, 6> */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(4)} y2={sy(6)} class="pvd-v" stroke-width="2.5" marker-end="url(#pvd-ah-o)" />

    {/* Right-angle marker near origin */}
    {/* Small square at the angle between the two vectors */}
    {/* Normalized directions: u_hat ~ (0.832, -0.555), v_hat ~ (0.555, 0.832) */}
    {/* Scale factor for the square side: 0.6 units */}
    <polyline
      points={`${sx(0.5)},${sy(-0.33)} ${sx(0.83)},${sy(0.17)} ${sx(0.33)},${sy(0.5)}`}
      fill="none" class="pvd-right" stroke-width="1.2"
    />

    {/* Labels — positioned away from vectors and axes */}
    <text class="pvd-u-lbl" x={sx(3.3)} y={sy(-2.5)} font-size="11" font-weight="bold">u = ⟨3, -2⟩</text>
    <text class="pvd-v-lbl" x={sx(2.2)} y={sy(6.5)} font-size="11" font-weight="bold">v = ⟨4, 6⟩</text>
    <text class="pvd-dot-lbl" x={sx(1.5)} y={sy(1.6)} font-size="9">u · v = 0</text>
    <text class="pvd-perp-lbl" x={sx(1.5)} y={sy(2.4)} font-size="9">⊥ perpendicular</text>
  </svg>
</figure>

<style>
  .pvd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .pvd svg { max-width:100%; height:auto; }
  .pvd-grid { stroke:#333; }
  .pvd-axis { stroke:#666; }
  .pvd-u { stroke:#58a6ff; }
  .pvd-v { stroke:#f0883e; }
  .pvd-right { stroke:#7ee787; }
  .pvd-u-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .pvd-v-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .pvd-dot-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .pvd-perp-lbl { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .pvd-grid { stroke:#ddd; }
  :global([data-theme="light"]) .pvd-axis { stroke:#999; }
  :global([data-theme="light"]) .pvd-u { stroke:#0550ae; }
  :global([data-theme="light"]) .pvd-v { stroke:#b35900; }
  :global([data-theme="light"]) .pvd-right { stroke:#116329; }
  :global([data-theme="light"]) .pvd-u-lbl { fill:#0550ae; }
  :global([data-theme="light"]) .pvd-v-lbl { fill:#b35900; }
  :global([data-theme="light"]) .pvd-dot-lbl { fill:#116329; }
  :global([data-theme="light"]) .pvd-perp-lbl { fill:#6639ba; }
</style>
