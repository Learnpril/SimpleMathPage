---
/**
 * HoleLimitGraph — graph of f(x) = (x^2 - 16)/(x - 4) = x + 4
 * with a hole at (4, 8). Dashed guides show x=4 and y=8.
 * Shows: limit = 8 even though f(4) is undefined.
 */
const w = 380;
const h = 280;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 8, yMin = 0, yMax = 12;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;
---

<figure class="hlg" role="img" aria-label="Graph of y = x + 4 with a hole at (4, 8), limit equals 8">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[1,2,3,4,5,6,7].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="hlg-grid" stroke-width="0.5" />
    ))}
    {[2,4,6,8,10].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="hlg-grid" stroke-width="0.5" />
    ))}
    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="hlg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="hlg-axis" stroke-width="1.2" />

    {/* Tick labels */}
    <text class="hlg-tick" x={sx(4)} y={sy(0) + 16} font-size="11" text-anchor="middle">4</text>
    <text class="hlg-tick" x={sx(0) - 8} y={sy(8) + 4} font-size="11" text-anchor="end">8</text>

    {/* Line y = x + 4, with gap at x = 4 */}
    <line x1={sx(0)} y1={sy(4)} x2={sx(3.88)} y2={sy(7.88)} class="hlg-curve" stroke-width="3" />
    <line x1={sx(4.12)} y1={sy(8.12)} x2={sx(8)} y2={sy(12)} class="hlg-curve" stroke-width="3" />

    {/* Hole at (4, 8) */}
    <circle cx={sx(4)} cy={sy(8)} r="6" fill="none" class="hlg-hole" stroke-width="2.5" />

    {/* Dashed guides to the hole */}
    <line x1={sx(4)} y1={sy(0)} x2={sx(4)} y2={sy(8)} class="hlg-guide" stroke-width="1.2" stroke-dasharray="5,4" />
    <line x1={sx(0)} y1={sy(8)} x2={sx(4)} y2={sy(8)} class="hlg-guide" stroke-width="1.2" stroke-dasharray="5,4" />

    {/* Labels in clear space */}
    <text class="hlg-lbl-green" x={sx(0.2)} y={sy(11)} font-size="12">limit = 8</text>
    <text class="hlg-lbl-orange" x={sx(4.8)} y={sy(6.8)} font-size="11">hole at x = 4</text>
    <text class="hlg-lbl-curve" x={sx(1)} y={sy(3)} font-size="11">y = x + 4</text>
  </svg>
</figure>

<style>
  .hlg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .hlg svg { max-width:100%; height:auto; }
  .hlg-grid { stroke:#333; }
  .hlg-axis { stroke:#666; }
  .hlg-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .hlg-curve { stroke:#58a6ff; }
  .hlg-hole { stroke:#f0883e; }
  .hlg-guide { stroke:#7ee787; }
  .hlg-lbl-green { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .hlg-lbl-orange { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .hlg-lbl-curve { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }

  :global([data-theme="light"]) .hlg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .hlg-axis { stroke:#999; }
  :global([data-theme="light"]) .hlg-tick { fill:#666; }
  :global([data-theme="light"]) .hlg-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .hlg-hole { stroke:#b35900; }
  :global([data-theme="light"]) .hlg-guide { stroke:#116329; }
  :global([data-theme="light"]) .hlg-lbl-green { fill:#116329; }
  :global([data-theme="light"]) .hlg-lbl-orange { fill:#b35900; }
  :global([data-theme="light"]) .hlg-lbl-curve { fill:#0550ae; }
</style>
