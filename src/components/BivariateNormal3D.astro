---
/**
 * BivariateNormal3D — the bell curve in two dimensions. Two correlated normal
 * variables produce a bell-shaped surface whose contour ellipses tilt with the
 * correlation. Slicing it in any direction gives a one-dimensional normal curve.
 */
---

<figure
  class="bvn"
  role="img"
  aria-label="Interactive 3D bell-shaped surface for two correlated normal variables, with contour ellipses tilted along the direction of correlation"
>
  <div class="bvn-canvas" data-bvn3d></div>
  <div class="bvn-hint">Drag to rotate · Scroll/Pinch to zoom</div>
  <figcaption class="bvn-cap">
    Two normal variables together form a bell <em>surface</em>. Slice it in any
    direction and the cross-section is a normal curve; the tilt of the contour
    ellipses is the correlation between the variables.
  </figcaption>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initScene(container: HTMLElement) {
    const width = Math.min(container.clientWidth, 480);
    const height = 360;
    const isDark = document.documentElement.dataset.theme !== "light";

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(isDark ? 0x121212 : 0xf8f9fa);

    const camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 200);
    camera.position.set(4.4, 3.4, 4.4);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Bivariate normal density with correlation rho
    const rho = 0.6;
    const sx = 1.0;
    const sy = 1.0;
    const amp = 2.2;
    function density(x: number, y: number) {
      const zx = x / sx;
      const zy = y / sy;
      const q = (zx * zx - 2 * rho * zx * zy + zy * zy) / (1 - rho * rho);
      return amp * Math.exp(-q / 2);
    }

    // Build the surface as a deformed plane
    const span = 6;
    const segs = 64;
    const geo = new THREE.PlaneGeometry(span, span, segs, segs);
    const pos = geo.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i);
      const y = pos.getY(i);
      pos.setZ(i, density(x, y));
    }
    geo.computeVertexNormals();

    const mat = new THREE.MeshPhongMaterial({
      color: isDark ? 0x58a6ff : 0x0550ae,
      transparent: true,
      opacity: 0.68,
      side: THREE.DoubleSide,
      shininess: 40,
    });
    const surface = new THREE.Mesh(geo, mat);
    surface.rotation.x = -Math.PI / 2; // lift z into the vertical axis
    scene.add(surface);

    // Wireframe over the surface for readability
    const wire = new THREE.Mesh(
      geo.clone(),
      new THREE.MeshBasicMaterial({
        color: isDark ? 0x7ee787 : 0x116329,
        wireframe: true,
        transparent: true,
        opacity: 0.16,
      }),
    );
    wire.rotation.x = -Math.PI / 2;
    scene.add(wire);

    // Contour ellipses on the base plane, showing the correlation tilt
    const contourMat = new THREE.LineBasicMaterial({
      color: isDark ? 0xd2a8ff : 0x6639ba,
      transparent: true,
      opacity: 0.85,
    });
    for (const level of [0.6, 1.2, 1.9]) {
      const pts: THREE.Vector3[] = [];
      for (let a = 0; a <= 96; a++) {
        const t = (a / 96) * Math.PI * 2;
        // Parameterize the ellipse q = level^2 for the given rho
        const u = Math.cos(t) * level;
        const v = Math.sin(t) * level;
        // Map correlated coordinates
        const x = u * Math.sqrt(1 + rho) + v * Math.sqrt(1 - rho);
        const y = u * Math.sqrt(1 + rho) - v * Math.sqrt(1 - rho);
        pts.push(new THREE.Vector3(x, 0.01, y));
      }
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), contourMat));
    }

    // Axes
    const axMat = new THREE.LineBasicMaterial({ color: isDark ? 0x666666 : 0xaaaaaa });
    const axes: [number, number, number][] = [
      [3.6, 0, 0],
      [0, 3.0, 0],
      [0, 0, 3.6],
    ];
    for (const dir of axes) {
      const pts = [new THREE.Vector3(0, 0, 0), new THREE.Vector3(...dir)];
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), axMat));
    }

    function makeLabel(text: string, p: [number, number, number], color: string, scale = 0.62) {
      const canvas = document.createElement("canvas");
      canvas.width = 256;
      canvas.height = 64;
      const ctx = canvas.getContext("2d")!;
      ctx.font = "bold 34px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(text, 128, 32);
      const sprite = new THREE.Sprite(
        new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(canvas), transparent: true }),
      );
      sprite.position.set(...p);
      sprite.scale.set(scale * 2.4, scale * 0.6, 1);
      scene.add(sprite);
    }
    const labelColor = isDark ? "#9198a1" : "#57606a";
    makeLabel("x", [3.9, 0, 0], labelColor);
    makeLabel("density", [0, 3.3, 0], labelColor, 0.72);
    makeLabel("y", [0, 0, 3.9], labelColor);

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const dl = new THREE.DirectionalLight(0xffffff, 0.65);
    dl.position.set(4, 6, 3);
    scene.add(dl);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.6;
    controls.minDistance = 4;
    controls.maxDistance = 16;
    controls.target.set(0, 0.6, 0);

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    return () => {
      cancelAnimationFrame(animId);
      renderer.dispose();
    };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-bvn3d]").forEach((el) => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            obs.disconnect();
            initScene(el);
          }
        },
        { threshold: 0.05 },
      );
      obs.observe(el);
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .bvn { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .bvn-canvas { width:100%; max-width:480px; min-height:360px; border-radius:8px; overflow:hidden; }
  .bvn-canvas canvas { border-radius:8px; }
  .bvn-hint { font-family:'Libre Baskerville',Georgia,serif; font-size:0.8rem; color:#888; margin-top:0.4rem; }
  .bvn-cap {
    font-family:'Libre Baskerville',Georgia,serif; font-size:0.85rem; color:#888;
    font-style:italic; text-align:center; max-width:460px; margin-top:0.5rem;
  }
</style>
