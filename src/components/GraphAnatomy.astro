---
/**
 * GraphAnatomy — the 5-vertex worked example graph with degrees labelled,
 * demonstrating the handshake theorem: degrees sum to twice the edge count.
 *
 * Each degree label is placed in the empty wedge around its vertex, found by
 * summing the unit vectors toward that vertex's neighbours and going the
 * opposite way. That keeps labels off the edges no matter how the graph is laid
 * out. Labels also carry a background halo so nothing can visually cut a glyph.
 */
const w = 500;
const h = 286;
const R = 17; // vertex radius
const LABEL_GAP = 22; // clearance from the circle edge to the degree label

const V: Record<string, { x: number; y: number }> = {
  A: { x: 62, y: 76 },
  B: { x: 196, y: 44 },
  C: { x: 140, y: 168 },
  D: { x: 300, y: 132 },
  E: { x: 408, y: 72 },
};
const edges: [string, string][] = [
  ["A", "B"],
  ["A", "C"],
  ["B", "C"],
  ["C", "D"],
  ["D", "E"],
];

// Adjacency, so degree and label placement both come from one source of truth
const nbrs: Record<string, string[]> = {};
for (const k of Object.keys(V)) nbrs[k] = [];
for (const [a, b] of edges) {
  nbrs[a].push(b);
  nbrs[b].push(a);
}

/** Direction with the most free space around a vertex: opposite its neighbours. */
function labelPos(k: string) {
  const v = V[k];
  let sx = 0;
  let sy = 0;
  for (const n of nbrs[k]) {
    const dx = V[n].x - v.x;
    const dy = V[n].y - v.y;
    const len = Math.hypot(dx, dy) || 1;
    sx += dx / len;
    sy += dy / len;
  }
  const mag = Math.hypot(sx, sy);
  // Point away from the neighbours; fall back to straight down for an isolated vertex
  const ux = mag < 0.001 ? 0 : -sx / mag;
  const uy = mag < 0.001 ? 1 : -sy / mag;
  const d = R + LABEL_GAP;
  return { x: v.x + ux * d, y: v.y + uy * d + 3 };
}

const vertices = Object.keys(V).map((k) => ({
  key: k,
  ...V[k],
  deg: nbrs[k].length,
  label: labelPos(k),
}));
const degreeSum = vertices.reduce((s, v) => s + v.deg, 0);
---

<figure
  class="gra"
  role="img"
  aria-label={`A graph with five vertices A through E and ${edges.length} edges. The degrees are ${vertices.map((v) => v.deg).join(", ")}, summing to ${degreeSum}, which is twice the edge count.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="14" y="24" class="gra-head" font-size="12.5" font-weight="bold">
      {`${vertices.length} vertices, ${edges.length} edges`}
    </text>

    {/* Edges first so the vertices sit on top of them */}
    {edges.map(([a, b]) => (
      <line x1={V[a].x} y1={V[a].y} x2={V[b].x} y2={V[b].y} class="gra-edge" />
    ))}

    {/* Vertices */}
    {vertices.map((v) => (
      <g>
        <circle cx={v.x} cy={v.y} r={R} class={v.deg % 2 === 1 ? "gra-node gra-odd" : "gra-node gra-even"} />
        <text x={v.x} y={v.y + 5} class="gra-vlabel" font-size="14" font-weight="bold" text-anchor="middle">{v.key}</text>
      </g>
    ))}

    {/* Degree labels, placed in the free wedge beside each vertex */}
    {vertices.map((v) => (
      <text x={v.label.x} y={v.label.y} class="gra-deg" font-size="10.5" text-anchor="middle">{`deg ${v.deg}`}</text>
    ))}

    {/* Legend */}
    <circle cx="26" cy="232" r="6" class="gra-node gra-even" />
    <text x="38" y="236" class="gra-legend" font-size="10">even degree</text>
    <circle cx="150" cy="232" r="6" class="gra-node gra-odd" />
    <text x="162" y="236" class="gra-legend" font-size="10">odd degree</text>

    {/* Handshake theorem */}
    <text x={w / 2} y="258" class="gra-foot" font-size="11.5" text-anchor="middle">
      {`${vertices.map((v) => v.deg).join(" + ")} = ${degreeSum} = 2 × ${edges.length} edges`}
    </text>
    <text x={w / 2} y="276" class="gra-sub" font-size="10" text-anchor="middle">
      Exactly two vertices have odd degree, and that count is always even
    </text>
  </svg>
</figure>

<style>
  .gra { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .gra svg { max-width:100%; height:auto; }
  .gra-edge { stroke:#888; stroke-width:2; }
  .gra-node { fill:#121212; stroke-width:2.5; }
  .gra-even { stroke:#58a6ff; }
  .gra-odd { stroke:#f0883e; }
  .gra-vlabel { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  /* Halo keeps the label readable even if an edge passes close by */
  .gra-deg {
    fill:#c9d1d9; font-family:'Libre Baskerville',Georgia,serif; font-style:italic;
    paint-order:stroke; stroke:#121212; stroke-width:4px; stroke-linejoin:round;
  }
  .gra-legend { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .gra-head { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .gra-foot { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .gra-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .gra-edge { stroke:#666; }
  :global([data-theme="light"]) .gra-node { fill:#ffffff; }
  :global([data-theme="light"]) .gra-even { stroke:#0550ae; }
  :global([data-theme="light"]) .gra-odd { stroke:#b35900; }
  :global([data-theme="light"]) .gra-vlabel { fill:#24292f; }
  :global([data-theme="light"]) .gra-deg { fill:#3d4450; stroke:#ffffff; }
  :global([data-theme="light"]) .gra-head { fill:#0550ae; }
  :global([data-theme="light"]) .gra-foot { fill:#116329; }
</style>
