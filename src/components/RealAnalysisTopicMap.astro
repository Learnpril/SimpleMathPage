---
/**
 * RealAnalysisTopicMap — the five areas of the section and the order they
 * depend on each other. Everything rests on completeness of the reals.
 */
const bw = 152;
const bh = 54;
const gap = 22;
const margin = 14;
const w = margin * 2 + 3 * bw + 2 * gap;
const h = 254;
const row1Y = 34;
const row2Y = 148;
const colX = (i: number) => margin + i * (bw + gap);

const areas = [
  { x: colX(0), y: row1Y, label: "The reals", sub: "no gaps", cls: "green" },
  { x: colX(1), y: row1Y, label: "Sequences", sub: "ε and N", cls: "blue" },
  { x: colX(2), y: row1Y, label: "Topology", sub: "open, closed, compact", cls: "purple" },
  { x: colX(1), y: row2Y, label: "Continuity", sub: "ε and δ", cls: "orange" },
  { x: colX(2), y: row2Y, label: "Calculus, proved", sub: "MVT and integrals", cls: "pink" },
];
---

<figure
  class="ratm"
  role="img"
  aria-label="Topic map of Real Analysis: completeness of the real numbers underpins sequences, which lead to the topology of the line, and both support continuity, which in turn makes the theorems of calculus provable"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Top row, left to right */}
    <line x1={colX(0) + bw} y1={row1Y + bh / 2} x2={colX(1) - 3} y2={row1Y + bh / 2} class="ratm-link" marker-end="url(#ratm-head)" />
    <line x1={colX(1) + bw} y1={row1Y + bh / 2} x2={colX(2) - 3} y2={row1Y + bh / 2} class="ratm-link" marker-end="url(#ratm-head)" />

    {/* Down into continuity, and across into the calculus theorems */}
    <line x1={colX(1) + bw / 2} y1={row1Y + bh} x2={colX(1) + bw / 2} y2={row2Y - 3} class="ratm-link" marker-end="url(#ratm-head)" />
    <line x1={colX(2) + bw / 2} y1={row1Y + bh} x2={colX(2) + bw / 2} y2={row2Y - 3} class="ratm-link" marker-end="url(#ratm-head)" />
    <line x1={colX(1) + bw} y1={row2Y + bh / 2} x2={colX(2) - 3} y2={row2Y + bh / 2} class="ratm-link" marker-end="url(#ratm-head)" />

    {areas.map((a) => (
      <g>
        <rect x={a.x} y={a.y} width={bw} height={bh} rx="8" class={`ratm-box ratm-${a.cls}`} />
        <text x={a.x + bw / 2} y={a.y + 23} class={`ratm-label ratm-t-${a.cls}`} font-size="13.5" text-anchor="middle" font-weight="bold">{a.label}</text>
        <text x={a.x + bw / 2} y={a.y + 41} class="ratm-sub" font-size="10" text-anchor="middle">{a.sub}</text>
      </g>
    ))}

    <text x={w / 2} y="228" class="ratm-foot" font-size="10.5" text-anchor="middle">
      Every theorem in the section traces back to one axiom: the reals have no gaps
    </text>
    <text x={w / 2} y="245" class="ratm-sub" font-size="9.5" text-anchor="middle">
      This is the course where the calculus you used gets proved rather than asserted
    </text>

    <defs>
      <marker id="ratm-head" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="ratm-head-fill" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .ratm { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ratm svg { width:100%; max-width:100%; height:auto; }
  .ratm-box { fill:none; stroke-width:2; }
  .ratm-green { stroke:#7ee787; }
  .ratm-blue { stroke:#58a6ff; }
  .ratm-purple { stroke:#d2a8ff; }
  .ratm-orange { stroke:#f0883e; }
  .ratm-pink { stroke:#ff7b72; }
  .ratm-label { font-family:'Libre Baskerville',Georgia,serif; }
  .ratm-t-green { fill:#7ee787; }
  .ratm-t-blue { fill:#58a6ff; }
  .ratm-t-purple { fill:#d2a8ff; }
  .ratm-t-orange { fill:#f0883e; }
  .ratm-t-pink { fill:#ff7b72; }
  .ratm-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .ratm-link { stroke:#888; stroke-width:1.5; }
  .ratm-head-fill { fill:#888; }
  .ratm-foot { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .ratm-green { stroke:#116329; }
  :global([data-theme="light"]) .ratm-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .ratm-purple { stroke:#6639ba; }
  :global([data-theme="light"]) .ratm-orange { stroke:#b35900; }
  :global([data-theme="light"]) .ratm-pink { stroke:#a40e26; }
  :global([data-theme="light"]) .ratm-t-green { fill:#116329; }
  :global([data-theme="light"]) .ratm-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .ratm-t-purple { fill:#6639ba; }
  :global([data-theme="light"]) .ratm-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .ratm-t-pink { fill:#a40e26; }
  :global([data-theme="light"]) :is(.ratm-sub, .ratm-foot) { fill:#57606a; }
  :global([data-theme="light"]) .ratm-link { stroke:#555; }
  :global([data-theme="light"]) .ratm-head-fill { fill:#555; }
</style>
