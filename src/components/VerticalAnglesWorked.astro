---
// VerticalAnglesWorked.astro - Two intersecting lines with 40°/140° vertical angle pairs
// Center (190,130). Line1: horizontal. Line2: 40° above horizontal.
// Circle radius 35. Four arc segments form a complete circle.
// cos(40°)≈0.766, sin(40°)≈0.643
// 0° = (225,130), 40° = (217,107), 180° = (155,130), 220° = (163,153)
---

<div class="diagram-container" style="text-align:center; margin: 1.5rem 0;">
  <svg viewBox="0 0 380 290" width="380" height="290" role="img" aria-label="Two intersecting lines forming 40° and 140° angle pairs" style="max-width:100%; height:auto;">

    <!-- Line 1: horizontal -->
    <line x1="30" y1="130" x2="350" y2="130" stroke="var(--line-color, #888)" stroke-width="2" />
    <!-- Line 2: at 40° above horizontal through center -->
    <line x1="68" y1="232" x2="312" y2="28" stroke="var(--line-color, #888)" stroke-width="2" />

    <!-- Center point -->
    <circle cx="190" cy="130" r="4" fill="var(--point-color, #e5c07b)" />

    <!-- Four arcs forming a complete circle -->
    <!-- Arc 1: 0° to 40° = 40° ACUTE (blue) - top-right -->
    <path d="M 225,130 A 35,35 0 0,0 217,107" fill="none" stroke="var(--angle-a-color, #61afef)" stroke-width="2.5" />
    <!-- Arc 2: 40° to 180° = 140° OBTUSE (red) - top-left -->
    <path d="M 217,107 A 35,35 0 0,0 155,130" fill="none" stroke="var(--angle-b-color, #e06c75)" stroke-width="2.5" />
    <!-- Arc 3: 180° to 220° = 40° ACUTE (blue) - bottom-left -->
    <path d="M 155,130 A 35,35 0 0,0 163,153" fill="none" stroke="var(--angle-a-color, #61afef)" stroke-width="2.5" />
    <!-- Arc 4: 220° to 360° = 140° OBTUSE (red) - bottom-right -->
    <path d="M 163,153 A 35,35 0 0,0 225,130" fill="none" stroke="var(--angle-b-color, #e06c75)" stroke-width="2.5" />

    <!-- Labels pushed outward -->
    <text x="255" y="104" font-size="16" font-weight="bold" fill="var(--angle-a-color, #61afef)">40°</text>
    <text x="85" y="172" font-size="16" font-weight="bold" fill="var(--angle-a-color, #61afef)">40°</text>
    <text x="88" y="88" font-size="16" font-weight="bold" fill="var(--angle-b-color, #e06c75)">140°</text>
    <text x="252" y="180" font-size="16" font-weight="bold" fill="var(--angle-b-color, #e06c75)">140°</text>

    <!-- Legend -->
    <rect x="80" y="258" width="14" height="14" rx="2" fill="var(--angle-a-color, #61afef)" />
    <text x="100" y="270" font-size="12" fill="var(--label-color, currentColor)">Vertical pair: 40°</text>
    <rect x="220" y="258" width="14" height="14" rx="2" fill="var(--angle-b-color, #e06c75)" />
    <text x="240" y="270" font-size="12" fill="var(--label-color, currentColor)">Vertical pair: 140°</text>

  </svg>
</div>

<style>
  :root {
    --line-color: #888;
    --point-color: #e5c07b;
    --angle-a-color: #61afef;
    --angle-b-color: #e06c75;
    --label-color: var(--sl-color-white, #e0e0e0);
  }
  :root[data-theme="light"] {
    --line-color: #555;
    --point-color: #d4a017;
    --angle-a-color: #2980b9;
    --angle-b-color: #c0392b;
    --label-color: #1a1a1a;
  }
</style>
