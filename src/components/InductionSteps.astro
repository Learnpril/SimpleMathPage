---
/**
 * InductionSteps — shows the domino analogy for mathematical induction.
 * Base case knocks over the first domino, inductive step proves
 * each domino knocks over the next.
 */
const w = 440;
const h = 160;
const dominoes = 7;
const dw = 18;
const dh = 50;
const gap = 40;
const startX = 30;
const baseY = 130;
---

<figure class="ids" role="img" aria-label="Mathematical induction as a chain of falling dominoes">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Ground line */}
    <line x1="15" y1={baseY} x2={w - 15} y2={baseY} class="ids-ground" stroke-width="1" />

    {/* Dominoes */}
    {Array.from({length: dominoes}).map((_, i) => {
      const x = startX + i * (dw + gap);
      const isFalling = i < 4;
      const tilt = i === 0 ? 20 : i === 1 ? 16 : i === 2 ? 12 : i === 3 ? 8 : 0;
      const labels = ["n=1", "n=2", "n=3", "n=4", "...", "k", "k+1"];
      return (
        <g>
          <rect
            x={x} y={baseY - dh} width={dw} height={dh} rx="3"
            class={i === 0 ? "ids-base" : isFalling ? "ids-falling" : "ids-standing"}
            fill-opacity="0.85"
            transform={isFalling ? `rotate(${tilt} ${x + dw/2} ${baseY})` : ""}
          />
          <text
            class={i === 0 ? "ids-n-base" : isFalling ? "ids-n-fall" : "ids-n"}
            x={x + dw/2} y={baseY + 16}
            font-size="10" text-anchor="middle"
          >{labels[i]}</text>
        </g>
      );
    })}

    {/* Base Case label */}
    <text class="ids-label-base" x={startX + dw/2} y="18" font-size="11" text-anchor="middle">Base Case</text>
    <line x1={startX + dw/2} y1="22" x2={startX + dw/2} y2={baseY - dh - 14} class="ids-ptr" stroke-width="1" stroke-dasharray="3,2" />

    {/* Inductive step arrow — starts after Base Case label */}
    <line x1={startX + dw + gap + 10} y1="14" x2={startX + 5*(dw + gap) - gap/2} y2="14" class="ids-arrow" stroke-width="1.5" />
    <polygon points={`${startX + 5*(dw + gap) - gap/2 - 2},9 ${startX + 5*(dw + gap) - gap/2 + 5},14 ${startX + 5*(dw + gap) - gap/2 - 2},19`} class="ids-arrow-head" />
    <text class="ids-label-step" x={startX + 3*(dw + gap)} y="10" font-size="10" text-anchor="middle">each one knocks over the next</text>
  </svg>
</figure>

<style>
  .ids { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ids svg { max-width:100%; height:auto; }
  .ids-base { fill:#7ee787; stroke:#7ee787; }
  .ids-falling { fill:#58a6ff; stroke:#58a6ff; }
  .ids-standing { fill:#666; stroke:#666; }
  .ids-ground { stroke:#555; }
  .ids-n { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .ids-n-base { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .ids-n-fall { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .ids-label-base { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .ids-label-step { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .ids-ptr { stroke:#7ee787; }
  .ids-arrow { stroke:#d2a8ff; }
  .ids-arrow-head { fill:#d2a8ff; }
  :global([data-theme="light"]) .ids-base { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .ids-falling { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .ids-standing { fill:#aaa; stroke:#aaa; }
  :global([data-theme="light"]) .ids-ground { stroke:#ccc; }
  :global([data-theme="light"]) .ids-n { fill:#888; }
  :global([data-theme="light"]) .ids-n-base { fill:#116329; }
  :global([data-theme="light"]) .ids-n-fall { fill:#0550ae; }
  :global([data-theme="light"]) .ids-label-base { fill:#116329; }
  :global([data-theme="light"]) .ids-label-step { fill:#6639ba; }
  :global([data-theme="light"]) .ids-ptr { stroke:#116329; }
  :global([data-theme="light"]) .ids-arrow { stroke:#6639ba; }
  :global([data-theme="light"]) .ids-arrow-head { fill:#6639ba; }
</style>
