---
/**
 * QuotientCollapse - forming ℤ₁₂/⟨3⟩. Each coset on the left becomes a single
 * element on the right, and the inherited operation makes the result ℤ₃.
 *
 * The cosets, their count and the resulting cyclic structure are computed from
 * n = 12 and the generator, so the labels cannot drift from the arithmetic.
 */
const n = 12;
const gen = 3;

const H: number[] = [];
for (let k = 0, x = 0; k < n; k++, x = (x + gen) % n) {
  if (H.includes(x)) break;
  H.push(x);
}
H.sort((a, b) => a - b);

const cosets: { rep: number; els: number[] }[] = [];
const claimed = new Set<number>();
for (let g = 0; g < n; g++) {
  if (claimed.has(g)) continue;
  const els = H.map((hEl) => (g + hEl) % n).sort((a, b) => a - b);
  els.forEach((e) => claimed.add(e));
  cosets.push({ rep: g, els });
}
const q = cosets.length;

const w = 540;
const h = 286;
const blockX = 28;
const blockW = 202;
const blockH = 34;
const rowY = cosets.map((_, i) => 100 + i * 50);

const ringCx = 420;
const ringCy = 158;
const ringR = 52;
const dotR = 18;
const palette = ["green", "blue", "purple", "orange"];

const nodePos = (i: number) => {
  const a = (-90 + i * (360 / q)) * (Math.PI / 180);
  return { x: ringCx + ringR * Math.cos(a), y: ringCy + ringR * Math.sin(a) };
};

/** Trim node-to-node links back to the circle edges. */
function link(a: { x: number; y: number }, b: { x: number; y: number }) {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  const pad = dotR + 4;
  return {
    x1: a.x + (dx / len) * pad,
    y1: a.y + (dy / len) * pad,
    x2: b.x - (dx / len) * pad,
    y2: b.y - (dy / len) * pad,
  };
}
---

<figure
  class="qco"
  role="img"
  aria-label={`Forming the quotient group of the integers mod 12 by the subgroup {${H.join(", ")}}. The ${q} cosets on the left each collapse to a single element on the right, and adding representatives makes the quotient a cyclic group of order ${q}.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="qco-head" font-size="12.5" font-weight="bold">A quotient group treats each coset as one element</text>
    <text x="16" y="42" class="qco-sub" font-size="10.5">
      {`H = ⟨${gen}⟩ = {${H.join(", ")}} inside ℤ₁₂`}
    </text>

    <text x={blockX + blockW / 2} y="72" class="qco-title" font-size="11" text-anchor="middle" font-weight="bold">the cosets of H</text>

    {cosets.map((c, i) => (
      <g>
        <rect x={blockX} y={rowY[i] - blockH / 2} width={blockW} height={blockH} rx="7" class={`qco-block qco-${palette[i]}`} />
        <text x={blockX + blockW / 2} y={rowY[i] + 5} class="qco-els" font-size="11" text-anchor="middle">
          {`${c.rep} + H = {${c.els.join(", ")}}`}
        </text>
      </g>
    ))}

    <text x="284" y="146" class="qco-arrowlbl" font-size="9.5" text-anchor="middle">collapse</text>
    <line x1="242" y1="158" x2="326" y2="158" class="qco-arrow" marker-end="url(#qco-head)" />

    <text x={ringCx} y="72" class="qco-title" font-size="11" text-anchor="middle" font-weight="bold">
      {`ℤ₁₂/H ≅ ℤ${q === 3 ? "₃" : ""}`}
    </text>

    {cosets.map((_, i) => {
      const a = nodePos(i);
      const b = nodePos((i + 1) % q);
      const l = link(a, b);
      return <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} class="qco-cyclink" marker-end="url(#qco-head-c)" />;
    })}
    {cosets.map((c, i) => {
      const p = nodePos(i);
      return (
        <g>
          <circle cx={p.x} cy={p.y} r={dotR} class={`qco-node qco-${palette[i]}`} />
          <text x={p.x} y={p.y + 4} class="qco-nodelbl" font-size="10.5" text-anchor="middle">{`[${c.rep}]`}</text>
        </g>
      );
    })}

    <text x={w / 2} y="252" class="qco-foot" font-size="10.5" text-anchor="middle">
      Add representatives to add cosets: (1 + H) + (1 + H) = 2 + H
    </text>
    <text x={w / 2} y="270" class="qco-sub2" font-size="9.5" text-anchor="middle">
      {`|ℤ₁₂/H| = [ℤ₁₂ : H] = ${q}, and this only works because H is normal`}
    </text>

    <defs>
      <marker id="qco-head" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="qco-head-fill" />
      </marker>
      <marker id="qco-head-c" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" class="qco-head-c-fill" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .qco { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .qco svg { width:100%; max-width:100%; height:auto; }
  .qco-block { fill-opacity:0.14; stroke-width:1.7; }
  .qco-node { fill-opacity:0.22; stroke-width:2; }
  .qco-green { fill:#7ee787; stroke:#7ee787; }
  .qco-blue { fill:#58a6ff; stroke:#58a6ff; }
  .qco-purple { fill:#d2a8ff; stroke:#d2a8ff; }
  .qco-orange { fill:#f0883e; stroke:#f0883e; }
  .qco-els, .qco-nodelbl { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .qco-title { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .qco-arrow { stroke:#888; stroke-width:1.6; }
  .qco-head-fill { fill:#888; }
  .qco-cyclink { stroke:#8b949e; stroke-width:1.5; }
  .qco-head-c-fill { fill:#8b949e; }
  .qco-arrowlbl { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .qco-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .qco-sub, .qco-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .qco-foot { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .qco-green { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .qco-blue { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .qco-purple { fill:#6639ba; stroke:#6639ba; }
  :global([data-theme="light"]) .qco-orange { fill:#b35900; stroke:#b35900; }
  :global([data-theme="light"]) .qco-els, :global([data-theme="light"]) .qco-nodelbl { fill:#24292f; }
  :global([data-theme="light"]) .qco-title { fill:#0550ae; }
  :global([data-theme="light"]) .qco-arrow, :global([data-theme="light"]) .qco-cyclink { stroke:#555; }
  :global([data-theme="light"]) .qco-head-fill, :global([data-theme="light"]) .qco-head-c-fill { fill:#555; }
  :global([data-theme="light"]) :is(.qco-sub, .qco-sub2, .qco-arrowlbl) { fill:#57606a; }
  :global([data-theme="light"]) .qco-head { fill:#24292f; }
  :global([data-theme="light"]) .qco-foot { fill:#116329; }
</style>
