---
/**
 * BasisSpanDiagram — shows how basis vectors e1, e2 build any vector
 * e1=(1,0) blue, e2=(0,1) green
 * Target vector (3,2) purple = 3*e1 + 2*e2
 * Dashed lines show the decomposition
 * Scale: 50px/unit, origin at (50, 220)
 */
---
<div class="diagram-container">
<svg viewBox="-10 -10 340 290" width="100%" style="max-width:380px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Basis vectors building a target vector: 3e1 + 2e2 = (3,2)">

  {/* Title */}
  <text x="165" y="12" fill="#888" font-size="15" font-family="serif" text-anchor="middle" font-weight="bold">Building &#x27E8;3, 2&#x27E9; from a basis</text>

  {/* Grid */}
  <g stroke="#333" stroke-width="0.5" opacity="0.15">
    {[0,50,100,150,200,250,300].map(x => <line x1={x} y1="20" x2={x} y2="230" />)}
    {[20,70,120,170,220].map(y => <line x1="0" y1={y} x2="310" y2={y} />)}
  </g>

  {/* Axes: origin at (50, 220) */}
  <line x1="0" y1="220" x2="315" y2="220" stroke="#666" stroke-width="1" class="bs-axis" />
  <line x1="50" y1="235" x2="50" y2="18" stroke="#666" stroke-width="1" class="bs-axis" />

  {/* Dashed decomposition lines */}
  {/* Horizontal: from origin to (200, 220) = 3 units right */}
  <line x1="50" y1="220" x2="200" y2="220" stroke="#58a6ff" stroke-width="2" stroke-dasharray="6,3" opacity="0.4" class="bs-blue-line" />
  {/* Vertical: from (200, 220) up to (200, 120) = 2 units up */}
  <line x1="200" y1="220" x2="200" y2="120" stroke="#7ee787" stroke-width="2" stroke-dasharray="6,3" opacity="0.4" class="bs-green-line" />

  {/* e1 basis vector: blue arrow (1 unit right) */}
  <line x1="50" y1="220" x2="94" y2="220" stroke="#58a6ff" stroke-width="3" class="bs-blue-line" />
  <polygon points="100,220 90,215 90,225" fill="#58a6ff" class="bs-blue-fill" />

  {/* e2 basis vector: green arrow (1 unit up) */}
  <line x1="50" y1="220" x2="50" y2="176" stroke="#7ee787" stroke-width="3" class="bs-green-line" />
  <polygon points="50,170 45,180 55,180" fill="#7ee787" class="bs-green-fill" />

  {/* Target vector (3,2): purple arrow from origin to (200, 120) */}
  {/* dir=(150,-100), unit=(0.832,-0.555), perp=(0.555,0.832) */}
  <line x1="50" y1="220" x2="192" y2="125" stroke="#d2a8ff" stroke-width="2.5" class="bs-purple-line" />
  <polygon points="200,120 194.5,129.7 188.9,121.3" fill="#d2a8ff" class="bs-purple-fill" />

  {/* Labels — clear of all lines */}
  <text x="108" y="210" fill="#58a6ff" font-size="13" font-family="serif" class="bs-blue-text">e&#x2081;</text>
  <text x="58" y="165" fill="#7ee787" font-size="13" font-family="serif" class="bs-green-text">e&#x2082;</text>
  <text x="208" y="118" fill="#d2a8ff" font-size="13" font-family="serif" class="bs-purple-text">&#x27E8;3, 2&#x27E9;</text>

  {/* Scaling annotations along dashed lines */}
  <text x="125" y="240" fill="#58a6ff" font-size="12" font-family="serif" text-anchor="middle" class="bs-blue-text">3 × e&#x2081;</text>
  <text x="218" y="175" fill="#7ee787" font-size="12" font-family="serif" class="bs-green-text">2 × e&#x2082;</text>

  {/* Origin dot */}
  <circle cx="50" cy="220" r="3.5" fill="#999" />

  {/* Legend */}
  <g transform="translate(20, 255)">
    <line x1="0" y1="0" x2="18" y2="0" stroke="#58a6ff" stroke-width="3" class="bs-blue-line" />
    <text x="24" y="4" fill="#888" font-size="12" font-family="serif">e&#x2081; = &#x27E8;1, 0&#x27E9;</text>
    <line x1="120" y1="0" x2="138" y2="0" stroke="#7ee787" stroke-width="3" class="bs-green-line" />
    <text x="144" y="4" fill="#888" font-size="12" font-family="serif">e&#x2082; = &#x27E8;0, 1&#x27E9;</text>
    <line x1="240" y1="0" x2="258" y2="0" stroke="#d2a8ff" stroke-width="2.5" class="bs-purple-line" />
    <text x="264" y="4" fill="#888" font-size="12" font-family="serif">target</text>
  </g>
</svg>
</div>

<style>
  .bs-blue-line { stroke: #58a6ff; }
  .bs-blue-fill { fill: #58a6ff; }
  .bs-blue-text { fill: #58a6ff; }
  .bs-green-line { stroke: #7ee787; }
  .bs-green-fill { fill: #7ee787; }
  .bs-green-text { fill: #7ee787; }
  .bs-purple-line { stroke: #d2a8ff; }
  .bs-purple-fill { fill: #d2a8ff; }
  .bs-purple-text { fill: #d2a8ff; }
  .bs-axis { stroke: #666; }

  :global([data-theme="light"]) .bs-blue-line { stroke: #0550ae; }
  :global([data-theme="light"]) .bs-blue-fill { fill: #0550ae; }
  :global([data-theme="light"]) .bs-blue-text { fill: #0550ae; }
  :global([data-theme="light"]) .bs-green-line { stroke: #1a7f2e; }
  :global([data-theme="light"]) .bs-green-fill { fill: #1a7f2e; }
  :global([data-theme="light"]) .bs-green-text { fill: #1a7f2e; }
  :global([data-theme="light"]) .bs-purple-line { stroke: #6b3fa0; }
  :global([data-theme="light"]) .bs-purple-fill { fill: #6b3fa0; }
  :global([data-theme="light"]) .bs-purple-text { fill: #6b3fa0; }
  :global([data-theme="light"]) .bs-axis { stroke: #999; }
  :global([data-theme="light"]) svg text[fill="#888"] { fill: #555; }
  :global([data-theme="light"]) svg g[opacity="0.15"] line { stroke: #ccc; }
</style>
