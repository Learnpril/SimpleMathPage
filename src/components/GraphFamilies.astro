---
/**
 * GraphFamilies — the four standard graph shapes you meet constantly:
 * complete, cycle, path, and complete bipartite.
 */
const w = 540;
const h = 210;
const cy = 100;
const centers = [72, 204, 336, 468];

// --- K4: every pair joined ---
const k4 = [
  { x: centers[0] - 32, y: cy - 30 },
  { x: centers[0] + 32, y: cy - 30 },
  { x: centers[0] - 32, y: cy + 30 },
  { x: centers[0] + 32, y: cy + 30 },
];
const k4Edges: [number, number][] = [[0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 3]];

// --- C5: a ring ---
const c5 = Array.from({ length: 5 }).map((_, i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return { x: centers[1] + 38 * Math.cos(a), y: cy + 38 * Math.sin(a) };
});
const c5Edges: [number, number][] = [[0, 1], [1, 2], [2, 3], [3, 4], [4, 0]];

// --- P4: a line ---
const p4 = [
  { x: centers[2] - 48, y: cy + 14 },
  { x: centers[2] - 16, y: cy - 16 },
  { x: centers[2] + 16, y: cy + 14 },
  { x: centers[2] + 48, y: cy - 16 },
];
const p4Edges: [number, number][] = [[0, 1], [1, 2], [2, 3]];

// --- K2,3: bipartite, every left joined to every right ---
const bipLeft = [
  { x: centers[3] - 32, y: cy - 24 },
  { x: centers[3] - 32, y: cy + 24 },
];
const bipRight = [
  { x: centers[3] + 32, y: cy - 36 },
  { x: centers[3] + 32, y: cy },
  { x: centers[3] + 32, y: cy + 36 },
];

const panels = [
  { c: centers[0], name: "K₄", desc: "complete", detail: "6 edges, all degree 3" },
  { c: centers[1], name: "C₅", desc: "cycle", detail: "5 edges, all degree 2" },
  { c: centers[2], name: "P₄", desc: "path", detail: "3 edges, ends degree 1" },
  { c: centers[3], name: "K₂,₃", desc: "bipartite", detail: "6 edges, no odd cycle" },
];
---

<figure
  class="gfm"
  role="img"
  aria-label="Four graph families side by side: the complete graph on four vertices, the five-vertex cycle, the four-vertex path, and the complete bipartite graph K two three"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Titles */}
    {panels.map((p) => (
      <g>
        <text x={p.c} y="28" class="gfm-name" font-size="13" font-weight="bold" text-anchor="middle">{p.name}</text>
        <text x={p.c} y="44" class="gfm-desc" font-size="10" text-anchor="middle">{p.desc}</text>
        <text x={p.c} y="176" class="gfm-detail" font-size="9" text-anchor="middle">{p.detail}</text>
      </g>
    ))}

    {/* K4 */}
    {k4Edges.map(([a, b]) => (
      <line x1={k4[a].x} y1={k4[a].y} x2={k4[b].x} y2={k4[b].y} class="gfm-edge" />
    ))}
    {k4.map((p) => <circle cx={p.x} cy={p.y} r="7" class="gfm-node gfm-blue" />)}

    {/* C5 */}
    {c5Edges.map(([a, b]) => (
      <line x1={c5[a].x} y1={c5[a].y} x2={c5[b].x} y2={c5[b].y} class="gfm-edge" />
    ))}
    {c5.map((p) => <circle cx={p.x} cy={p.y} r="7" class="gfm-node gfm-green" />)}

    {/* P4 */}
    {p4Edges.map(([a, b]) => (
      <line x1={p4[a].x} y1={p4[a].y} x2={p4[b].x} y2={p4[b].y} class="gfm-edge" />
    ))}
    {p4.map((p) => <circle cx={p.x} cy={p.y} r="7" class="gfm-node gfm-purple" />)}

    {/* K2,3 */}
    {bipLeft.map((l) => bipRight.map((r) => (
      <line x1={l.x} y1={l.y} x2={r.x} y2={r.y} class="gfm-edge" />
    )))}
    {bipLeft.map((p) => <circle cx={p.x} cy={p.y} r="7" class="gfm-node gfm-orange" />)}
    {bipRight.map((p) => <circle cx={p.x} cy={p.y} r="7" class="gfm-node gfm-blue" />)}

    <text x={w / 2} y="200" class="gfm-foot" font-size="10.5" text-anchor="middle">
      A bipartite graph splits into two groups with every edge crossing between them
    </text>
  </svg>
</figure>

<style>
  .gfm { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .gfm svg { max-width:100%; height:auto; }
  .gfm-edge { stroke:#888; stroke-width:1.6; }
  .gfm-node { fill:#121212; stroke-width:2.2; }
  .gfm-blue { stroke:#58a6ff; }
  .gfm-green { stroke:#7ee787; }
  .gfm-purple { stroke:#d2a8ff; }
  .gfm-orange { stroke:#f0883e; }
  .gfm-name { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .gfm-desc { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .gfm-detail { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .gfm-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .gfm-edge { stroke:#666; }
  :global([data-theme="light"]) .gfm-node { fill:#ffffff; }
  :global([data-theme="light"]) .gfm-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .gfm-green { stroke:#116329; }
  :global([data-theme="light"]) .gfm-purple { stroke:#6639ba; }
  :global([data-theme="light"]) .gfm-orange { stroke:#b35900; }
  :global([data-theme="light"]) .gfm-name { fill:#24292f; }
  :global([data-theme="light"]) .gfm-desc { fill:#0550ae; }
  :global([data-theme="light"]) .gfm-foot { fill:#b35900; }
</style>
