---
/**
 * LogBranchCut — the principal argument jumps by a full turn across the negative
 * real axis. Left: two sample points either side of the cut, with their Arg
 * values computed by atan2. Right: Arg z plotted as you walk once round a
 * circle, sampled from the same function, so the sawtooth is measured.
 */
const w = 540;
const h = 306;

const deg = (rad: number) => (rad * 180) / Math.PI;
const argOf = (t: number) => deg(Math.atan2(Math.sin(t), Math.cos(t)));

// ---- left panel ----
const lcx = 128;
const cy = 148;
const lu = 52;
const lx = (re: number) => lcx + re * lu;
const ly = (im: number) => cy - im * lu;

const sampleDeg = 160;
const above = { t: (sampleDeg * Math.PI) / 180 };
const below = { t: (-sampleDeg * Math.PI) / 180 };
const argAbove = argOf(above.t);
const argBelow = argOf(below.t);
const jump = 360; // the limiting jump across the cut

// ---- right panel: Arg z as θ goes 0 → 360° ----
const pl = 300;
const pr = 506;
const pTop = 80;
const pBot = 216;
const tx = (thetaDeg: number) => pl + (thetaDeg / 360) * (pr - pl);
const ty = (argDeg: number) => cy - (argDeg / 180) * (cy - pTop);

function branch(loDeg: number, hiDeg: number) {
  const pts: string[] = [];
  for (let i = 0; i <= 60; i++) {
    const d = loDeg + (i / 60) * (hiDeg - loDeg);
    const t = (d * Math.PI) / 180;
    pts.push(`${tx(d).toFixed(1)},${ty(argOf(t)).toFixed(1)}`);
  }
  return pts.join(" ");
}
const branchA = branch(0.4, 179.4);
const branchB = branch(180.6, 359.6);
---

<figure
  class="lbc"
  role="img"
  aria-label={`On the left, a point at ${argAbove.toFixed(0)} degrees just above the negative real axis and one at ${argBelow.toFixed(0)} degrees just below it. On the right, the principal argument plotted around a full turn rises to 180 degrees, drops by ${jump} degrees at the negative real axis, and climbs back to zero.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="lbc-head" font-size="12.5" font-weight="bold">The logarithm needs a cut</text>
    <text x="16" y="38" class="lbc-sub" font-size="10.5">Arg z is forced into (−π, π], so it must jump somewhere</text>

    <line x1="230" y1="52" x2="230" y2="240" class="lbc-divide" />

    {/* ---------- left: the cut plane ---------- */}
    <text x={lcx} y="56" class="lbc-panel" font-size="10" text-anchor="middle">the principal branch</text>
    <line x1={lx(-1.3)} y1={cy} x2={lx(1.3)} y2={cy} class="lbc-axis" />
    <line x1={lcx} y1={ly(1.3)} x2={lcx} y2={ly(-1.3)} class="lbc-axis" />
    {/* the cut itself, drawn over the negative real axis */}
    <line x1={lx(-1.3)} y1={cy} x2={lx(-0.06)} y2={cy} class="lbc-cut" />
    <circle cx={lcx} cy={cy} r="4" class="lbc-hole" />

    <circle cx={lx(Math.cos(above.t))} cy={ly(Math.sin(above.t))} r="4" class="lbc-dot-a" />
    <text x={lx(Math.cos(above.t))} y={ly(Math.sin(above.t)) - 12} class="lbc-lbl-a" font-size="9.5" text-anchor="middle">
      {`Arg = ${argAbove.toFixed(0)}°`}
    </text>
    <circle cx={lx(Math.cos(below.t))} cy={ly(Math.sin(below.t))} r="4" class="lbc-dot-b" />
    <text x={lx(Math.cos(below.t))} y={ly(Math.sin(below.t)) + 18} class="lbc-lbl-b" font-size="9.5" text-anchor="middle">
      {`Arg = ${argBelow.toFixed(0)}°`}
    </text>

    <text x={lcx} y="236" class="lbc-key" font-size="9.5" text-anchor="middle">thick dashes = the cut</text>

    {/* ---------- right: the sawtooth ---------- */}
    <text x={(pl + pr) / 2} y="56" class="lbc-panel" font-size="10" text-anchor="middle">Arg z around one full turn</text>
    <line x1={pl} y1={cy} x2={pr} y2={cy} class="lbc-axis" />
    <line x1={pl} y1={pTop - 4} x2={pl} y2={pBot - 2} class="lbc-axis" />

    <polyline points={branchA} class="lbc-branch" fill="none" />
    <polyline points={branchB} class="lbc-branch" fill="none" />
    <line x1={tx(180)} y1={pTop} x2={tx(180)} y2={pBot} class="lbc-jumpline" />

    <text x="296" y="84" class="lbc-tick" font-size="9.5" text-anchor="end">+180°</text>
    <text x="296" y="152" class="lbc-tick" font-size="9.5" text-anchor="end">0°</text>
    <text x="296" y="216" class="lbc-tick" font-size="9.5" text-anchor="end">−180°</text>
    <text x={tx(0)} y="232" class="lbc-tick" font-size="9.5" text-anchor="middle">0</text>
    <text x={tx(180)} y="232" class="lbc-tick" font-size="9.5" text-anchor="middle">180°</text>
    <text x={tx(360)} y="232" class="lbc-tick" font-size="9.5" text-anchor="middle">360°</text>
    <text x={tx(180) + 12} y="110" class="lbc-jumplbl" font-size="9.5" text-anchor="start">{`jump of ${jump}°`}</text>

    <text x={w / 2} y="264" class="lbc-foot" font-size="10.5" text-anchor="middle">
      log z = ln|z| + i Arg z is analytic on ℂ minus the cut, and discontinuous across it
    </text>
    <text x={w / 2} y="284" class="lbc-sub2" font-size="9.5" text-anchor="middle">
      Approaching the cut from above gives 180° and from below −180°, so the jump is a full turn
    </text>
    <text x={w / 2} y="300" class="lbc-sub2" font-size="9.5" text-anchor="middle">
      The cut is a choice, not a property of log; any ray from 0 to ∞ would serve
    </text>
  </svg>
</figure>

<style>
  .lbc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .lbc svg { width:100%; max-width:100%; height:auto; }
  .lbc-axis { stroke:#888; stroke-width:1.3; }
  .lbc-divide { stroke:#3a3a3a; stroke-width:1; }
  .lbc-cut { stroke:#ff7b72; stroke-width:3.4; stroke-dasharray:7,4; }
  .lbc-hole { fill:none; stroke:#eee; stroke-width:1.6; }
  .lbc-dot-a { fill:#7ee787; stroke:none; }
  .lbc-dot-b { fill:#d2a8ff; stroke:none; }
  .lbc-lbl-a { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .lbc-lbl-b { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .lbc-branch { stroke:#58a6ff; stroke-width:2.2; }
  .lbc-jumpline { stroke:#ff7b72; stroke-width:1.4; stroke-dasharray:4,4; }
  .lbc-jumplbl { fill:#ff7b72; font-family:'Libre Baskerville',Georgia,serif; }
  .lbc-tick, .lbc-key { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .lbc-panel, .lbc-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .lbc-sub, .lbc-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .lbc-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .lbc-axis { stroke:#666; }
  :global([data-theme="light"]) .lbc-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) :is(.lbc-cut, .lbc-jumpline) { stroke:#a40e26; }
  :global([data-theme="light"]) .lbc-jumplbl { fill:#a40e26; }
  :global([data-theme="light"]) .lbc-hole { stroke:#24292f; }
  :global([data-theme="light"]) .lbc-dot-a { fill:#116329; }
  :global([data-theme="light"]) .lbc-lbl-a { fill:#116329; }
  :global([data-theme="light"]) .lbc-dot-b { fill:#6639ba; }
  :global([data-theme="light"]) .lbc-lbl-b { fill:#6639ba; }
  :global([data-theme="light"]) .lbc-branch { stroke:#0550ae; }
  :global([data-theme="light"]) .lbc-foot { fill:#0550ae; }
  :global([data-theme="light"]) .lbc-panel, :global([data-theme="light"]) .lbc-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.lbc-tick, .lbc-key, .lbc-sub, .lbc-sub2) { fill:#57606a; }
</style>
