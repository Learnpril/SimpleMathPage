---
/**
 * GrowthDecayGraph — shows exponential growth and decay curves
 * Growth: P = 500(1.12)^t (blue), Decay: P = 400(0.5)^(t/25) scaled (orange)
 * Side by side on the same axes for comparison.
 */
const w = 340;
const h = 240;
const pad = 40;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 10, yMin = 0, yMax = 1400;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// Growth: 500 * 1.12^t
const growPts: string[] = [];
for (let t = 0; t <= 10; t += 0.2) {
  const y = 500 * Math.pow(1.12, t);
  if (y <= yMax) growPts.push(`${sx(t).toFixed(1)},${sy(y).toFixed(1)}`);
}

// Decay: 1200 * 0.8^t (starts high, decays visibly)
const decayPts: string[] = [];
for (let t = 0; t <= 10; t += 0.2) {
  const y = 1200 * Math.pow(0.8, t);
  decayPts.push(`${sx(t).toFixed(1)},${sy(y).toFixed(1)}`);
}
---

<figure class="gdg" role="img" aria-label="Exponential growth curve rising and decay curve falling over time">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[0,2,4,6,8,10].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="gdg-grid" stroke-width="0.5" />
    ))}
    {[0,200,400,600,800,1000,1200].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="gdg-grid" stroke-width="0.5" />
    ))}

    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(yMin)} x2={sx(xMax)} y2={sy(yMin)} class="gdg-axis" stroke-width="1.5" />
    <line x1={sx(xMin)} y1={sy(yMin)} x2={sx(xMin)} y2={sy(yMax)} class="gdg-axis" stroke-width="1.5" />

    {/* Curves */}
    <polyline points={growPts.join(' ')} fill="none" class="gdg-grow" stroke-width="2.5" />
    <polyline points={decayPts.join(' ')} fill="none" class="gdg-decay" stroke-width="2.5" />

    {/* Start dots */}
    <circle cx={sx(0)} cy={sy(500)} r="4" class="gdg-grow-dot" />
    <circle cx={sx(0)} cy={sy(1200)} r="4" class="gdg-decay-dot" />

    {/* Labels */}
    <text class="gdg-grow-lbl" x={sx(4)} y={sy(1200)} font-size="11" font-weight="bold">Growth</text>
    <text class="gdg-decay-lbl" x={sx(5.5)} y={sy(450)} font-size="11" font-weight="bold">Decay</text>

    {/* Axis labels */}
    <text class="gdg-ax" x={sx(5)} y={sy(yMin) + 16} font-size="10" text-anchor="middle">Time (t)</text>
    <text class="gdg-ax" x={sx(xMin) - 6} y={sy(700)} font-size="10" text-anchor="end" transform={`rotate(-90, ${sx(xMin) - 6}, ${sy(700)})`}>Amount</text>
  </svg>
</figure>

<style>
  .gdg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .gdg svg { max-width:100%; height:auto; }
  .gdg-grid { stroke:#333; }
  .gdg-axis { stroke:#666; }
  .gdg-grow { stroke:#58a6ff; }
  .gdg-decay { stroke:#f0883e; }
  .gdg-grow-dot { fill:#58a6ff; }
  .gdg-decay-dot { fill:#f0883e; }
  .gdg-grow-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .gdg-decay-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .gdg-ax { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .gdg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .gdg-axis { stroke:#999; }
  :global([data-theme="light"]) .gdg-grow { stroke:#0969da; }
  :global([data-theme="light"]) .gdg-decay { stroke:#d4700a; }
  :global([data-theme="light"]) .gdg-grow-dot { fill:#0969da; }
  :global([data-theme="light"]) .gdg-decay-dot { fill:#d4700a; }
  :global([data-theme="light"]) .gdg-grow-lbl { fill:#0969da; }
  :global([data-theme="light"]) .gdg-decay-lbl { fill:#d4700a; }
</style>
