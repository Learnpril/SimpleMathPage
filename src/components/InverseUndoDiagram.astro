---
/**
 * InverseUndoDiagram — shows A⁻¹ undoing the transformation
 * Parallelogram (green) → unit square (blue) via A⁻¹
 */
---
<div class="diagram-container">
<svg viewBox="-10 -10 400 275" width="100%" style="max-width:440px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Matrix inverse undoes transformation: parallelogram back to unit square">

  {/* Title */}
  <text x="185" y="10" fill="#888" font-size="15" font-family="serif" text-anchor="middle" font-weight="bold">Applying A⁻¹ (undo)</text>

  {/* Grid */}
  <g stroke="#333" stroke-width="0.5" opacity="0.15">
    {[0,50,100,150,200,250,300,350].map(x => <line x1={x} y1="20" x2={x} y2="200" />)}
    {[20,70,120,170,200].map(y => <line x1="0" y1={y} x2="360" y2={y} />)}
  </g>

  {/* Axes */}
  <line x1="0" y1="200" x2="365" y2="200" stroke="#666" stroke-width="1" class="iu-axis" />
  <line x1="0" y1="205" x2="0" y2="18" stroke="#666" stroke-width="1" class="iu-axis" />

  {/* Parallelogram (green): same shape as before */}
  <polygon points="0,200 100,200 150,125 50,125" fill="#7ee787" fill-opacity="0.2" stroke="#7ee787" stroke-width="2.5" class="iu-green-shape" />
  <text x="75" y="170" fill="#7ee787" font-size="14" font-family="serif" text-anchor="middle" font-weight="bold" class="iu-green-text">area = 3</text>

  {/* Arrow */}
  <line x1="160" y1="175" x2="190" y2="175" stroke="#d2a8ff" stroke-width="2" class="iu-purple-stroke" />
  <polygon points="195,175 187,170 187,180" fill="#d2a8ff" class="iu-purple-fill" />
  <text x="178" y="165" fill="#d2a8ff" font-size="13" font-family="serif" text-anchor="middle" class="iu-purple-text">A⁻¹</text>

  {/* Unit square (blue): restored */}
  <polygon points="210,200 260,200 260,150 210,150" fill="#58a6ff" fill-opacity="0.2" stroke="#58a6ff" stroke-width="2.5" class="iu-blue-shape" />
  <text x="235" y="222" fill="#58a6ff" font-size="13" font-family="serif" text-anchor="middle" class="iu-blue-text">area = 1</text>

  {/* Label */}
  <text x="235" y="140" fill="#888" font-size="14" font-family="serif" text-anchor="middle">back to original</text>

  {/* Legend */}
  <g transform="translate(50, 238)">
    <rect x="0" y="0" width="14" height="14" rx="3" fill="#7ee787" class="iu-green-fill" />
    <text x="20" y="12" fill="#888" font-size="12" font-family="serif">Transformed</text>
    <rect x="130" y="0" width="14" height="14" rx="3" fill="#d2a8ff" class="iu-purple-fill" />
    <text x="150" y="12" fill="#888" font-size="12" font-family="serif">A⁻¹ (inverse)</text>
    <rect x="260" y="0" width="14" height="14" rx="3" fill="#58a6ff" class="iu-blue-fill" />
    <text x="280" y="12" fill="#888" font-size="12" font-family="serif">Restored</text>
  </g>
</svg>
</div>

<style>
  .iu-blue-shape { fill: #58a6ff; stroke: #58a6ff; }
  .iu-green-shape { fill: #7ee787; stroke: #7ee787; }
  .iu-blue-text { fill: #58a6ff; }
  .iu-green-text { fill: #7ee787; }
  .iu-purple-text { fill: #d2a8ff; }
  .iu-purple-stroke { stroke: #d2a8ff; }
  .iu-purple-fill { fill: #d2a8ff; }
  .iu-blue-fill { fill: #58a6ff; }
  .iu-green-fill { fill: #7ee787; }
  .iu-axis { stroke: #666; }

  :global([data-theme="light"]) .iu-blue-shape { fill: #0550ae; stroke: #0550ae; }
  :global([data-theme="light"]) .iu-green-shape { fill: #1a7f2e; stroke: #1a7f2e; }
  :global([data-theme="light"]) .iu-blue-text { fill: #0550ae; }
  :global([data-theme="light"]) .iu-green-text { fill: #1a7f2e; }
  :global([data-theme="light"]) .iu-purple-text { fill: #6b3fa0; }
  :global([data-theme="light"]) .iu-purple-stroke { stroke: #6b3fa0; }
  :global([data-theme="light"]) .iu-purple-fill { fill: #6b3fa0; }
  :global([data-theme="light"]) .iu-blue-fill { fill: #0550ae; }
  :global([data-theme="light"]) .iu-green-fill { fill: #1a7f2e; }
  :global([data-theme="light"]) .iu-axis { stroke: #999; }
  :global([data-theme="light"]) svg text[fill="#888"] { fill: #555; }
  :global([data-theme="light"]) svg g[opacity="0.15"] line { stroke: #ccc; }
</style>
