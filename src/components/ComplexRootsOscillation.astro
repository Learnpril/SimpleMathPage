---
/**
 * ComplexRootsOscillation — Three overlaid oscillation curves showing:
 * 1. Undamped: y = cos(2x) (constant amplitude, α=0)
 * 2. Light damping: y = e^{-0.3x} cos(2x) (slow decay)
 * 3. Heavy damping: y = e^{-1.2x} cos(2x) (rapid decay)
 * Plus the decay envelope for the heavily damped case.
 * Legend below the chart in its own space.
 */

const ox = 40, oy = 140, sx = 38, sy = 100;
const toPx = (t: number) => ox + t * sx;
const toPy = (v: number) => oy - v * sy;
const X0 = 20, X1 = 390, Y0 = 15, Y1 = 265;

function curve(f: (t: number) => number, tmin: number, tmax: number, step = 0.03) {
  const pts: [number, number][] = [];
  for (let t = tmin; t <= tmax + 1e-9; t += step) {
    const px = toPx(t), py = toPy(f(t));
    if (px >= X0 && px <= X1 && py >= Y0 && py <= Y1) pts.push([px, py]);
  }
  return pts;
}
const ptsStr = (pts: [number, number][]) => pts.map(p => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

const undamped = curve(t => Math.cos(2 * t), 0, 9);
const lightDamp = curve(t => Math.exp(-0.3 * t) * Math.cos(2 * t), 0, 9);
const heavyDamp = curve(t => Math.exp(-1.2 * t) * Math.cos(2 * t), 0, 9);
const envelope = curve(t => Math.exp(-1.2 * t), 0, 9);
const envelopeNeg = curve(t => -Math.exp(-1.2 * t), 0, 9);
---

<figure class="cro" role="img" aria-label="Three oscillation curves showing undamped, lightly damped, and heavily damped motion">
  <svg viewBox="0 0 400 310" xmlns="http://www.w3.org/2000/svg" class="cro-svg">
    {/* Grid */}
    <g class="cro-grid">
      {[0,2,4,6,8].map(t => <line x1={toPx(t)} y1={Y0} x2={toPx(t)} y2={Y1} />)}
      {[-1,0,1].map(v => <line x1={X0} y1={toPy(v)} x2={X1} y2={toPy(v)} />)}
    </g>

    {/* Axes */}
    <line x1={X0} y1={toPy(0)} x2={X1} y2={toPy(0)} class="cro-axis" />
    <line x1={toPx(0)} y1={Y0} x2={toPx(0)} y2={Y1} class="cro-axis" />
    <text x={X1 + 4} y={toPy(0) + 4} class="cro-lbl axis">t</text>
    <text x={toPx(0) + 6} y={Y0 + 2} class="cro-lbl axis">y</text>

    {/* Decay envelope (dashed, for heavy damping) */}
    <polyline points={ptsStr(envelope)} class="cro-envelope" fill="none" />
    <polyline points={ptsStr(envelopeNeg)} class="cro-envelope" fill="none" />

    {/* Curves */}
    <polyline points={ptsStr(undamped)} class="cro-curve c-blue" fill="none" />
    <polyline points={ptsStr(lightDamp)} class="cro-curve c-green" fill="none" />
    <polyline points={ptsStr(heavyDamp)} class="cro-curve c-purple" fill="none" />

    {/* Legend below chart */}
    <line x1="40" y1="284" x2="62" y2="284" class="cro-curve c-blue" />
    <text x="68" y="288" class="cro-lbl leg">Undamped (α = 0)</text>
    <line x1="195" y1="284" x2="217" y2="284" class="cro-curve c-green" />
    <text x="223" y="288" class="cro-lbl leg">Light damping (α = −0.3)</text>
    <line x1="40" y1="300" x2="62" y2="300" class="cro-curve c-purple" />
    <text x="68" y="304" class="cro-lbl leg">Heavy damping (α = −1.2)</text>
  </svg>
</figure>

<style>
  .cro { display: flex; justify-content: center; margin: 1.5rem 0; }
  .cro-svg { width: 100%; max-width: 500px; height: auto; }
  .cro-grid line { stroke: #262626; stroke-width: 0.5; }
  .cro-axis { stroke: #555; stroke-width: 1.2; }
  .cro-envelope { stroke: #d2a8ff; stroke-width: 1; stroke-dasharray: 5 4; opacity: 0.5; }
  .cro-curve { stroke-width: 2.2; stroke-linecap: round; }
  .c-blue { stroke: #58a6ff; }
  .c-green { stroke: #7ee787; }
  .c-purple { stroke: #d2a8ff; }
  .cro-lbl { font-family: "Libre Baskerville", Georgia, serif; fill: #aaa; }
  .axis { font-size: 13px; font-weight: bold; fill: #888; }
  .leg { font-size: 10px; }

  :root[data-theme="light"] .cro-grid line { stroke: #e8e8e8; }
  :root[data-theme="light"] .cro-axis { stroke: #999; }
  :root[data-theme="light"] .cro-envelope { stroke: #6b3fa0; }
  :root[data-theme="light"] .c-blue { stroke: #0550ae; }
  :root[data-theme="light"] .c-green { stroke: #1a7f2e; }
  :root[data-theme="light"] .c-purple { stroke: #6b3fa0; }
  :root[data-theme="light"] .cro-lbl { fill: #555; }
  :root[data-theme="light"] .axis { fill: #666; }
</style>
