---
/**
 * QuadraticSolveDiagram — plots y = x² − 4x + 3
 * Shows x-intercepts at (1,0) and (3,0), vertex at (2,−1), y-int at (0,3).
 * Illustrates that "solving = 0" means finding where the curve crosses the x-axis.
 */

const pad = 55;
const w = 420;
const h = 380;
const plotW = 310;
const plotH = 280;
const xLo = -1;
const xHi = 5;
const yLo = -3;
const yHi = 6;
const xRange = xHi - xLo;
const yRange = yHi - yLo;

function toX(v: number) { return pad + ((v - xLo) / xRange) * plotW; }
function toY(v: number) { return pad + ((yHi - v) / yRange) * plotH; }

const xAxisY = toY(0);
const yAxisX = toX(0);

// Parabola: y = x² − 4x + 3
const curvePts: string[] = [];
for (let x = -0.5; x <= 4.5; x += 0.05) {
  const y = x * x - 4 * x + 3;
  if (y >= yLo - 0.5 && y <= yHi + 0.5) {
    curvePts.push(`${curvePts.length === 0 ? 'M' : 'L'}${toX(x).toFixed(1)},${toY(y).toFixed(1)}`);
  }
}
const curveD = curvePts.join(' ');

const xTicks = [1, 2, 3, 4];
const yTicks = [-2, -1, 1, 2, 3, 4, 5];
const yLabelTicks = [-2, 2, 4];
---

<figure class="qs-diagram" role="img" aria-label="Graph of y = x² − 4x + 3 showing solutions at x = 1 and x = 3">
  <figcaption class="qs-title">Solving x² − 4x + 3 = 0 means finding where the curve crosses the x-axis</figcaption>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">

    <rect class="qs-bg" x="0" y="0" width={w} height={h} rx="8" />

    {xTicks.map(x => <line class="qs-grid" x1={toX(x)} y1={pad} x2={toX(x)} y2={pad + plotH} />)}
    {yTicks.map(y => <line class="qs-grid" x1={pad} y1={toY(y)} x2={pad + plotW} y2={toY(y)} />)}

    <line class="qs-axis" x1={pad} y1={xAxisY} x2={pad + plotW + 5} y2={xAxisY} stroke-width="1.5" />
    <line class="qs-axis" x1={yAxisX} y1={pad + plotH} x2={yAxisX} y2={pad - 5} stroke-width="1.5" />
    <text class="qs-label" x={pad + plotW + 10} y={xAxisY + 4} font-size="13">x</text>
    <text class="qs-label" x={yAxisX + 6} y={pad - 10} font-size="13">y</text>

    {xTicks.map(x => <text class="qs-tick" x={toX(x)} y={xAxisY + 16} font-size="10" text-anchor="middle">{x}</text>)}
    {yLabelTicks.map(y => <text class="qs-tick" x={yAxisX - 8} y={toY(y) + 4} font-size="10" text-anchor="end">{y}</text>)}

    <path class="qs-curve" d={curveD} fill="none" stroke-width="2.5" />

    {/* x-intercepts — the solutions */}
    <circle class="qs-sol" cx={toX(1)} cy={toY(0)} r="6" />
    <text class="qs-sol-label" x={toX(1) - 10} y={toY(0) + 20} font-size="11" text-anchor="end">x = 1</text>

    <circle class="qs-sol" cx={toX(3)} cy={toY(0)} r="6" />
    <text class="qs-sol-label" x={toX(3) + 10} y={toY(0) + 20} font-size="11">x = 3</text>

    {/* Vertex */}
    <circle class="qs-vtx" cx={toX(2)} cy={toY(-1)} r="4" />
    <text class="qs-vtx-label" x={toX(2) + 10} y={toY(-1) + 16} font-size="10">(2, −1)</text>

    {/* Curve label — right side, open space */}
    <text class="qs-curve-label" x={toX(4.3)} y={toY(2.5)} font-size="10" font-weight="bold">x² − 4x + 3</text>

  </svg>
</figure>

<style>
  .qs-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .qs-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .qs-diagram svg { max-width: 100%; height: auto; }
  .qs-bg { fill: var(--sl-color-bg, #121212); }
  .qs-grid { stroke: #333; stroke-width: 0.5; }
  .qs-axis { stroke: #888; }
  .qs-label { fill: #aaa; font-family: sans-serif; }
  .qs-tick { fill: #aaa; font-family: sans-serif; }
  .qs-curve { stroke: #58a6ff; }
  .qs-curve-label { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .qs-sol { fill: #f0c674; stroke: #fff; stroke-width: 2; }
  .qs-sol-label { fill: #f0c674; font-family: 'Libre Baskerville', Georgia, serif; font-weight: bold; }
  .qs-vtx { fill: #888; stroke: #aaa; stroke-width: 1.5; }
  .qs-vtx-label { fill: #888; font-family: 'Libre Baskerville', Georgia, serif; }

  :global([data-theme="light"]) .qs-bg { fill: #f8f9fa; }
  :global([data-theme="light"]) .qs-grid { stroke: #ccc; }
  :global([data-theme="light"]) .qs-axis { stroke: #222; }
  :global([data-theme="light"]) .qs-label { fill: #222; }
  :global([data-theme="light"]) .qs-tick { fill: #333; }
  :global([data-theme="light"]) .qs-curve { stroke: #0969da; }
  :global([data-theme="light"]) .qs-curve-label { fill: #0969da; }
  :global([data-theme="light"]) .qs-sol { fill: #b45309; stroke: #fff; }
  :global([data-theme="light"]) .qs-sol-label { fill: #b45309; }
  :global([data-theme="light"]) .qs-vtx { fill: #666; stroke: #444; }
  :global([data-theme="light"]) .qs-vtx-label { fill: #666; }
</style>
