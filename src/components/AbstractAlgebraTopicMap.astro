---
/**
 * AbstractAlgebraTopicMap - the ladder of structures this section climbs, from
 * a bare set with an operation up to fields, and the order the lessons follow.
 */
const bw = 152;
const bh = 54;
const gap = 22;
const margin = 14;
const w = margin * 2 + 3 * bw + 2 * gap;
const h = 250;
const row1Y = 34;
const row2Y = 148;
const colX = (i: number) => margin + i * (bw + gap);

const areas = [
  { x: colX(0), y: row1Y, label: "Operations", sub: "closure & axioms", cls: "green" },
  { x: colX(1), y: row1Y, label: "Groups", sub: "one operation", cls: "blue" },
  { x: colX(2), y: row1Y, label: "Structure", sub: "cosets & quotients", cls: "purple" },
  { x: colX(1), y: row2Y, label: "Rings", sub: "two operations", cls: "orange" },
  { x: colX(2), y: row2Y, label: "Fields", sub: "division works", cls: "pink" },
];
---

<figure
  class="aatm"
  role="img"
  aria-label="Topic map of Abstract Algebra: binary operations lead to groups, then to structural tools like cosets and quotients, and adding a second operation gives rings and then fields"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Top row, left to right */}
    <line x1={colX(0) + bw} y1={row1Y + bh / 2} x2={colX(1) - 3} y2={row1Y + bh / 2} class="aatm-link" marker-end="url(#aatm-head)" />
    <line x1={colX(1) + bw} y1={row1Y + bh / 2} x2={colX(2) - 3} y2={row1Y + bh / 2} class="aatm-link" marker-end="url(#aatm-head)" />

    {/* Groups gain a second operation and become rings */}
    <line x1={colX(1) + bw / 2} y1={row1Y + bh} x2={colX(1) + bw / 2} y2={row2Y - 3} class="aatm-link" marker-end="url(#aatm-head)" />

    {/* Rings with division become fields */}
    <line x1={colX(1) + bw} y1={row2Y + bh / 2} x2={colX(2) - 3} y2={row2Y + bh / 2} class="aatm-link" marker-end="url(#aatm-head)" />

    {areas.map((a) => (
      <g>
        <rect x={a.x} y={a.y} width={bw} height={bh} rx="8" class={`aatm-box aatm-${a.cls}`} />
        <text x={a.x + bw / 2} y={a.y + 23} class={`aatm-label aatm-t-${a.cls}`} font-size="14" text-anchor="middle" font-weight="bold">{a.label}</text>
        <text x={a.x + bw / 2} y={a.y + 41} class="aatm-sub" font-size="10.5" text-anchor="middle">{a.sub}</text>
      </g>
    ))}

    <text x={w / 2} y={h - 26} class="aatm-foot" font-size="10.5" text-anchor="middle">
      Each step adds one rule and asks what still has to be true
    </text>
    <text x={w / 2} y={h - 9} class="aatm-sub" font-size="10" text-anchor="middle">
      The subject is not about numbers; it is about the rules numbers happen to obey
    </text>

    <defs>
      <marker id="aatm-head" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="aatm-head-fill" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .aatm { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .aatm svg { width:100%; max-width:100%; height:auto; }
  .aatm-box { fill:none; stroke-width:2; }
  .aatm-green { stroke:#7ee787; }
  .aatm-blue { stroke:#58a6ff; }
  .aatm-purple { stroke:#d2a8ff; }
  .aatm-orange { stroke:#f0883e; }
  .aatm-pink { stroke:#ff7b72; }
  .aatm-label { font-family:'Libre Baskerville',Georgia,serif; }
  .aatm-t-green { fill:#7ee787; }
  .aatm-t-blue { fill:#58a6ff; }
  .aatm-t-purple { fill:#d2a8ff; }
  .aatm-t-orange { fill:#f0883e; }
  .aatm-t-pink { fill:#ff7b72; }
  .aatm-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .aatm-link { stroke:#888; stroke-width:1.5; }
  .aatm-head-fill { fill:#888; }
  .aatm-foot { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .aatm-green { stroke:#116329; }
  :global([data-theme="light"]) .aatm-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .aatm-purple { stroke:#6639ba; }
  :global([data-theme="light"]) .aatm-orange { stroke:#b35900; }
  :global([data-theme="light"]) .aatm-pink { stroke:#a40e26; }
  :global([data-theme="light"]) .aatm-t-green { fill:#116329; }
  :global([data-theme="light"]) .aatm-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .aatm-t-purple { fill:#6639ba; }
  :global([data-theme="light"]) .aatm-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .aatm-t-pink { fill:#a40e26; }
  :global([data-theme="light"]) :is(.aatm-sub, .aatm-foot) { fill:#57606a; }
  :global([data-theme="light"]) .aatm-link { stroke:#555; }
  :global([data-theme="light"]) .aatm-head-fill { fill:#555; }
</style>
