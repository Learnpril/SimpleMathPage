---
/**
 * ResidueSum - a contour enclosing some poles but not others. The residues are
 * computed from the analytic formula, the contour integral is computed
 * numerically along the drawn circle, and the two are compared, so the figure
 * verifies the residue theorem rather than restating it.
 */
const w = 540;
const h = 306;

const ox = 152;
const oy = 156;
const unit = 30;
const px = (re: number) => ox + re * unit;
const py = (im: number) => oy - im * unit;

type C = { re: number; im: number };
const mul = (a: C, b: C): C => ({ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re });
const inv = (a: C): C => {
  const d = a.re * a.re + a.im * a.im;
  return { re: a.re / d, im: -a.im / d };
};
const sub = (a: C, b: C): C => ({ re: a.re - b.re, im: a.im - b.im });

/** f(z) = 1 / ((z − 1)(z + 1)(z − 4)), simple poles at 1, −1 and 4. */
const poleList = [
  { p: { re: 1, im: 0 }, name: "1" },
  { p: { re: -1, im: 0 }, name: "−1" },
  { p: { re: 4, im: 0 }, name: "4" },
];
const f = (z: C): C =>
  inv(mul(mul(sub(z, poleList[0].p), sub(z, poleList[1].p)), sub(z, poleList[2].p)));

/** For a simple pole at p, Res = 1 / Π_{q ≠ p}(p − q). */
function residueAt(idx: number) {
  let acc: C = { re: 1, im: 0 };
  poleList.forEach((q, j) => {
    if (j !== idx) acc = mul(acc, sub(poleList[idx].p, q.p));
  });
  return inv(acc);
}

const R = 2.4; // contour radius: encloses 1 and −1, excludes 4
const enclosed = poleList.map((q, j) => ({
  ...q,
  idx: j,
  inside: Math.hypot(q.p.re, q.p.im) < R,
  res: residueAt(j),
}));

const sumRes = enclosed
  .filter((q) => q.inside)
  .reduce((s, q) => ({ re: s.re + q.res.re, im: s.im + q.res.im }), { re: 0, im: 0 });
const predicted: C = mul({ re: 0, im: 2 * Math.PI }, sumRes);

/** Numerical ∮ f dz around |z| = R. */
function loopIntegral(n = 60000): C {
  let sre = 0;
  let sim = 0;
  for (let k = 0; k < n; k++) {
    const t = (2 * Math.PI * k) / n;
    const t2 = (2 * Math.PI * (k + 1)) / n;
    const a: C = { re: R * Math.cos(t), im: R * Math.sin(t) };
    const b: C = { re: R * Math.cos(t2), im: R * Math.sin(t2) };
    const mid: C = { re: (a.re + b.re) / 2, im: (a.im + b.im) / 2 };
    const term = mul(f(mid), sub(b, a));
    sre += term.re;
    sim += term.im;
  }
  return { re: sre, im: sim };
}
const measured = loopIntegral();
const agree = Math.hypot(measured.re - predicted.re, measured.im - predicted.im);

const fr = (v: number) => {
  const x = Math.abs(v) < 1e-6 ? 0 : v;
  return x.toFixed(4).replace("-", "−");
};
const fc = (v: C) => `${fr(v.re)} ${v.im < 0 ? "−" : "+"} ${Math.abs(v.im).toFixed(4)}i`;
---

<figure
  class="rsm"
  role="img"
  aria-label={`A circle of radius ${R} encloses the poles at 1 and −1 but not the one at 4. The residues at the enclosed poles sum to ${fr(sumRes.re)}, so 2πi times that sum is ${fc(predicted)}, and integrating numerically around the circle gives ${fc(measured)}.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="rsm-head" font-size="12.5" font-weight="bold">Only the poles you enclose contribute</text>
    <text x="16" y="38" class="rsm-sub" font-size="10.5">f(z) = 1 ⁄ ((z − 1)(z + 1)(z − 4)) around the circle |z| = 2.4</text>

    <line x1="296" y1="52" x2="296" y2="248" class="rsm-divide" />

    {/* ---------- the picture ---------- */}
    <line x1={px(-1.9)} y1={oy} x2={px(4.6)} y2={oy} class="rsm-axis" />
    <line x1={ox} y1={py(2.9)} x2={ox} y2={py(-2.9)} class="rsm-axis" />
    <circle cx={ox} cy={oy} r={R * unit} class="rsm-contour" />

    {enclosed.map((q) => (
      <g>
        <line x1={px(q.p.re) - 5} y1={py(q.p.im) - 5} x2={px(q.p.re) + 5} y2={py(q.p.im) + 5} class={`rsm-pole rsm-${q.inside ? "in" : "out"}`} />
        <line x1={px(q.p.re) - 5} y1={py(q.p.im) + 5} x2={px(q.p.re) + 5} y2={py(q.p.im) - 5} class={`rsm-pole rsm-${q.inside ? "in" : "out"}`} />
      </g>
    ))}
    <text x={px(1)} y={py(0) - 14} class="rsm-in-lbl" font-size="9.5" text-anchor="middle">1</text>
    <text x={px(-1)} y={py(0) - 14} class="rsm-in-lbl" font-size="9.5" text-anchor="middle">−1</text>
    <text x={px(4)} y={py(0) - 14} class="rsm-out-lbl" font-size="9.5" text-anchor="middle">4</text>

    {/* ---------- the arithmetic ---------- */}
    <text x="312" y="70" class="rsm-panel" font-size="10" text-anchor="start">residues at the enclosed poles</text>
    {enclosed.filter((q) => q.inside).map((q, i) => (
      <text x="312" y={92 + i * 18} class="rsm-row" font-size="9.5" text-anchor="start">
        {`Res at ${q.name}:   ${fr(q.res.re)}`}
      </text>
    ))}
    <text x="312" y="150" class="rsm-in-lbl" font-size="9.5" text-anchor="start">{`sum of residues:  ${fr(sumRes.re)}`}</text>
    <text x="312" y="170" class="rsm-out-lbl" font-size="9.5" text-anchor="start">{`pole at 4 excluded (Res ${fr(enclosed[2].res.re)})`}</text>

    <text x="312" y="198" class="rsm-panel" font-size="10" text-anchor="start">2πi × sum, and the integral</text>
    <text x="312" y="218" class="rsm-row" font-size="9.5" text-anchor="start">{`predicted:  ${fc(predicted)}`}</text>
    <text x="312" y="236" class="rsm-row" font-size="9.5" text-anchor="start">{`measured:   ${fc(measured)}`}</text>

    <text x={w / 2} y="270" class="rsm-foot" font-size="10.5" text-anchor="middle">
      {`∮_C f dz = 2πi Σ Res, agreeing here to ${agree.toExponential(1)}`}
    </text>
    <text x={w / 2} y="290" class="rsm-sub2" font-size="9.5" text-anchor="middle">
      The pole at 4 lies outside the contour and contributes nothing at all
    </text>
  </svg>
</figure>

<style>
  .rsm { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .rsm svg { width:100%; max-width:100%; height:auto; }
  .rsm-axis { stroke:#888; stroke-width:1.3; }
  .rsm-divide { stroke:#3a3a3a; stroke-width:1; }
  .rsm-contour { fill:#58a6ff; fill-opacity:0.08; stroke:#58a6ff; stroke-width:2; }
  .rsm-pole { stroke-width:2.4; }
  .rsm-in { stroke:#7ee787; }
  .rsm-out { stroke:#ff7b72; }
  .rsm-in-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .rsm-out-lbl { fill:#ff7b72; font-family:'Libre Baskerville',Georgia,serif; }
  .rsm-row { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .rsm-panel, .rsm-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .rsm-sub, .rsm-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .rsm-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .rsm-axis { stroke:#666; }
  :global([data-theme="light"]) .rsm-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .rsm-contour { stroke:#0550ae; fill:#0550ae; fill-opacity:0.07; }
  :global([data-theme="light"]) .rsm-foot { fill:#0550ae; }
  :global([data-theme="light"]) .rsm-in { stroke:#116329; }
  :global([data-theme="light"]) .rsm-in-lbl { fill:#116329; }
  :global([data-theme="light"]) .rsm-out { stroke:#a40e26; }
  :global([data-theme="light"]) .rsm-out-lbl { fill:#a40e26; }
  :global([data-theme="light"]) .rsm-panel, :global([data-theme="light"]) .rsm-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.rsm-row, .rsm-sub, .rsm-sub2) { fill:#57606a; }
</style>
