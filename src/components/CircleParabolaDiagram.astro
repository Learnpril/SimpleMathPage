---
/**
 * CircleParabolaDiagram - two panels side by side:
 * Left: circle (x-3)²+(y+2)²=25, center (3,-2), r=5
 * Right: parabola y=2(x-4)²+1, vertex (4,1)
 */
const pw = 200; const ph = 200; const gap = 20;
const totalW = pw * 2 + gap + 20;
const totalH = ph + 30;

// Left panel: circle, range -3 to 9 x, -8 to 4 y
const lx = 10; const ly = 10;
const lxLo = -3; const lxHi = 9; const lyLo = -8; const lyHi = 4;
function lX(v: number) { return lx + ((v - lxLo) / (lxHi - lxLo)) * pw; }
function lY(v: number) { return ly + ((lyHi - v) / (lyHi - lyLo)) * ph; }

const cirPts: string[] = [];
for (let a = 0; a <= 360; a += 2) {
  const x = 3 + 5 * Math.cos(a * Math.PI / 180);
  const y = -2 + 5 * Math.sin(a * Math.PI / 180);
  cirPts.push(`${a === 0 ? 'M' : 'L'}${lX(x).toFixed(1)},${lY(y).toFixed(1)}`);
}

// Right panel: parabola y=2(x-4)²+1, range 1 to 7 x, -1 to 20 y
const rx = lx + pw + gap; const ry = 10;
const rxLo = 1; const rxHi = 7; const ryLo = -1; const ryHi = 20;
function rX(v: number) { return rx + ((v - rxLo) / (rxHi - rxLo)) * pw; }
function rY(v: number) { return ry + ((ryHi - v) / (ryHi - ryLo)) * ph; }

const parPts: string[] = [];
for (let x = 1.5; x <= 6.5; x += 0.05) {
  const y = 2 * (x - 4) * (x - 4) + 1;
  if (y <= 20) parPts.push(`${parPts.length === 0 ? 'M' : 'L'}${rX(x).toFixed(1)},${rY(y).toFixed(1)}`);
}

const lAxY = lY(0); const lAxX = lX(0);
const rAxY = rY(0); const rAxX = rX(0);
---

<figure class="cpd-diagram" role="img" aria-label="Circle with center (3,−2) and radius 5, and parabola y=2(x−4)²+1">
  <figcaption class="cpd-title">Circle and parabola from the worked examples</figcaption>
  <svg viewBox={`0 0 ${totalW} ${totalH}`} width={totalW} height={totalH} xmlns="http://www.w3.org/2000/svg">
    <rect class="cpd-bg" x="0" y="0" width={totalW} height={totalH} rx="8" />

    {/* Left: Circle */}
    <line class="cpd-axis" x1={lx} y1={lAxY} x2={lx + pw} y2={lAxY} stroke-width="0.8" />
    <line class="cpd-axis" x1={lAxX} y1={ly} x2={lAxX} y2={ly + ph} stroke-width="0.8" />
    <path class="cpd-circle" d={cirPts.join(' ') + ' Z'} fill="none" stroke-width="2.5" />
    {/* Center dot */}
    <circle class="cpd-center" cx={lX(3)} cy={lY(-2)} r="4" />
    <text class="cpd-center-label" x={lX(3) + 8} y={lY(-2) + 16} font-size="11" font-weight="bold">(3, −2)</text>
    {/* Radius line */}
    <line class="cpd-radius" x1={lX(3)} y1={lY(-2)} x2={lX(8)} y2={lY(-2)} stroke-width="1.5" stroke-dasharray="4,3" />
    <text class="cpd-radius-label" x={lX(5.5)} y={lY(-2) - 8} font-size="10" text-anchor="middle">r = 5</text>
    {/* Label */}
    <text class="cpd-eq" x={lx + pw / 2} y={ly + ph + 18} font-size="10" text-anchor="middle" font-weight="bold">(x − 3)² + (y + 2)² = 25</text>

    {/* Right: Parabola */}
    <line class="cpd-axis" x1={rx} y1={rAxY} x2={rx + pw} y2={rAxY} stroke-width="0.8" />
    <line class="cpd-axis" x1={rAxX} y1={ry} x2={rAxX} y2={ry + ph} stroke-width="0.8" />
    <path class="cpd-parabola" d={parPts.join(' ')} fill="none" stroke-width="2.5" />
    {/* Vertex dot */}
    <circle class="cpd-vertex" cx={rX(4)} cy={rY(1)} r="4" />
    <text class="cpd-vertex-label" x={rX(4) + 10} y={rY(1) + 16} font-size="11" font-weight="bold">(4, 1)</text>
    {/* Axis of symmetry */}
    <line class="cpd-sym" x1={rX(4)} y1={ry} x2={rX(4)} y2={ry + ph} stroke-width="1" stroke-dasharray="4,3" />
    {/* Label */}
    <text class="cpd-eq cpd-eq-par" x={rx + pw / 2} y={ry + ph + 18} font-size="10" text-anchor="middle" font-weight="bold">y = 2(x − 4)² + 1</text>

  </svg>
</figure>

<style>
  .cpd-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .cpd-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .cpd-diagram svg { max-width: 100%; height: auto; }
  .cpd-bg { fill: var(--sl-color-bg, #121212); }
  .cpd-axis { stroke: #555; }
  .cpd-circle { stroke: #58a6ff; }
  .cpd-center { fill: #f0c674; stroke: #fff; stroke-width: 1.5; }
  .cpd-center-label { fill: #f0c674; font-family: 'Libre Baskerville', Georgia, serif; }
  .cpd-radius { stroke: #7ee787; }
  .cpd-radius-label { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }
  .cpd-parabola { stroke: #f78166; }
  .cpd-vertex { fill: #f0c674; stroke: #fff; stroke-width: 1.5; }
  .cpd-vertex-label { fill: #f0c674; font-family: 'Libre Baskerville', Georgia, serif; }
  .cpd-sym { stroke: #666; }
  .cpd-eq { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .cpd-eq-par { fill: #f78166; }

  :global([data-theme="light"]) .cpd-bg { fill: #f8f9fa; }
  :global([data-theme="light"]) .cpd-axis { stroke: #aaa; }
  :global([data-theme="light"]) .cpd-circle { stroke: #0550ae; }
  :global([data-theme="light"]) .cpd-center { fill: #b45309; stroke: #fff; }
  :global([data-theme="light"]) .cpd-center-label { fill: #b45309; }
  :global([data-theme="light"]) .cpd-radius { stroke: #116329; }
  :global([data-theme="light"]) .cpd-radius-label { fill: #116329; }
  :global([data-theme="light"]) .cpd-parabola { stroke: #cf222e; }
  :global([data-theme="light"]) .cpd-vertex { fill: #b45309; stroke: #fff; }
  :global([data-theme="light"]) .cpd-vertex-label { fill: #b45309; }
  :global([data-theme="light"]) .cpd-sym { stroke: #999; }
  :global([data-theme="light"]) .cpd-eq { fill: #0550ae; }
  :global([data-theme="light"]) .cpd-eq-par { fill: #cf222e; }
</style>
