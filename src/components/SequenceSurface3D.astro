---
/**
 * SequenceSurface3D — the sequence fₙ(x) = xⁿ on [0,1] drawn as a surface over
 * the (x, n) plane. Every slice at fixed n is one function; every slice at fixed
 * x < 1 is a sequence sliding down to 0. The cliff along x = 1 never softens,
 * which is uniform convergence failing, visible as geometry.
 */
---

<figure
  class="ss3"
  role="img"
  aria-label="Interactive 3D surface of x to the power n over x between 0 and 1 and n from 1 to 20. Slices at fixed n are the individual functions, sliding toward zero as n grows, while a permanent cliff remains at x equals 1 where every function still takes the value 1."
>
  <div class="ss3-canvas" data-ss3d></div>
  <div class="ss3-hint">Drag to rotate · Scroll/Pinch to zoom</div>
  <figcaption class="ss3-cap">
    The surface is <strong>z = xⁿ</strong> over x in [0, 1] and n from 1 to 20.
    Follow a line of constant <em>x</em> below 1 and the height falls to zero:
    that is pointwise convergence. But the edge at <em>x</em> = 1 stays pinned at
    height 1 for every n, so the <strong>supremum distance never shrinks</strong>
    and the convergence is not uniform.
  </figcaption>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  const N_MAX = 20;

  function initScene(container: HTMLElement) {
    const width = Math.min(container.clientWidth, 480);
    const height = 360;
    const isDark = document.documentElement.dataset.theme !== "light";

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(isDark ? 0x121212 : 0xf8f9fa);

    const camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 200);
    camera.position.set(3.4, 2.6, 3.6);
    camera.lookAt(0, 0.4, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const group = new THREE.Group();
    scene.add(group);

    // Plane in the XZ sense: u ↦ x ∈ [0,1], v ↦ n ∈ [1, N_MAX], height = xⁿ
    const segs = 90;
    const geo = new THREE.PlaneGeometry(2, 2, segs, segs);
    const pos = geo.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      const u = (pos.getX(i) + 1) / 2; // 0..1
      const v = (pos.getY(i) + 1) / 2; // 0..1
      const x = u;
      const n = 1 + v * (N_MAX - 1);
      pos.setZ(i, Math.pow(x, n) * 1.4);
    }
    geo.computeVertexNormals();
    geo.rotateX(-Math.PI / 2);

    const surface = new THREE.Mesh(
      geo,
      new THREE.MeshPhongMaterial({
        color: isDark ? 0x58a6ff : 0x0550ae,
        shininess: 18,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.9,
      }),
    );
    group.add(surface);

    const wire = new THREE.Mesh(
      geo.clone(),
      new THREE.MeshBasicMaterial({
        color: isDark ? 0x0d1117 : 0xffffff,
        wireframe: true,
        transparent: true,
        opacity: 0.18,
      }),
    );
    group.add(wire);

    /** A single slice fₙ, drawn as a curve lying on the surface. */
    function slice(n: number, colour: number) {
      const pts: THREE.Vector3[] = [];
      for (let k = 0; k <= 120; k++) {
        const x = k / 120;
        const v = (n - 1) / (N_MAX - 1);
        pts.push(new THREE.Vector3(x * 2 - 1, Math.pow(x, n) * 1.4 + 0.012, -(v * 2 - 1)));
      }
      return new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(pts),
        new THREE.LineBasicMaterial({ color: colour, linewidth: 2 }),
      );
    }
    const sliceColours = isDark
      ? [0x7ee787, 0xf0883e, 0xd2a8ff]
      : [0x116329, 0xb35900, 0x6639ba];
    [1, 4, N_MAX].forEach((n, i) => group.add(slice(n, sliceColours[i])));

    // The cliff at x = 1: every fₙ passes through height 1 there
    const cliff: THREE.Vector3[] = [];
    for (let k = 0; k <= 40; k++) {
      cliff.push(new THREE.Vector3(1, 1.4 + 0.012, -((k / 40) * 2 - 1)));
    }
    group.add(
      new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(cliff),
        new THREE.LineBasicMaterial({ color: isDark ? 0xff7b72 : 0xa40e26 }),
      ),
    );

    // The limit function: zero on [0,1), drawn along the far edge for reference
    const base = new THREE.GridHelper(2, 8, isDark ? 0x444444 : 0xcccccc, isDark ? 0x2a2a2a : 0xe4e4e4);
    base.position.y = 0;
    group.add(base);

    scene.add(new THREE.AmbientLight(0xffffff, 0.8));
    const dl = new THREE.DirectionalLight(0xffffff, 0.55);
    dl.position.set(3, 6, 4);
    scene.add(dl);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.target.set(0, 0.4, 0);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.minDistance = 2.6;
    controls.maxDistance = 12;

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    return () => {
      cancelAnimationFrame(animId);
      renderer.dispose();
    };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-ss3d]").forEach((el) => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            obs.disconnect();
            initScene(el);
          }
        },
        { threshold: 0.05 },
      );
      obs.observe(el);
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .ss3 { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ss3-canvas { width:100%; max-width:480px; min-height:360px; border-radius:8px; overflow:hidden; }
  .ss3-canvas canvas { border-radius:8px; }
  .ss3-hint { font-family:'Libre Baskerville',Georgia,serif; font-size:0.8rem; color:#9198a1; margin-top:0.4rem; }
  .ss3-cap {
    font-family:'Libre Baskerville',Georgia,serif; font-size:0.85rem; color:#9198a1;
    font-style:italic; text-align:center; max-width:460px; margin-top:0.5rem; line-height:1.5;
  }
  :global([data-theme="light"]) .ss3-hint, :global([data-theme="light"]) .ss3-cap { color:#57606a; }
</style>
