---
/**
 * EVTDiagram - a continuous function on a closed bounded interval attains its
 * extremes; on an open interval it need not.
 *
 * The maximum and minimum on the left are found by scanning the samples, so the
 * marked points are the real extremes of the plotted function.
 */
const w = 540;
const h = 306;
const bottom = 230;
const top = 70;
const samples = 400;

const f = (x: number) => 0.8 * Math.sin(3.2 * x) + 0.15 * x;
const xHi = 2;
const pts = Array.from({ length: samples + 1 }, (_, i) => {
  const x = (i / samples) * xHi;
  return { x, y: f(x) };
});
const maxPt = pts.reduce((best, p) => (p.y > best.y ? p : best), pts[0]);
const minPt = pts.reduce((best, p) => (p.y < best.y ? p : best), pts[0]);

const left = { l: 50, r: 250 };
const rightP = { l: 310, r: 510 };
const pxL = (x: number) => left.l + (x / xHi) * (left.r - left.l);
const pyL = (v: number) => bottom - ((v + 1.0) / 2.1) * (bottom - top);
const pxR = (t: number) => rightP.l + t * (rightP.r - rightP.l);
const pyR = (v: number) => bottom - v * 150;

const curve = pts.map((p) => `${pxL(p.x).toFixed(1)},${pyL(p.y).toFixed(1)}`).join(" ");
const labelY = 252;
---

<figure
  class="evt"
  role="img"
  aria-label={`Two panels. On a closed interval a continuous function attains its maximum of about ${maxPt.y.toFixed(3)} and its minimum of about ${minPt.y.toFixed(3)} at interior points. On an open interval the function f of x equals x approaches 0 and 1 without ever reaching either, so it has no maximum or minimum.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="evt-head" font-size="12.5" font-weight="bold">Closed and bounded is what makes the extremes attainable</text>

    <text x={(left.l + left.r) / 2} y="54" class="evt-title" font-size="10.5" text-anchor="middle" font-weight="bold">on [a, b]: attained</text>
    <text x={(rightP.l + rightP.r) / 2} y="54" class="evt-title" font-size="10.5" text-anchor="middle" font-weight="bold">on (a, b): not attained</text>

    {/* ---------- Closed interval ---------- */}
    <line x1={left.l} y1={bottom} x2={left.r + 8} y2={bottom} class="evt-axis" />
    <line x1={left.l} y1={top - 4} x2={left.l} y2={bottom} class="evt-axis" />
    <line x1={left.l} y1={pyL(maxPt.y)} x2={left.r} y2={pyL(maxPt.y)} class="evt-level evt-lv-green" />
    <line x1={left.l} y1={pyL(minPt.y)} x2={left.r} y2={pyL(minPt.y)} class="evt-level evt-lv-orange" />
    <polyline points={curve} class="evt-curve" fill="none" />
    <circle cx={pxL(maxPt.x)} cy={pyL(maxPt.y)} r="4.4" class="evt-max" />
    <circle cx={pxL(minPt.x)} cy={pyL(minPt.y)} r="4.4" class="evt-min" />

    {/* ---------- Open interval ---------- */}
    <line x1={rightP.l} y1={bottom} x2={rightP.r + 8} y2={bottom} class="evt-axis" />
    <line x1={rightP.l} y1={top - 4} x2={rightP.l} y2={bottom} class="evt-axis" />
    <line x1={pxR(0)} y1={pyR(0)} x2={pxR(1)} y2={pyR(1)} class="evt-curve evt-c-orange" />
    <circle cx={pxR(0)} cy={pyR(0)} r="4.4" class="evt-hole" />
    <circle cx={pxR(1)} cy={pyR(1)} r="4.4" class="evt-hole" />

    {/* Annotations below the axis, clear of every curve */}
    <text x={pxL(maxPt.x)} y={labelY} class="evt-lbl evt-t-green" font-size="9.5" text-anchor="middle">max</text>
    <text x={pxL(minPt.x)} y={labelY} class="evt-lbl evt-t-orange" font-size="9.5" text-anchor="middle">min</text>
    <text x={pxR(0)} y={labelY} class="evt-lbl evt-t-grey" font-size="9.5" text-anchor="middle">no min</text>
    <text x={pxR(1)} y={labelY} class="evt-lbl evt-t-grey" font-size="9.5" text-anchor="middle">no max</text>

    <text x={w / 2} y="274" class="evt-foot" font-size="10.5" text-anchor="middle">
      {`Continuous on a closed bounded interval: max ≈ ${maxPt.y.toFixed(3)}, min ≈ ${minPt.y.toFixed(3)}, both reached`}
    </text>
    <text x={w / 2} y="292" class="evt-sub" font-size="9.5" text-anchor="middle">
      On (0, 1) the values 0 and 1 are approached and never reached, so neither is attained
    </text>
  </svg>
</figure>

<style>
  .evt { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .evt svg { width:100%; max-width:100%; height:auto; }
  .evt-axis { stroke:#888; stroke-width:1.3; }
  .evt-level { stroke-width:1.2; stroke-dasharray:4,3; }
  .evt-lv-green { stroke:#7ee787; }
  .evt-lv-orange { stroke:#f0883e; }
  .evt-curve { stroke:#58a6ff; stroke-width:2.2; }
  .evt-c-orange { stroke:#f0883e; }
  .evt-max { fill:#7ee787; stroke:#eee; stroke-width:1.2; }
  .evt-min { fill:#f0883e; stroke:#eee; stroke-width:1.2; }
  .evt-hole { fill:#0d1117; stroke:#f0883e; stroke-width:2.2; }
  .evt-title { fill:#c9d1d9; font-family:'Libre Baskerville',Georgia,serif; }
  .evt-lbl { font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .evt-t-green { fill:#7ee787; }
  .evt-t-orange { fill:#f0883e; }
  .evt-t-grey { fill:#9198a1; }
  .evt-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .evt-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .evt-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .evt-axis { stroke:#666; }
  :global([data-theme="light"]) .evt-lv-green, :global([data-theme="light"]) .evt-t-green { stroke:#116329; fill:#116329; }
  :global([data-theme="light"]) .evt-max { fill:#116329; stroke:#fff; }
  :global([data-theme="light"]) .evt-lv-orange, :global([data-theme="light"]) .evt-c-orange, :global([data-theme="light"]) .evt-t-orange { stroke:#b35900; fill:#b35900; }
  :global([data-theme="light"]) .evt-c-orange { fill:none; }
  :global([data-theme="light"]) .evt-min { fill:#b35900; stroke:#fff; }
  :global([data-theme="light"]) .evt-hole { fill:#ffffff; stroke:#b35900; }
  :global([data-theme="light"]) .evt-curve, :global([data-theme="light"]) .evt-foot { stroke:#0550ae; fill:#0550ae; }
  :global([data-theme="light"]) .evt-curve { fill:none; }
  :global([data-theme="light"]) .evt-title { fill:#24292f; }
  :global([data-theme="light"]) :is(.evt-sub, .evt-t-grey) { fill:#57606a; }
  :global([data-theme="light"]) .evt-head { fill:#24292f; }
</style>
