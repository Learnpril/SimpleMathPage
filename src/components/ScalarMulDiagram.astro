---
/**
 * ScalarMulDiagram - shows scalar multiplication of a matrix
 * 3 × [[1,2],[3,4]] = [[3,6],[9,12]]
 */
---
<div class="diagram-container">
<svg viewBox="-10 -10 400 170" width="100%" style="max-width:420px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Scalar multiplication: 3 times a matrix">

  {/* Scalar */}
  <text x="18" y="60" fill="#f0883e" font-size="26" font-family="serif" font-weight="bold" class="sm-orange">3</text>

  {/* Times */}
  <text x="42" y="60" fill="#888" font-size="22" font-family="serif">×</text>

  {/* Matrix */}
  <rect x="62" y="18" width="90" height="80" rx="5" fill="none" stroke="#58a6ff" stroke-width="1.8" class="sm-blue-stroke" />
  <text x="82" y="52" fill="#58a6ff" font-size="20" font-family="serif" font-weight="bold" class="sm-blue">1</text>
  <text x="124" y="52" fill="#7ee787" font-size="20" font-family="serif" font-weight="bold" class="sm-green">2</text>
  <text x="82" y="86" fill="#d2a8ff" font-size="20" font-family="serif" font-weight="bold" class="sm-purple">3</text>
  <text x="124" y="86" fill="#f0883e" font-size="20" font-family="serif" font-weight="bold" class="sm-orange">4</text>

  {/* Equals */}
  <text x="170" y="64" fill="#888" font-size="22" font-family="serif">=</text>

  {/* Result */}
  <rect x="195" y="18" width="100" height="80" rx="5" fill="none" stroke="#888" stroke-width="1.8" />
  <text x="216" y="52" fill="#58a6ff" font-size="20" font-family="serif" font-weight="bold" class="sm-blue">3</text>
  <text x="264" y="52" fill="#7ee787" font-size="20" font-family="serif" font-weight="bold" class="sm-green">6</text>
  <text x="216" y="86" fill="#d2a8ff" font-size="20" font-family="serif" font-weight="bold" class="sm-purple">9</text>
  <text x="258" y="86" fill="#f0883e" font-size="20" font-family="serif" font-weight="bold" class="sm-orange">12</text>

  {/* Annotations showing the multiplication */}
  <text x="310" y="46" fill="#888" font-size="11" font-family="serif">3 × 1 = 3</text>
  <text x="310" y="62" fill="#888" font-size="11" font-family="serif">3 × 2 = 6</text>
  <text x="310" y="80" fill="#888" font-size="11" font-family="serif">3 × 3 = 9</text>
  <text x="310" y="96" fill="#888" font-size="11" font-family="serif">3 × 4 = 12</text>

  {/* Legend */}
  <g transform="translate(10, 115)">
    <text x="0" y="12" fill="#888" font-size="11" font-family="serif">Every entry is multiplied by the scalar (<tspan fill="#f0883e" font-weight="bold" class="sm-orange">3</tspan>)</text>
  </g>
</svg>
</div>

<style>
  .sm-blue { fill: #58a6ff; }
  .sm-green { fill: #7ee787; }
  .sm-purple { fill: #d2a8ff; }
  .sm-orange { fill: #f0883e; }
  .sm-blue-stroke { stroke: #58a6ff; }

  :global([data-theme="light"]) .sm-blue { fill: #0550ae; }
  :global([data-theme="light"]) .sm-green { fill: #1a7f2e; }
  :global([data-theme="light"]) .sm-purple { fill: #6b3fa0; }
  :global([data-theme="light"]) .sm-orange { fill: #c05010; }
  :global([data-theme="light"]) .sm-blue-stroke { stroke: #0550ae; }
  :global([data-theme="light"]) svg text[fill="#888"] { fill: #555; }
  :global([data-theme="light"]) svg rect[stroke="#888"] { stroke: #999; }
</style>
