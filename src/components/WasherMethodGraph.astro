---
/**
 * WasherMethodGraph — y = x and y = x² from 0 to 1, showing outer/inner radii.
 * Shows a sample washer cross-section at x = 0.6 with outer and inner radius lines.
 */
const w = 380;
const h = 300;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -0.2, xMax = 1.3, yMin = -0.1, yMax = 1.3;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// y = x line
const linePts: string[] = [];
for (let i = 0; i <= 60; i++) {
  const x = xMin + i * (xMax - xMin) / 60;
  linePts.push(`${sx(x)},${sy(x)}`);
}

// y = x² parabola
const parPts: string[] = [];
for (let i = 0; i <= 80; i++) {
  const x = xMin + i * (xMax - xMin) / 80;
  const y = x * x;
  if (y <= yMax) parPts.push(`${sx(x)},${sy(y)}`);
}

// Shaded region between x and x² from 0 to 1
const shadePts: string[] = [];
for (let i = 0; i <= 40; i++) {
  const x = i / 40;
  shadePts.push(`${sx(x)},${sy(x)}`);
}
for (let i = 40; i >= 0; i--) {
  const x = i / 40;
  shadePts.push(`${sx(x)},${sy(x * x)}`);
}

// Sample washer at x = 0.6
const wx = 0.6;
const outerR = wx;
const innerR = wx * wx;
---

<figure class="wsg" role="img" aria-label="Washer method: region between y equals x and y equals x squared from 0 to 1, with outer and inner radius lines at x equals 0.6">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[0.5, 1].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="wsg-grid" stroke-width="0.5" />
    ))}
    {[0.5, 1].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="wsg-grid" stroke-width="0.5" />
    ))}

    {/* Axes */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="wsg-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="wsg-axis" stroke-width="1.2" />

    {/* Shaded region */}
    <polygon points={shadePts.join(' ')} class="wsg-shade" />

    {/* Curves */}
    <polyline points={linePts.join(' ')} fill="none" class="wsg-line" stroke-width="2.5" />
    <polyline points={parPts.join(' ')} fill="none" class="wsg-par" stroke-width="2.5" />

    {/* Outer radius line (from x-axis to y = x) */}
    <line x1={sx(wx)} y1={sy(0)} x2={sx(wx)} y2={sy(outerR)} class="wsg-outer" stroke-width="2.5" stroke-dasharray="6,3" />
    <circle cx={sx(wx)} cy={sy(outerR)} r="3.5" class="wsg-dot-outer" />

    {/* Inner radius line (from x-axis to y = x²) */}
    <line x1={sx(wx)} y1={sy(0)} x2={sx(wx)} y2={sy(innerR)} class="wsg-inner" stroke-width="2.5" stroke-dasharray="4,4" />
    <circle cx={sx(wx)} cy={sy(innerR)} r="3.5" class="wsg-dot-inner" />

    {/* Intersection dots */}
    <circle cx={sx(0)} cy={sy(0)} r="3.5" class="wsg-dot-int" />
    <circle cx={sx(1)} cy={sy(1)} r="3.5" class="wsg-dot-int" />

    {/* Tick labels */}
    <text class="wsg-tick" x={sx(0.5)} y={sy(0)+16} font-size="10" text-anchor="middle">0.5</text>
    <text class="wsg-tick" x={sx(1)} y={sy(0)+16} font-size="10" text-anchor="middle">1</text>
    <text class="wsg-tick" x={sx(0)-6} y={sy(0.5)+4} font-size="10" text-anchor="end">0.5</text>
    <text class="wsg-tick" x={sx(0)-6} y={sy(1)+4} font-size="10" text-anchor="end">1</text>
  </svg>
  <div class="wsg-legend">
    <span class="wsg-leg"><span class="wsg-sw wsg-sw-line"></span> y = x (outer)</span>
    <span class="wsg-leg"><span class="wsg-sw wsg-sw-par"></span> y = x² (inner)</span>
    <span class="wsg-leg"><span class="wsg-sw wsg-sw-outer"></span> outer radius</span>
    <span class="wsg-leg"><span class="wsg-sw wsg-sw-inner"></span> inner radius</span>
    <span class="wsg-leg"><span class="wsg-sw wsg-sw-shade"></span> washer region</span>
  </div>
</figure>

<style>
  .wsg { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .wsg svg { max-width:100%; height:auto; }
  .wsg-grid { stroke:#333; }
  .wsg-axis { stroke:#666; }
  .wsg-line { stroke:#58a6ff; }
  .wsg-par { stroke:#f0883e; }
  .wsg-shade { fill:rgba(126,231,135,0.2); stroke:none; }
  .wsg-outer { stroke:#7ee787; }
  .wsg-inner { stroke:#d2a8ff; }
  .wsg-dot-outer { fill:#7ee787; }
  .wsg-dot-inner { fill:#d2a8ff; }
  .wsg-dot-int { fill:#888; }
  .wsg-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .wsg-legend { display:flex; gap:0.75rem; flex-wrap:wrap; justify-content:center; margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.8rem; }
  .wsg-leg { display:flex; align-items:center; gap:0.35rem; }
  .wsg-sw { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .wsg-sw-line { background:#58a6ff; height:4px; }
  .wsg-sw-par { background:#f0883e; height:4px; }
  .wsg-sw-outer { background:#7ee787; height:4px; }
  .wsg-sw-inner { background:#d2a8ff; height:4px; }
  .wsg-sw-shade { background:rgba(126,231,135,0.4); }
  :global([data-theme="light"]) .wsg-grid { stroke:#ddd; }
  :global([data-theme="light"]) .wsg-axis { stroke:#999; }
  :global([data-theme="light"]) .wsg-line { stroke:#0550ae; }
  :global([data-theme="light"]) .wsg-par { stroke:#b35900; }
  :global([data-theme="light"]) .wsg-shade { fill:rgba(17,99,41,0.12); }
  :global([data-theme="light"]) .wsg-outer { stroke:#116329; }
  :global([data-theme="light"]) .wsg-inner { stroke:#6639ba; }
  :global([data-theme="light"]) .wsg-dot-outer { fill:#116329; }
  :global([data-theme="light"]) .wsg-dot-inner { fill:#6639ba; }
  :global([data-theme="light"]) .wsg-dot-int { fill:#666; }
  :global([data-theme="light"]) .wsg-tick { fill:#666; }
  :global([data-theme="light"]) .wsg-sw-line { background:#0550ae; }
  :global([data-theme="light"]) .wsg-sw-par { background:#b35900; }
  :global([data-theme="light"]) .wsg-sw-outer { background:#116329; }
  :global([data-theme="light"]) .wsg-sw-inner { background:#6639ba; }
  :global([data-theme="light"]) .wsg-sw-shade { background:rgba(17,99,41,0.25); }
</style>
