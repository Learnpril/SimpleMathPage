---
/**
 * MVTDiagram — the mean value theorem: some tangent is parallel to the secant.
 *
 * The point c is found by solving f'(c) = (f(b) − f(a))/(b − a) numerically, so
 * the tangent drawn really is parallel to the secant.
 */
const w = 540;
const h = 306;
const left = 70;
const right = 450;
const bottom = 232;
const top = 66;

const a = 0.3;
const b = 2.6;
const f = (x: number) => 0.35 * x * x * x - 1.6 * x * x + 2.1 * x + 0.4;
const df = (x: number) => 1.05 * x * x - 3.2 * x + 2.1;

const slope = (f(b) - f(a)) / (b - a);

// Bisection on df(x) − slope over the subinterval where it changes sign
function findC() {
  let lo = a;
  let hi = b;
  const g = (x: number) => df(x) - slope;
  // Walk to find a sign change, then bisect
  const steps = 400;
  for (let i = 0; i < steps; i++) {
    const x1 = a + ((b - a) * i) / steps;
    const x2 = a + ((b - a) * (i + 1)) / steps;
    if (g(x1) * g(x2) <= 0) {
      lo = x1;
      hi = x2;
      break;
    }
  }
  for (let i = 0; i < 60; i++) {
    const mid = (lo + hi) / 2;
    if (g(lo) * g(mid) <= 0) hi = mid;
    else lo = mid;
  }
  return (lo + hi) / 2;
}
const c = findC();

const xLo = 0;
const xHi = 2.9;
const yLo = 0;
const yHi = 2.4;
const px = (x: number) => left + ((x - xLo) / (xHi - xLo)) * (right - left);
const py = (y: number) => bottom - ((y - yLo) / (yHi - yLo)) * (bottom - top);

const curve = Array.from({ length: 181 }, (_, i) => {
  const x = xLo + (i / 180) * (xHi - xLo);
  return `${px(x).toFixed(1)},${py(f(x)).toFixed(1)}`;
}).join(" ");

// Tangent at c, drawn as a short segment
const tanHalf = 0.55;
const tan = [c - tanHalf, c + tanHalf].map((x) => `${px(x).toFixed(1)},${py(f(c) + slope * (x - c)).toFixed(1)}`).join(" ");
---

<figure
  class="mvt"
  role="img"
  aria-label={`A curve with a secant drawn between two points. The secant slope is about ${slope.toFixed(3)}, and at the interior point c of about ${c.toFixed(3)} the tangent has that same slope, so the tangent is parallel to the secant.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="mvt-head" font-size="12.5" font-weight="bold">Somewhere the tangent matches the average slope</text>
    <text x="16" y="40" class="mvt-sub" font-size="10.5">
      {`Secant slope over [a, b] is ${slope.toFixed(3)}, and f′(c) equals it at c ≈ ${c.toFixed(3)}`}
    </text>

    <line x1={left - 10} y1={bottom} x2={right + 6} y2={bottom} class="mvt-axis" />
    <line x1={left} y1={top - 4} x2={left} y2={bottom} class="mvt-axis" />

    <polyline points={curve} class="mvt-curve" fill="none" />

    {/* The secant, and the parallel tangent at c */}
    <line x1={px(a)} y1={py(f(a))} x2={px(b)} y2={py(f(b))} class="mvt-secant" />
    <polyline points={tan} class="mvt-tangent" fill="none" />

    {/* Vertical guides down to the axis, so labels can live below it */}
    {[a, c, b].map((x) => (
      <line x1={px(x)} y1={py(f(x))} x2={px(x)} y2={bottom} class="mvt-drop" />
    ))}

    <circle cx={px(a)} cy={py(f(a))} r="4" class="mvt-end" />
    <circle cx={px(b)} cy={py(f(b))} r="4" class="mvt-end" />
    <circle cx={px(c)} cy={py(f(c))} r="4.4" class="mvt-cdot" />

    <text x={px(a)} y="252" class="mvt-lbl" font-size="9.5" text-anchor="middle">a</text>
    <text x={px(c)} y="252" class="mvt-clbl" font-size="9.5" text-anchor="middle">{`c ≈ ${c.toFixed(2)}`}</text>
    <text x={px(b)} y="252" class="mvt-lbl" font-size="9.5" text-anchor="middle">b</text>

    <text x={w / 2} y="278" class="mvt-foot" font-size="10.5" text-anchor="middle">
      f′(c) = (f(b) − f(a)) / (b − a) for some c strictly inside (a, b)
    </text>
    <text x={w / 2} y="296" class="mvt-sub2" font-size="9.5" text-anchor="middle">
      The proof applies Rolle's theorem to the difference between f and the secant line
    </text>
  </svg>
</figure>

<style>
  .mvt { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .mvt svg { width:100%; max-width:100%; height:auto; }
  .mvt-axis { stroke:#888; stroke-width:1.3; }
  .mvt-curve { stroke:#58a6ff; stroke-width:2.2; }
  .mvt-secant { stroke:#f0883e; stroke-width:1.8; stroke-dasharray:6,4; }
  .mvt-tangent { stroke:#7ee787; stroke-width:2.4; }
  .mvt-drop { stroke:#555; stroke-width:1; stroke-dasharray:3,3; }
  .mvt-end { fill:#f0883e; stroke:#f0883e; stroke-width:1.6; }
  .mvt-cdot { fill:#7ee787; stroke:#eee; stroke-width:1.2; }
  .mvt-lbl { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .mvt-clbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .mvt-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .mvt-sub, .mvt-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .mvt-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .mvt-axis { stroke:#666; }
  :global([data-theme="light"]) .mvt-curve, :global([data-theme="light"]) .mvt-foot { stroke:#0550ae; fill:#0550ae; }
  :global([data-theme="light"]) .mvt-curve { fill:none; }
  :global([data-theme="light"]) .mvt-secant, :global([data-theme="light"]) .mvt-end { stroke:#b35900; fill:#b35900; }
  :global([data-theme="light"]) .mvt-secant { fill:none; }
  :global([data-theme="light"]) .mvt-tangent, :global([data-theme="light"]) .mvt-clbl { stroke:#116329; fill:#116329; }
  :global([data-theme="light"]) .mvt-tangent { fill:none; }
  :global([data-theme="light"]) .mvt-cdot { fill:#116329; stroke:#fff; }
  :global([data-theme="light"]) .mvt-drop { stroke:#ccc; }
  :global([data-theme="light"]) :is(.mvt-lbl, .mvt-sub, .mvt-sub2) { fill:#57606a; }
  :global([data-theme="light"]) .mvt-head { fill:#24292f; }
</style>
