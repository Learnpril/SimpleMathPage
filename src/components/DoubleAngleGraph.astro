---
/**
 * DoubleAngleGraph — shows sin(x) and sin(2x) overlaid
 * to visually demonstrate the double-angle relationship.
 */
const w = 340;
const h = 200;
const pad = 35;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 2 * Math.PI, yMin = -1.3, yMax = 1.3;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const sinPts: string[] = [];
const sin2Pts: string[] = [];
for (let x = 0; x <= 2 * Math.PI; x += 0.04) {
  sinPts.push(`${sx(x).toFixed(1)},${sy(Math.sin(x)).toFixed(1)}`);
  sin2Pts.push(`${sx(x).toFixed(1)},${sy(Math.sin(2 * x)).toFixed(1)}`);
}
---

<figure class="dag" role="img" aria-label="Graphs of sin(x) and sin(2x) showing the double-angle effect on period">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="dag-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="dag-axis" stroke-width="1" />
    {[-1, 1].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="dag-grid" stroke-width="0.5" stroke-dasharray="4,4" />
    ))}
    {/* Tick marks at pi and 2pi */}
    <text class="dag-tick" x={sx(Math.PI)} y={sy(0) + 14} font-size="10" text-anchor="middle">{'\u03C0'}</text>
    <text class="dag-tick" x={sx(2 * Math.PI)} y={sy(0) + 14} font-size="10" text-anchor="middle">2{'\u03C0'}</text>

    {/* Curves */}
    <polyline points={sinPts.join(' ')} fill="none" class="dag-sin" stroke-width="2.5" />
    <polyline points={sin2Pts.join(' ')} fill="none" class="dag-sin2" stroke-width="2.5" />

    {/* Labels */}
    <text class="dag-sin-lbl" x={sx(1.2)} y={sy(1.15)} font-size="11" font-weight="bold">sin(x)</text>
    <text class="dag-sin2-lbl" x={sx(0.4)} y={sy(-1.15)} font-size="11" font-weight="bold">sin(2x)</text>
  </svg>
</figure>

<style>
  .dag { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .dag svg { max-width:100%; height:auto; }
  .dag-axis { stroke:#666; }
  .dag-grid { stroke:#444; }
  .dag-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .dag-sin { stroke:#58a6ff; }
  .dag-sin2 { stroke:#f0883e; }
  .dag-sin-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .dag-sin2-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .dag-axis { stroke:#999; }
  :global([data-theme="light"]) .dag-grid { stroke:#ddd; }
  :global([data-theme="light"]) .dag-sin { stroke:#0969da; }
  :global([data-theme="light"]) .dag-sin2 { stroke:#d4700a; }
  :global([data-theme="light"]) .dag-sin-lbl { fill:#0969da; }
  :global([data-theme="light"]) .dag-sin2-lbl { fill:#d4700a; }
</style>
