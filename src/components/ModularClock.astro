---
/**
 * ModularClock — a 12-hour clock face as the residue classes mod 12.
 * Counting past 11 wraps back to 0, so 15 lands on 3.
 */
const w = 490;
const h = 318;
const cx = 150;
const cy = 150;
const R = 100;
// 0 at the top, increasing clockwise
const marks = Array.from({ length: 12 }).map((_, i) => {
  const a = (-90 + i * 30) * (Math.PI / 180);
  return { n: i, x: cx + R * Math.cos(a), y: cy + R * Math.sin(a), a };
});
const target = marks[3];
---

<figure
  class="mck"
  role="img"
  aria-label="A clock face numbered 0 to 11 showing that counting 15 steps from 0 lands on 3, because 15 is congruent to 3 modulo 12"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="14" y="24" class="mck-head" font-size="12.5" font-weight="bold">Arithmetic that wraps around</text>

    {/* Clock face */}
    <circle cx={cx} cy={cy} r={R} class="mck-face" />

    {/* Wrap arc from 11 back to 0, showing the reset point */}
    <path
      d={`M ${marks[11].x} ${marks[11].y} A ${R} ${R} 0 0 1 ${marks[0].x} ${marks[0].y}`}
      class="mck-wrap"
      fill="none"
      marker-end="url(#mck-head-o)"
    />
    <text x={cx + 42} y={cy - R - 12} class="mck-wrap-lbl" font-size="9.5" text-anchor="middle">11 → 0, wrap</text>

    {/* Hour marks */}
    {marks.map((m) => (
      <g>
        <circle cx={m.x} cy={m.y} r={m.n === 3 ? "13" : "10"} class={m.n === 3 ? "mck-dot-hit" : m.n === 0 ? "mck-dot-zero" : "mck-dot"} />
        <text x={m.x} y={m.y + 4} class={m.n === 3 ? "mck-num-hit" : "mck-num"} font-size="11" font-weight={m.n === 3 ? "bold" : "normal"} text-anchor="middle">{m.n}</text>
      </g>
    ))}

    {/* Hand pointing at 3 */}
    <line x1={cx} y1={cy} x2={target.x - 14} y2={target.y} class="mck-hand" marker-end="url(#mck-head-g)" />
    <circle cx={cx} cy={cy} r="4" class="mck-hub" />

    {/* Explanation column */}
    <text x="290" y="96" class="mck-eq" font-size="13" font-weight="bold">15 ÷ 12 = 1 remainder 3</text>
    <text x="290" y="122" class="mck-eq2" font-size="13" font-weight="bold">15 ≡ 3 (mod 12)</text>
    <text x="290" y="150" class="mck-note" font-size="10">Count 15 steps from 0:</text>
    <text x="290" y="166" class="mck-note" font-size="10">one full lap of 12, then 3 more.</text>
    <text x="290" y="192" class="mck-note" font-size="10">Only the remainder survives,</text>
    <text x="290" y="208" class="mck-note" font-size="10">which is why 3 o'clock and</text>
    <text x="290" y="224" class="mck-note" font-size="10">15:00 are the same position.</text>

    <text x={w / 2} y="292" class="mck-foot" font-size="10.5" text-anchor="middle">
      Every integer falls into one of 12 residue classes: 0, 1, 2, ..., 11
    </text>
    <text x={w / 2} y="310" class="mck-sub" font-size="10" text-anchor="middle">
      Days of the week are mod 7, and angles are mod 360
    </text>

    <defs>
      <marker id="mck-head-g" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="mck-fill-g" />
      </marker>
      <marker id="mck-head-o" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
        <polygon points="0 0, 7 2.5, 0 5" class="mck-fill-o" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .mck { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .mck svg { max-width:100%; height:auto; }
  .mck-face { fill:none; stroke:#555; stroke-width:1.5; }
  .mck-dot { fill:#121212; stroke:#58a6ff; stroke-width:1.8; }
  .mck-dot-zero { fill:#121212; stroke:#d2a8ff; stroke-width:2.4; }
  .mck-dot-hit { fill:#121212; stroke:#7ee787; stroke-width:3; }
  .mck-num { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .mck-num-hit { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .mck-hand { stroke:#7ee787; stroke-width:2.2; }
  .mck-hub { fill:#7ee787; }
  .mck-wrap { stroke:#f0883e; stroke-width:2; }
  .mck-wrap-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .mck-head { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .mck-eq { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .mck-eq2 { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .mck-note { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .mck-foot { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .mck-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .mck-face { stroke:#ccc; }
  :global([data-theme="light"]) .mck-dot { fill:#ffffff; stroke:#0550ae; }
  :global([data-theme="light"]) .mck-dot-zero { fill:#ffffff; stroke:#6639ba; }
  :global([data-theme="light"]) .mck-dot-hit { fill:#ffffff; stroke:#116329; }
  :global([data-theme="light"]) .mck-num { fill:#555; }
  :global([data-theme="light"]) .mck-num-hit { fill:#116329; }
  :global([data-theme="light"]) .mck-hand { stroke:#116329; }
  :global([data-theme="light"]) .mck-hub { fill:#116329; }
  :global([data-theme="light"]) .mck-wrap { stroke:#b35900; }
  :global([data-theme="light"]) .mck-wrap-lbl { fill:#b35900; }
  :global([data-theme="light"]) .mck-head { fill:#0550ae; }
  :global([data-theme="light"]) .mck-eq { fill:#24292f; }
  :global([data-theme="light"]) .mck-eq2 { fill:#116329; }
  :global([data-theme="light"]) .mck-fill-g { fill:#116329; }
  :global([data-theme="light"]) .mck-fill-o { fill:#b35900; }
  :global([data-theme="light"]) .mck-foot { fill:#6639ba; }
  .mck-fill-g { fill:#7ee787; }
  .mck-fill-o { fill:#f0883e; }
</style>
