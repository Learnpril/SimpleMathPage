---
/**
 * PolarFormDiagram — modulus and argument on the left, the sixth roots of unity
 * on the right. Every number shown is computed from the point, and the roots are
 * generated from the formula rather than listed, so the picture cannot drift.
 */
const w = 540;
const h = 306;

// ---- left: one point, its modulus and argument ----
const lcx = 118;
const lcy = 150;
const lunit = 20;
const z = { re: 3, im: 4 };
const r = Math.hypot(z.re, z.im);
const theta = Math.atan2(z.im, z.re); // radians, in (−π, π]
const degrees = (theta * 180) / Math.PI;

const lx = (re: number) => lcx + re * lunit;
const ly = (im: number) => lcy - im * lunit;

// the argument arc, drawn from the positive real axis round to the point
const arcR = 34;
const arc = Array.from({ length: 41 }, (_, i) => {
  const t = (i / 40) * theta;
  return `${(lcx + arcR * Math.cos(t)).toFixed(1)},${(lcy - arcR * Math.sin(t)).toFixed(1)}`;
}).join(" ");

// ---- right: the nth roots of unity ----
const n = 6;
const rcx = 400;
const rcy = 152;
const runit = 58;
const roots = Array.from({ length: n }, (_, k) => {
  const t = (2 * Math.PI * k) / n;
  return { k, re: Math.cos(t), im: Math.sin(t), deg: (t * 180) / Math.PI };
});
const spacing = 360 / n;
const rx = (re: number) => rcx + re * runit;
const ry = (im: number) => rcy - im * runit;
// Verify the roots sum to zero, and report what we measured
const sumRe = roots.reduce((s, p) => s + p.re, 0);
const sumIm = roots.reduce((s, p) => s + p.im, 0);
const sumMag = Math.hypot(sumRe, sumIm);
---

<figure
  class="pfd"
  role="img"
  aria-label={`On the left, the point 3 plus 4i with modulus ${r} and argument ${degrees.toFixed(1)} degrees shown as a right triangle and an arc. On the right, the six sixth roots of unity spaced ${spacing} degrees apart on the unit circle, whose sum has magnitude ${sumMag.toFixed(3)}.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="pfd-head" font-size="12.5" font-weight="bold">Polar form: a length and an angle</text>
    <text x="16" y="38" class="pfd-sub" font-size="10.5">z = r(cos θ + i sin θ) = r e^(iθ), and roots become equal spacing</text>

    <line x1="262" y1="52" x2="262" y2="238" class="pfd-divide" />

    {/* ---------- left panel ---------- */}
    <text x="120" y="56" class="pfd-panel" font-size="10" text-anchor="middle">modulus and argument</text>
    <line x1={lx(-0.8)} y1={lcy} x2={lx(4.6)} y2={lcy} class="pfd-axis" />
    <line x1={lcx} y1={ly(4.3)} x2={lcx} y2={ly(-0.8)} class="pfd-axis" />

    {/* right triangle: legs then hypotenuse */}
    <line x1={lcx} y1={lcy} x2={lx(z.re)} y2={lcy} class="pfd-leg" />
    <line x1={lx(z.re)} y1={lcy} x2={lx(z.re)} y2={ly(z.im)} class="pfd-leg" />
    <line x1={lcx} y1={lcy} x2={lx(z.re)} y2={ly(z.im)} class="pfd-rvec" />
    <polyline points={arc} class="pfd-arc" fill="none" />

    <circle cx={lx(z.re)} cy={ly(z.im)} r="4" class="pfd-dot" />
    <text x={lx(z.re) + 8} y={ly(z.im) - 4} class="pfd-zlbl" font-size="9.5" text-anchor="start">z = 3 + 4i</text>
    <text x={lx(1.5)} y={lcy + 14} class="pfd-leg-lbl" font-size="9.5" text-anchor="middle">3</text>
    <text x={lx(z.re) + 8} y={ly(2)} class="pfd-leg-lbl" font-size="9.5" text-anchor="start">4</text>
    <text x={lcx + 46} y={lcy - 12} class="pfd-arclbl" font-size="9.5" text-anchor="start">θ</text>

    <text x="120" y="200" class="pfd-val" font-size="9.5" text-anchor="middle">{`|z| = √(3² + 4²) = ${r.toFixed(0)}`}</text>
    <text x="120" y="216" class="pfd-val" font-size="9.5" text-anchor="middle">{`θ = arctan(4⁄3) = ${degrees.toFixed(2)}°`}</text>

    {/* ---------- right panel ---------- */}
    <text x={rcx} y="56" class="pfd-panel" font-size="10" text-anchor="middle">the six sixth roots of 1</text>
    <circle cx={rcx} cy={rcy} r={runit} class="pfd-circle" />
    <line x1={rx(-1.05)} y1={rcy} x2={rx(1.05)} y2={rcy} class="pfd-axis" />
    <line x1={rcx} y1={ry(1.05)} x2={rcx} y2={ry(-1.05)} class="pfd-axis" />

    {roots.map((p) => (
      <g>
        <line x1={rcx} y1={rcy} x2={rx(p.re)} y2={ry(p.im)} class="pfd-spoke" />
        <circle cx={rx(p.re)} cy={ry(p.im)} r="4" class="pfd-root" />
        <text
          x={rx(p.re * 1.34)}
          y={ry(p.im * 1.34) + 3.4}
          class="pfd-klbl"
          font-size="9.5"
          text-anchor="middle">{`${p.deg.toFixed(0)}°`}</text>
      </g>
    ))}

    <text x={rcx} y="252" class="pfd-val" font-size="9.5" text-anchor="middle">{`Spaced exactly ${spacing.toFixed(0)}° apart`}</text>

    <text x={w / 2} y="274" class="pfd-foot" font-size="10.5" text-anchor="middle">
      {`z^${n} = 1 has solutions e^(2πik/${n}) for k = 0 … ${n - 1}, and their sum is ${sumMag < 1e-9 ? "0" : sumMag.toFixed(3)}`}
    </text>
    <text x={w / 2} y="292" class="pfd-sub2" font-size="9.5" text-anchor="middle">
      Multiplying adds arguments and multiplies moduli, which is why roots land on a regular polygon
    </text>
  </svg>
</figure>

<style>
  .pfd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .pfd svg { width:100%; max-width:100%; height:auto; }
  .pfd-axis { stroke:#888; stroke-width:1.3; }
  .pfd-divide { stroke:#3a3a3a; stroke-width:1; }
  .pfd-leg { stroke:#9198a1; stroke-width:1.2; stroke-dasharray:4,3; }
  .pfd-rvec { stroke:#58a6ff; stroke-width:2.4; }
  .pfd-arc { stroke:#f0883e; stroke-width:1.8; }
  .pfd-dot { fill:#58a6ff; stroke:#eee; stroke-width:1.2; }
  .pfd-circle { fill:none; stroke:#58a6ff; stroke-width:1.6; }
  .pfd-spoke { stroke:#7ee787; stroke-width:1.2; }
  .pfd-root { fill:#7ee787; stroke:#eee; stroke-width:1.1; }
  .pfd-zlbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .pfd-arclbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .pfd-klbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .pfd-leg-lbl, .pfd-val { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .pfd-panel, .pfd-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .pfd-sub, .pfd-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .pfd-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .pfd-axis { stroke:#666; }
  :global([data-theme="light"]) .pfd-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) :is(.pfd-rvec, .pfd-circle) { stroke:#0550ae; }
  :global([data-theme="light"]) .pfd-dot { fill:#0550ae; stroke:#fff; }
  :global([data-theme="light"]) :is(.pfd-zlbl, .pfd-foot) { fill:#0550ae; }
  :global([data-theme="light"]) .pfd-arc { stroke:#b35900; }
  :global([data-theme="light"]) .pfd-arclbl { fill:#b35900; }
  :global([data-theme="light"]) .pfd-spoke { stroke:#116329; }
  :global([data-theme="light"]) .pfd-root { fill:#116329; stroke:#fff; }
  :global([data-theme="light"]) .pfd-klbl { fill:#116329; }
  :global([data-theme="light"]) .pfd-panel, :global([data-theme="light"]) .pfd-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.pfd-leg-lbl, .pfd-val, .pfd-sub, .pfd-sub2) { fill:#57606a; }
</style>
