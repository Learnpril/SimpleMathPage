---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<nav class="progress-nav" aria-label="Progress navigation">
			<a href="/progress/" class="progress-nav-link" data-progress-link>Progress</a>
		</nav>
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
	<div class="mobile-header-icons print:hidden">
		<a href="/progress/" class="mobile-header-icon" aria-label="Progress" data-mobile-progress>
			<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M3 13h2v8H3zm4-4h2v12H7zm4-4h2v16h-2zm4 8h2v8h-2zm4-4h2v12h-2z"/></svg>
		</a>
		<button class="mobile-header-icon" aria-label="Search" data-mobile-search>
			<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
		</button>
		<button class="mobile-header-icon" aria-label="Toggle theme" data-mobile-theme>
			<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-3a1 1 0 0 0 1-1V1a1 1 0 0 0-2 0v2a1 1 0 0 0 1 1zm0 18a1 1 0 0 0-1 1v2a1 1 0 0 0 2 0v-2a1 1 0 0 0-1-1zM5.64 7.05 4.22 5.64a1 1 0 0 1 1.42-1.42l1.41 1.42a1 1 0 1 1-1.41 1.41zm12.73 9.9a1 1 0 1 0-1.42 1.42l1.42 1.41a1 1 0 0 0 1.41-1.41l-1.41-1.42zM4 12a1 1 0 0 0-1-1H1a1 1 0 0 0 0 2h2a1 1 0 0 0 1-1zm18-1h-2a1 1 0 0 0 0 2h2a1 1 0 0 0 0-2zM5.64 16.95a1 1 0 1 0-1.41 1.42l1.41 1.41a1 1 0 0 0 1.42-1.41l-1.42-1.42zm12.73-9.9a1 1 0 1 0 1.41-1.41l-1.41-1.42a1 1 0 0 0-1.42 1.42l1.42 1.41z"/></svg>
		</button>
		<button class="mobile-header-icon mobile-auth-icon" aria-label="Account" id="mobile-auth-btn">
			<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
		</button>
	</div>
</div>

<script>
	function initProgressLink() {
		const link = document.querySelector('a[data-progress-link]');
		if (!link) return;
		const path = window.location.pathname.replace(/\/$/, '');
		if (path === '/progress') {
			link.setAttribute('aria-current', 'page');
			link.classList.add('progress-nav-link--active');
		}
	}

	function initMobileIcons() {
		// Shorten site title to "MBU" on mobile
		const titleSpan = document.querySelector('.site-title span') as HTMLElement;
		if (titleSpan && window.innerWidth < 800) {
			titleSpan.textContent = 'MBU';
		}

		// Mobile progress active state
		const mobileProgress = document.querySelector('a[data-mobile-progress]');
		if (mobileProgress) {
			const path = window.location.pathname.replace(/\/$/, '');
			if (path === '/progress') {
				mobileProgress.classList.add('progress-nav-link--active');
				mobileProgress.setAttribute('aria-current', 'page');
			}
		}

		// Mobile search button
		const searchBtn = document.querySelector('button[data-mobile-search]');
		if (searchBtn) {
			searchBtn.addEventListener('click', () => {
				const openModal = document.querySelector('button[data-open-modal]');
				if (openModal) openModal.click();
			});
		}

		// Mobile theme toggle
		const themeBtn = document.querySelector('button[data-mobile-theme]') as HTMLElement;
		if (themeBtn) {
			const sunSvg = '<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-3a1 1 0 0 0 1-1V1a1 1 0 0 0-2 0v2a1 1 0 0 0 1 1zm0 18a1 1 0 0 0-1 1v2a1 1 0 0 0 2 0v-2a1 1 0 0 0-1-1zM5.64 7.05 4.22 5.64a1 1 0 0 1 1.42-1.42l1.41 1.42a1 1 0 1 1-1.41 1.41zm12.73 9.9a1 1 0 1 0-1.42 1.42l1.42 1.41a1 1 0 0 0 1.41-1.41l-1.41-1.42zM4 12a1 1 0 0 0-1-1H1a1 1 0 0 0 0 2h2a1 1 0 0 0 1-1zm18-1h-2a1 1 0 0 0 0 2h2a1 1 0 0 0 0-2zM5.64 16.95a1 1 0 1 0-1.41 1.42l1.41 1.41a1 1 0 0 0 1.42-1.41l-1.42-1.42zm12.73-9.9a1 1 0 1 0 1.41-1.41l-1.41-1.42a1 1 0 0 0-1.42 1.42l1.42 1.41z"/></svg>';
			const moonSvg = '<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73A8.15 8.15 0 0 1 9.08 5.49a8.59 8.59 0 0 1 .25-2 1 1 0 0 0-.37-1 1 1 0 0 0-1-.17 10 10 0 1 0 13.69 11.65 1 1 0 0 0 0-.96z"/></svg>';
			const isDark = document.documentElement.dataset.theme !== 'light';
			themeBtn.innerHTML = isDark ? sunSvg : moonSvg;
			themeBtn.addEventListener('click', () => {
				const sel = document.querySelector('starlight-theme-select select') as HTMLSelectElement;
				if (sel) {
					const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
					sel.value = next;
					sel.dispatchEvent(new Event('change'));
					themeBtn.innerHTML = next === 'dark' ? sunSvg : moonSvg;
				}
			});
		}

		// Mobile auth button
		const authBtn = document.getElementById('mobile-auth-btn');
		if (authBtn && !authBtn.dataset.wired) {
			authBtn.dataset.wired = 'true';
			authBtn.addEventListener('click', () => {
				import('../lib/auth-modal').then((mod) => {
					if (mod && mod.handleMobileAuthClick) mod.handleMobileAuthClick(authBtn);
					else if (mod && mod.showAuthModal) mod.showAuthModal();
				}).catch(() => {});
			});
		}
	}

	function initAll() {
		initProgressLink();
		initMobileIcons();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAll);
	} else {
		initAll();
	}
	document.addEventListener('astro:page-load', initAll);
</script>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
			overflow: clip;
			/* Avoid clipping focus ring around link inside title wrapper. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
        /* 1 (site title): runs up until the main content column's left edge or the width of the title, whichever is the largest  */
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					/* 2 (search box): all free space that is available. */
					1fr
					/* 3 (right items): use the space that these need. */
					auto;
				align-content: center;
			}

			.mobile-header-icons {
				display: none;
			}
		}
	}
</style>
