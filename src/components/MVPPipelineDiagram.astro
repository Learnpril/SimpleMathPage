---
/**
 * MVPPipelineDiagram — Interactive Three.js showing the MVP pipeline
 * A colored cube auto-rotates in 3D space with labeled axes,
 * a grid (world space), and a light source showing dot-product lighting.
 * Demonstrates Model (rotation), View (orbit camera), Projection (perspective).
 */
---

<figure class="mvp3d" role="img" aria-label="Interactive 3D MVP pipeline demonstration">
  <div class="mvp3d-canvas" data-mvppipeline></div>
  <div class="mvp3d-hint">Drag to rotate · Scroll/Pinch to zoom</div>
</figure>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  function initScene(container: HTMLElement) {
    const width = container.clientWidth || 480;
    const height = 380;
    const isDark = document.documentElement.dataset.theme !== "light";

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(isDark ? 0x121212 : 0xf8f9fa);

    const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 100);
    camera.position.set(4, 3, 5);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Grid (world space)
    const gc = isDark ? 0x333333 : 0xcccccc;
    scene.add(new THREE.GridHelper(8, 8, gc, gc));

    // Axes
    const axLen = 4;
    const axColors = [
      { dir: [axLen, 0, 0], color: isDark ? 0x58a6ff : 0x0550ae, label: "x" },
      { dir: [0, axLen, 0], color: isDark ? 0x7ee787 : 0x1a7f2e, label: "y" },
      { dir: [0, 0, axLen], color: isDark ? 0xd2a8ff : 0x6b3fa0, label: "z" },
    ];
    axColors.forEach(({ dir, color, label }) => {
      const g = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(0, 0, 0),
        new THREE.Vector3(dir[0], dir[1], dir[2]),
      ]);
      scene.add(new THREE.Line(g, new THREE.LineBasicMaterial({ color })));

      // Axis label
      const c = document.createElement("canvas");
      c.width = 128; c.height = 64;
      const ctx = c.getContext("2d")!;
      ctx.font = "bold 48px sans-serif";
      ctx.fillStyle = "#" + color.toString(16).padStart(6, "0");
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(label, 64, 32);
      const t = new THREE.CanvasTexture(c);
      const m = new THREE.SpriteMaterial({ map: t, transparent: true, depthTest: false });
      const sp = new THREE.Sprite(m);
      sp.position.set(dir[0] * 1.1, dir[1] * 1.1, dir[2] * 1.1);
      sp.scale.set(0.5, 0.25, 1);
      scene.add(sp);
    });

    // Cube with colored faces (the "model")
    const cubeGeo = new THREE.BoxGeometry(1.2, 1.2, 1.2);
    const cubeMat = new THREE.MeshPhongMaterial({
      color: isDark ? 0x58a6ff : 0x0550ae,
      shininess: 60,
      transparent: true,
      opacity: 0.85,
    });
    const cube = new THREE.Mesh(cubeGeo, cubeMat);
    cube.position.set(0, 0.6, 0);
    scene.add(cube);

    // Wireframe overlay
    const wireGeo = new THREE.EdgesGeometry(cubeGeo);
    const wireMat = new THREE.LineBasicMaterial({
      color: isDark ? 0x7ee787 : 0x1a7f2e,
      linewidth: 1,
    });
    const wireframe = new THREE.LineSegments(wireGeo, wireMat);
    cube.add(wireframe);

    // Light source (shows dot-product lighting in action)
    const dirLight = new THREE.DirectionalLight(isDark ? 0xffffff : 0xffffff, 1.2);
    dirLight.position.set(3, 5, 4);
    scene.add(dirLight);
    scene.add(new THREE.AmbientLight(isDark ? 0x404040 : 0x606060, 0.8));

    // Light direction arrow (orange)
    const lightDir = dirLight.position.clone().normalize();
    scene.add(new THREE.ArrowHelper(
      lightDir.clone().negate(),
      dirLight.position.clone().multiplyScalar(0.6),
      1.5,
      isDark ? 0xf0883e : 0xc05010,
      0.2, 0.12
    ));

    // Light label
    function makeLabel(text: string, pos: number[], color: string, s = 0.5) {
      const c = document.createElement("canvas");
      c.width = 256; c.height = 64;
      const ctx = c.getContext("2d")!;
      ctx.font = "bold 40px sans-serif";
      ctx.fillStyle = color;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(text, 128, 32);
      const t = new THREE.CanvasTexture(c);
      const m = new THREE.SpriteMaterial({ map: t, transparent: true, depthTest: false });
      const sp = new THREE.Sprite(m);
      sp.position.set(pos[0], pos[1], pos[2]);
      sp.scale.set(s * 3, s * 0.75, 1);
      scene.add(sp);
    }

    makeLabel("light", [2.2, 3.5, 2.8], isDark ? "#f0883e" : "#c05010", 0.45);
    makeLabel("Model (cube)", [0, 2.2, 0], isDark ? "#58a6ff" : "#0550ae", 0.5);

    // Controls (this IS the View matrix in action)
    const ctrl = new OrbitControls(camera, renderer.domElement);
    ctrl.enableDamping = true;
    ctrl.dampingFactor = 0.08;
    ctrl.autoRotate = true;
    ctrl.autoRotateSpeed = 0.8;
    ctrl.enablePan = false;
    ctrl.minDistance = 3;
    ctrl.maxDistance = 15;

    let animId: number;
    function animate() {
      animId = requestAnimationFrame(animate);
      // Model matrix: rotate the cube
      cube.rotation.y += 0.005;
      cube.rotation.x += 0.002;
      ctrl.update();
      renderer.render(scene, camera);
    }
    animate();
    return () => { cancelAnimationFrame(animId); renderer.dispose(); };
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-mvppipeline]").forEach(el => {
      if (el.querySelector("canvas")) return;
      const obs = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) { obs.disconnect(); initScene(el); }
      }, { threshold: 0.05 });
      obs.observe(el);
    });
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .mvp3d { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .mvp3d-canvas { width:100%; max-width:480px; min-height:380px; border-radius:8px; overflow:hidden; }
  .mvp3d-canvas canvas { border-radius:8px; }
  .mvp3d-hint { font-family:"Libre Baskerville",Georgia,serif; font-size:0.8rem; color:#888; margin-top:0.4rem; }
</style>
