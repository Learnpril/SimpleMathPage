---
/**
 * ConditionalTree — the two-factory widget example as a probability tree.
 * Branch probabilities multiply along each path, and the four paths sum to 1.
 */
const w = 540;
const h = 262;
const rootX = 56;
const rootY = 128;
const midX = 210;
const leafX = 380;

const branches = [
  {
    label: "Factory A",
    p: 0.6,
    y: 74,
    cls: "blue",
    leaves: [
      { label: "defective", p: 0.02, y: 46, joint: 0.012, hl: true },
      { label: "good", p: 0.98, y: 100, joint: 0.588, hl: false },
    ],
  },
  {
    label: "Factory B",
    p: 0.4,
    y: 182,
    cls: "green",
    leaves: [
      { label: "defective", p: 0.05, y: 156, joint: 0.02, hl: true },
      { label: "good", p: 0.95, y: 210, joint: 0.38, hl: false },
    ],
  },
];
/**
 * Position a branch probability alongside its edge by stepping off the
 * midpoint along the edge's normal. Nudging labels straight up by a fixed
 * amount puts them on top of sloped edges; this cannot.
 */
function edgeLabel(x1: number, y1: number, x2: number, y2: number, off = 13) {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const len = Math.hypot(dx, dy) || 1;
  let nx = -dy / len;
  let ny = dx / len;
  if (ny > 0) {
    nx = -nx;
    ny = -ny;
  }
  return { x: (x1 + x2) / 2 + nx * off, y: (y1 + y2) / 2 + ny * off + 3 };
}

const totalDefective = branches
  .flatMap((b) => b.leaves)
  .filter((l) => l.hl)
  .reduce((s, l) => s + l.joint, 0);
const allPaths = branches.flatMap((b) => b.leaves).reduce((s, l) => s + l.joint, 0);
---

<figure
  class="cdt"
  role="img"
  aria-label="A probability tree splitting into Factory A at 0.6 and Factory B at 0.4, each branching into defective and good outcomes, with the four path probabilities multiplying out to 0.012, 0.588, 0.020 and 0.380"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="22" class="cdt-head" font-size="12.5" font-weight="bold">Multiply along a path, add across paths</text>

    {/* Root */}
    <circle cx={rootX} cy={rootY} r="6" class="cdt-root" />
    <text x={rootX} y={rootY + 22} class="cdt-sub" font-size="9.5" text-anchor="middle">widget</text>

    {branches.map((b) => {
      const bl = edgeLabel(rootX + 7, rootY, midX - 8, b.y);
      return (
      <g>
        {/* First-level branch */}
        <line x1={rootX + 7} y1={rootY} x2={midX - 8} y2={b.y} class={`cdt-edge cdt-e-${b.cls}`} />
        <text
          x={bl.x}
          y={bl.y}
          class={`cdt-p cdt-t-${b.cls}`}
          font-size="10"
          text-anchor="middle"
        >{b.p}</text>
        <text x={midX} y={b.y + 4} class={`cdt-node cdt-t-${b.cls}`} font-size="11" font-weight="bold">{b.label}</text>

        {/* Second-level branches */}
        {b.leaves.map((l) => {
          const ll = edgeLabel(midX + 62, b.y, leafX - 8, l.y);
          return (
          <g>
            <line x1={midX + 62} y1={b.y} x2={leafX - 8} y2={l.y} class={l.hl ? "cdt-edge cdt-e-orange" : "cdt-edge cdt-e-dim"} />
            <text
              x={ll.x}
              y={ll.y}
              class={l.hl ? "cdt-p cdt-t-orange" : "cdt-p cdt-dim"}
              font-size="9.5"
              text-anchor="middle"
            >{l.p}</text>
            <text x={leafX} y={l.y + 4} class={l.hl ? "cdt-leaf cdt-t-orange" : "cdt-leaf cdt-dim"} font-size="10">{l.label}</text>
            <text x={leafX + 74} y={l.y + 4} class={l.hl ? "cdt-joint cdt-t-orange" : "cdt-joint cdt-dim"} font-size="10">
              {l.joint.toFixed(3)}
            </text>
          </g>
          );
        })}
      </g>
      );
    })}

    {/* Column header for joint probabilities */}
    <text x={leafX + 74} y="30" class="cdt-sub" font-size="9.5">path probability</text>

    {/* Totals */}
    <line x1={leafX + 60} y1="230" x2={w - 16} y2="230" class="cdt-rule" />
    <text x={leafX - 8} y="244" class="cdt-total-lbl" font-size="9.5" text-anchor="end">all four paths sum to</text>
    <text x={leafX + 74} y="244" class="cdt-total" font-size="10.5">{allPaths.toFixed(3)}</text>

    <text x="16" y="244" class="cdt-foot" font-size="10.5">
      {`P(defective) = 0.012 + 0.020 = ${totalDefective.toFixed(3)}`}
    </text>
  </svg>
</figure>

<style>
  .cdt { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cdt svg { width:100%; max-width:100%; height:auto; }
  .cdt-root { fill:#d2a8ff; }
  .cdt-edge { stroke-width:1.6; }
  .cdt-e-blue { stroke:#58a6ff; }
  .cdt-e-green { stroke:#7ee787; }
  .cdt-e-orange { stroke:#f0883e; }
  .cdt-e-dim { stroke:#666; stroke-width:1.2; }
  .cdt-node, .cdt-leaf, .cdt-p, .cdt-joint { font-family:'Libre Baskerville',Georgia,serif; }
  .cdt-t-blue { fill:#58a6ff; }
  .cdt-t-green { fill:#7ee787; }
  .cdt-t-orange { fill:#f0883e; }
  .cdt-dim { fill:#888; }
  .cdt-sub { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cdt-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .cdt-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .cdt-total { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-weight:bold; }
  .cdt-total-lbl { fill:#888; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .cdt-rule { stroke:#555; stroke-width:1; }
  :global([data-theme="light"]) .cdt-root { fill:#6639ba; }
  :global([data-theme="light"]) .cdt-e-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .cdt-e-green { stroke:#116329; }
  :global([data-theme="light"]) .cdt-e-orange { stroke:#b35900; }
  :global([data-theme="light"]) .cdt-e-dim { stroke:#bbb; }
  :global([data-theme="light"]) .cdt-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .cdt-t-green { fill:#116329; }
  :global([data-theme="light"]) .cdt-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .cdt-head { fill:#24292f; }
  :global([data-theme="light"]) .cdt-foot { fill:#b35900; }
  :global([data-theme="light"]) .cdt-total { fill:#116329; }
  :global([data-theme="light"]) .cdt-rule { stroke:#ccc; }
</style>
