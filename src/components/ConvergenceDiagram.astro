---
/**
 * ConvergenceDiagram — shows partial sums of 9 + 3 + 1 + 1/3 + ...
 * approaching the limit of 13.5, illustrating convergence.
 * Partial sums: 9, 12, 13, 13.33, 13.44, 13.48, 13.49, 13.497
 */
const w = 300;
const h = 180;
const pad = 40;
const gw = w - 2 * pad;
const gh = h - pad - 20;
const sums = [9, 12, 13, 13.333, 13.444, 13.481, 13.494, 13.498];
const limit = 13.5;
const n = sums.length;
const xStep = gw / (n - 1);
const yMin = 0;
const yMax = 15;
const sx = (i: number) => pad + i * xStep;
const sy = (v: number) => pad + gh - ((v - yMin) / (yMax - yMin)) * gh;
---

<figure class="cvd" role="img" aria-label="Partial sums of an infinite geometric series converging to 13.5">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Axes */}
    <line x1={pad} y1={sy(yMin)} x2={pad} y2={sy(yMax)} class="cvd-axis" stroke-width="1" />
    <line x1={pad} y1={sy(yMin)} x2={pad + gw} y2={sy(yMin)} class="cvd-axis" stroke-width="1" />

    {/* Limit line (dashed) */}
    <line x1={pad} y1={sy(limit)} x2={pad + gw} y2={sy(limit)} class="cvd-limit" stroke-width="1.5" stroke-dasharray="6,4" />
    <text class="cvd-limit-lbl" x={pad + gw + 4} y={sy(limit) + 4} font-size="9">13.5</text>

    {/* Grid lines */}
    {[3, 6, 9, 12].map(v => (
      <g>
        <line x1={pad} y1={sy(v)} x2={pad + gw} y2={sy(v)} class="cvd-grid" stroke-width="0.5" />
        <text class="cvd-tick" x={pad - 6} y={sy(v) + 3} font-size="8" text-anchor="end">{v}</text>
      </g>
    ))}

    {/* Connecting line */}
    <polyline
      points={sums.map((s, i) => `${sx(i)},${sy(s)}`).join(' ')}
      fill="none" class="cvd-line" stroke-width="2"
    />

    {/* Dots at each partial sum */}
    {sums.map((s, i) => (
      <circle cx={sx(i)} cy={sy(s)} r="4" class="cvd-dot" />
    ))}

    {/* Term labels */}
    {[0, 1, 2, 4, 7].map(i => (
      <text class="cvd-n" x={sx(i)} y={sy(yMin) + 14} font-size="7" text-anchor="middle">n={i + 1}</text>
    ))}

    {/* Arrow pointing at the limit */}
    <text class="cvd-converge" x={pad + gw - 40} y={sy(limit) - 8} font-size="9">converges</text>
  </svg>
</figure>

<style>
  .cvd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .cvd svg { max-width:100%; height:auto; }
  .cvd-axis { stroke:#555; }
  .cvd-grid { stroke:#333; }
  .cvd-line { stroke:#58a6ff; }
  .cvd-dot { fill:#58a6ff; }
  .cvd-limit { stroke:#7ee787; }
  .cvd-limit-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .cvd-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .cvd-n { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .cvd-converge { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .cvd-axis { stroke:#bbb; }
  :global([data-theme="light"]) .cvd-grid { stroke:#ddd; }
  :global([data-theme="light"]) .cvd-line { stroke:#0550ae; }
  :global([data-theme="light"]) .cvd-dot { fill:#0550ae; }
  :global([data-theme="light"]) .cvd-limit { stroke:#116329; }
  :global([data-theme="light"]) .cvd-limit-lbl { fill:#116329; }
  :global([data-theme="light"]) .cvd-tick { fill:#666; }
  :global([data-theme="light"]) .cvd-n { fill:#666; }
  :global([data-theme="light"]) .cvd-converge { fill:#116329; }
</style>
