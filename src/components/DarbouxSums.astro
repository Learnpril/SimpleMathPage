---
/**
 * DarbouxSums — lower and upper Darboux sums for the same function on two
 * partitions, with every number measured from the actual sampled infima and
 * suprema on each subinterval rather than assumed.
 */
const w = 540;
const h = 314;
const plotTop = 64;
const plotBottom = 194;

const A = 0;
const B = 1;
const f = (x: number) => x * x;
const exact = 1 / 3; // ∫₀¹ x² dx

const yLo = 0;
const yHi = 1.1;

/** Infimum and supremum on a subinterval, found by sampling. */
function infSup(x0: number, x1: number) {
  let lo = Infinity;
  let hi = -Infinity;
  for (let k = 0; k <= 60; k++) {
    const v = f(x0 + (k / 60) * (x1 - x0));
    if (v < lo) lo = v;
    if (v > hi) hi = v;
  }
  return { lo, hi };
}

/** Uniform partition into n pieces: the subintervals and the two sums. */
function darboux(n: number) {
  const dx = (B - A) / n;
  const bars = Array.from({ length: n }, (_, i) => {
    const x0 = A + i * dx;
    const x1 = x0 + dx;
    return { x0, x1, ...infSup(x0, x1) };
  });
  const lower = bars.reduce((s, b) => s + b.lo * dx, 0);
  const upper = bars.reduce((s, b) => s + b.hi * dx, 0);
  return { n, dx, bars, lower, upper, gap: upper - lower };
}

const panels = [
  { d: darboux(4), left: 44, right: 246 },
  { d: darboux(10), left: 294, right: 496 },
];

const py = (y: number) =>
  plotBottom - ((y - yLo) / (yHi - yLo)) * (plotBottom - plotTop);
const pxOf = (p: { left: number; right: number }, x: number) =>
  p.left + ((x - A) / (B - A)) * (p.right - p.left);

const curveOf = (p: { left: number; right: number }) =>
  Array.from({ length: 121 }, (_, i) => {
    const x = A + (i / 120) * (B - A);
    return `${pxOf(p, x).toFixed(1)},${py(f(x)).toFixed(1)}`;
  }).join(" ");

const coarse = panels[0].d;
const fine = panels[1].d;
---

<figure
  class="dbx"
  role="img"
  aria-label={`Two panels showing lower and upper Darboux sums for x squared on the unit interval. With ${coarse.n} subintervals the sums are ${coarse.lower.toFixed(3)} and ${coarse.upper.toFixed(3)}, a gap of ${coarse.gap.toFixed(3)}. With ${fine.n} subintervals they are ${fine.lower.toFixed(3)} and ${fine.upper.toFixed(3)}, a gap of ${fine.gap.toFixed(3)}. Both trap the exact value one third.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="dbx-head" font-size="12.5" font-weight="bold">The sums squeeze from both sides</text>
    <text x="16" y="38" class="dbx-sub" font-size="10.5">Lower and upper Darboux sums for f(x) = x² on [0, 1]</text>

    <line x1="270" y1="52" x2="270" y2="200" class="dbx-divide" />

    {panels.map((p) => (
      <g>
        <text
          x={(p.left + p.right) / 2}
          y="58"
          class="dbx-panel"
          font-size="10"
          text-anchor="middle">{`n = ${p.d.n} subintervals`}</text>

        {/* Upper rectangles first, outlined, so the filled lower ones read on top */}
        {p.d.bars.map((b) => (
          <rect
            x={pxOf(p, b.x0)}
            y={py(b.hi)}
            width={pxOf(p, b.x1) - pxOf(p, b.x0)}
            height={plotBottom - py(b.hi)}
            class="dbx-up"
          />
        ))}
        {p.d.bars.map((b) => (
          <rect
            x={pxOf(p, b.x0)}
            y={py(b.lo)}
            width={pxOf(p, b.x1) - pxOf(p, b.x0)}
            height={plotBottom - py(b.lo)}
            class="dbx-lo"
          />
        ))}

        <polyline points={curveOf(p)} class="dbx-curve" fill="none" />
        <line x1={p.left - 6} y1={plotBottom} x2={p.right + 6} y2={plotBottom} class="dbx-axis" />

        <text x={p.left} y="208" class="dbx-tick" font-size="9.5" text-anchor="middle">0</text>
        <text x={p.right} y="208" class="dbx-tick" font-size="9.5" text-anchor="middle">1</text>

        <text
          x={(p.left + p.right) / 2}
          y="228"
          class="dbx-lolbl"
          font-size="9.5"
          text-anchor="middle">{`lower sum  ${p.d.lower.toFixed(3)}`}</text>
        <text
          x={(p.left + p.right) / 2}
          y="244"
          class="dbx-uplbl"
          font-size="9.5"
          text-anchor="middle">{`upper sum  ${p.d.upper.toFixed(3)}`}</text>
        <text
          x={(p.left + p.right) / 2}
          y="260"
          class="dbx-gap"
          font-size="9.5"
          text-anchor="middle">{`gap  ${p.d.gap.toFixed(3)}`}</text>
      </g>
    ))}

    <text x={w / 2} y="286" class="dbx-foot" font-size="10.5" text-anchor="middle">
      {`L(f, P) ≤ ∫₀¹ f = ${exact.toFixed(4)} ≤ U(f, P) for every partition P`}
    </text>
    <text x={w / 2} y="304" class="dbx-sub2" font-size="9.5" text-anchor="middle">
      {`The gap falls from ${coarse.gap.toFixed(3)} to ${fine.gap.toFixed(3)} — here it is exactly 1⁄n, so it can be made as small as you like`}
    </text>
  </svg>
</figure>

<style>
  .dbx { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .dbx svg { width:100%; max-width:100%; height:auto; }
  .dbx-axis { stroke:#888; stroke-width:1.3; }
  .dbx-divide { stroke:#3a3a3a; stroke-width:1; }
  .dbx-curve { stroke:#58a6ff; stroke-width:2.2; }
  .dbx-up { fill:none; stroke:#f0883e; stroke-width:1.1; }
  .dbx-lo { fill:#7ee787; fill-opacity:0.22; stroke:#7ee787; stroke-width:1.1; }
  .dbx-tick { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .dbx-lolbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  .dbx-uplbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .dbx-gap { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .dbx-panel { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .dbx-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .dbx-sub, .dbx-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .dbx-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .dbx-axis { stroke:#666; }
  :global([data-theme="light"]) .dbx-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .dbx-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .dbx-foot { fill:#0550ae; }
  :global([data-theme="light"]) .dbx-up { stroke:#b35900; }
  :global([data-theme="light"]) .dbx-uplbl { fill:#b35900; }
  :global([data-theme="light"]) .dbx-lo { stroke:#116329; fill:#116329; fill-opacity:0.16; }
  :global([data-theme="light"]) .dbx-lolbl { fill:#116329; }
  :global([data-theme="light"]) .dbx-gap { fill:#6639ba; }
  :global([data-theme="light"]) .dbx-panel, :global([data-theme="light"]) .dbx-head { fill:#24292f; }
  :global([data-theme="light"]) :is(.dbx-tick, .dbx-sub, .dbx-sub2) { fill:#57606a; }
</style>
