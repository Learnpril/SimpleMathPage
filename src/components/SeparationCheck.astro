---
/**
 * SeparationCheck — the T0, T1 and T2 axioms tested on three topologies over a
 * three-point set. Each verdict comes from a brute-force search over point pairs
 * and open sets, so the ticks and crosses are the result of the search.
 */
const w = 540;
const h = 306;

const FULL = 0b111;
const names = ["a", "b", "c"];
const label = (m: number) => {
  if (m === 0) return "∅";
  if (m === FULL) return "X";
  return `{${names.filter((_, i) => m & (1 << i)).join("")}}`;
};

const pairs: [number, number][] = [
  [0, 1],
  [0, 2],
  [1, 2],
];

function axioms(family: number[]) {
  const has = (m: number) => family.includes(m);
  const opensWith = (i: number) => family.filter((m) => m & (1 << i));

  const t0 = pairs.every(([i, j]) =>
    family.some((m) => Boolean(m & (1 << i)) !== Boolean(m & (1 << j))),
  );
  const t1 = pairs.every(
    ([i, j]) =>
      opensWith(i).some((m) => !(m & (1 << j))) && opensWith(j).some((m) => !(m & (1 << i))),
  );
  const t2 = pairs.every(([i, j]) =>
    opensWith(i).some((u) => opensWith(j).some((v) => (u & v) === 0)),
  );
  return { t0, t1, t2, has };
}

const cases = [
  { cx: 96, title: "trivial", family: [0, FULL] },
  { cx: 270, title: "a chain", family: [0, 0b001, 0b011, FULL] },
  { cx: 444, title: "discrete", family: [0, 0b001, 0b010, 0b100, 0b011, 0b101, 0b110, FULL] },
].map((c) => ({ ...c, ...axioms(c.family) }));

const strongest = (c: (typeof cases)[number]) =>
  c.t2 ? "T₂ (Hausdorff)" : c.t1 ? "T₁ only" : c.t0 ? "T₀ only" : "none of them";
---

<figure
  class="spc"
  role="img"
  aria-label={`Three topologies on a three-point set tested against the separation axioms. The trivial topology satisfies ${cases[0].t0 ? "T0" : "none of them"}, the chain topology satisfies T0 only, and the discrete topology satisfies all of T0, T1 and T2.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="spc-head" font-size="12.5" font-weight="bold">How well can a topology tell points apart?</text>
    <text x="16" y="38" class="spc-sub" font-size="10.5">Separation axioms checked on three topologies over X = {"{"}a, b, c{"}"}</text>

    <line x1="183" y1="52" x2="183" y2="248" class="spc-divide" />
    <line x1="357" y1="52" x2="357" y2="248" class="spc-divide" />

    {cases.map((c) => (
      <g>
        <text x={c.cx} y="64" class={`spc-title spc-${c.t2 ? "ok" : c.t0 ? "mid" : "bad"}`} font-size="11" text-anchor="middle" font-weight="bold">{c.title}</text>
        <text x={c.cx} y="84" class="spc-sets" font-size="9" text-anchor="middle">
          {`${c.family.length} open sets`}
        </text>

        <text x={c.cx} y="116" class={`spc-ax spc-${c.t0 ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">
          {`T₀  distinguishable   ${c.t0 ? "✓" : "✗"}`}
        </text>
        <text x={c.cx} y="136" class={`spc-ax spc-${c.t1 ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">
          {`T₁  points closed   ${c.t1 ? "✓" : "✗"}`}
        </text>
        <text x={c.cx} y="156" class={`spc-ax spc-${c.t2 ? "ok" : "bad"}`} font-size="9.5" text-anchor="middle">
          {`T₂  disjoint opens   ${c.t2 ? "✓" : "✗"}`}
        </text>

        <text x={c.cx} y="188" class={`spc-verdict spc-${c.t2 ? "ok" : c.t0 ? "mid" : "bad"}`} font-size="10" text-anchor="middle" font-weight="bold">
          {strongest(c)}
        </text>
        <text x={c.cx} y="214" class="spc-note" font-size="9" text-anchor="middle">
          {c.t2 ? "metrizable" : c.t0 ? "not metrizable" : "not metrizable"}
        </text>
        <text x={c.cx} y="230" class="spc-note" font-size="9" text-anchor="middle">
          {c.t2 ? "limits are unique" : "limits need not be unique"}
        </text>
      </g>
    ))}

    <text x={w / 2} y="266" class="spc-foot" font-size="10.5" text-anchor="middle">
      T₄ ⊆ T₃ ⊆ T₂ ⊆ T₁ ⊆ T₀, and every metric space is T₄
    </text>
    <text x={w / 2} y="286" class="spc-sub2" font-size="9.5" text-anchor="middle">
      Hausdorff is the usual dividing line, since it is what makes limits unique
    </text>
    <text x={w / 2} y="302" class="spc-sub2" font-size="9.5" text-anchor="middle">
      The cofinite topology on an infinite set is T₁ and not T₂, so the axioms differ
    </text>
  </svg>
</figure>

<style>
  .spc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .spc svg { width:100%; max-width:100%; height:auto; }
  .spc-divide { stroke:#3a3a3a; stroke-width:1; }
  .spc-title, .spc-ax, .spc-verdict { font-family:'Libre Baskerville',Georgia,serif; }
  .spc-ok { fill:#7ee787; }
  .spc-mid { fill:#f0883e; }
  .spc-bad { fill:#ff7b72; }
  .spc-sets, .spc-note { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .spc-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .spc-sub, .spc-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .spc-foot { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .spc-divide { stroke:#d0d7de; }
  :global([data-theme="light"]) .spc-ok { fill:#116329; }
  :global([data-theme="light"]) .spc-mid { fill:#b35900; }
  :global([data-theme="light"]) .spc-bad { fill:#a40e26; }
  :global([data-theme="light"]) .spc-head { fill:#24292f; }
  :global([data-theme="light"]) .spc-foot { fill:#0550ae; }
  :global([data-theme="light"]) :is(.spc-sets, .spc-note, .spc-sub, .spc-sub2) { fill:#57606a; }
</style>
