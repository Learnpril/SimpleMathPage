---
/**
 * PartialSumsGraph - shows partial sums of the geometric series
 * sum (1/2)^n from n=1 to infinity, converging to 1.
 * Also shows partial sums of the harmonic series diverging.
 */
const w = 420;
const h = 300;
const pad = 55;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 16, yMin = 0, yMax = 4.5;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

// Geometric series partial sums: S_n = 1 - (1/2)^n
const geoPts: { x: number; y: number }[] = [];
let geoSum = 0;
for (let n = 1; n <= 15; n++) {
  geoSum += Math.pow(0.5, n);
  geoPts.push({ x: n, y: geoSum });
}

// Harmonic series partial sums: S_n = sum 1/k
const harmPts: { x: number; y: number }[] = [];
let harmSum = 0;
for (let n = 1; n <= 15; n++) {
  harmSum += 1 / n;
  if (harmSum <= yMax) harmPts.push({ x: n, y: harmSum });
}

const xTicks = [2, 4, 6, 8, 10, 12, 14];
const yTicks = [1, 2, 3, 4];
---

<figure class="ps" role="img" aria-label="Partial sums of geometric series converging to 1 versus harmonic series diverging">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {xTicks.map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="ps-grid" stroke-width="0.5" />
    ))}
    {yTicks.map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="ps-grid" stroke-width="0.5" />
    ))}

    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="ps-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="ps-axis" stroke-width="1.2" />

    {/* Convergence line at y = 1 */}
    <line x1={sx(xMin)} y1={sy(1)} x2={sx(xMax)} y2={sy(1)}
          class="ps-limit" stroke-width="1.5" stroke-dasharray="6,4" />

    {/* Geometric series dots and line */}
    {geoPts.length > 1 && (
      <polyline
        points={geoPts.map(p => `${sx(p.x)},${sy(p.y)}`).join(" ")}
        fill="none" class="ps-geo-line" stroke-width="1.5" />
    )}
    {geoPts.map(p => (
      <circle cx={sx(p.x)} cy={sy(p.y)} r="4" class="ps-geo-dot" />
    ))}

    {/* Harmonic series dots and line */}
    {harmPts.length > 1 && (
      <polyline
        points={harmPts.map(p => `${sx(p.x)},${sy(p.y)}`).join(" ")}
        fill="none" class="ps-harm-line" stroke-width="1.5" />
    )}
    {harmPts.map(p => (
      <circle cx={sx(p.x)} cy={sy(p.y)} r="4" class="ps-harm-dot" />
    ))}

    {/* Tick labels */}
    {xTicks.filter((_, i) => i % 2 === 0).map(v => (
      <text class="ps-tick" x={sx(v)} y={sy(0) + 16} font-size="10" text-anchor="middle">{v}</text>
    ))}
    {yTicks.map(v => (
      <text class="ps-tick" x={sx(0) - 8} y={sy(v) + 4} font-size="10" text-anchor="end">{v}</text>
    ))}
    <text class="ps-tick" x={sx(xMax) - 4} y={sy(0) + 16} font-size="10" text-anchor="end">n</text>
  </svg>
  <div class="ps-legend">
    <span class="ps-leg-item"><span class="ps-swatch ps-sw-geo"></span> geometric: sum of (1/2)^n → 1</span>
    <span class="ps-leg-item"><span class="ps-swatch ps-sw-harm"></span> harmonic: sum of 1/n → ∞</span>
    <span class="ps-leg-item"><span class="ps-swatch ps-sw-limit"></span> limit = 1</span>
  </div>
</figure>

<style>
  .ps { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ps svg { max-width:100%; height:auto; }
  .ps-grid { stroke:#333; }
  .ps-axis { stroke:#666; }
  .ps-limit { stroke:#f0883e; }
  .ps-geo-line { stroke:#58a6ff; }
  .ps-geo-dot { fill:#58a6ff; }
  .ps-harm-line { stroke:#f47067; }
  .ps-harm-dot { fill:#f47067; }
  .ps-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .ps-legend {
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .ps-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .ps-swatch { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .ps-sw-geo { background:#58a6ff; border-radius:50%; width:10px; height:10px; }
  .ps-sw-harm { background:#f47067; border-radius:50%; width:10px; height:10px; }
  .ps-sw-limit { background:none; border-bottom:2px dashed #f0883e; height:0; margin-top:6px; }
  :global([data-theme="light"]) .ps-grid { stroke:#ddd; }
  :global([data-theme="light"]) .ps-axis { stroke:#999; }
  :global([data-theme="light"]) .ps-limit { stroke:#b35900; }
  :global([data-theme="light"]) .ps-geo-line { stroke:#0550ae; }
  :global([data-theme="light"]) .ps-geo-dot { fill:#0550ae; }
  :global([data-theme="light"]) .ps-harm-line { stroke:#cf222e; }
  :global([data-theme="light"]) .ps-harm-dot { fill:#cf222e; }
  :global([data-theme="light"]) .ps-tick { fill:#666; }
  :global([data-theme="light"]) .ps-sw-geo { background:#0550ae; }
  :global([data-theme="light"]) .ps-sw-harm { background:#cf222e; }
  :global([data-theme="light"]) .ps-sw-limit { border-color:#b35900; }
</style>
