---
/**
 * VectorAddDiagram — shows vectors u = <2,5> and v = <-3,4>
 * with tip-to-tail addition giving u+v = <-1,9>.
 */
const w = 280;
const h = 280;
const pad = 35;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -5, xMax = 5, yMin = -1, yMax = 10;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;
---

<figure class="vad" role="img" aria-label="Vector addition: u + v shown tip-to-tail">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Grid */}
    {[-4,-2,0,2,4].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="vad-grid" stroke-width="0.5" />
    ))}
    {[0,2,4,6,8].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="vad-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="vad-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="vad-axis" stroke-width="1" />

    {/* Arrowhead marker definitions */}
    <defs>
      <marker id="vad-ah-blue" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#58a6ff" />
      </marker>
      <marker id="vad-ah-orange" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#f0883e" />
      </marker>
      <marker id="vad-ah-green" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#7ee787" />
      </marker>
    </defs>

    {/* Vector u: origin to (2,5) */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(2)} y2={sy(5)} class="vad-u" stroke-width="2.5" marker-end="url(#vad-ah-blue)" />
    {/* Vector v: from tip of u (2,5) to (2-3, 5+4) = (-1,9) */}
    <line x1={sx(2)} y1={sy(5)} x2={sx(-1)} y2={sy(9)} class="vad-v" stroke-width="2.5" marker-end="url(#vad-ah-orange)" />
    {/* Resultant u+v: origin to (-1,9) */}
    <line x1={sx(0)} y1={sy(0)} x2={sx(-1)} y2={sy(9)} class="vad-sum" stroke-width="2" stroke-dasharray="6,3" marker-end="url(#vad-ah-green)" />

    {/* Labels */}
    <text class="vad-u-lbl" x={sx(1.6)} y={sy(2.2)} font-size="12" font-weight="bold">u</text>
    <text class="vad-v-lbl" x={sx(0.8)} y={sy(7.5)} font-size="12" font-weight="bold">v</text>
    <text class="vad-sum-lbl" x={sx(-2.5)} y={sy(5)} font-size="11" font-weight="bold">u + v</text>
  </svg>
</figure>

<style>
  .vad { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .vad svg { max-width:100%; height:auto; }
  .vad-grid { stroke:#333; }
  .vad-axis { stroke:#666; }
  .vad-u { stroke:#58a6ff; }
  .vad-v { stroke:#f0883e; }
  .vad-sum { stroke:#7ee787; }
  .vad-u-lbl { fill:#58a6ff; font-family:'Libre Baskerville',Georgia,serif; }
  .vad-v-lbl { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; }
  .vad-sum-lbl { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .vad-grid { stroke:#ddd; }
  :global([data-theme="light"]) .vad-axis { stroke:#999; }
  :global([data-theme="light"]) .vad-u { stroke:#0969da; }
  :global([data-theme="light"]) .vad-v { stroke:#d4700a; }
  :global([data-theme="light"]) .vad-sum { stroke:#1a7f37; }
  :global([data-theme="light"]) .vad-u-lbl { fill:#0969da; }
  :global([data-theme="light"]) .vad-v-lbl { fill:#d4700a; }
  :global([data-theme="light"]) .vad-sum-lbl { fill:#1a7f37; }
</style>
