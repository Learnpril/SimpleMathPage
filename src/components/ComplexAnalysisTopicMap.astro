---
/**
 * ComplexAnalysisTopicMap - the five areas of the section and how they depend
 * on each other. Everything follows from one condition: complex
 * differentiability, which is far stronger than it looks.
 */
const bw = 152;
const bh = 54;
const gap = 22;
const margin = 14;
const w = margin * 2 + 3 * bw + 2 * gap;
const h = 254;
const row1Y = 34;
const row2Y = 148;
const colX = (i: number) => margin + i * (bw + gap);

const areas = [
  { x: colX(0), y: row1Y, label: "The plane", sub: "modulus and argument", cls: "green" },
  { x: colX(1), y: row1Y, label: "Analytic functions", sub: "Cauchy–Riemann", cls: "blue" },
  { x: colX(2), y: row1Y, label: "Contour integrals", sub: "Cauchy's theorem", cls: "purple" },
  { x: colX(1), y: row2Y, label: "Series", sub: "Taylor and Laurent", cls: "orange" },
  { x: colX(2), y: row2Y, label: "Residues", sub: "real integrals, solved", cls: "pink" },
];
---

<figure
  class="catm"
  role="img"
  aria-label="Topic map of Complex Analysis: the geometry of the complex plane supports analytic functions defined by the Cauchy-Riemann equations, which make contour integration work, and both lead to power and Laurent series, whose coefficients give the residue calculus"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Top row, left to right */}
    <line x1={colX(0) + bw} y1={row1Y + bh / 2} x2={colX(1) - 3} y2={row1Y + bh / 2} class="catm-link" marker-end="url(#catm-head)" />
    <line x1={colX(1) + bw} y1={row1Y + bh / 2} x2={colX(2) - 3} y2={row1Y + bh / 2} class="catm-link" marker-end="url(#catm-head)" />

    {/* Down into series, and across into residues */}
    <line x1={colX(1) + bw / 2} y1={row1Y + bh} x2={colX(1) + bw / 2} y2={row2Y - 3} class="catm-link" marker-end="url(#catm-head)" />
    <line x1={colX(2) + bw / 2} y1={row1Y + bh} x2={colX(2) + bw / 2} y2={row2Y - 3} class="catm-link" marker-end="url(#catm-head)" />
    <line x1={colX(1) + bw} y1={row2Y + bh / 2} x2={colX(2) - 3} y2={row2Y + bh / 2} class="catm-link" marker-end="url(#catm-head)" />

    {areas.map((a) => (
      <g>
        <rect x={a.x} y={a.y} width={bw} height={bh} rx="8" class={`catm-box catm-${a.cls}`} />
        <text x={a.x + bw / 2} y={a.y + 23} class={`catm-label catm-t-${a.cls}`} font-size="13" text-anchor="middle" font-weight="bold">{a.label}</text>
        <text x={a.x + bw / 2} y={a.y + 41} class="catm-sub" font-size="10" text-anchor="middle">{a.sub}</text>
      </g>
    ))}

    <text x={w / 2} y="228" class="catm-foot" font-size="10.5" text-anchor="middle">
      One hypothesis drives the whole section: the derivative exists as a complex limit
    </text>
    <text x={w / 2} y="245" class="catm-sub" font-size="9.5" text-anchor="middle">
      That single condition forces infinite differentiability, rigidity, and a working integral calculus
    </text>

    <defs>
      <marker id="catm-head" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="catm-head-fill" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .catm { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .catm svg { width:100%; max-width:100%; height:auto; }
  .catm-box { fill:none; stroke-width:2; }
  .catm-green { stroke:#7ee787; }
  .catm-blue { stroke:#58a6ff; }
  .catm-purple { stroke:#d2a8ff; }
  .catm-orange { stroke:#f0883e; }
  .catm-pink { stroke:#ff7b72; }
  .catm-label { font-family:'Libre Baskerville',Georgia,serif; }
  .catm-t-green { fill:#7ee787; }
  .catm-t-blue { fill:#58a6ff; }
  .catm-t-purple { fill:#d2a8ff; }
  .catm-t-orange { fill:#f0883e; }
  .catm-t-pink { fill:#ff7b72; }
  .catm-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .catm-link { stroke:#888; stroke-width:1.5; }
  .catm-head-fill { fill:#888; }
  .catm-foot { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .catm-green { stroke:#116329; }
  :global([data-theme="light"]) .catm-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .catm-purple { stroke:#6639ba; }
  :global([data-theme="light"]) .catm-orange { stroke:#b35900; }
  :global([data-theme="light"]) .catm-pink { stroke:#a40e26; }
  :global([data-theme="light"]) .catm-t-green { fill:#116329; }
  :global([data-theme="light"]) .catm-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .catm-t-purple { fill:#6639ba; }
  :global([data-theme="light"]) .catm-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .catm-t-pink { fill:#a40e26; }
  :global([data-theme="light"]) :is(.catm-sub, .catm-foot) { fill:#57606a; }
  :global([data-theme="light"]) .catm-link { stroke:#555; }
  :global([data-theme="light"]) .catm-head-fill { fill:#555; }
</style>
