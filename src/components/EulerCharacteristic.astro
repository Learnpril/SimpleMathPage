---
/**
 * EulerCharacteristic - V − E + F computed for several polyhedra and for two
 * triangulations of the torus. The counts are stored and χ is derived from them, and
 * the surface each one lies on is identified from the resulting value.
 */
const w = 540;
const h = 306;

type Row = { name: string; V: number; E: number; F: number; note: string };

const rows: Row[] = [
  { name: "tetrahedron", V: 4, E: 6, F: 4, note: "4 triangles" },
  { name: "cube", V: 8, E: 12, F: 6, note: "6 squares" },
  { name: "octahedron", V: 6, E: 12, F: 8, note: "8 triangles" },
  { name: "icosahedron", V: 12, E: 30, F: 20, note: "20 triangles" },
  { name: "torus, coarse", V: 9, E: 27, F: 18, note: "3 × 3 grid, triangulated" },
  { name: "torus, finer", V: 16, E: 48, F: 32, note: "4 × 4 grid, triangulated" },
];

const table = rows.map((r) => {
  const chi = r.V - r.E + r.F;
  const surface = chi === 2 ? "sphere" : chi === 0 ? "torus" : chi === 1 ? "ℝP²" : `genus ${(2 - chi) / 2}`;
  return { ...r, chi, surface };
});

const spheres = table.filter((r) => r.chi === 2).length;
const tori = table.filter((r) => r.chi === 0).length;

const rowY = (i: number) => 100 + i * 26;
const cols = { name: 24, v: 196, e: 240, f: 284, chi: 344, surf: 430 };
---

<figure
  class="euc"
  role="img"
  aria-label={`A table of vertex, edge and face counts for six subdivisions. The four polyhedra all give Euler characteristic 2 and so all lie on a sphere. Both triangulations of the torus give 0, despite having different counts, which shows the value depends on the surface and not on the subdivision.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="euc-head" font-size="12.5" font-weight="bold">V − E + F does not depend on how you cut it up</text>
    <text x="16" y="38" class="euc-sub" font-size="10.5">Different subdivisions of the same surface give the same number</text>

    <text x={cols.name} y="72" class="euc-hdr" font-size="9.5" text-anchor="start">subdivision</text>
    <text x={cols.v} y="72" class="euc-hdr" font-size="9.5" text-anchor="end">V</text>
    <text x={cols.e} y="72" class="euc-hdr" font-size="9.5" text-anchor="end">E</text>
    <text x={cols.f} y="72" class="euc-hdr" font-size="9.5" text-anchor="end">F</text>
    <text x={cols.chi} y="72" class="euc-hdr" font-size="9.5" text-anchor="end">χ</text>
    <text x={cols.surf} y="72" class="euc-hdr" font-size="9.5" text-anchor="start">surface</text>

    <line x1="20" y1="80" x2="516" y2="80" class="euc-rule" />

    {table.map((r, i) => (
      <g>
        <text x={cols.name} y={rowY(i)} class="euc-name" font-size="9.5" text-anchor="start">{r.name}</text>
        <text x={cols.v} y={rowY(i)} class="euc-num" font-size="9.5" text-anchor="end">{String(r.V)}</text>
        <text x={cols.e} y={rowY(i)} class="euc-num" font-size="9.5" text-anchor="end">{String(r.E)}</text>
        <text x={cols.f} y={rowY(i)} class="euc-num" font-size="9.5" text-anchor="end">{String(r.F)}</text>
        <text x={cols.chi} y={rowY(i)} class={`euc-chi euc-${r.chi === 2 ? "s" : "t"}`} font-size="10.5" text-anchor="end" font-weight="bold">{String(r.chi)}</text>
        <text x={cols.surf} y={rowY(i)} class={`euc-surf euc-${r.chi === 2 ? "s" : "t"}`} font-size="9.5" text-anchor="start">{r.surface}</text>
      </g>
    ))}

    <line x1="20" y1="234" x2="516" y2="234" class="euc-rule" />

    <text x={w / 2} y="258" class="euc-foot" font-size="10.5" text-anchor="middle">
      {`${spheres} subdivisions of the sphere all give 2; ${tori} of the torus both give 0`}
    </text>
    <text x={w / 2} y="278" class="euc-sub2" font-size="9.5" text-anchor="middle">
      The counts differ wildly while the alternating sum does not - that is what makes it an invariant
    </text>
    <text x={w / 2} y="296" class="euc-sub2" font-size="9.5" text-anchor="middle">
      Subdividing a face adds one vertex and one edge, or one edge and one face, leaving χ unchanged
    </text>
  </svg>
</figure>

<style>
  .euc { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .euc svg { width:100%; max-width:100%; height:auto; }
  .euc-rule { stroke:#3a3a3a; stroke-width:1; }
  .euc-hdr { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .euc-name, .euc-num { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .euc-chi, .euc-surf { font-family:'Libre Baskerville',Georgia,serif; }
  .euc-s { fill:#7ee787; }
  .euc-t { fill:#58a6ff; }
  .euc-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .euc-sub, .euc-sub2 { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .euc-foot { fill:#7ee787; font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .euc-rule { stroke:#d0d7de; }
  :global([data-theme="light"]) .euc-s { fill:#116329; }
  :global([data-theme="light"]) .euc-t { fill:#0550ae; }
  :global([data-theme="light"]) .euc-head { fill:#24292f; }
  :global([data-theme="light"]) .euc-foot { fill:#116329; }
  :global([data-theme="light"]) :is(.euc-hdr, .euc-name, .euc-num, .euc-sub, .euc-sub2) { fill:#57606a; }
</style>
