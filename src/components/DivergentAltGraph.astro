---
/**
 * DivergentAltGraph — partial sums of sum (-1)^(n+1) * n/(n+1)
 * which diverges because the terms approach ±1, not 0.
 * The partial sums bounce between ~0 and ~1 without settling.
 */
const w = 420;
const h = 260;
const pad = 55;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = 0, xMax = 22, yMin = -0.6, yMax = 1.4;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const N = 20;
const pts: { x: number; y: number }[] = [];
let sum = 0;
for (let n = 1; n <= N; n++) {
  sum += Math.pow(-1, n + 1) * (n / (n + 1));
  pts.push({ x: n, y: sum });
}

const xTicks = [5, 10, 15, 20];
const yTicks = [-0.5, 0, 0.5, 1.0];
---

<figure class="dag" role="img" aria-label="Partial sums of divergent alternating series bouncing between 0 and 1 without converging">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {xTicks.map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="dag-grid" stroke-width="0.5" />
    ))}
    {yTicks.map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="dag-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="dag-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="dag-axis" stroke-width="1.2" />

    {/* Zigzag line */}
    <polyline
      points={pts.map(p => `${sx(p.x)},${sy(p.y)}`).join(" ")}
      fill="none" class="dag-line" stroke-width="1.5" />

    {/* Dots */}
    {pts.map(p => (
      <circle cx={sx(p.x)} cy={sy(p.y)} r="3.5" class="dag-dot" />
    ))}

    {xTicks.map(v => (
      <text class="dag-tick" x={sx(v)} y={sy(0) + 16} font-size="10" text-anchor="middle">{v}</text>
    ))}
    {yTicks.filter(v => v !== 0).map(v => (
      <text class="dag-tick" x={sx(0) - 8} y={sy(v) + 4} font-size="10" text-anchor="end">{v}</text>
    ))}
    <text class="dag-tick" x={sx(xMax) - 2} y={sy(0) + 16} font-size="10" text-anchor="end">n</text>
  </svg>
  <div class="dag-legend">
    <span class="dag-leg-item"><span class="dag-swatch dag-sw-dot"></span> partial sums bounce, never settle (diverges)</span>
  </div>
</figure>

<style>
  .dag { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .dag svg { max-width:100%; height:auto; }
  .dag-grid { stroke:#333; }
  .dag-axis { stroke:#666; }
  .dag-line { stroke:#f47067; opacity:0.5; }
  .dag-dot { fill:#f47067; }
  .dag-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .dag-legend {
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .dag-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .dag-swatch { display:inline-block; border-radius:50%; width:10px; height:10px; }
  .dag-sw-dot { background:#f47067; }
  :global([data-theme="light"]) .dag-grid { stroke:#ddd; }
  :global([data-theme="light"]) .dag-axis { stroke:#999; }
  :global([data-theme="light"]) .dag-line { stroke:#cf222e; }
  :global([data-theme="light"]) .dag-dot { fill:#cf222e; }
  :global([data-theme="light"]) .dag-tick { fill:#666; }
  :global([data-theme="light"]) .dag-sw-dot { background:#cf222e; }
</style>
