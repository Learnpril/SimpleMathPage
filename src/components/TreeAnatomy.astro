---
/**
 * TreeAnatomy — a rooted tree with the vocabulary labelled: root, internal
 * vertices, leaves, and depth levels. 7 vertices and 6 edges, as every tree must.
 */
const w = 480;
const h = 288;
const N = {
  R: { x: 200, y: 46, kind: "root" },
  A: { x: 120, y: 110, kind: "internal" },
  B: { x: 280, y: 110, kind: "internal" },
  C: { x: 70, y: 178, kind: "leaf" },
  D: { x: 170, y: 178, kind: "leaf" },
  E: { x: 280, y: 178, kind: "internal" },
  F: { x: 240, y: 232, kind: "leaf" },
  G: { x: 330, y: 232, kind: "leaf" },
} as const;
type Key = keyof typeof N;
const edges: [Key, Key][] = [
  ["R", "A"],
  ["R", "B"],
  ["A", "C"],
  ["A", "D"],
  ["B", "E"],
  ["E", "F"],
  ["E", "G"],
];
const levels = [
  { y: 46, label: "depth 0" },
  { y: 110, label: "depth 1" },
  { y: 178, label: "depth 2" },
  { y: 232, label: "depth 3" },
];
---

<figure
  class="tra"
  role="img"
  aria-label="A rooted tree with root R, internal vertices A, B and E, and leaves C, D, F and G, arranged over four depth levels"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {/* Depth guides */}
    {levels.map((l) => (
      <g>
        <line x1="14" y1={l.y} x2={w - 90} y2={l.y} class="tra-level" stroke-dasharray="2,4" />
        <text x={w - 84} y={l.y + 4} class="tra-level-lbl" font-size="9">{l.label}</text>
      </g>
    ))}

    {/* Edges */}
    {edges.map(([a, b]) => (
      <line x1={N[a].x} y1={N[a].y} x2={N[b].x} y2={N[b].y} class="tra-edge" />
    ))}

    {/* Vertices */}
    {(Object.keys(N) as Key[]).map((k) => (
      <g>
        <circle cx={N[k].x} cy={N[k].y} r="15" class={`tra-node tra-${N[k].kind}`} />
        <text x={N[k].x} y={N[k].y + 5} class="tra-vl" font-size="12.5" font-weight="bold" text-anchor="middle">{k}</text>
      </g>
    ))}

    {/* Callouts */}
    <text x={N.R.x + 24} y={N.R.y - 6} class="tra-call tra-c-purple" font-size="10">root</text>
    <text x={N.C.x - 20} y={N.C.y + 30} class="tra-call tra-c-green" font-size="10" text-anchor="middle">leaf</text>
    <text x={N.B.x + 24} y={N.B.y - 4} class="tra-call tra-c-blue" font-size="10">internal</text>

    {/* Legend */}
    <circle cx="24" cy="26" r="6" class="tra-node tra-root" />
    <text x="35" y="30" class="tra-legend" font-size="9">root</text>
    <circle cx="80" cy="26" r="6" class="tra-node tra-internal" />
    <text x="91" y="30" class="tra-legend" font-size="9">internal</text>
    <circle cx="150" cy="26" r="6" class="tra-node tra-leaf" />
    <text x="161" y="30" class="tra-legend" font-size="9">leaf</text>

    <text x={w / 2} y="278" class="tra-foot" font-size="10.5" text-anchor="middle">
      7 vertices, 6 edges, height 3 — every tree has exactly one fewer edge than vertices
    </text>
  </svg>
</figure>

<style>
  .tra { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .tra svg { max-width:100%; height:auto; }
  .tra-edge { stroke:#888; stroke-width:2; }
  .tra-node { fill:#121212; stroke-width:2.4; }
  .tra-root { stroke:#d2a8ff; }
  .tra-internal { stroke:#58a6ff; }
  .tra-leaf { stroke:#7ee787; }
  .tra-vl { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .tra-level { stroke:#444; }
  .tra-level-lbl { fill:#666; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .tra-call { font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .tra-c-purple { fill:#d2a8ff; }
  .tra-c-blue { fill:#58a6ff; }
  .tra-c-green { fill:#7ee787; }
  .tra-legend { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .tra-foot { fill:#f0883e; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .tra-edge { stroke:#666; }
  :global([data-theme="light"]) .tra-node { fill:#ffffff; }
  :global([data-theme="light"]) .tra-root { stroke:#6639ba; }
  :global([data-theme="light"]) .tra-internal { stroke:#0550ae; }
  :global([data-theme="light"]) .tra-leaf { stroke:#116329; }
  :global([data-theme="light"]) .tra-vl { fill:#24292f; }
  :global([data-theme="light"]) .tra-level { stroke:#ddd; }
  :global([data-theme="light"]) .tra-c-purple { fill:#6639ba; }
  :global([data-theme="light"]) .tra-c-blue { fill:#0550ae; }
  :global([data-theme="light"]) .tra-c-green { fill:#116329; }
  :global([data-theme="light"]) .tra-foot { fill:#b35900; }
</style>
