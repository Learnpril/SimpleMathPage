---
/**
 * EndBehaviorDiagram — shows the four end behavior cases
 * in a 2x2 grid: even/odd degree × positive/negative leading coefficient.
 */
const cellW = 160;
const cellH = 120;
const pad = 10;
const gap = 16;
const w = 2 * cellW + gap + 2 * pad;
const h = 2 * cellH + gap + 2 * pad + 30; // extra for header

const cases = [
  { label: 'Even +', desc: 'Both ends up', example: 'y = x²',
    pts: [[0.15,0.7],[0.35,0.95],[0.5,0.55],[0.65,0.95],[0.85,0.7]] },
  { label: 'Even −', desc: 'Both ends down', example: 'y = −x²',
    pts: [[0.15,0.3],[0.35,0.05],[0.5,0.45],[0.65,0.05],[0.85,0.3]] },
  { label: 'Odd +', desc: 'Down-left, up-right', example: 'y = x³',
    pts: [[0.1,0.85],[0.3,0.7],[0.5,0.5],[0.7,0.3],[0.9,0.15]] },
  { label: 'Odd −', desc: 'Up-left, down-right', example: 'y = −x³',
    pts: [[0.1,0.15],[0.3,0.3],[0.5,0.5],[0.7,0.7],[0.9,0.85]] },
];

const colors = ['#58a6ff', '#f47067', '#7ee787', '#d2a8ff'];
---

<figure class="ebd" role="img" aria-label="Four end behavior cases for polynomials">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {cases.map((c, i) => {
      const col = i % 2;
      const row = Math.floor(i / 2);
      const x = pad + col * (cellW + gap);
      const y = pad + row * (cellH + gap);
      const color = colors[i];
      // Convert normalized points to cell coordinates
      const polyPts = c.pts.map(([px, py]) =>
        `${(x + px * cellW).toFixed(1)},${(y + (1 - py) * cellH).toFixed(1)}`
      ).join(' ');
      return (
        <g>
          <rect x={x} y={y} width={cellW} height={cellH} rx="8" class="ebd-card" />
          <polyline points={polyPts} fill="none" stroke={color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <text x={x + cellW / 2} y={y + cellH + 13} font-size="11" text-anchor="middle" class="ebd-lbl" fill={color} font-weight="bold">{c.label}: {c.desc}</text>
        </g>
      );
    })}
  </svg>
</figure>

<style>
  .ebd { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .ebd svg { max-width:100%; height:auto; }
  .ebd-card { fill:#1c2128; stroke:#444; stroke-width:1; }
  .ebd-lbl { font-family:'Libre Baskerville',Georgia,serif; }
  :global([data-theme="light"]) .ebd-card { fill:#f0f0f0; stroke:#ccc; }
</style>
