---
/**
 * DefiniteIntegralArea — shows f(x) = x² with shaded area from x=1 to x=3.
 * The shaded region represents the definite integral ∫₁³ x² dx.
 */
const w = 440;
const h = 300;
const pad = 55;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -0.5, xMax = 4, yMin = 0, yMax = 10;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const f = (x: number) => x * x;

// Curve points
const curvePts: string[] = [];
for (let i = 0; i <= 80; i++) {
  const x = xMin + i * (xMax - xMin) / 80;
  const y = f(x);
  if (y <= yMax) curvePts.push(`${sx(x)},${sy(y)}`);
}

// Shaded area polygon: from (1,0) up along curve to (3,9) back down to (3,0)
const shadePts: string[] = [`${sx(1)},${sy(0)}`];
for (let i = 0; i <= 40; i++) {
  const x = 1 + i * 2 / 40;
  shadePts.push(`${sx(x)},${sy(f(x))}`);
}
shadePts.push(`${sx(3)},${sy(0)}`);
---

<figure class="dia" role="img" aria-label="Shaded area under x squared from 1 to 3 representing the definite integral">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {[0,1,2,3].map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="dia-grid" stroke-width="0.5" />
    ))}
    {[2,4,6,8].map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="dia-grid" stroke-width="0.5" />
    ))}
    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="dia-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="dia-axis" stroke-width="1.2" />

    {/* Shaded area */}
    <polygon points={shadePts.join(' ')} class="dia-shade" />

    {/* Curve */}
    <polyline points={curvePts.join(' ')} fill="none" class="dia-curve" stroke-width="3" />

    {/* Bound markers */}
    <text class="dia-tick" x={sx(1)} y={sy(0) + 18} font-size="11" text-anchor="middle">1</text>
    <text class="dia-tick" x={sx(3)} y={sy(0) + 18} font-size="11" text-anchor="middle">3</text>
  </svg>
  <div class="dia-legend">
    <span class="dia-leg-item"><span class="dia-swatch dia-sw-curve"></span> f(x) = x²</span>
    <span class="dia-leg-item"><span class="dia-swatch dia-sw-shade"></span> area = definite integral from 1 to 3</span>
  </div>
</figure>

<style>
  .dia { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .dia svg { max-width:100%; height:auto; }
  .dia-grid { stroke:#333; }
  .dia-axis { stroke:#666; }
  .dia-curve { stroke:#58a6ff; }
  .dia-shade { fill:rgba(126,231,135,0.25); stroke:none; }
  .dia-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .dia-legend {
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .dia-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .dia-swatch { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .dia-sw-curve { background:#58a6ff; height:4px; }
  .dia-sw-shade { background:rgba(126,231,135,0.4); }
  :global([data-theme="light"]) .dia-grid { stroke:#ddd; }
  :global([data-theme="light"]) .dia-axis { stroke:#999; }
  :global([data-theme="light"]) .dia-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .dia-shade { fill:rgba(17,99,41,0.15); }
  :global([data-theme="light"]) .dia-tick { fill:#666; }
  :global([data-theme="light"]) .dia-sw-curve { background:#0550ae; }
  :global([data-theme="light"]) .dia-sw-shade { background:rgba(17,99,41,0.25); }
</style>
