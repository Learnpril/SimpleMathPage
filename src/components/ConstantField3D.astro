---
/**
 * ConstantField3D - SVG side-view of the constant gravitational field
 * F(x,y,z) = <0, 0, -9.8> showing identical downward arrows at a grid
 * of points in the xz-plane.
 */
---

<figure class="diagram-container" role="img" aria-label="Constant gravitational vector field showing identical downward arrows at every point">
  <svg viewBox="-180 -160 360 340" width="360" height="340" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="cf-ah-d" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto">
        <path d="M0,0 L6,2 L0,4 Z" class="cf-arrow" />
      </marker>
    </defs>
    <!-- Axes -->
    <line x1="-150" y1="140" x2="150" y2="140" class="cf-axis" />
    <line x1="-130" y1="160" x2="-130" y2="-140" class="cf-axis" />
    <text x="155" y="145" class="cf-axis-label">x</text>
    <text x="-125" y="-145" class="cf-axis-label">z</text>
    <!-- Grid of identical downward arrows -->
    <!-- Each arrow: same length (30px), pointing straight down -->
    <!-- Row 1 (top) -->
    <line x1="-100" y1="-100" x2="-100" y2="-70" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="-40" y1="-100" x2="-40" y2="-70" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="20" y1="-100" x2="20" y2="-70" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="80" y1="-100" x2="80" y2="-70" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <!-- Row 2 -->
    <line x1="-100" y1="-40" x2="-100" y2="-10" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="-40" y1="-40" x2="-40" y2="-10" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="20" y1="-40" x2="20" y2="-10" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="80" y1="-40" x2="80" y2="-10" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <!-- Row 3 -->
    <line x1="-100" y1="20" x2="-100" y2="50" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="-40" y1="20" x2="-40" y2="50" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="20" y1="20" x2="20" y2="50" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="80" y1="20" x2="80" y2="50" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <!-- Row 4 (bottom) -->
    <line x1="-100" y1="80" x2="-100" y2="110" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="-40" y1="80" x2="-40" y2="110" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="20" y1="80" x2="20" y2="110" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <line x1="80" y1="80" x2="80" y2="110" class="cf-vec" marker-end="url(#cf-ah-d)" />
    <!-- Label -->
    <text x="0" y="170" text-anchor="middle" class="cf-label">Every arrow is identical: same direction, same length</text>
  </svg>
</figure>

<style>
  .cf-axis { stroke: #666; stroke-width: 1; }
  .cf-axis-label { font: bold 14px sans-serif; fill: #888; }
  .cf-vec { stroke: #f0883e; stroke-width: 2; }
  .cf-arrow { fill: #f0883e; }
  .cf-label { font: 12px 'Libre Baskerville', Georgia, serif; fill: #888; }
  [data-theme="light"] .cf-axis { stroke: #999; }
  [data-theme="light"] .cf-axis-label { fill: #666; }
  [data-theme="light"] .cf-vec { stroke: #b35900; stroke-width: 2; }
  [data-theme="light"] .cf-arrow { fill: #b35900; }
  [data-theme="light"] .cf-label { fill: #666; }
</style>
