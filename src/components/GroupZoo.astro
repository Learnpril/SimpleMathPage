---
/**
 * GroupZoo - the handful of groups worth knowing by heart, with their orders
 * and whether they commute. Almost every example in the section is one of these.
 */
const bw = 168;
const bh = 86;
const gap = 15;
const margin = 14;
const w = margin * 2 + 3 * bw + 2 * gap;
const h = 260;
const rows = [46, 140];
const colX = (i: number) => margin + i * (bw + gap);

const zoo = [
  { name: "(ℤ, +)", order: "order ∞", desc: "the model", desc2: "additive group", abelian: true, cls: "green" },
  { name: "(ℤₙ, +)", order: "order n", desc: "clock arithmetic,", desc2: "wraps at n", abelian: true, cls: "green" },
  { name: "U(n)", order: "order φ(n)", desc: "residues mod n", desc2: "that have inverses", abelian: true, cls: "blue" },
  { name: "Sₙ", order: "order n!", desc: "all rearrangements", desc2: "of n objects", abelian: false, cls: "purple" },
  { name: "Dₙ", order: "order 2n", desc: "symmetries of", desc2: "an n-gon", abelian: false, cls: "orange" },
  { name: "GLₙ(ℝ)", order: "order ∞", desc: "invertible", desc2: "n × n matrices", abelian: false, cls: "orange" },
];
---

<figure
  class="gzo"
  role="img"
  aria-label="A reference set of groups: the integers under addition, the integers mod n, the unit group U of n, the symmetric group S of n, the dihedral group D of n, and the general linear group, with their orders and whether each is abelian"
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="24" class="gzo-head" font-size="12.5" font-weight="bold">The groups worth knowing by heart</text>

    {zoo.map((g, i) => {
      const x = colX(i % 3);
      const y = rows[Math.floor(i / 3)];
      return (
        <g>
          <rect x={x} y={y} width={bw} height={bh} rx="8" class={`gzo-box gzo-${g.cls}`} />
          <text x={x + 14} y={y + 21} class={`gzo-name gzo-t-${g.cls}`} font-size="12.5" font-weight="bold">{g.name}</text>
          <text x={x + bw - 14} y={y + 21} class="gzo-order" font-size="9.5" text-anchor="end">{g.order}</text>
          <text x={x + 14} y={y + 42} class="gzo-desc" font-size="9.5">{g.desc}</text>
          <text x={x + 14} y={y + 57} class="gzo-desc" font-size="9.5">{g.desc2}</text>
          <text x={x + 14} y={y + 76} class={g.abelian ? "gzo-tag gzo-abelian" : "gzo-tag gzo-nonabelian"} font-size="9.5">
            {g.abelian ? "abelian" : "non-abelian"}
          </text>
        </g>
      );
    })}

    <text x={w / 2} y="248" class="gzo-foot" font-size="10" text-anchor="middle">
      Dₙ and Sₙ are non-abelian once n ≥ 3; test any new claim against one of these six
    </text>
  </svg>
</figure>

<style>
  .gzo { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .gzo svg { width:100%; max-width:100%; height:auto; }
  .gzo-box { fill:none; stroke-width:2; }
  .gzo-green { stroke:#7ee787; }
  .gzo-blue { stroke:#58a6ff; }
  .gzo-purple { stroke:#d2a8ff; }
  .gzo-orange { stroke:#f0883e; }
  .gzo-name { font-family:'Libre Baskerville',Georgia,serif; }
  .gzo-t-green { fill:#7ee787; }
  .gzo-t-blue { fill:#58a6ff; }
  .gzo-t-purple { fill:#d2a8ff; }
  .gzo-t-orange { fill:#f0883e; }
  .gzo-order { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; }
  .gzo-desc { fill:#c9d1d9; font-family:'Libre Baskerville',Georgia,serif; }
  .gzo-tag { font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  .gzo-abelian { fill:#7ee787; }
  .gzo-nonabelian { fill:#ff7b72; }
  .gzo-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .gzo-foot { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .gzo-green { stroke:#116329; }
  :global([data-theme="light"]) .gzo-blue { stroke:#0550ae; }
  :global([data-theme="light"]) .gzo-purple { stroke:#6639ba; }
  :global([data-theme="light"]) .gzo-orange { stroke:#b35900; }
  :global([data-theme="light"]) .gzo-t-green, :global([data-theme="light"]) .gzo-abelian { fill:#116329; }
  :global([data-theme="light"]) .gzo-t-blue { fill:#0550ae; }
  :global([data-theme="light"]) .gzo-t-purple { fill:#6639ba; }
  :global([data-theme="light"]) .gzo-t-orange { fill:#b35900; }
  :global([data-theme="light"]) .gzo-nonabelian { fill:#a40e26; }
  :global([data-theme="light"]) .gzo-desc { fill:#24292f; }
  :global([data-theme="light"]) :is(.gzo-order, .gzo-foot) { fill:#57606a; }
  :global([data-theme="light"]) .gzo-head { fill:#24292f; }
</style>
