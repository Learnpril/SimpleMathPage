---
/**
 * LinearDESolutionGraph - plots y = (1/3)x² - 1/(3x) for x > 0,
 * the solution to dy/dx + (1/x)y = x with y(1) = 0.
 * Shows the initial point (1, 0) and the parabolic-ish curve.
 */
const w = 420;
const h = 320;
const pad = 50;
const gw = w - 2 * pad;
const gh = h - 2 * pad;
const xMin = -0.5, xMax = 4, yMin = -3, yMax = 6;
const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * gw;
const sy = (y: number) => pad + ((yMax - y) / (yMax - yMin)) * gh;

const f = (x: number) => (1 / 3) * x * x - 1 / (3 * x);

// Curve for x > 0.08 (avoid blowup near 0)
const pts: string[] = [];
for (let i = 0; i <= 300; i++) {
  const x = 0.08 + (i / 300) * (xMax - 0.08);
  const y = f(x);
  if (y >= yMin && y <= yMax) pts.push(`${sx(x)},${sy(y)}`);
}

const xTicks = [0, 1, 2, 3];
const yTicks = [-2, 0, 2, 4];
---

<figure class="lde" role="img" aria-label="Graph of y = one third x squared minus one over 3x with initial point at (1, 0)">
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    {xTicks.map(v => (
      <line x1={sx(v)} y1={sy(yMin)} x2={sx(v)} y2={sy(yMax)} class="lde-grid" stroke-width="0.5" />
    ))}
    {yTicks.map(v => (
      <line x1={sx(xMin)} y1={sy(v)} x2={sx(xMax)} y2={sy(v)} class="lde-grid" stroke-width="0.5" />
    ))}

    <line x1={sx(xMin)} y1={sy(0)} x2={sx(xMax)} y2={sy(0)} class="lde-axis" stroke-width="1.5" />
    <line x1={sx(0)} y1={sy(yMin)} x2={sx(0)} y2={sy(yMax)} class="lde-axis" stroke-width="1.2" />

    {/* Solution curve */}
    <polyline points={pts.join(" ")} fill="none" class="lde-curve" stroke-width="2.5" />

    {/* Initial point (1, 0) */}
    <circle cx={sx(1)} cy={sy(0)} r="5" class="lde-dot" />

    {/* Tick labels */}
    {xTicks.filter(v => v !== 0).map(v => (
      <text class="lde-tick" x={sx(v)} y={sy(0) + 16} font-size="10" text-anchor="middle">{v}</text>
    ))}
    {yTicks.filter(v => v !== 0).map(v => (
      <text class="lde-tick" x={sx(0) - 8} y={sy(v) + 4} font-size="10" text-anchor="end">{v}</text>
    ))}
  </svg>
  <div class="lde-legend">
    <span class="lde-leg-item"><span class="lde-swatch lde-sw-curve"></span> y = (1/3)x² − 1/(3x)</span>
    <span class="lde-leg-item"><span class="lde-swatch lde-sw-dot"></span> initial point (1, 0)</span>
  </div>
</figure>

<style>
  .lde { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .lde svg { max-width:100%; height:auto; }
  .lde-grid { stroke:#333; }
  .lde-axis { stroke:#666; }
  .lde-curve { stroke:#58a6ff; }
  .lde-dot { fill:#7ee787; stroke:#7ee787; }
  .lde-tick { fill:#888; font-family:'Libre Baskerville',Georgia,serif; }
  .lde-legend {
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;
    margin-top:0.5rem; font-family:'Libre Baskerville',Georgia,serif; font-size:0.82rem;
  }
  .lde-leg-item { display:flex; align-items:center; gap:0.35rem; }
  .lde-swatch { display:inline-block; width:18px; height:12px; border-radius:2px; }
  .lde-sw-curve { background:#58a6ff; height:4px; }
  .lde-sw-dot { background:#7ee787; border-radius:50%; width:10px; height:10px; }
  :global([data-theme="light"]) .lde-grid { stroke:#ddd; }
  :global([data-theme="light"]) .lde-axis { stroke:#999; }
  :global([data-theme="light"]) .lde-curve { stroke:#0550ae; }
  :global([data-theme="light"]) .lde-dot { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .lde-tick { fill:#666; }
  :global([data-theme="light"]) .lde-sw-curve { background:#0550ae; }
  :global([data-theme="light"]) .lde-sw-dot { background:#116329; }
</style>
