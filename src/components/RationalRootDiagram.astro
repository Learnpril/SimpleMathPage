---
/**
 * RationalRootDiagram - shows how p/q candidates come from
 * the constant term and leading coefficient of 2x³ − 5x² − 4x + 3.
 * Highlights the two key numbers, their factors, and the resulting list.
 */
---

<figure class="rr-diagram" role="img" aria-label="Rational Root Theorem: factors of constant term over factors of leading coefficient">
  <figcaption class="rr-title">How the Rational Root Theorem generates candidates</figcaption>
  <svg viewBox="0 0 440 260" width="440" height="260" xmlns="http://www.w3.org/2000/svg">

    {/* Polynomial as one line - 2x³ − 5x² − 4x + 3 with colored highlights */}
    <text class="rr-lead" x="110" y="38" font-size="24" text-anchor="end" font-weight="bold">2</text>
    <text class="rr-poly" x="112" y="38" font-size="20" text-anchor="start">x³ − 5x² − 4x +</text>
    <text class="rr-const" x="330" y="38" font-size="24" text-anchor="start" font-weight="bold">3</text>

    {/* Underline highlights */}
    <line class="rr-lead-line" x1="92" y1="44" x2="110" y2="44" stroke-width="3" />
    <line class="rr-const-line" x1="330" y1="44" x2="348" y2="44" stroke-width="3" />

    {/* Arrow down from leading coefficient */}
    <line class="rr-arrow-q" x1="101" y1="50" x2="101" y2="80" stroke-width="1.5" />
    <text class="rr-q-title" x="101" y="98" font-size="12" text-anchor="middle" font-weight="bold">q factors</text>
    <text class="rr-q-title" x="101" y="112" font-size="10" text-anchor="middle">(leading coeff)</text>

    {/* q factors box */}
    <rect class="rr-q-box" x="53" y="120" width="96" height="36" rx="6" />
    <text class="rr-q-vals" x="101" y="143" font-size="16" text-anchor="middle" font-weight="bold">±1, ±2</text>

    {/* Arrow down from constant term */}
    <line class="rr-arrow-p" x1="339" y1="50" x2="339" y2="80" stroke-width="1.5" />
    <text class="rr-p-title" x="339" y="98" font-size="12" text-anchor="middle" font-weight="bold">p factors</text>
    <text class="rr-p-title" x="339" y="112" font-size="10" text-anchor="middle">(constant term)</text>

    {/* p factors box */}
    <rect class="rr-p-box" x="291" y="120" width="96" height="36" rx="6" />
    <text class="rr-p-vals" x="339" y="143" font-size="16" text-anchor="middle" font-weight="bold">±1, ±3</text>

    {/* Merge arrows: both boxes → result */}
    <line class="rr-merge" x1="149" y1="138" x2="185" y2="205" stroke-width="1.5" stroke-dasharray="4,3" />
    <line class="rr-merge" x1="291" y1="138" x2="255" y2="205" stroke-width="1.5" stroke-dasharray="4,3" />

    {/* Formula label - centered, above the merge lines */}
    <text class="rr-formula" x="220" y="178" font-size="13" text-anchor="middle">p / q =</text>

    {/* Result box */}
    <rect class="rr-result-box" x="60" y="200" width="320" height="40" rx="8" />
    <text class="rr-result" x="220" y="226" font-size="15" text-anchor="middle" font-weight="bold">±1, ±3, ±1/2, ±3/2</text>

    {/* Label under result */}
    <text class="rr-result-sub" x="220" y="254" font-size="11" text-anchor="middle">Possible rational roots to test</text>

  </svg>
</figure>

<style>
  .rr-diagram { display: flex; flex-direction: column; align-items: center; margin: 1.5rem 0; }
  .rr-title { font-size: 0.95rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; font-style: italic; }
  .rr-diagram svg { max-width: 100%; height: auto; }

  .rr-poly { fill: #aaa; font-family: 'Libre Baskerville', Georgia, serif; }
  .rr-lead { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .rr-lead-line { stroke: #58a6ff; }
  .rr-const { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }
  .rr-const-line { stroke: #7ee787; }

  .rr-arrow-q { stroke: #58a6ff; }
  .rr-q-title { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }
  .rr-q-box { fill: none; stroke: #58a6ff; stroke-width: 2; }
  .rr-q-vals { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; }

  .rr-arrow-p { stroke: #7ee787; }
  .rr-p-title { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }
  .rr-p-box { fill: none; stroke: #7ee787; stroke-width: 2; }
  .rr-p-vals { fill: #7ee787; font-family: 'Libre Baskerville', Georgia, serif; }

  .rr-merge { stroke: #888; }
  .rr-formula { fill: #aaa; font-family: 'Libre Baskerville', Georgia, serif; }
  .rr-result-box { fill: none; stroke: #f0c674; stroke-width: 2; }
  .rr-result { fill: #f0c674; font-family: 'Libre Baskerville', Georgia, serif; }
  .rr-result-sub { fill: #999; font-family: 'Libre Baskerville', Georgia, serif; }

  :global([data-theme="light"]) .rr-poly { fill: #444; }
  :global([data-theme="light"]) .rr-lead { fill: #0550ae; }
  :global([data-theme="light"]) .rr-lead-line { stroke: #0550ae; }
  :global([data-theme="light"]) .rr-const { fill: #116329; }
  :global([data-theme="light"]) .rr-const-line { stroke: #116329; }
  :global([data-theme="light"]) .rr-arrow-q { stroke: #0550ae; }
  :global([data-theme="light"]) .rr-q-title { fill: #0550ae; }
  :global([data-theme="light"]) .rr-q-box { stroke: #0550ae; }
  :global([data-theme="light"]) .rr-q-vals { fill: #0550ae; }
  :global([data-theme="light"]) .rr-arrow-p { stroke: #116329; }
  :global([data-theme="light"]) .rr-p-title { fill: #116329; }
  :global([data-theme="light"]) .rr-p-box { stroke: #116329; }
  :global([data-theme="light"]) .rr-p-vals { fill: #116329; }
  :global([data-theme="light"]) .rr-merge { stroke: #aaa; }
  :global([data-theme="light"]) .rr-formula { fill: #555; }
  :global([data-theme="light"]) .rr-result-box { stroke: #b45309; }
  :global([data-theme="light"]) .rr-result { fill: #b45309; }
  :global([data-theme="light"]) .rr-result-sub { fill: #666; }
</style>
