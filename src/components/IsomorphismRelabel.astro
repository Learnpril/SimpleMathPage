---
/**
 * IsomorphismRelabel — ℤ₄ under addition and U(5) under multiplication are the
 * same group with different names, and the dictionary is k ↦ 2ᵏ mod 5.
 *
 * The correspondence is computed by taking powers of 2 modulo 5, and the worked
 * check at the bottom is derived from it too, so the example cannot be wrong.
 */
const modulus = 5;
const base = 2;
const size = 4;

// The dictionary: k ↦ baseᵏ mod modulus
const dict = Array.from({ length: size }, (_, k) => {
  let v = 1;
  for (let i = 0; i < k; i++) v = (v * base) % modulus;
  return { k, v };
});

// A matched computation on both sides: pick a + b in ℤ₄ and its image
const a = 1;
const b = 2;
const sum = (a + b) % size;
const prodLeft = dict[a].v;
const prodRight = dict[b].v;
const prod = (prodLeft * prodRight) % modulus;

const w = 540;
const h = 292;
const boxW = 120;
const boxH = 34;
const leftX = 70;
const rightX = 350;
const rowY = Array.from({ length: size }, (_, i) => 92 + i * 44);
---

<figure
  class="iso"
  role="img"
  aria-label={`The integers mod 4 under addition and the unit group of 5 under multiplication are isomorphic. The dictionary sends k to 2 to the power k modulo 5, matching 0,1,2,3 with ${dict.map((d) => d.v).join(", ")}. Adding on the left corresponds to multiplying on the right.`}
>
  <svg viewBox={`0 0 ${w} ${h}`} width={w} height={h} xmlns="http://www.w3.org/2000/svg">
    <text x="16" y="20" class="iso-head" font-size="12.5" font-weight="bold">The same group in two costumes</text>

    <text x={leftX + boxW / 2} y="66" class="iso-colhdr iso-t-blue" font-size="11" text-anchor="middle" font-weight="bold">ℤ₄ under +</text>
    <text x={w / 2} y="66" class="iso-dict" font-size="10" text-anchor="middle">{`k ↦ ${base}ᵏ mod ${modulus}`}</text>
    <text x={rightX + boxW / 2} y="66" class="iso-colhdr iso-t-green" font-size="11" text-anchor="middle" font-weight="bold">U(5) under ×</text>

    {dict.map((d, i) => (
      <g>
        <rect x={leftX} y={rowY[i] - boxH / 2} width={boxW} height={boxH} rx="7" class="iso-box iso-b-blue" />
        <text x={leftX + boxW / 2} y={rowY[i] + 5} class="iso-el" font-size="12" text-anchor="middle">{d.k}</text>

        <line x1={leftX + boxW + 8} y1={rowY[i]} x2={rightX - 8} y2={rowY[i]} class="iso-arrow" marker-end="url(#iso-head)" />

        <rect x={rightX} y={rowY[i] - boxH / 2} width={boxW} height={boxH} rx="7" class="iso-box iso-b-green" />
        <text x={rightX + boxW / 2} y={rowY[i] + 5} class="iso-el" font-size="12" text-anchor="middle">{d.v}</text>
      </g>
    ))}

    <text x={w / 2} y="254" class="iso-foot" font-size="10.5" text-anchor="middle">
      {`${a} + ${b} = ${sum} in ℤ₄ matches ${prodLeft} × ${prodRight} = ${prod} in U(5)`}
    </text>
    <text x={w / 2} y="272" class="iso-sub" font-size="9.5" text-anchor="middle">
      Every line of one table becomes a line of the other, which is what ≅ means
    </text>

    <defs>
      <marker id="iso-head" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" class="iso-head-fill" />
      </marker>
    </defs>
  </svg>
</figure>

<style>
  .iso { display:flex; flex-direction:column; align-items:center; margin:1.5rem 0; }
  .iso svg { width:100%; max-width:100%; height:auto; }
  .iso-box { fill-opacity:0.14; stroke-width:1.7; }
  .iso-b-blue { fill:#58a6ff; stroke:#58a6ff; }
  .iso-b-green { fill:#7ee787; stroke:#7ee787; }
  .iso-colhdr { font-family:'Libre Baskerville',Georgia,serif; }
  .iso-t-blue { fill:#58a6ff; }
  .iso-t-green { fill:#7ee787; }
  .iso-el { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .iso-dict { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .iso-arrow { stroke:#888; stroke-width:1.4; }
  .iso-head-fill { fill:#888; }
  .iso-head { fill:#eee; font-family:'Libre Baskerville',Georgia,serif; }
  .iso-foot { fill:#d2a8ff; font-family:'Libre Baskerville',Georgia,serif; }
  .iso-sub { fill:#9198a1; font-family:'Libre Baskerville',Georgia,serif; font-style:italic; }
  :global([data-theme="light"]) .iso-b-blue, :global([data-theme="light"]) .iso-t-blue { fill:#0550ae; stroke:#0550ae; }
  :global([data-theme="light"]) .iso-b-green, :global([data-theme="light"]) .iso-t-green { fill:#116329; stroke:#116329; }
  :global([data-theme="light"]) .iso-el { fill:#24292f; }
  :global([data-theme="light"]) .iso-dict, :global([data-theme="light"]) .iso-foot { fill:#6639ba; }
  :global([data-theme="light"]) .iso-arrow { stroke:#555; }
  :global([data-theme="light"]) .iso-head-fill { fill:#555; }
  :global([data-theme="light"]) .iso-head { fill:#24292f; }
  :global([data-theme="light"]) .iso-sub { fill:#57606a; }
</style>
