---
/**
 * UndeterminedCoefficientsDemo - Shows y = y_h + y_p decomposition.
 * Equation: y'' + 2y' + 5y = 4cos(2x)
 * y_h = e^{-x}(cos2x + 0.5sin2x) - transient (decays)
 * y_p = 0.8cos(2x) + 0.8sin(2x) - steady-state forced response
 * y = y_h + y_p - full solution
 * Legend below chart in dedicated space.
 */

const ox = 40, oy = 150, sx = 40, sy = 70;
const toPx = (t: number) => ox + t * sx;
const toPy = (v: number) => oy - v * sy;
const X0 = 20, X1 = 390, Y0 = 15, Y1 = 265;

function curve(f: (t: number) => number, tmin: number, tmax: number, step = 0.03) {
  const pts: [number, number][] = [];
  for (let t = tmin; t <= tmax + 1e-9; t += step) {
    const px = toPx(t), py = toPy(f(t));
    if (px >= X0 && px <= X1 && py >= Y0 && py <= Y1) pts.push([px, py]);
  }
  return pts;
}
const ptsStr = (pts: [number, number][]) => pts.map(p => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

// Homogeneous (transient): decays away
const yh = (t: number) => Math.exp(-t) * (Math.cos(2 * t) + 0.5 * Math.sin(2 * t));
// Particular (steady-state): constant amplitude oscillation
const yp = (t: number) => 0.8 * Math.cos(2 * t) + 0.8 * Math.sin(2 * t);
// Full solution
const yFull = (t: number) => yh(t) + yp(t);

const cRed = curve(yh, 0, 8.5);
const cBlue = curve(yp, 0, 8.5);
const cGreen = curve(yFull, 0, 8.5);
---

<figure class="ucd" role="img" aria-label="Decomposition of nonhomogeneous solution into homogeneous transient and particular steady-state">
  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg" class="ucd-svg">
    {/* Grid */}
    <g class="ucd-grid">
      {[0,2,4,6,8].map(t => <line x1={toPx(t)} y1={Y0} x2={toPx(t)} y2={Y1} />)}
      {[-2,-1,0,1,2].map(v => toPy(v) >= Y0 && toPy(v) <= Y1 ? <line x1={X0} y1={toPy(v)} x2={X1} y2={toPy(v)} /> : null)}
    </g>

    {/* Axes */}
    <line x1={X0} y1={toPy(0)} x2={X1} y2={toPy(0)} class="ucd-axis" />
    <line x1={toPx(0)} y1={Y0} x2={toPx(0)} y2={Y1} class="ucd-axis" />
    <text x={X1 + 4} y={toPy(0) + 4} class="ucd-lbl axis">x</text>
    <text x={toPx(0) + 6} y={Y0 + 2} class="ucd-lbl axis">y</text>

    {/* Curves */}
    <polyline points={ptsStr(cRed)} class="ucd-curve c-red" fill="none" />
    <polyline points={ptsStr(cBlue)} class="ucd-curve c-blue" fill="none" />
    <polyline points={ptsStr(cGreen)} class="ucd-curve c-green" fill="none" />

    {/* Legend below chart */}
    <line x1="40" y1="284" x2="62" y2="284" class="ucd-curve c-red" />
    <text x="68" y="288" class="ucd-lbl leg">y_h: transient (decays away)</text>
    <line x1="40" y1="300" x2="62" y2="300" class="ucd-curve c-blue" />
    <text x="68" y="304" class="ucd-lbl leg">y_p: particular (steady-state)</text>
    <line x1="40" y1="316" x2="62" y2="316" class="ucd-curve c-green" />
    <text x="68" y="320" class="ucd-lbl leg">y = y_h + y_p (full solution)</text>
  </svg>
</figure>

<style>
  .ucd { display: flex; justify-content: center; margin: 1.5rem 0; }
  .ucd-svg { width: 100%; max-width: 500px; height: auto; }
  .ucd-grid line { stroke: #262626; stroke-width: 0.5; }
  .ucd-axis { stroke: #555; stroke-width: 1.2; }
  .ucd-curve { stroke-width: 2.2; stroke-linecap: round; }
  .c-red { stroke: #f47067; }
  .c-blue { stroke: #58a6ff; }
  .c-green { stroke: #7ee787; }
  .ucd-lbl { font-family: "Libre Baskerville", Georgia, serif; fill: #aaa; }
  .axis { font-size: 13px; font-weight: bold; fill: #888; }
  .leg { font-size: 10px; }

  :root[data-theme="light"] .ucd-grid line { stroke: #e8e8e8; }
  :root[data-theme="light"] .ucd-axis { stroke: #999; }
  :root[data-theme="light"] .c-red { stroke: #c4432b; }
  :root[data-theme="light"] .c-blue { stroke: #0550ae; }
  :root[data-theme="light"] .c-green { stroke: #1a7f2e; }
  :root[data-theme="light"] .ucd-lbl { fill: #555; }
  :root[data-theme="light"] .axis { fill: #666; }
</style>
