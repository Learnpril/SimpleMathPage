---
interface Props {
  title?: string;
}
const { title = "Cone — V = ⅓πr²h" } = Astro.props;
---

<figure class="cone-diagram" role="img" aria-label={title}>
  {title && <figcaption class="cone-title">{title}</figcaption>}
  <svg viewBox="0 0 220 200" width="220" height="200" xmlns="http://www.w3.org/2000/svg">

    {/* Cone body — two slant lines from apex to base ellipse */}
    <line class="cone-edge" x1="110" y1="20" x2="40" y2="155" />
    <line class="cone-edge" x1="110" y1="20" x2="180" y2="155" />

    {/* Base ellipse */}
    <ellipse class="cone-base" cx="110" cy="155" rx="70" ry="18" />

    {/* Height dashed line (apex to center of base) */}
    <line class="cone-dim" x1="110" y1="20" x2="110" y2="155" stroke-dasharray="5,4" />

    {/* Radius line (center to edge of base) */}
    <line class="cone-dim" x1="110" y1="155" x2="180" y2="155" />

    {/* Height label */}
    <text class="cone-label" x="96" y="92" text-anchor="end">h</text>

    {/* Radius label */}
    <text class="cone-label" x="145" y="148" text-anchor="middle">r</text>

    {/* Small dots at endpoints */}
    <circle class="cone-dot" cx="110" cy="20" r="3" />
    <circle class="cone-dot" cx="110" cy="155" r="3" />
    <circle class="cone-dot" cx="180" cy="155" r="3" />

  </svg>
</figure>

<style>
  .cone-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1.5rem 0;
  }
  .cone-title {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
    font-style: italic;
  }
  .cone-diagram svg {
    max-width: 100%;
    height: auto;
  }

  /* Dark mode (default) */
  .cone-edge { stroke: #999; stroke-width: 2; }
  .cone-base { fill: none; stroke: #999; stroke-width: 2; }
  .cone-dim { stroke: #58a6ff; stroke-width: 1.5; }
  .cone-label { fill: #58a6ff; font-family: 'Libre Baskerville', Georgia, serif; font-size: 16px; font-style: italic; font-weight: bold; }
  .cone-dot { fill: #58a6ff; }

  /* Light mode */
  :global([data-theme="light"]) .cone-edge { stroke: #444; }
  :global([data-theme="light"]) .cone-base { stroke: #444; }
  :global([data-theme="light"]) .cone-dim { stroke: #0550ae; }
  :global([data-theme="light"]) .cone-label { fill: #0550ae; }
  :global([data-theme="light"]) .cone-dot { fill: #0550ae; }
</style>
