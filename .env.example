# Copy to .env and fill in. Both values come from the Supabase project settings,
# under Project Settings > API.
#
# The PUBLIC_ prefix is Astro's, and it means these are compiled into the client
# bundle. That is intended: the anon key is designed to be public and is what row
# level security exists to protect. Never put a service_role key in here.
#
# `astro build` succeeds without this file, so the site's pages all render. What
# breaks is sign-in and progress tracking: src/lib/supabase/client.ts throws
# "Supabase not configured" when either value is missing.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Advertising. Two separate switches, and they do different jobs. See ADS.md.
#
# PUBLIC_ADSENSE_CLIENT alone puts the AdSense loader script in the head of every
# page. That is what a Google review needs, and it places no ad units.
#
# PUBLIC_ADS_ENABLED is what actually renders visible ad units. It stays false.
#
# For production both are set in netlify.toml, not here. Set them locally only if
# you want to reproduce the deployed head; leaving them unset makes the site emit
# no third-party ad requests at all.
# ---------------------------------------------------------------------------

PUBLIC_ADS_ENABLED=false

# WITH the "ca-" prefix. Note public/ads.txt wants the same ID WITHOUT it.
PUBLIC_ADSENSE_CLIENT=ca-pub-4826012304343164
